package ar.com.ospim.procesaArchivos.beans;

import java.text.ParseException;
import java.text.SimpleDateFormat;
import java.util.Date;

public class HeaderSumaXxxx {
	
	public static final int SUMARTE = 1;
	public static final int SUMA70 = 2;
	public static final int SUMA = 3;
	public static final int SUBASI = 4;
	
	public static int longTipoRegistro = 2;
	public static int longTipoProceso = 7; // para SUMARTE, depende del nombre del proceso lo voy a cambiar
	public static int longFechaEnvioAFIP = 10;
	public static int longHoraEnvioAFIP = 8;
	public static int longAreaReservada = 126;
	
	private String tipoRegistro;
	private String tipoProceso;
	private Date fechaEnvioAFIP;
	private String horaEnvioAFIP;
	private String areaReservada;
	private String clvId;
	
	
	
	public HeaderSumaXxxx() {}

	/**
	 * 
	 * @param line
	 * @param proceso: 1 para Sumarte, 2 para Suma70, 3 para Suma
	 * @throws ParseException
	 */
	public HeaderSumaXxxx(String line, int proceso) throws ParseException{
		SimpleDateFormat sdf= new SimpleDateFormat("yyyy-MM-dd");		
		int posicion=0;
		switch (proceso) {
		case SUMA70:
			longTipoProceso = 6;
			break;
		case SUMA: // idem SUBASI
			longTipoProceso = 6; // SUMA
//			longTipoProceso = 6; // SUBASI
			break;
		case SUBASI: // idem SUBASI
			//longTipoProceso = 4; // SUMA
			longTipoProceso = 6; // SUBASI
			break;
		default: longTipoProceso = 6;
			break;
		}
		
		this.tipoRegistro   = line.substring(posicion,longTipoRegistro);
		posicion += longTipoRegistro; 
		this.tipoProceso    = line.substring(posicion,posicion+longTipoProceso);
		posicion += longTipoProceso;
		this.fechaEnvioAFIP = sdf.parse(line.substring(posicion+longTipoRegistro,posicion+longFechaEnvioAFIP+longTipoRegistro));
		posicion += longFechaEnvioAFIP;
		this.horaEnvioAFIP  = line.substring(posicion+longTipoRegistro,posicion+longHoraEnvioAFIP+longTipoRegistro);
		posicion += longHoraEnvioAFIP;
//		this.areaReservada  = line.substring(posicion,posicion+longAreaReservada);
	
	}
	
	
	
	public String toString(){
		StringBuilder aux= new StringBuilder();
		aux.append("COD. REG: ");
		aux.append(this.getTipoRegistro());
		aux.append("\nCOD. ARCH: ");
		aux.append(this.getTipoProceso());
		aux.append("\nFECHA AFIP: ");
		aux.append(this.getFechaEnvioAFIP());

		return aux.toString();		
	}

	public String getTipoRegistro() {
		return tipoRegistro;
	}

	public void setTipoRegistro(String tipoRegistro) {
		this.tipoRegistro = tipoRegistro;
	}

	public String getTipoProceso() {
		return tipoProceso;
	}

	public void setTipoProceso(String tipoProceso) {
		this.tipoProceso = tipoProceso;
	}

	public Date getFechaEnvioAFIP() {
		return fechaEnvioAFIP;
	}

	public void setFechaEnvioAFIP(Date fechaEnvioAFIP) {
		this.fechaEnvioAFIP = fechaEnvioAFIP;
	}

	public String getHoraEnvioAFIP() {
		return horaEnvioAFIP;
	}

	public void setHoraEnvioAFIP(String horaEnvioAFIP) {
		this.horaEnvioAFIP = horaEnvioAFIP;
	}

	public String getAreaReservada() {
		return areaReservada;
	}

	public void setAreaReservada(String areaReservada) {
		this.areaReservada = areaReservada;
	}

	public String getClvId() {
		return clvId;
	}

	public void setClvId(String clvId) {
		this.clvId = clvId;
	}
	
	

}
