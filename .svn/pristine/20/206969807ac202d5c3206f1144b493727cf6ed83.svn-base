package ar.com.ospim.afiliados.action;

import java.text.SimpleDateFormat;
import java.util.Date;
import java.util.List;

import javax.portlet.ActionRequest;
import javax.portlet.ActionResponse;
import javax.portlet.PortletConfig;
import javax.portlet.PortletSession;
import javax.portlet.RenderRequest;
import javax.portlet.RenderResponse;
import javax.servlet.http.HttpSession;

import org.apache.log4j.Logger;
import org.apache.struts.action.ActionForm;
import org.apache.struts.action.ActionForward;
import org.apache.struts.action.ActionMapping;

import com.liferay.portal.kernel.language.LanguageUtil;
import com.liferay.portal.kernel.servlet.SessionErrors;
import com.liferay.portal.kernel.servlet.SessionMessages;
import com.liferay.portal.kernel.util.Constants;
import com.liferay.portal.kernel.util.ParamUtil;
import com.liferay.portal.model.User;
import com.liferay.portal.struts.PortletAction;
import com.liferay.portal.util.PortalUtil;

import ar.com.ospim.afiliados.WebKeysAfiliados;
import ar.com.ospim.afiliados.beans.Afiliado;
import ar.com.ospim.afiliados.exceptions.RestaurarCoberturaMedicaException;
import ar.com.ospim.afiliados.services.PlanServiceUtil;

/**
 * 
 * @author Sergio
 *
 * 
 */
public class GestionarActivSuspCoberturaMedicaAction extends PortletAction {
	
	private PlanServiceUtil planService = new PlanServiceUtil();
	
	private Logger _log = Logger.getLogger(this.getClass());
	
	public void processAction(ActionMapping mapping, ActionForm form,
			PortletConfig portletConfig, ActionRequest actionRequest,
			ActionResponse actionResponse) throws Exception {
						
//		User user = PortalUtil.getUser(actionRequest);
	}

	public ActionForward render(ActionMapping mapping, ActionForm form,
			PortletConfig portletConfig, RenderRequest renderRequest,
			RenderResponse renderResponse) throws Exception {
				
		HttpSession session = (HttpSession) PortalUtil.getHttpServletRequest(renderRequest).getSession();
		
		User user = PortalUtil.getUser(renderRequest);
		
		SimpleDateFormat formatoDeFechas = new SimpleDateFormat("dd/MM/yyyy");
		
		
		String cuilTitular = ParamUtil.getString(renderRequest, "cuil_titular");
		int inte = ParamUtil.getInteger(renderRequest, "inte");
		String fechaDia = ParamUtil.getString(renderRequest,"diaSuspCob");
		String fechaMes = ParamUtil.getString(renderRequest,"mesSuspCob");
		String fechaAnio = ParamUtil.getString(renderRequest,"anioSuspCob");
		Date fechaSusReacCobertuMedica = null;
		try {
			fechaSusReacCobertuMedica = formatoDeFechas.parse(fechaDia + "/"
					+ (Integer.parseInt(fechaMes) + 1) + "/"
					+ fechaAnio);
		} catch (Exception e) {
			fechaSusReacCobertuMedica = null;
		}
		
		String cmd = ParamUtil.getString(renderRequest, "accion");
		
		boolean resultado = false;
		String mensaje = null;
		
		if(cmd.equalsIgnoreCase(Constants.DEACTIVATE)) {
			resultado = planService.suspenderCobMedicaBeneficiario(cuilTitular, inte, fechaSusReacCobertuMedica, user.getScreenName());
			if(inte == 0) {
				mensaje = LanguageUtil.get(defaultLocale, "suspender-cob-med-gf-ok");
			}else {
				mensaje = LanguageUtil.get(defaultLocale, "suspender-cob-med-i-ok");
			}
		}
		
		if(cmd.equalsIgnoreCase(Constants.RESTORE)) {
			resultado = planService.restablecerCobMedicaBeneficiario(cuilTitular, inte, fechaSusReacCobertuMedica, user.getScreenName());
			if(inte == 0) {
				mensaje = LanguageUtil.get(defaultLocale, "restablecer-cob-med-gf-ok");
			}else {
				mensaje = LanguageUtil.get(defaultLocale, "restablecer-cob-med-i-ok");
			}
		}
		
		
		if(cmd.equalsIgnoreCase("antecedentes")) {
			resultado = planService.marcarAntecedenteJudicialAfiliado(cuilTitular, inte, user.getScreenName());
			
			List<Afiliado>afiliadosList = (List<Afiliado>) session.getAttribute(WebKeysAfiliados.BUSQUEDA_AFILIADO);
			for(Afiliado a:afiliadosList) {
				if(a.getCuil_titular().equals(cuilTitular) && a.getInte()==inte) {
					a.setTieneAntecedentesJudiciales(1);
					break;
				}
			}
			
			return mapping.findForward("portlet.afiliados.result.search");
		}
		
		
		if(resultado) {
			SessionMessages.add(renderRequest, "coberturaMedicaOk");
			renderRequest.setAttribute("msgCoberturaMedicaOk", mensaje); 
		}else {
			SessionErrors.add(renderRequest, new RestaurarCoberturaMedicaException().getClass().getName());
//			throw new RestaurarCoberturaMedicaException();
		}
		
//		return mapping.findForward("portlet.afiliados.busqueda");
		return mapping.findForward("portlet.afiliados.result.search");
		
	}
}