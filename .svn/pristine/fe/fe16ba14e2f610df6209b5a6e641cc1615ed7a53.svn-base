package ar.com.ospim.global.beans;

import java.io.Serializable;
import java.util.ArrayList;
import java.util.Calendar;
import java.util.Date;
import java.util.List;

import org.apache.poi.hssf.usermodel.HSSFWorkbook;

import com.liferay.portal.SystemException;
import com.liferay.portal.kernel.log.Log;
import com.liferay.portal.kernel.log.LogFactoryUtil;

import ar.com.ospim.automatico.AgendadoJava;
import ar.com.ospim.automatico.beans.ReporteAutomatico;
import ar.com.ospim.automatico.service.ReportesServiceUtil;
import ar.com.ospim.comprobantesPortalProveedores.services.ComprobanteServiceUtil;
import ar.com.ospim.global.services.TraeListasServiceUtil;
import ar.com.ospim.webservice.proveedoresLPA.ClienteProveedoresLPA;

public class SincronizarComprobantesPortalProveedores extends AgendadoJava implements Serializable {

	/**
	 * 
	 */
	private static final long serialVersionUID = 9170170054427467871L;
	private static Log logger = LogFactoryUtil.getLog(SincronizarComprobantesPortalProveedores.class);

	@Override
	public void correrAgendado(ReporteAutomatico ra) {

		logger.debug("ya esta Sincronización Portal Proveedores");
		ar.com.ospim.automatico.ReportesScheduler.ReportesAutomaticosConfiguracion rac = null;
		
		
		try {
			rac = ReportesServiceUtil.getConfiguracion();
			Calendar c1 = Calendar.getInstance();
///////////////			
//Borrar	   
///////////////
//          c1.set(2023, Calendar.SEPTEMBER, 2);			
//	        c1.set(2023, Calendar.AUGUST, 16);
//		
			c1.add(Calendar.DATE, -1);
	        Date fechaIni=  c1.getTime();
			Date fechaFin= c1.getTime(); 
			
			List <Comprobante> cs = ClienteProveedoresLPA.getComprobantesByEstado("Verificado",fechaIni,fechaFin);
			List <Comprobante> csProcesados = new ArrayList<Comprobante>();
			List <Comprobante> csErroneos = new ArrayList<Comprobante>();
			
			if(!cs.isEmpty()) {
				for(Comprobante c:cs) {
					try {
					    ComprobanteServiceUtil.savecomprobanteProveedor(c, "automatico");
					    csProcesados.add(c);
					}catch(Exception ec) {
						csErroneos.add(c);
					}
				}
			}
			
			if(!csProcesados.isEmpty()) {
				ClienteProveedoresLPA.getComprobantes(csProcesados);
				ClienteProveedoresLPA.getAdjuntos(csProcesados);
			}
			
			if(!csErroneos.isEmpty()) {
				for(Comprobante c:csErroneos) {
				  logger.error(c.getComprobanteIdProveedor());
				}  
			}
			
			List <Comprobante> csR = ClienteProveedoresLPA.getComprobantesByEstado("Rechazado",fechaIni,fechaFin);
			List <Comprobante> csProcesadosR = new ArrayList<Comprobante>();
			List <Comprobante> csErroneosR = new ArrayList<Comprobante>();
			if(!csR.isEmpty()) {
				for(Comprobante c:csR) {
					try {
					    ComprobanteServiceUtil.savecomprobanteProveedor(c, "automatico");
					    csProcesadosR.add(c);
					}catch(Exception ee) {
						csErroneosR.add(c);
					}
				}
			}
			
			if(!csProcesadosR.isEmpty()) {
					ClienteProveedoresLPA.getComprobantes(csProcesadosR);
					ClienteProveedoresLPA.getAdjuntos(csProcesadosR);
			}
				
			if(!csErroneosR.isEmpty()) {
			   for(Comprobante c:csErroneosR) {
				  logger.error(c.getComprobanteIdProveedor());
			   }  
			}
			
			//CON RECIBO
			List <Comprobante> csRec = ClienteProveedoresLPA.getComprobantesByEstado("Con Recibo",fechaIni,fechaFin);
			List <Comprobante> csProcesadosRec = new ArrayList<Comprobante>();
			List <Comprobante> csErroneosRec = new ArrayList<Comprobante>();
			if(!csRec.isEmpty()) {
				for(Comprobante c:csRec) {
					try {
					    csProcesadosRec.add(c);
					}catch(Exception ee) {
						csErroneosRec.add(c);
					}
				}
			}
			
			if(!csProcesadosRec.isEmpty()) {
					ClienteProveedoresLPA.getComprobanteRecibo(csProcesadosRec);
			}
				
			if(!csErroneosRec.isEmpty()) {
			   for(Comprobante c:csErroneosRec) {
				  logger.error("Error  al traer recibo " +c.getComprobanteIdProveedor());
			   }  
			}
			
			//Comprobantes pendientes de Verificar o Rechazar
			String qDias =TraeListasServiceUtil.getSystemConfig("PORTAL_PROVEEDORES_ESTADOS_NO_CONFIRMADOS_DIAS_RECUPERAR");
			Calendar c2 = Calendar.getInstance();
			c2.add(Calendar.DATE, Integer.parseInt(qDias) );
			Calendar c3 = Calendar.getInstance();
			Date fechaIniPend=c2.getTime();
			Date fechaFinPend=c3.getTime();
			
			List <Comprobante> csPendientes= new ArrayList<Comprobante>();
			ComprobanteServiceUtil.deleteComprobanteTemporal();
			String[] strEstados = TraeListasServiceUtil.getSystemConfig("PORTAL_PROVEEDORES_ESTADOS_NO_CONFIRMADOS").split(";");
			if(strEstados.length>0) {
				for(int i=0;i<strEstados.length;i++) {
				   csPendientes.addAll(ClienteProveedoresLPA.getComprobantesByEstado(strEstados[i],fechaIniPend,fechaFinPend));
				}
				for(Comprobante c:csPendientes) {
					try {
					    ComprobanteServiceUtil.saveComprobanteProveedorTemporal(c, "automatico");
					}catch(Exception ee) {
					}
				}
			}
			
			ra.setUltimaEjecucion(new Date());
			ReportesServiceUtil.reporteEjecutado(ra);
			
			logger.debug("Fin Sincronizacion Portal Proveedores");
		} catch (NumberFormatException e) {
			logger.error(e);
		} catch (SystemException e) {
			logger.error(e);
		} catch (Exception e) {
			logger.error(e);
		}
	}

	@Override
	public HSSFWorkbook getResultados() {
		// TODO Auto-generated method stub
		return null;
	}


    
}
