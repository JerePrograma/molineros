package ar.com.ospim.afiliados.services;

import java.sql.Connection;
import java.util.List;

import ar.com.ospim.afiliados.beans.AfiCuentasBancarias;
import ar.com.ospim.util.ConnectionHelper;

import com.liferay.portal.SystemException;
import com.liferay.portal.model.User;

public class AfiCuentasBancariasServiceUtil {

    private static AfiCuentasBancariasServiceImpl instance = null;

    private static AfiCuentasBancariasServiceImpl getInstance() {
        if (instance == null) {
            instance = new AfiCuentasBancariasServiceImpl();
        }
        return instance;
    }

    public static void insertaCuenta(Connection con, AfiCuentasBancarias cuenta) throws SystemException {
        getInstance().insertaCuenta(con, cuenta);
    }

    public static void actualizaCuenta(Connection con, int idCuenta, String user) throws SystemException {
        getInstance().actualizaCuenta(con, idCuenta, user);
    }

    public static void eliminaArchivo(Connection con, int id, String tipo) throws SystemException {
        getInstance().eliminaArchivo(con, id, tipo);
    }

    public static AfiCuentasBancarias getCuentaPorId(Connection con, int id) throws SystemException {
        return getInstance().getCuentaPorId(con, id);
    }

    public static List<AfiCuentasBancarias> getCuentas(Connection con, String cuilTitular, int inte) throws SystemException {
        return getInstance().getCuentas(con, cuilTitular, inte);
    }
    
	 //sobrecarga el metodo para compatibilidad con codigo jsp
    public static List<AfiCuentasBancarias> getCuentas(String cuilTitular, int inte) throws SystemException {
        Connection con = null;
        try {
            con = ConnectionHelper.getConnection();
            return getCuentas(con, cuilTitular, inte);
        } catch (Exception e) {
            throw new SystemException("Error buscando cuentas bancarias", e);
        } finally {
            ConnectionHelper.cerrar(con);
        }
    }
    
    public static AfiCuentasBancarias getCuentaPorId(int id) throws SystemException {
        Connection con = null;
        try {
            con = ConnectionHelper.getConnection();
            return getCuentaPorId(con, id);
        } catch (Exception e) {
            throw new SystemException("Error buscando cuenta por ID", e);
        } finally {
            ConnectionHelper.cerrar(con);
        }
    }

    public static int insertaOActualizaCuentaBancaria(
            String cuilTitular,
            int inte,
            String apellido,
            String nombre,
            String email,
            boolean titular,
            String cbu,
            String cuilCbu,
            String fileCbu,
            String fileNotaAutorizada,
            User user
    ) throws SystemException {
        return getInstance().insertaOActualizaCuentaBancaria(
            cuilTitular, inte, apellido, nombre, email, titular,
            cbu, cuilCbu, fileCbu, fileNotaAutorizada, user
        );
    }


}
