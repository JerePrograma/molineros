	public BigDecimal getImporteCheques() {
		BigDecimal total = BigDecimal.ZERO;

		if (this.chequesRecibidos != null && this.chequesRecibidos.size() > 0) {
			for (MovimientoBancoCheque mov : this.chequesRecibidos) {
				if (!mov.isBorradoLogico()) {
					total = total.add(mov.getCheque().getImporte());
				}
			}
		}
		if (this.chequesDepositados != null
				&& this.chequesDepositados.size() > 0) {
			for (MovimientoBancoCheque mov : this.chequesDepositados) {
				if (!mov.isBorradoLogico()) {
					total = total.add(mov.getCheque().getImporte());
				}
			}
		}
		if (this.chequesCanjeados != null && this.chequesCanjeados.size() > 0) {
			for (MovimientoBancoCheque mov : this.chequesCanjeados) {
				if (!mov.isBorradoLogico()) {
					total = total.add(mov.getCheque().getImporte());
				}
			}
		}

		return total;

	}

