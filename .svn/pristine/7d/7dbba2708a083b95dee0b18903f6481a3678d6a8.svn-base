		this.tipo_mov = new TipoMovBcrio(tipo_mov);
		this.cta_bcria = new CuentaBancaria(cta_bca);
		// this.tipo_trx_bcria = new TipoTrxBancaria(tipo_trx);
		this.fecha_comprobante = new Date(fecha_compro.getTime());
		this.nro_comprobante = nro_compro;
		this.descripcion = descrip;
		this.importe = new BigDecimal(importe);
	}

