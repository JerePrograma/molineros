			String alta_usr) {
		this.id_movimiento = id_mov;
		this.fecha_movimiento = new Date(fecha_mov.getTime());
		this.tipo_mov = new TipoMovBcrio(id_tipo_mov);
		this.cta_bcria = new CuentaBancaria(id_cta_bca);
