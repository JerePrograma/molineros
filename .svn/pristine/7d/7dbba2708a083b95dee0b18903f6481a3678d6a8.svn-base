		this.concilia_fecha = concilia_fecha != null ? new Date(
				concilia_fecha.getTime()) : null;
		this.concilia_usr = concilia_usr;
		this.alta_fecha = new Date(alta_fecha.getTime());
		this.alta_usr = alta_usr;
	}

