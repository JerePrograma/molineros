	public MovimientoBancario(MovimientoBancario mov) {
		this.id_movimiento = mov.getId_movimiento();
		this.fecha_movimiento = mov.getFecha_movimiento();
		this.tipo_mov = mov.getTipo_mov();
		this.cta_bcria = mov.getCta_bcria();
		this.fecha_comprobante = mov.getFecha_comprobante();
		this.nro_comprobante = mov.getNro_comprobante();
		this.descripcion = mov.getDescripcion();
		this.importe = mov.getImporte();
		this.no_a_la_orden = mov.isNo_a_la_orden();
		this.deb_cred = mov.isDeb_cred();
		this.imprime_cheque = mov.isImprime_cheque();
		this.concilia_fecha = mov.getConcilia_fecha();
		this.concilia_usr = mov.getConcilia_usr();
		this.alta_fecha = mov.getAlta_fecha();
		this.baja_fecha = mov.getBaja_fecha();
		this.alta_usr = mov.getAlta_usr();
	}

	public MovimientoBancario(String line) throws ParseException {
		super();
		String[] linea = line.split("\\|");

		this.descripcion = linea[0].trim();

		@SuppressWarnings("deprecation")
		List<CuentaBancaria> ctasBcrias = TraeListasServiceUtil.getCtasBcrias();

		String cuentaBcriaCrudo = linea[1].trim();

		String[] ctaBcriaArr = cuentaBcriaCrudo.split("/");

		for (CuentaBancaria cta : ctasBcrias) {
			if (cta.getNro_cuenta() == Integer.parseInt(ctaBcriaArr[0])) {
				this.cta_bcria = cta;
			}
		}

		try {
			if (!linea[2].trim().equals("")) {
				this.fecha_movimiento = sdf.parse(linea[2].trim());
			}

			if (linea[3].trim().toUpperCase().equals("SUBSIDIOS APE")) {
				this.tipo_mov = new TipoMovBcrio(TipoMovBcrio.SUBSIDIOS_APE);
			}
			if (linea[4].trim().toUpperCase().equals("CREDITO")) {
				this.deb_cred = false;
			}
			this.nroExpedienteSur = linea[5].trim();

			if (!linea[6].trim().equals("")) {
				this.fechaSur = sdf.parse(linea[6].trim());
			}

			if (!linea[7].trim().equals("")) {
				this.fecha_comprobante = sdf.parse(linea[7].trim());
			} else {
				this.fecha_comprobante = this.fecha_movimiento;
			}

		} catch (ParseException e) {
			throw e;
		}
		this.nro_comprobante = linea[8].trim();
		String importeStr = linea[9].trim();
		this.importe = new BigDecimal(importeStr.replace(",", "."));

	}

