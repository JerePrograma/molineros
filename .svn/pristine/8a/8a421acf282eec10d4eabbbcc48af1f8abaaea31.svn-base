	public String traerNumerosReclamos(int op, int idFormaPago) throws SystemException {
		Connection con = null;
		CallableStatement stmt = null;
		
		String numeros=  "";
		
		_log.debug("Orden de pago " + op);
		
		try {
			String sql = "{call autorizaciones.traer_numeros_reclamos (?,?)}";
			con = ConnectionHelper.getConnection();
			stmt = con.prepareCall(sql.toString());
			stmt.setInt(1, op);
			stmt.setInt(2, idFormaPago);

			ResultSet rs = stmt.executeQuery();
			while (rs.next()) {
				numeros = numeros + rs.getString(1) + " - ";
			}
			if (StringUtils.checkNotEmpty(numeros)){
				numeros= numeros.substring(0, numeros.length() - 2);
			}
			
		} catch (Exception e) {
			_log.error("Error al buscar ReclamoPrestacional por OP", e);
		} finally {
			ConnectionHelper.cerrar(stmt, con);
		}
		
		return numeros;
	}	
	
	public List<ReclamoPrestacionalCuenta> getCuentasPorCuil(String cuil) throws Exception {
	    List<ReclamoPrestacionalCuenta> lista = new ArrayList<ReclamoPrestacionalCuenta>();
	    Connection con = null;
	    PreparedStatement ps = null;
	    ResultSet rs = null;

	    try {
	        con = ConnectionHelper.getConnection();
	        String sql = "SELECT *, cuil_cbu AS cuil FROM autorizaciones.reclamos_prestacionales_cuenta_bancaria WHERE cuil_cbu = ? AND baja_fecha IS NULL";
	        ps = con.prepareStatement(sql);
	        ps.setString(1, cuil);
	        rs = ps.executeQuery();

	        while (rs.next()) {
	            ReclamoPrestacionalCuenta cuenta = ReclamoPrestacionalCuenta.getMapping(rs, "");
	            lista.add(cuenta);
	        }
	    } catch (Exception e) {
	        _log.error("Error en getCuentasPorCuil", e);
	        throw e;
	    } finally {
	        ConnectionHelper.cerrar(ps, con);
	    }

	    return lista;
	}
	
	public static Integer obtenerIdReintegroAPP(int idPReintegroApp) throws SystemException {
        Connection con = null;
        CallableStatement stmt = null;
        try {
            con = ConnectionHelper.getConnection();
            stmt = con.prepareCall("{ ? = call autorizaciones.obtener_id_reintegro_app(?) }");
            stmt.registerOutParameter(1, java.sql.Types.INTEGER);
            stmt.setInt(2, idPReintegroApp);
            stmt.execute();
            return stmt.getInt(1);
        } catch (Exception e) {
            throw new SystemException("Error al obtener id_reintegro_app para reintegro id: " + idPReintegroApp, e);
        } finally {
            ConnectionHelper.cerrar(stmt, con);
        }
    }
	
	public static List<DLFileEntryImpl> getImagenesReintegro(String titulo) throws SystemException {
	    Connection con = null;
	    CallableStatement stmt = null;
	    List<DLFileEntryImpl> list = new ArrayList<DLFileEntryImpl>();
	    try {
	        String sql = "{call autorizaciones.busca_imagenes_reintegro(?)}";
	        con = ConnectionHelper.getConnection();
	        stmt = con.prepareCall(sql);
	        stmt.setString(1, titulo);

	        ResultSet rs = stmt.executeQuery();
	        while (rs.next()) {
	            DLFileEntryImpl a = new DLFileEntryImpl();
	            a.setFolderId(rs.getLong("folderId"));
	            a.setName(rs.getString("fileName"));
	            a.setDescription(rs.getString("fileDescription"));
	            a.setTitle(rs.getString("fileTitle"));
	            a.setSize(rs.getInt("size"));
	            list.add(a);
	        }
	    } catch (Exception e) {
	        _log.error("Error al buscar Imágenes de Reintegro", e);
	        throw new SystemException(e);
	    } finally {
	        ConnectionHelper.cerrar(stmt, con);
	    }
	    return list;
	}
	
	public List<MovimientoReclamoHistorico> buscaHistoricoReclamo(int idReclamo)
	        throws SQLException, SystemException {

	    Connection con = null;
	    CallableStatement stmt = null;
	    List<MovimientoReclamoHistorico> historico = new ArrayList<MovimientoReclamoHistorico>();

	    try {
	        con = ConnectionHelper.getConnection();
	        String sql = "{ call autorizaciones.historico_reclamo_prestacional(?) }";
	        stmt = con.prepareCall(sql);
	        stmt.setInt(1, idReclamo);
	        ResultSet rs = stmt.executeQuery();

	        while (rs.next()) {
	            MovimientoReclamoHistorico m = new MovimientoReclamoHistorico();
	            m.setEstado(rs.getString("estado"));
	            m.setAltaFecha(rs.getTimestamp("alta_fecha"));
	            m.setAltaUsuario(rs.getString("alta_usuario"));
	            m.setBajaFecha(rs.getTimestamp("baja_fecha"));
	            m.setObservacion(rs.getString("observacion"));
	            historico.add(m);
	        }

	    } catch (Exception e) {
	        throw new SystemException(e);
	    } finally {
	        ConnectionHelper.cerrar(stmt, con);
	    }
	    
	    return historico;
	}
	
	public void altaModiCuenta2(ReclamoPrestacional reclamo, User user, Integer idCuenta) throws SystemException {
	    Connection con = null;
	    CallableStatement stmt = null;

	    try {
	        String sqlAlta = "{call autorizaciones.inserta_reclamo_prestaciones_cuenta(?,?,?,?,?,?,?,?,?,?,?)}";
	        String sqlModi = "{call autorizaciones.update_reclamo_prestaciones_cuenta(?,?,?,?,?,?,?,?,?,?)}";
	        con = ConnectionHelper.getConnection();

	        if (reclamo.getCuenta() != null) {
	            ReclamoPrestacionalCuenta cuenta = reclamo.getCuenta();
	            ReclamoPrestacionalCuenta existente = this.getReclamoPrestacionalCuenta(cuenta.getIdReclamoPrestacional());
	            
	            //trae los datos desde afi_cuentas_bancarias segun el idCuenta recibido
	            if (idCuenta != null && idCuenta > 0) {	                
	            	AfiCuentasBancarias afiCuenta = AfiCuentasBancariasServiceUtil.getCuentaPorId(con, idCuenta);
                    if (afiCuenta != null) {
                    	// Siempre el titular (grupo familiar)
                        cuenta.setCuilGrupoFamiliar(afiCuenta.getCuilTitular());
                        
                        String cuilPago;
                        if (afiCuenta.isTitular()) {
                            cuilPago = afiCuenta.getCuilTitular();
                        } else {
                            cuilPago = (afiCuenta.getCuilCbu() != null && !afiCuenta.getCuilCbu().trim().isEmpty())
                                    ? afiCuenta.getCuilCbu()
                                    : afiCuenta.getCuilTitular();
                        }
                        cuenta.setCuil(cuilPago);
                        
                        cuenta.setCbu(afiCuenta.getCbu());
                        cuenta.setEmail(afiCuenta.getEmail());
                        cuenta.setApellido(afiCuenta.getApellido());
                        cuenta.setNombre(afiCuenta.getNombre());
                        cuenta.setImagenCBU(afiCuenta.getFileCbu());
                        // Nota autorizada solo si es apoderado
                        if (!afiCuenta.isTitular()) {
                            cuenta.setImagenNotaAutorizada(afiCuenta.getFileNotaAutorizada());
                        } else {
                            cuenta.setImagenNotaAutorizada(null);
                        }
                        cuenta.setCmbTitular(afiCuenta.isTitular() ? "0" : "1");
                    }
	            }
	            
	            // Insert o update igual que antes
	            if (existente == null) {
	                stmt = con.prepareCall(sqlAlta);
	                stmt.setInt(1, cuenta.getIdReclamoPrestacional());
	                stmt.setString(2, cuenta.getCuil());
	                stmt.setString(3, cuenta.getCbu());
	                stmt.setString(4, cuenta.getEmail() == null ? "" : cuenta.getEmail());
	                stmt.setString(5, cuenta.getCmbTitular());
	                stmt.setString(6, cuenta.getImagenCBU());
	                stmt.setString(7, cuenta.getImagenNotaAutorizada());
	                stmt.setString(8, cuenta.getApellido() == null ? "" : cuenta.getApellido().toUpperCase());
	                stmt.setString(9, cuenta.getNombre() == null ? "" : cuenta.getNombre().toUpperCase());
	                stmt.setString(10, user.getScreenName());
	                stmt.setString(11, cuenta.getCuilGrupoFamiliar());
	                stmt.executeQuery();
	            } else {
	                stmt = con.prepareCall(sqlModi);
	                stmt.setInt(1, cuenta.getIdReclamoPrestacional());
	                stmt.setString(2, cuenta.getCuil());
	                stmt.setString(3, cuenta.getCbu());
	                stmt.setString(4, cuenta.getEmail());
	                stmt.setString(5, cuenta.getCmbTitular());
	                stmt.setString(6, cuenta.getImagenCBU());
	                stmt.setString(7, cuenta.getImagenNotaAutorizada());
	                stmt.setString(8, cuenta.getApellido().toUpperCase());
	                stmt.setString(9, cuenta.getNombre().toUpperCase());
	                stmt.setString(10, user.getScreenName());
	                stmt.executeQuery();
	            }
	        }

	    } catch (SQLException e) {
	        _log.error("Error altaModiCuenta2 - CBU Reclamo Prestacional", e);
	        throw new SystemException(e);
	    } finally {
	        ConnectionHelper.cerrar(stmt, con);
	    }
	}

	private boolean existePrestacion(Connection con, int idReclamo, PrestacionesReclamo pres) throws SQLException {
	    PreparedStatement ps = null;
	    ResultSet rs = null;

	    String sql = "select autorizaciones.existe_prestacion(?, ?, ?, ?, ?, ?, ?, ?, ?)";

	    try {
	        ps = con.prepareStatement(sql);
	        ps.setInt(1, idReclamo);
	        ps.setInt(2, pres.getId_prestacion());
	        ps.setInt(3, pres.getId_medicamento());
	        ps.setString(4, pres.getComprobanteTipo() != null ? pres.getComprobanteTipo() : "");
	        ps.setString(5, pres.getComprobanteNro() != null ? pres.getComprobanteNro() : "");
	        ps.setString(6, pres.getComprobanteSucursal() != null ? pres.getComprobanteSucursal() : "");
	        ps.setString(7, pres.getComprobanteLetra() != null ? pres.getComprobanteLetra() : "");
	        ps.setString(8, pres.getComprobanteCUIT() != null ? pres.getComprobanteCUIT() : "");

	        if (pres.getFechaPrestacion() != null) {
	            ps.setDate(9, new java.sql.Date(pres.getFechaPrestacion().getTime()));
	        } else {
	            ps.setNull(9, Types.DATE);
	        }

	        rs = ps.executeQuery();
	        if (rs.next()) {
	            return rs.getBoolean(1);
	        }
	        return false;
	    } finally {
	        ConnectionHelper.cerrar(ps);
	    }
	}
	
	private boolean existeRevision(Connection con, int idReclamo, RevisionesReclamo rev) throws SQLException {
	    PreparedStatement ps = null;
	    ResultSet rs = null;

	    String sql = "select autorizaciones.existe_revision(?, ?, ?, ?, ?, ?)";

	    try {
	        ps = con.prepareStatement(sql);
	        ps.setInt(1, idReclamo);

	        if (rev.getFecha_revision() != null) {
	            ps.setDate(2, new java.sql.Date(rev.getFecha_revision().getTime()));
	        } else {
	            ps.setNull(2, Types.DATE);
	        }

	        ps.setString(3, rev.getUsr_presente() != null ? rev.getUsr_presente() : "");
	        ps.setString(4, rev.getUsr_resolucion() != null ? rev.getUsr_resolucion() : "");
	        ps.setString(5, rev.getUsr_responsable_resolucion() != null ? rev.getUsr_responsable_resolucion() : "");
	        ps.setString(6, rev.getObservacion() != null ? rev.getObservacion() : "");

	        rs = ps.executeQuery();
	        if (rs.next()) {
	            return rs.getBoolean(1);
	        }
	        return false;
	    } finally {
	        ConnectionHelper.cerrar(ps);
	    }
	}

}