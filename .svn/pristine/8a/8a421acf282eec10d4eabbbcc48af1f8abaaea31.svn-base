	public ReclamoPrestacional getReclamoPrestacional(int id) throws SystemException, NoSuchAfiliadoEntryException {
		Connection con = null;
		CallableStatement stmt = null;
		ReclamoPrestacional rp = null;
		
		_log.debug("Recl. Prest. ID " + id);
		
		try {
			String sql = "{call autorizaciones.reclamoprestaciones_by_id (?)}";
			con = ConnectionHelper.getConnection();
			stmt = con.prepareCall(sql.toString());
			stmt.setInt(1, id);
			ResultSet rs = stmt.executeQuery();
			while (rs.next()) {
				rp = ReclamoPrestacional.getMapping(rs, "rp_");
			}
		} catch (Exception e) {
			_log.error("Error al buscar reclamo prestacional", e);
		} finally {
			ConnectionHelper.cerrar(stmt, con);
		}
		
		rp.setPrestaciones(this.getPrestacionesDelReclamo(id));
		rp.setPrestacionesAsociadas(this.getPrestacionesAsociadasDelReclamo( rp.getCaso_vinculado() ));	
		rp.setRevisiones(this.getRevisionesDelReclamo(id));
		rp.setContactosCRM (this.getContactosDelReclamoxIdReclamo(rp.getAfiliado().getCuil_titular() , rp.getAfiliado().getInte(), id));
//		rp.setAfiliadoTitular(EditarAfiliadoServiceUtil.getAfiliadoTitularEntry(rp.getAfiliado().getCuil_titular()));
		
		rp.setAfiliadoTitular(EditarAfiliadoServiceUtil.getAfiliadoInclusoDadoBajaPorCuil(rp.getAfiliado().getCuil_titular(), null));
		rp.setCuenta(this.getReclamoPrestacionalCuenta(id));
	    rp.setId(id);
			
		return rp;
	}
	 
	
	
