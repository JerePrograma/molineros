	public boolean actualizar(ReclamoPrestacional reclamo , User user ) throws SystemException {
		
		Connection con = null;
		CallableStatement stmt = null, stmt2 = null, stmt3 = null, stmt4 = null, stmt5 = null;	
		boolean resp=false ;
		int idReclamo = reclamo.getId_reclamo();
			
		try {
			
			String screenName = user.getScreenName();
			
			String sql1 ="{call autorizaciones.inserta_reclamo_prestaciones(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)}";
			
			String sql11  = "{call autorizaciones.borrar_prestacion_reclamoprestacional(?,?,?)}"; 
			String sql111  = "{call autorizaciones.update_reclamo_prestaciones(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)}"; 
			
			String sql2 ="{call autorizaciones.inserta_reclamo_revisiones (?,?,?,?,?,?,?)}";
			String sql21 = "{call autorizaciones.borrar_revision_reclamoprestacional(?,?)}";  
			
			String sql4 = "{call autorizaciones.inserta_reclamo_estado(?,?,?)}";
			String sql5 = "{call autorizaciones.baja_estados_reclamo(?,?)}";		
			String sql6 ="{call autorizaciones.inserta_reclamo_cierre (?,?,?,?,?,?,?,?,?,?,?)}";
			String sql7 = "{call autorizaciones.update_datos_reclamoprestacional(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)}";
			String sql8 = "{call autorizaciones.update_reclamo_contactos(?,?,?,?)}";
			String sql9 ="{call autorizaciones.update_estados_prestaciones_encierre(?,?)}";
			
			con = ConnectionHelper.getConnectionForTransaction();
		
		
			
			if(reclamo.getEstado()>0 )
			{			
						// dar de baja los registro de estado de este reclamo			
			    stmt = con.prepareCall(sql5.toString()); 
			    stmt.setInt(1, idReclamo   );			
				stmt.setString(2, screenName);
				stmt.executeUpdate();
						// 	ingresar el nuevo registro de estado			   
			    stmt = con.prepareCall(sql4.toString()); 
			    stmt.setInt(1, idReclamo   );
				stmt.setInt(2, reclamo.getEstado());
				stmt.setString(3, screenName);
				stmt.executeUpdate();
			}
			
	// actualiza datos de la fecha seccional en la base se analiza si la fecha es distinta a null 			   
		    stmt = con.prepareCall(sql7.toString()); 
		    stmt.setInt(1, idReclamo);
			if (null != reclamo.getSeccional_fecha() ) {
				stmt.setDate(2, new java.sql.Date(reclamo.getSeccional_fecha().getTime()));										 
			} else {					
				stmt.setNull(2, Types.DATE);
			}				
			stmt.setBoolean(3,reclamo.isAmparo()  );  
			stmt.setBoolean(4, reclamo.isEntramite() ); 
			stmt.setBoolean(5, reclamo.isRecuperable() ); 
			stmt.setBoolean(6, reclamo.isSuperintendencia() ); 
			stmt.setString(7, reclamo.getDictamenComision() );
			stmt.setString(8, reclamo.getJustificaconMedica() );
			stmt.setString(9, reclamo.getDiagnosticoAfiliado()  );
			stmt.setString(10, reclamo.getCodigoCie10()  );
			stmt.setString(11, reclamo.getTipoPedido()  );
			stmt.setString(12,  screenName );
			if(reclamo.getNroLote()!=null && reclamo.getNroLote()>0) {
				stmt.setInt(13,reclamo.getNroLote());
			}else {
				stmt.setNull(13,Types.INTEGER);
			}
			stmt.setString(14, reclamo.getSector()  );

			if(reclamo.getCodigoIntegracion()!=0) {
				stmt.setInt(15,reclamo.getCodigoIntegracion());
			}else {
				stmt.setNull(15,Types.INTEGER);
			}
			
			stmt.executeUpdate();	
	
	//		*** GRABAR REGISTROS DE CIERRE***				
			if (reclamo.getEstado()==3 ){ 		     		
				    stmt3= con.prepareCall(sql6.toString());						
				    stmt3.setInt(1, idReclamo   ); 
				    
				    stmt3.setInt(2, reclamo.getTipo_gestion_cierre_reclamo()); 				
					if (null != reclamo.getFecha_cierre()) {
						stmt3.setDate(3, new java.sql.Date(reclamo.getFecha_cierre().getTime()));							 
					} else {					
						stmt3.setNull(3, Types.DATE);
					}				
					stmt3.setBoolean(4, reclamo.isReclamo_ps_factura_ospim()  );  
					stmt3.setBoolean(5, reclamo.isReclamo_a_negociar() );  
					stmt3.setString(6, reclamo.getReclamo_observacion_cierre() );  
					stmt3.setString(7, screenName); 
					stmt3.setBoolean(8, reclamo.isReclamo_convenio_gerenciadora() ); 
					stmt3.setBoolean(9, reclamo.isDosPorciento() );  
					stmt3.setBoolean(10, reclamo.isDebitoPrestadora()  );
					stmt3.setInt(11, reclamo.getIdObservacionMedica());

					stmt3.executeUpdate();			
							
			}		
		//  GRABAR REGISTROS  DE CONTACTOS DE RECLAMO PRESTACIONAL		
					if(reclamo.getContactosCRM()  !=null && reclamo.getContactosCRM().size() > 0){
						stmt5 = con.prepareCall(sql8.toString());
						for (ContactoCRM contactocrm  : reclamo.getContactosCRM() ) {
	
								stmt5 = con.prepareCall(sql8.toString());
								stmt5.setInt(1, idReclamo);				
								stmt5.setInt(2, contactocrm.getIdContacto()  );  
								stmt5.setString(3, screenName); 
								if (contactocrm.getIdCrmReclamoPrestacional()>0){
									stmt5.setBoolean(4, true); //ischecked
								}else{
									stmt5.setBoolean(4, false ); //is not checked	
								}
								stmt5.executeUpdate();
						}
					}
					
			
	//		*** REVISIONES RECLAMOS***
			if(reclamo.getRevisiones()!=null && reclamo.getRevisiones().size() > 0){
				for (RevisionesReclamo rev  : reclamo.getRevisiones()) { 
					if(rev.getEstado() != null){  
						if(rev.getEstado().equals(RevisionesReclamo.ESTADOS.BAJA)){ 
							stmt2 = con.prepareCall(sql21.toString());
							stmt2.setInt(1, rev.getId());
							stmt2.setString(2, screenName);													
						}else if(rev.getEstado().equals(RevisionesReclamo.ESTADOS.NUEVO)){

						    boolean existe = existeRevision(con, idReclamo, rev);

						    if (existe) {
						        continue;
						    }

						    stmt2 = con.prepareCall(sql2.toString());
						    stmt2.setInt(1, idReclamo);

						    if (rev.getFecha_revision() != null) {
						        stmt2.setDate(2, new java.sql.Date(rev.getFecha_revision().getTime()));
						    } else {
						        stmt2.setNull(2, Types.DATE);
						    }

						    if (rev.getUsr_presente() != null && !rev.getUsr_presente().trim().equals("")) {
						        stmt2.setString(3, rev.getUsr_presente());
						    } else {
						        stmt2.setNull(3, Types.VARCHAR);
						    }

						    if (rev.getUsr_resolucion() != null && !rev.getUsr_resolucion().trim().equals("")) {
						        stmt2.setString(4, rev.getUsr_resolucion());

						        if (rev.getUsr_resolucion().trim().equals("AUTORIZADO")) {
						            reclamo.setEstadoResolucionAutorizada(ReclamoPrestacional.ESTADOSEVALUACIONRECLAMO.AUTORIZADA);
						        } else {
						            reclamo.setEstadoResolucionAutorizada(ReclamoPrestacional.ESTADOSEVALUACIONRECLAMO.RECHAZADA);
						        }

						    } else {
						        stmt2.setNull(4, Types.VARCHAR);
						    }

						    if (rev.getUsr_responsable_resolucion() != null && !rev.getUsr_responsable_resolucion().trim().equals("")) {
						        stmt2.setString(5, rev.getUsr_responsable_resolucion());
						    } else {
						        stmt2.setNull(5, Types.VARCHAR);
						    }

						    stmt2.setString(6, screenName);

						    if (rev.getObservacion() != null && !rev.getObservacion().trim().equals("")) {
						        stmt2.setString(7, rev.getObservacion());
						    } else {
						        stmt2.setNull(7, Types.VARCHAR);
						    }
						}
						stmt2.executeUpdate();
					}
				}
			}
	//		*** GRABAR REGISTRO DE PRESTACIONES ***				
			if(reclamo.getPrestaciones()!=null && reclamo.getPrestaciones().size() > 0){
				for (PrestacionesReclamo  pres : reclamo.getPrestaciones()) {
					if(pres.getEstado() != null){ 
						if(PrestacionesReclamo.ESTADOS.BAJA.equals(pres.getEstado())){ 
							stmt4 = con.prepareCall(sql11.toString());
							stmt4.setInt(1, pres.getIdRegistro());
							stmt4.setString(2, screenName);
							stmt4.setInt(3, idReclamo);
							
						}else if(pres.getEstado().equals(PrestacionesReclamo.ESTADOS.NUEVO)){

						    boolean existe = existePrestacion(con, idReclamo, pres);

						    if (existe) {

						        continue;
						    }

						    stmt4 = con.prepareCall(sql1.toString());
						    stmt4.setInt(1, idReclamo);

						    if (pres.getId_medicamento()>0) {
						        stmt4.setInt(2, pres.getId_medicamento());
						        stmt4.setNull(3, Types.INTEGER);
						    } else if (pres.getId_prestacion()>0) {
						        stmt4.setNull(2, Types.INTEGER);
						        stmt4.setInt(3, pres.getId_prestacion());
						    } else {
						        stmt4.setNull(2, Types.INTEGER);
						        stmt4.setNull(3, Types.INTEGER);
						    }

						    stmt4.setDouble(4, pres.getImporte());
						    stmt4.setString(5, pres.getFrecuencia());
						    stmt4.setDouble(6, pres.getCargo_ospim());
						    stmt4.setDouble(7, pres.getCargo_ps());
						    stmt4.setString(8, pres.getObservaciones());
						    stmt4.setString(9, screenName);
						    stmt4.setInt(10, pres.getRecuperable());

						    if (reclamo.getEstado()==3) {
						        if (reclamo.getTipo_gestion_cierre_reclamo() ==5) {
						            stmt4.setInt(11, 2);
						        } else {
						            if (!PrestacionesReclamo.ESTADOS.BAJA.equals(pres.getEstado()) && pres.getEstadoRechazoAprobado()!=3) {
						                stmt4.setInt(11, 1);
						            } else {
						                stmt4.setInt(11, 2);
						            }
						        }
						    } else if (!PrestacionesReclamo.ESTADOS.BAJA.equals(pres.getEstado())) {
						        stmt4.setInt(11, pres.getEstadoRechazoAprobado());
						    }

						    stmt4.setDouble(12, pres.getCantidad());

						    if(pres.getComprobanteTipo()!=null){
						        stmt4.setString(13,pres.getComprobanteTipo());
						    } else {
						        stmt4.setNull(13, Types.VARCHAR);
						    }

						    if(pres.getComprobanteNro()!=null) {
						        stmt4.setString(14,pres.getComprobanteNro());
						    } else {
						        stmt4.setNull(14, Types.VARCHAR);
						    }

						    if (pres.getComprobanteFecha() != null) {
						        stmt4.setDate(15, new java.sql.Date(pres.getComprobanteFecha().getTime()));
						    } else {
						        stmt4.setNull(15, Types.DATE);
						    }

						    if (pres.getComprobanteCantidad() != null) {
						        stmt4.setDouble(16, pres.getComprobanteCantidad());
						    } else {
						        stmt4.setNull(16,Types.DOUBLE);
						    }

						    if (pres.getComprobanteImporte() != null) {
						        stmt4.setDouble(17, pres.getComprobanteImporte());
						    } else {
						        stmt4.setNull(17,Types.DOUBLE);
						    }

						    if (pres.getComprobanteTotal() != null) {
						        stmt4.setDouble(18, pres.getComprobanteTotal());
						    } else {
						        stmt4.setNull(18,Types.DOUBLE);
						    }

						    if(pres.getComprobanteCUIT()!=null){
						        stmt4.setString(19,pres.getComprobanteCUIT());
						    } else {
						        stmt4.setNull(19, Types.VARCHAR);
						    }

						    if(pres.getComprobanteSucursal()!=null) {
						        stmt4.setString(20,pres.getComprobanteSucursal());
						    } else {
						        stmt4.setNull(20, Types.VARCHAR);
						    }

						    if(pres.getComprobanteCUITSucursal()!=null) {
						        stmt4.setString(21,pres.getComprobanteCUITSucursal());
						    } else {
						        stmt4.setNull(21, Types.VARCHAR);
						    }

						    if(pres.getComprobanteLetra()!=null){
						        stmt4.setString(22, pres.getComprobanteLetra());
						    } else {
						        stmt4.setNull(22, Types.VARCHAR);
						    }

						    if(pres.getFechaPrestacion()!=null){
						        stmt4.setDate(23, new java.sql.Date(pres.getFechaPrestacion().getTime()));
						    } else {
						        stmt4.setNull(23, Types.DATE);
						    }

						    if (pres.getReconocidoSSS() != null) {
						        stmt4.setDouble(24, pres.getReconocidoSSS());
						    } else {
						        stmt4.setNull(24,Types.DOUBLE);
						    }

						    stmt4.setDouble(25, pres.getCargo_imesa());						
							
						}else if(pres.getEstado().equals(PrestacionesReclamo.ESTADOS.MODIF  ) 
								|| reclamo.getEstado()==3 ){
							stmt4 = con.prepareCall(sql111.toString());
							stmt4.setInt(1, pres.getId_prestacionrecord() );
							stmt4.setDouble(2, pres.getImporte() );  
							stmt4.setString(3, pres.getFrecuencia()  );  
							stmt4.setDouble(4, pres.getCargo_ospim()  );  
							stmt4.setDouble(5, pres.getCargo_ps()  ); 
							if (pres.getEstadoRechazoAprobado()>1){
								stmt4.setString(6, pres.getObservacionesAutorizaRechaza()  );
							}else{
								stmt4.setString(6, pres.getObservaciones() );	
							}						 
							stmt4.setString(7, screenName);
							/*
							 0 cargado  
							 1 autorizado 
							 2 rechazado
							 */
							if (reclamo.getEstado()==3 ){ // RECLAMO CERRADO  
								if (reclamo.getTipo_gestion_cierre_reclamo() ==5){ 
									// solo si es rechazada en la gestion no se autoriza masivamente, se rechaza todo aunque este de baja tambien.
									stmt4.setInt(8, 2 ); // LA PRESTACION FUE RECHAZADA     	
								}else {
									if (!PrestacionesReclamo.ESTADOS.BAJA.equals(pres.getEstado())){
										
										
										if (pres.getEstadoRechazoAprobado() == 0 || pres.getEstadoRechazoAprobado() == 1 ){
											stmt4.setInt(8, 1); //  SE AUTORIZA LA PRESTACION
										}else{
											stmt4.setInt(8, pres.getEstadoRechazoAprobado() ); // dejamos lo que trae 
										}

									}else{
//										stmt4.setInt(8, pres.getEstadoRechazoAprobado()  );
										stmt4.setInt(8, 2  ); // si es baja lo rechazamos
									}
//									if (!PrestacionesReclamo.ESTADOS.BAJA.equals(pres.getEstado())  
//											&& pres.getEstadoRechazoAprobado() != 3){ // no fue rechazado por el usuario 
//										stmt4.setInt(8, 1); //  SE AUTORIZA LA PRESTACION 	
//										}else{
//										stmt4.setInt(8,2); //  SE RECHAZO LA PRESTACION POR EL USUARIO									
//									}							 
								}
							}else{ // se graba lo que definio el usuario 							
								stmt4.setInt(8, pres.getEstadoRechazoAprobado()  );
							}
							
						    
							if(reclamo.getMarcaSeccional() != null && 
								WebKeysAutorizaciones.RECLAMO_PRESTACIONAL_SECCIONAL.endsWith(reclamo.getMarcaSeccional() )){
								//stmt4.setNull(9, Types.BOOLEAN);
								 stmt4.setNull(9, Types.INTEGER);	
							}else{		
								/*
								boolean recuperoSur =  Boolean.TRUE.equals(pres.isRecuperableSur());
								stmt4.setBoolean(9,  recuperoSur );
								*/
								if(pres.getRecuperable()!=null) {
								   stmt4.setInt(9,pres.getRecuperable());
								}else {
								   stmt4.setNull(9, Types.INTEGER);	
								}
							}
							
							//stmt4.setBoolean(9, pres.isRecuperableSur()   );
							stmt4.setDouble(10, pres.getCantidad()   );
							
							if(pres.getComprobanteNro()!=null) {
								   stmt4.setString(11,pres.getComprobanteTipo());
							} else {
									stmt4.setNull(11, Types.VARCHAR);
							}
							
							if(pres.getComprobanteNro()!=null) {
								   stmt4.setString(12,pres.getComprobanteNro());
							} else {
									stmt4.setNull(12, Types.VARCHAR);
							}
							
							
							if (null != pres.getComprobanteFecha()) {
								stmt4.setDate(13, new java.sql.Date(pres.getComprobanteFecha().getTime()));
							} else {
								stmt4.setNull(13, Types.DATE);
							}
							
							if (null != pres.getComprobanteCantidad()) {
							   stmt4.setDouble(14, pres.getComprobanteCantidad()); 
							} else {
							   stmt4.setNull(14,Types.DOUBLE);	
							}
							
							
							if (null != pres.getComprobanteImporte()) {
								   stmt4.setDouble(15, pres.getComprobanteImporte()); 
							} else {
								   stmt4.setNull(15,Types.DOUBLE);	
							}
							
							if (null != pres.getComprobanteTotal()) {
								   stmt4.setDouble(16, pres.getComprobanteTotal()); 
							} else {
								   stmt4.setNull(16,Types.DOUBLE);	
							}
							if(pres.getComprobanteCUIT()!=null){
								   stmt4.setString(17,pres.getComprobanteCUIT());
							} else {
								   stmt4.setNull(17, Types.VARCHAR);
							}
								
							if(pres.getComprobanteSucursal()!=null) {
									stmt4.setString(18,pres.getComprobanteSucursal());
							} else {
									stmt4.setNull(18, Types.VARCHAR);
							}
							if(pres.getFechaPrestacion()!=null){
								stmt4.setDate(19, new java.sql.Date(pres.getFechaPrestacion().getTime()));
							}else{
								stmt4.setDate(19, null);
							}
							
							if (pres.getId_prestacion() !=0) {
								   stmt4.setInt(20, pres.getId_prestacion()); 
							} else {
								   stmt4.setNull(20,Types.INTEGER);	
							}
							if (pres.getId_medicamento()!= 0) {
								   stmt4.setInt(21, pres.getId_medicamento()); 
							} else {
								   stmt4.setNull(21,Types.INTEGER);	
							}
							if(pres.getComprobanteLetra()!=null) {
								   stmt4.setString(22,pres.getComprobanteLetra());
							} else {
									stmt4.setNull(22, Types.VARCHAR);
							}
							if (null != pres.getReconocidoSSS()) {
								   stmt4.setDouble(23, pres.getReconocidoSSS()); 
							} else {
								   stmt4.setNull(23,Types.DOUBLE);	
							}
							if (null != pres.getCargo_imesa()) {
								   stmt4.setDouble(24, pres.getCargo_imesa()); 
							} else {
								   stmt4.setNull(24,Types.DOUBLE);	
							}
							
							
						}
						stmt4.executeUpdate();
					}
				}
			}
			
			
			// GRABAR DATOS DE PRESTACIONES QUE QUEDARON EN ESTADO DE CARGADO EN EL CIERRE 
			if (!PrestacionesReclamo.ESTADOS.BAJA.equals(reclamo.getEstado())  && reclamo.getEstado()==3 ){
				stmt5= con.prepareCall(sql9.toString());						
				stmt5.setInt(1, idReclamo   );
				if (reclamo.getTipo_gestion_cierre_reclamo() ==5){
					stmt5.setInt(2, 2 ); // CODIGO 2 RECHAZADO    	
				}else {
					stmt5.setInt(2, 1); //  CODIGO 1 AUTORIZADO
				}
				stmt5.executeUpdate();				
			}
					
			con.commit();	 
			resp=true;
		} catch (SQLException e) {
			_log.error("Error al actualizar prestador y sus componentes", e);
			ConnectionHelper.rollback(con);		
			throw new SystemException(e);
		}  finally {
			ConnectionHelper.cerrar(stmt);
			ConnectionHelper.cerrar(stmt2);
			ConnectionHelper.cerrar(stmt3);		
			ConnectionHelper.cerrar(stmt4);
			ConnectionHelper.cerrar(stmt5, con);
		}
		return resp ;
	}
	
	
	public void altaModiCuenta(ReclamoPrestacional reclamo , User user) throws SystemException{
		Connection con = null;
		CallableStatement stmt = null;
		try {
			String sqlAlta ="{call autorizaciones.inserta_reclamo_prestaciones_cuenta(?,?,?,?,?,?,?,?,?,?,?)}";
			String sqlModi = "{call autorizaciones.update_reclamo_prestaciones_cuenta(?,?,?,?,?,?,?,?,?,?)}";
			con = ConnectionHelper.getConnection();
			
			if (reclamo.getCuenta() != null){
				ReclamoPrestacionalCuenta cuenta = reclamo.getCuenta();
	            ReclamoPrestacionalCuenta existente = this.getReclamoPrestacionalCuenta(cuenta.getIdReclamoPrestacional());
	            
				if(this.getReclamoPrestacionalCuenta(cuenta.getIdReclamoPrestacional()) ==  null){
					//alta cuenta
					stmt = con.prepareCall(sqlAlta.toString());
					
					stmt.setInt(1, cuenta.getIdReclamoPrestacional());
					stmt.setString(2, cuenta.getCuil());
					stmt.setString(3, cuenta.getCbu());
				    stmt.setString(4, cuenta.getEmail() == null ? "" : cuenta.getEmail());
					stmt.setString(5, cuenta.getCmbTitular());
					stmt.setString(6, cuenta.getImagenCBU());
					stmt.setString(7, cuenta.getImagenNotaAutorizada());
					stmt.setString(8, (cuenta.getApellido() == null ? "" : cuenta.getApellido().toUpperCase()));
				    stmt.setString(9, (cuenta.getNombre() == null ? "" : cuenta.getNombre().toUpperCase()));
					stmt.setString(10, user.getScreenName());
					stmt.setString(11, cuenta.getCuilGrupoFamiliar());
					ResultSet rs = stmt.executeQuery();
					
				}else{
					//update
					stmt = con.prepareCall(sqlModi.toString());
					
					stmt.setInt(1, cuenta.getIdReclamoPrestacional());
					stmt.setString(2, cuenta.getCuil());
					stmt.setString(3, cuenta.getCbu());
					stmt.setString(4, cuenta.getEmail());
					stmt.setString(5, cuenta.getCmbTitular());
					stmt.setString(6, cuenta.getImagenCBU());
					stmt.setString(7, cuenta.getImagenNotaAutorizada());
					stmt.setString(8, cuenta.getApellido().toUpperCase());
					stmt.setString(9, cuenta.getNombre().toUpperCase());
					stmt.setString(10, user.getScreenName());
					ResultSet rs = stmt.executeQuery();
				}
			}
			
			
		} catch (SQLException  e) {
			_log.error("Error alata Modi  cbu Reclamo Prestacional ", e);
			throw new SystemException();
		} finally {
			ConnectionHelper.cerrar(stmt, con);
		}
	}
	
	
	
	public void borrar(int id, String screenName) throws SystemException, ImposibleBorrarReclamoPrestacionalException {
		Connection con = null;
		CallableStatement stmt = null;
		try {
			String sql = "{call autorizaciones.borra_reclamo_prestacional(?, ?)}";
			con = ConnectionHelper.getConnection();
			stmt = con.prepareCall(sql.toString());
			stmt.setInt(1, id);
			stmt.setString(2, screenName);
			ResultSet rs = stmt.executeQuery();
			while (rs.next()) {
				if (rs.getInt(1) == 0) {
					throw new ImposibleBorrarReclamoPrestacionalException ();
				}
			}
		} catch (SQLException  e) {
			_log.error("Error al borrar el reclamo prestacional", e);
			throw new SystemException();
		} finally {
			ConnectionHelper.cerrar(stmt, con);
		}
	}
	
	
