		}
	
		return RevisionesDelReclamo ;	
	}
	
	
	public void  setDatosOpReclamoPrestacional(ReclamoPrestacional   reclamo ){
	
		Connection con = null;
		CallableStatement stmt = null;
		String sql="" ;
		String sector;
		sector = reclamo.getSector();
		boolean notFound=true;
		ResultSet rs; 
		try {
			if (sector.equals("FARMACIA") ) {
				sql = "{call buscar_resumen_op_reintegros_reclamos_prestacionales_farmacia(?)}";
			}else{
				sql = "{call buscar_resumen_op_reintegros_reclamos_prestacionales  (?)}";	
			}
			
			con = ConnectionHelper.getConnection();
			stmt = con.prepareCall(sql.toString());
			stmt.setInt(1, reclamo.getId_reclamo()  );
			rs = stmt.executeQuery();
			while (rs.next()) {
				reclamo.setFechaOP(rs.getDate("r__fecha_op") );						
				reclamo.setId_lista_reintegro(rs.getInt("opor_id_lista_reintegro_pago"));
				reclamo.setChequeOP(rs.getBigDecimal("r__nro_cheque") != null ? rs.getBigDecimal("r__nro_cheque").toBigInteger() : null);
				reclamo.setIdOP(rs.getInt("r__id_orden_pago"));
				reclamo.setCtaDescrpcion(rs.getString("cta_descripcion"));
				reclamo.setCtaNro(rs.getInt("cta_nro_cuenta"));
				reclamo.setCtaSucursal(rs.getInt("cta_sucursal"));
				notFound=false;
			}
			if (notFound){ // buscar OP de liquidacion de reclamos 
				sql = "{call buscar_resumen_op_liquidaciones_reclamos_prestacionales	 (?)}";
				stmt = con.prepareCall(sql.toString());
				stmt.setInt(1, reclamo.getId_reclamo()  );
				rs = stmt.executeQuery();
				while (rs.next()) {
					reclamo.setFechaOP(rs.getDate("r__fecha_op") );						
					reclamo.setId_lista_reintegro(-1);// la liquidacion no tiene lista
					reclamo.setChequeOP(rs.getBigDecimal("r__nro_cheque") != null ? rs.getBigDecimal("r__nro_cheque").toBigInteger() : null);
					reclamo.setIdOP(rs.getInt("r__id_orden_pago"));
					reclamo.setCtaDescrpcion(rs.getString("cta_descripcion"));
					reclamo.setCtaNro(rs.getInt("cta_nro_cuenta"));
					reclamo.setCtaSucursal(rs.getInt("cta_sucursal"));
					notFound=false;
				}
			}
			
			
			sql = "{call autorizaciones.validar_reabrir_reclamoprestaciones (?)}";
			stmt = con.prepareCall(sql.toString());
			stmt.setInt(1, reclamo.getId_reclamo()  );
			rs = stmt.executeQuery();
			while (rs.next()) {
				 reclamo.setMarcaReabrirReclamo(rs.getBoolean(1));
			}
			
			
		} catch (Exception e) {
			_log.error("Error al buscar prestaciones asociadas del reclamo", e);
		} finally {
			ConnectionHelper.cerrar(stmt, con);
		}
		
	}
	
	
	
