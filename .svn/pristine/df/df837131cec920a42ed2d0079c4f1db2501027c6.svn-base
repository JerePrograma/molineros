		}

		public void setImporteHta(BigDecimal importeHta) {
			this.importeHta = importeHta;
		}

		public void setTotalDebitos(BigDecimal totalDebitos) {
			this.totalDebitos = totalDebitos;
		}

		public Map<String, BigDecimal> getResumenDesde() {
