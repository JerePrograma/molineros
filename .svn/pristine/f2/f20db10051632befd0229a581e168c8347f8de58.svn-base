	public void update(Asiento asiento, Connection con, String user, int entidad)
			throws Exception {
		CallableStatement stmt = null;
		try {
			String sql = null;
			if(entidad==WebKeysGlobal.AMTIMA){
				sql = "{call actualizar_asiento_amtima(?, ?, ?, ?, ?, ?, ?, ?)}";
			}else if(entidad==WebKeysGlobal.UOMA){
				sql = "{call uoma.actualizar_asiento_uoma(?, ?, ?, ?, ?, ?, ?, ?)}";
			}else {
				sql = "{call actualizar_asiento(?, ?, ?, ?, ?, ?, ?, ?)}";
			}
			stmt = con.prepareCall(sql.toString());
			stmt.setDate(1, new java.sql.Date(asiento.getFecha().getTime()));
			stmt.setString(2, asiento.getDescripcion());
			stmt.setBoolean(3, asiento.isAutomatico());
			stmt.setInt(4, asiento.getNro());
			stmt.setDate(5, new java.sql.Date(asiento.getEjercicioDesde()
					.getTime()));
			stmt.setDate(6, new java.sql.Date(asiento.getEjercicioHasta()
					.getTime()));
			stmt.setString(7, user);
			stmt.setInt(8, asiento.getId());

			stmt.execute();
		} catch (Exception e) {
			_log.error("Error al traer actualizar_asiento", e);
			throw e;
		} finally {
			ConnectionHelper.cerrar(stmt);
		}
	}

	public void update(Asiento asiento, Detalle detalle, Connection con, int entidad)
			throws Exception {
		CallableStatement stmt = null;
		try {
			String sql = null;
			if(entidad==WebKeysGlobal.AMTIMA){
				sql = "{call actualizar_detalle_asiento_amtima(?, ?, ?, ?, ?, ?, ?, ?,?)}";
			}else if(entidad==WebKeysGlobal.UOMA){
				sql = "{call uoma.actualizar_detalle_asiento_uoma(?, ?, ?, ?, ?, ?, ?, ?,?)}";
			}else{
				sql = "{call actualizar_detalle_asiento(?, ?, ?, ?, ?, ?, ?, ?,?)}";
			}
			stmt = con.prepareCall(sql.toString());
			stmt.setInt(1, asiento.getId());
			stmt.setInt(2, detalle.getPase());
			stmt.setInt(3, detalle.getCuenta().getId());
			stmt.setString(4, detalle.getComprobante());
			stmt.setBigDecimal(5, detalle.getDebe());
			stmt.setBigDecimal(6, detalle.getHaber());
			stmt.setString(7, detalle.getObservaciones());
			if(detalle.getCentroCosto()!=null && detalle.getCentroCosto().getId()!=null && detalle.getCentroCosto().getId()!=0) {
				stmt.setInt(8, detalle.getCentroCosto().getId());
			}else {
				stmt.setNull(8,Types.INTEGER);	
			}
			
			stmt.setInt(9, detalle.getId());
			stmt.execute();
		} catch (Exception e) {
			_log.error("Error al traer actualizar_detalle_asiento", e);
			throw e;
		} finally {
			ConnectionHelper.cerrar(stmt);
		}
	}

