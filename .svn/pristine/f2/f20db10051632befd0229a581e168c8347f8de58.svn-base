			con = ConnectionHelper.getConnection();
			stmt = con.prepareCall(sql.toString());
			stmt.setInt(1, asiento.getId());
			stmt.execute();
		} catch (Exception e) {
			_log.error("Error al traer eliminar_asiento", e);
			throw e;
		} finally {
			ConnectionHelper.cerrar(stmt, con);
		}

	}

	public List<BalanceSumasYSaldos> buscarBalanceSumasYSaldos(Date desde,
			Date hasta, boolean incluirAutomaticos, boolean incluirManuales,
			boolean incluirAsientoInicial, int entidad) {
		Connection con = null;
		CallableStatement stmt = null;
		List<BalanceSumasYSaldos> balance = new ArrayList<BalanceSumasYSaldos>();
		try {
			String sql =null;
			if(entidad==WebKeysGlobal.AMTIMA){
				sql = "{call buscar_asientos_sumas_saldos_amtima(?, ?, ?, ?, ?)}";
			}else if(entidad==WebKeysGlobal.UOMA){
				sql = "{call uoma.buscar_asientos_sumas_saldos_uoma(?, ?, ?, ?, ?)}";	
			}else{
				sql = "{call buscar_asientos_sumas_saldos(?, ?, ?, ?, ?)}";	
			}
				
			
			con = ConnectionHelper.getConnection();
			stmt = con.prepareCall(sql.toString());
			stmt.setDate(1, new java.sql.Date(desde.getTime()));
			stmt.setDate(2, new java.sql.Date(hasta.getTime()));
			stmt.setBoolean(3, incluirAutomaticos);
			stmt.setBoolean(4, incluirManuales);
			stmt.setBoolean(5, incluirAsientoInicial);

			ResultSet rs = stmt.executeQuery();
			while (rs.next()) {
				balance.add(BalanceSumasYSaldos.getMapping(rs));
			}
		} catch (Exception e) {
			_log.error("Error al traer buscar_asientos_sumas_saldos", e);
		} finally {
			ConnectionHelper.cerrar(stmt, con);
		}
		return balance;
	}
	
	
