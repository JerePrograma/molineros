	public List<Asiento> buscarAsientos(Date desde, Date hasta,
			Integer desdeNroAsiento, Integer hastaNroAsiento,
			boolean incluirAutomaticos, boolean incluirManuales, int entidad) {
		Connection con = null;
		CallableStatement stmt = null;
		List<Asiento> asientos = new ArrayList<Asiento>();
		try {
			String sql = null;
			if(entidad==WebKeysGlobal.AMTIMA){
				sql = "{call buscar_asientos_amtima(?, ?, ?, ?, ?, ?)}";
			}else if(entidad==WebKeysGlobal.UOMA){
				sql = "{call uoma.buscar_asientos_uoma(?, ?, ?, ?, ?, ?)}";	
			}else{
				sql = "{call buscar_asientos(?, ?, ?, ?, ?, ?)}";	
			}
			
			con = ConnectionHelper.getConnection();
			stmt = con.prepareCall(sql.toString());
			stmt.setDate(1, new java.sql.Date(desde.getTime()));
			stmt.setDate(2, new java.sql.Date(hasta.getTime()));
			if (desdeNroAsiento != null) {
				stmt.setInt(3, desdeNroAsiento);
			} else {
				stmt.setNull(3, Types.INTEGER);
			}
			if (hastaNroAsiento != null) {
				stmt.setInt(4, hastaNroAsiento);
			} else {
				stmt.setNull(4, Types.INTEGER);
			}
			stmt.setBoolean(5, incluirAutomaticos);
			stmt.setBoolean(6, incluirManuales);

			ResultSet rs = stmt.executeQuery();
			while (rs.next()) {
				asientos.add(Asiento.getMapping(rs));
			}
		} catch (Exception e) {
			_log.error("Error al traer buscar_asientos", e);
		} finally {
			ConnectionHelper.cerrar(stmt, con);
		}
		return asientos;
	}

	public List<Asiento> buscarDetalleAsientos(Date desde, Date hasta,
			Integer desdeNroAsiento, Integer hastaNroAsiento,
			boolean incluirAutomaticos, boolean incluirManuales, int entidad) {
		Connection con = null;
		CallableStatement stmt = null;
		List<Asiento> asientos = new ArrayList<Asiento>();
		try {
			String sql=null;
			if(entidad==WebKeysGlobal.AMTIMA){
				sql = "{call buscar_detalle_asientos_amtima(?, ?, ?, ?, ?, ?)}";
			}else if(entidad==WebKeysGlobal.UOMA){
				sql = "{call uoma.buscar_detalle_asientos_uoma(?, ?, ?, ?, ?, ?)}";	
			}else{
				sql = "{call buscar_detalle_asientos(?, ?, ?, ?, ?, ?)}";	
			}
			
			con = ConnectionHelper.getConnection();
			stmt = con.prepareCall(sql.toString());
			stmt.setDate(1, new java.sql.Date(desde.getTime()));
			stmt.setDate(2, new java.sql.Date(hasta.getTime()));
			if (desdeNroAsiento != null) {
				stmt.setInt(3, desdeNroAsiento);
			} else {
				stmt.setNull(3, Types.INTEGER);
			}
			if (hastaNroAsiento != null) {
				stmt.setInt(4, hastaNroAsiento);
			} else {
				stmt.setNull(4, Types.INTEGER);
			}
			stmt.setBoolean(5, incluirAutomaticos);
			stmt.setBoolean(6, incluirManuales);

			ResultSet rs = stmt.executeQuery();
			while (rs.next()) {
				Detalle detalle = Detalle.getMapping(rs);
				int asientoId = rs.getInt("asiento_id");
				Asiento asiento = new Asiento(asientoId);
				asiento.setFecha(rs.getDate("asiento_fecha"));
				asiento.setNro(rs.getInt("asiento_numero"));
				asiento.setDetalle(new ArrayList<Detalle>(1));
				asiento.getDetalle().add(detalle);
				asientos.add(asiento);
			}
		} catch (Exception e) {
			_log.error("Error al traer buscar_asientos", e);
		} finally {
			ConnectionHelper.cerrar(stmt, con);
		}
		return asientos;
	}

	public void save(Asiento asiento, Connection con, String username, int entidad)
			throws Exception {
		CallableStatement stmt = null;
		try {
			String sql = null;
			if(entidad==WebKeysGlobal.AMTIMA){
				sql = "{call insertar_asiento_amtima(?, ?, ?, ?, ?, ?)}";
			}else if(entidad==WebKeysGlobal.UOMA){
				sql = "{call uoma.insertar_asiento_uoma(?, ?, ?, ?, ?, ?)}";	
			}else{
				sql = "{call insertar_asiento(?, ?, ?, ?, ?, ?)}";	
			}
			
			stmt = con.prepareCall(sql.toString());
			stmt.setDate(1, new java.sql.Date(asiento.getFecha().getTime()));
			stmt.setString(2, asiento.getDescripcion());
			stmt.setBoolean(3, asiento.isAutomatico());
			stmt.setDate(4, new java.sql.Date(asiento.getEjercicioDesde()
					.getTime()));
			stmt.setDate(5, new java.sql.Date(asiento.getEjercicioHasta()
					.getTime()));
			stmt.setString(6, username);

			ResultSet rs = stmt.executeQuery();
			while (rs.next()) {
				asiento.setId(rs.getInt(1));
			}
		} catch (Exception e) {
			_log.error("Error al traer insertar_asiento", e);
			throw e;
		} finally {
			ConnectionHelper.cerrar(stmt);
		}
	}

	public void save(Asiento asiento, Detalle detalle, Connection con, int entidad)
			throws Exception {
		CallableStatement stmt = null;
		try {
			String sql = null;
			if(entidad==WebKeysGlobal.AMTIMA){
				sql = "{call insertar_detalle_asiento_amtima(?, ?, ?, ?, ?, ?, ? ,?)}";	
			}else if(entidad==WebKeysGlobal.UOMA){
				sql = "{call uoma.insertar_detalle_asiento_uoma(?, ?, ?, ?, ?, ?, ?,?)}";	
			}else {
				sql = "{call insertar_detalle_asiento(?, ?, ?, ?, ?, ?, ?,?)}";	
			}			
			stmt = con.prepareCall(sql.toString());
			stmt.setInt(1, asiento.getId());
			stmt.setInt(2, detalle.getPase());
			stmt.setInt(3, detalle.getCuenta().getId());
			stmt.setString(4, detalle.getComprobante());
			stmt.setBigDecimal(5, detalle.getDebe());
			stmt.setBigDecimal(6, detalle.getHaber());
			stmt.setString(7, detalle.getObservaciones());
			if(detalle.getCentroCosto()!=null && detalle.getCentroCosto().getId() != null &&
					detalle.getCentroCosto().getId()!=0 ) {
				 stmt.setInt(8, detalle.getCentroCosto().getId());
			}else {
				  stmt.setNull(8,Types.INTEGER);	
			}
			stmt.execute();
		} catch (Exception e) {
			_log.error("Error al traer insertar_detalle_asiento", e);
			throw e;
		} finally {
			ConnectionHelper.cerrar(stmt);
		}
	}
	
