	public void updateCierre(Asiento asiento, Connection connectionParameter, int entidad)
			throws Exception {
		
		Connection con = null;
		CallableStatement stmt = null;
		
		try {
			
			if (connectionParameter == null) {
				con = ConnectionHelper.getConnection();
			} else {
				con = connectionParameter;
			}	
			
			
		
			String sql = null;
			if(entidad==WebKeysGlobal.AMTIMA){
				sql = "{call actualizar_cierre_asiento_amtima(?)}";
			}else if(entidad==WebKeysGlobal.UOMA){
				sql = "{call uoma.actualizar_cierre_asiento_uoma(?)}";
			}else{
				sql = "{call actualizar_cierre_asiento(?)}";
			}
			stmt = con.prepareCall(sql.toString());
			stmt.setInt(1, asiento.getId());
			stmt.execute();
		} catch (Exception e) {
			_log.error("Error al traer actualizar_cierre_asiento", e);
			throw e;
		} finally {
			if (connectionParameter == null) {
				ConnectionHelper.cerrar(stmt, con);
			}else {
				ConnectionHelper.cerrar(stmt);
			}	
		}
	}

	public List<Asiento> buscarAsientoCierre(Date desde, Date hasta, int entidad) {
		Connection con = null;
		CallableStatement stmt = null;
		List<Asiento> asientos = new ArrayList<Asiento>();
		Map<Integer,Asiento> map = new HashMap<Integer,Asiento>();
		try {
			String sql=null;
			if(entidad==WebKeysGlobal.AMTIMA){
				sql = "{call buscar_detalle_asiento_cierre_amtima(?, ?)}";
			}else if(entidad==WebKeysGlobal.UOMA){
				sql = "{call uoma.buscar_detalle_asiento_cierre_uoma(?, ?)}";	
			}else{
				sql = "{call buscar_detalle_asiento_cierre(?, ?)}";	
			}
			
			con = ConnectionHelper.getConnection();
			stmt = con.prepareCall(sql.toString());
			stmt.setDate(1, new java.sql.Date(desde.getTime()));
			stmt.setDate(2, new java.sql.Date(hasta.getTime()));
			
			ResultSet rs = stmt.executeQuery();
			while (rs.next()) {
				Detalle detalle = Detalle.getMapping(rs);
				int asientoId = rs.getInt("asiento_id");
				Asiento asiento =map.get(asientoId);
				if(asiento==null) {
					asiento = new Asiento(asientoId);
					asiento.setFecha(rs.getDate("asiento_fecha"));
					asiento.setNro(rs.getInt("asiento_numero"));
					asiento.setDetalle(new ArrayList<Detalle>(1));
				}
				asiento.getDetalle().add(detalle);
				map.put(asientoId, asiento);
			}
			for(Asiento a: map.values()) {
			  asientos.add(a);
			}  
		} catch (Exception e) {
			_log.error("Error al traer buscar_asientos_cierre", e);
		} finally {
			ConnectionHelper.cerrar(stmt, con);
		}
		return asientos;
	}

	public void updateApertura(Asiento asiento, Connection connectionParameter, int entidad)
			throws Exception {
		
		Connection con = null;
		CallableStatement stmt = null;
		
		try {
			
			if (connectionParameter == null) {
				con = ConnectionHelper.getConnection();
			} else {
				con = connectionParameter;
			}	
			
			
		
			String sql = null;
			if(entidad==WebKeysGlobal.AMTIMA){
				sql = "{call actualizar_apertura_asiento_amtima(?)}";
			}else if(entidad==WebKeysGlobal.UOMA){
				sql = "{call uoma.actualizar_apertura_asiento_uoma(?)}";
			}else{
				sql = "{call actualizar_apertura_asiento(?)}";
			}
			stmt = con.prepareCall(sql.toString());
			stmt.setInt(1, asiento.getId());
			stmt.execute();
		} catch (Exception e) {
			_log.error("Error al traer actualizar_apertura_asiento", e);
			throw e;
		} finally {
			if (connectionParameter == null) {
				ConnectionHelper.cerrar(stmt, con);
			}else {
				ConnectionHelper.cerrar(stmt);
			}	
		}
	}

	public List<Asiento> buscarAsientoApertura(Date desde, Date hasta, int entidad) {
		Connection con = null;
		CallableStatement stmt = null;
		List<Asiento> asientos = new ArrayList<Asiento>();
		Map<Integer,Asiento> map = new HashMap<Integer,Asiento>();
		try {
			String sql=null;
			if(entidad==WebKeysGlobal.AMTIMA){
				sql = "{call buscar_detalle_asiento_apertura_amtima(?, ?)}";
			}else if(entidad==WebKeysGlobal.UOMA){
				sql = "{call uoma.buscar_detalle_asiento_apertura_uoma(?, ?)}";	
			}else{
				sql = "{call buscar_detalle_asiento_apertura(?, ?)}";	
			}
			
			con = ConnectionHelper.getConnection();
			stmt = con.prepareCall(sql.toString());
			stmt.setDate(1, new java.sql.Date(desde.getTime()));
			stmt.setDate(2, new java.sql.Date(hasta.getTime()));
			
			ResultSet rs = stmt.executeQuery();
			while (rs.next()) {
				Detalle detalle = Detalle.getMapping(rs);
				int asientoId = rs.getInt("asiento_id");
				Asiento asiento =map.get(asientoId);
				if(asiento==null) {
					asiento = new Asiento(asientoId);
					asiento.setFecha(rs.getDate("asiento_fecha"));
					asiento.setNro(rs.getInt("asiento_numero"));
					asiento.setDetalle(new ArrayList<Detalle>(1));
				}
				asiento.getDetalle().add(detalle);
				map.put(asientoId, asiento);
			}
			for(Asiento a: map.values()) {
			  asientos.add(a);
			}  
		} catch (Exception e) {
			_log.error("Error al traer buscar_asientos_apertura", e);
		} finally {
			ConnectionHelper.cerrar(stmt, con);
		}
		return asientos;
	}

	public List<CuentaAsientoDetalle> buscarCuentasAsientosDetalles(String id_cuentas, String id_centros_costos, Date desde, Date hasta, int entidad){
		Connection con = null;
		CallableStatement stmt = null;
		List<CuentaAsientoDetalle> cuentaAsientosDetalles = new ArrayList<CuentaAsientoDetalle>();
		
		try {
			String sql=null;
			if(entidad==WebKeysGlobal.AMTIMA){
				sql = "{call cuenta_asiento_detalle_reporte_final_con_centro_costo_amtima(?, ?, ?, ?)}";
			}else if(entidad==WebKeysGlobal.UOMA){
				sql = "{call uoma.cuenta_asiento_detalle_reporte_final_con_centro_costo(?, ?, ?, ?)}";	
			}else{
				sql = "{call cuenta_asiento_detalle_reporte_final_con_centro_costo_ospim(?, ?, ?, ?)}";
			}
			con = ConnectionHelper.getConnection();
			stmt = con.prepareCall(sql.toString());
			stmt.setString(1, id_cuentas);
			stmt.setString(2, id_centros_costos);
			stmt.setDate(3, new java.sql.Date(desde.getTime()));
			stmt.setDate(4, new java.sql.Date(hasta.getTime()));
			
			ResultSet rs = stmt.executeQuery();
			
			while (rs.next()) {
				
				CuentaAsientoDetalle cuentaAsientoDetalle = new CuentaAsientoDetalle();
				
				cuentaAsientoDetalle.setId_cuenta(rs.getInt("id_plan_cuentas"));
				cuentaAsientoDetalle.setDescripcion_cuenta(rs.getString("cuenta"));
				cuentaAsientoDetalle.setNumero_cuenta(rs.getString("numero"));
				cuentaAsientoDetalle.setFecha_asiento(rs.getDate("fecha_asiento"));
				cuentaAsientoDetalle.setAsiento_id(rs.getInt("asiento_id"));
				cuentaAsientoDetalle.setPase(rs.getInt("pase"));
				cuentaAsientoDetalle.setId_centro_costo(rs.getInt("id_centro_costo"));
				cuentaAsientoDetalle.setCentro_costo(rs.getString("centro_costo"));
				cuentaAsientoDetalle.setComprobante(rs.getString("comprobante"));
				cuentaAsientoDetalle.setObservaciones(rs.getString("observaciones"));
				cuentaAsientoDetalle.setDebe(rs.getBigDecimal("debe"));
				cuentaAsientoDetalle.setHaber(rs.getBigDecimal("haber"));
				
				cuentaAsientosDetalles.add(cuentaAsientoDetalle);
			}

		}catch (Exception e) {
			_log.error("Error al traer buscar_asientos", e);
		} finally {
			ConnectionHelper.cerrar(stmt, con);
		}
		return cuentaAsientosDetalles;
	}

