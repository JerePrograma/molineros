    private static Map<String,Object> calcularBajayMotivo(Afiliado afi, Afiliado titular, Connection connection, String updateAfiBorrado, Boolean bajaCascada) throws SystemException, 
    	AfliadoYaTieneConyugeException, ConyugeNoPuedeSerSolteroException, TitularNoPuedeSerSolteroException, HijoNoPuedeSerCasadoException{
    	
    	Date bajaFechaTitular = titular.getBaja_fecha();
		Integer idMotBajaTitular = titular.getId_motivo_baja();
		
    	Date bajaFecha = null;
    	Integer idMotivoBaja = 0;
    	
    	/*Comienza analisis baja titular*/
    	if(bajaCascada !=null && bajaCascada && afi.getInte() == 0) {
    		bajaFecha = afi.getBaja_fecha();
    		idMotivoBaja = afi.getId_motivo_baja();
    		
    		int idPlanActual = afi.getAfiPlan().getPlan().getId();
//	        Se debe bajar los planes: 1-"INTEGRAL",2-"TOTAL"  3 - "COBERTURA", 5 - "OSPIM - AMTADH", 9 - "COBERTURA TOTAL O", 19 - "COBERTURA - USUFRUCTO", 22 - "COBERTURA TOTAL OA" 
    		if((idMotivoBaja == 1 || idMotivoBaja == 2 || idMotivoBaja == 3 || idMotivoBaja == 21 )
//    				&&  (idPlanActual == 1 || idPlanActual == 2 || idPlanActual == 3 || idPlanActual == 5 || idPlanActual == 9 || idPlanActual == 19 || idPlanActual == 22)) {
    				&& !(idPlanActual == 8 || idPlanActual == 7 || idPlanActual == 6 || idPlanActual == 18 || idPlanActual == 27 || idPlanActual == 52)) { // planes con ospim en false
    			
//DS 03/09/2021 Agregado para ver si exite grupo Familiar si el motivo de baja es 2 fallecimiento
    			Integer mesesABaja=3;
    			List<Afiliado> grupoFamiliar;
				try {
				  if(idMotivoBaja==2) {	
					grupoFamiliar = BusquedaAfiliadoServiceUtil.getBusquedaGrupoFliar(titular.getCuil_titular());
				    Integer grupo=0;
    			    if(grupoFamiliar!=null && grupoFamiliar.size()>0){
    				  for (Iterator<Afiliado> iterator = grupoFamiliar.iterator(); iterator.hasNext();) {
    					Afiliado af = iterator.next();
    					if(af.getBaja_fecha()==null) {
    						grupo++;
    					}
    				  }
    				  if(grupo==1 || idPlanActual == 20) mesesABaja=0;
    			    }
				  }  
				} catch (Exception e) {}
//Fin agregado    			
				
    			Calendar calAux = Calendar.getInstance();
    			calAux.setTime(bajaFecha);
//    			calAux.add(Calendar.DATE, 91);
    			
//    			calAux.add(Calendar.MONTH, 3);
    			calAux.add(Calendar.MONTH, mesesABaja);
    			bajaFecha = calAux.getTime();
    			afi.setBaja_fecha(bajaFecha); //Este parche es para que luego al dar la baja por grupo familiar no quede el titular sin actualizar los 90 dias extras
    		}
    		
    	}
    	
    	if((bajaCascada == null || !bajaCascada.booleanValue()) && afi.getInte() == 0) {
    		bajaFecha = afi.getBaja_fecha()!=null?afi.getBaja_fecha():null;
    		idMotivoBaja = afi.getBaja_fecha()!=null?afi.getId_motivo_baja():0;
    	}
    	/*Fin analisis baja titular*/
    	Map<String,Object> datosBaja = new HashMap<String, Object>();
    	 
    	// si el parentesco es conyuge o concubino, verifica si el cuil titular
		// tiene conyuge o concubino
		int inteConyuge = 0;
		if (afi.getId_parentesco() == WebKeysAfiliados.CONCUBINO_DEFAULT
			|| afi.getId_parentesco() == WebKeysAfiliados.CONYUGE_DEFAULT) {
			inteConyuge = getInstance().getTieneConyugeGrupoCuil(afi.getCuil_titular(), afi.getVigen_fecha() ,connection);
		}
		// Si no tiene conyuge o si se está actualizando el conyuge mismo es
		// posible actualizar el afiliado con parentésco conyuge o concubino, si
		// no, se lanza la excepción
		if (! ( inteConyuge == 0 || inteConyuge == afi.getInte())) {
			throw new AfliadoYaTieneConyugeException();
		}
		if (afi.getId_parentesco() == WebKeysAfiliados.CONYUGE_DEFAULT 
				&& afi.getId_civil_esta() == WebKeysAfiliados.ESTADO_CIVIL_SOLTERO) {
			throw new ConyugeNoPuedeSerSolteroException();
		}
		if (((afi.getId_parentesco() == WebKeysAfiliados.CONCUBINO_DEFAULT
				|| afi.getId_parentesco() == WebKeysAfiliados.CONYUGE_DEFAULT))
//				&& inteConyuge != afi.getInte()) // existe el conyugue
				&& titular.getId_civil_esta() == WebKeysAfiliados.ESTADO_CIVIL_SOLTERO) {
			
			throw new TitularNoPuedeSerSolteroException();
		}
		
		if ((afi.getId_parentesco() == WebKeysAfiliados.HIJO_MENOR
				|| afi.getId_parentesco() == WebKeysAfiliados.HIJO_MAYOR
				|| afi.getId_parentesco() == WebKeysAfiliados.HIJO_MAYOR_CONYUGE 
				|| afi.getId_parentesco() == WebKeysAfiliados.HIJO_MENOR_CONYUGE) 
				&& afi.getId_civil_esta() == WebKeysAfiliados.ESTADO_CIVIL_CASADO
			) {
			throw new HijoNoPuedeSerCasadoException();
		}	

		//Si tiene hasta 21 calculo la fecha de baja a los 21 años				
		if (((afi.getId_parentesco() == WebKeysAfiliados.HIJO_MENOR 
			|| afi.getId_parentesco() == WebKeysAfiliados.HIJO_MENOR_CONYUGE) 
			|| afi.getId_parentesco() == WebKeysAfiliados.MENOR_BAJO_GUARDA)) {
			
			  bajaFecha = DateUtils.addYears(afi.getNaci_fecha(),WebKeysGlobal.ANIOS_MAYOR_EDAD);
		      idMotivoBaja = WebKeysAfiliados.HIJO_MAYOR;

		//Si esta entre 21 y 25 calculo la fecha de baja a los 25 años
		}else if(afi.getId_parentesco() == WebKeysAfiliados.HIJO_MAYOR 
				||  afi.getId_parentesco() == WebKeysAfiliados.HIJO_MAYOR_CONYUGE
				||  afi.getId_parentesco() == WebKeysAfiliados.MAYOR_DE_25_AÑOS_DISCAPACITADO) {

			try {
				bajaFecha = getInstanceReincorpora().calculaFechaBajaFuturaIntegrante(connection, afi.getCuil_titular(), afi.getInte());
				
				if(bajaFecha == null) {
					bajaFecha = DateUtils.addYears(afi.getNaci_fecha(), 25);
				}
			} catch (Exception e) {
				throw new SystemException(e);
			}
			
			idMotivoBaja = WebKeysAfiliados.HIJO_MAYOR;  //"MAYOR DE 21 AÑOS NO ESTUDIANTE    "
			
			if(afi.getDiscapacitado().equals("1")){ // es discapacitado
				idMotivoBaja = WebKeysAfiliados.CERTIFICADO_POR_INCAPACIDAD; //"VTO. CERTIF. DISCAP./INCAP.       "
			}
	    } 
		
		if ((afi.getId_parentesco() == WebKeysAfiliados.CONYUGE_DEFAULT 
				|| afi.getId_parentesco() == WebKeysAfiliados.CONCUBINO_DEFAULT)
			&& bajaFechaTitular == null	&& 
			(idMotivoBaja == WebKeysAfiliados.HIJO_MAYOR || idMotivoBaja == WebKeysAfiliados.HIJO_MAYOR_CONYUGE)
			) {
				
				bajaFecha = null;
				idMotivoBaja = null;
				afi.setId_amtima_baja_fecha(bajaFecha);
				afi.setId_ospim_baja_fecha(bajaFecha);
				afi.setId_uoma_baja_fecha(bajaFecha);

		}
		
//			the value 0 if the argument Date is equal to this Date; 
//			a value less than 0 if this Date is before the Date argument; 
//			and a value greater than 0 if this Date is after the Date argument.
		if (bajaFechaTitular != null && bajaFecha != null
				&& bajaFecha.compareTo(bajaFechaTitular) < 0) {
//				Id_ospim_baja_fecha = bajaFecha;
//				Id_uoma_baja_fecha = bajaFecha;
//				Id_amtima_baja_fecha = bajaFecha;
		} else if (bajaFechaTitular != null && bajaFecha != null
				&& bajaFecha.compareTo(bajaFechaTitular) > 0) { // si el titular tiene una baja futura se la ponemos al integrante
			bajaFecha = bajaFechaTitular;
			idMotivoBaja = idMotBajaTitular;
		}
		
		if(bajaFecha != null) {
			afi.setId_amtima_baja_fecha(bajaFecha);
			afi.setId_ospim_baja_fecha(bajaFecha);
			afi.setId_uoma_baja_fecha(bajaFecha);
		}
//	REVISAR PORQUE ANDA BIEN PARA "EDITAR BAJA" PERO MAL para REINCORPORAR
//		if(afi.getInte()==0 && afi.getBaja_fecha() != null && afi.getId_motivo_baja() > 0) {
//			bajaFecha = afi.getBaja_fecha() ; //bajaFechaTitular;
//			idMotivoBaja = afi.getId_motivo_baja(); //idMotBajaTitular;
//		}
		
//		//Dejo la fecha que selecciona el usuario si es un editar afiliado borrado
//		if (updateAfiBorrado!= null && updateAfiBorrado.equals(Constants.UPDATE)) {    
//			bajaFecha = afi.getBaja_fecha();
//			motivo_baja = afi.getId_motivo_baja();
//		}
	
		if (updateAfiBorrado!= null && updateAfiBorrado.equals(Constants.UPDATE) &&
				afi.getInte()==0 && afi.getBaja_fecha() != null && afi.getId_motivo_baja() > 0) {    
			bajaFecha = afi.getBaja_fecha();
			idMotivoBaja = afi.getId_motivo_baja();
		}
		
//		La conyugue o concubina se carga cuando el titular ya tiene una baja futura.
		if ((afi.getId_parentesco() == WebKeysAfiliados.CONYUGE_DEFAULT 
				|| afi.getId_parentesco() == WebKeysAfiliados.CONCUBINO_DEFAULT)
			&& bajaFechaTitular != null && afi.getBaja_fecha() == null){
			bajaFecha = bajaFechaTitular;
			idMotivoBaja = idMotBajaTitular;
//			La conyugue o concubina se carga (ya tiene baja) cuando el titular ya tiene una baja futura.
		}else if ((afi.getId_parentesco() == WebKeysAfiliados.CONYUGE_DEFAULT 
				|| afi.getId_parentesco() == WebKeysAfiliados.CONCUBINO_DEFAULT)
			&& bajaFechaTitular != null && afi.getBaja_fecha()!= null && afi.getBaja_fecha().equals(bajaFechaTitular)){
			bajaFecha = afi.getBaja_fecha();
			idMotivoBaja = afi.getId_motivo_baja();
    	}	
		// SI EL DOCUMENTO ES ET SE LE DA LA BAJA A UN AÑO PARA
		// OBLIGAR A PRESENTAR LA DOCUMENTACION.
		if (afi.getDocumento_tipo().trim().equals("ET")) {
			
			bajaFecha = DateUtils.addYears(afi.getNaci_fecha(), 1);
//			idMotivoBaja = afi.getId_motivo_baja();
			idMotivoBaja = 14; //BAJA ADMINISTRATIVA afi.getId_motivo_baja();
		}
		
		datosBaja.put(BAJAFECHA_KEY, bajaFecha);
		datosBaja.put(BAJAMOTIVO_KEY, idMotivoBaja);
		
    	return datosBaja;
    }
    
