			instance = new EditarAfiliadoServiceImpl();
		}
		return instance;
	}
	
	public static ReincorporarServiceImpl getInstanceReincorpora() {
		if (null == reincorporacionServImpl) {
			reincorporacionServImpl = new ReincorporarServiceImpl();
		}
		return reincorporacionServImpl;
	}
