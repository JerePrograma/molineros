	/**
	 * actualiza un afiliado existente
	 * 
	 * @param connection
	 * 
	 * @throws SystemException
	 * @throws NoSuchAfiliadoEntryException
	 * @throws AfliadoYaTieneConyugeException
	 * @throws ConyugeNoPuedeSerSolteroException
	 * @throws HijoNoPuedeSerCasadoException
	 * @throws TitularNoPuedeSerSolteroException
	 */
	public static void actualizaAfiliadoEntry(Afiliado afi, String preCarga, String idPreAfi, String userName, 
			String updateAfiBorrado, Boolean bajaCascada, Connection connection)
			throws NoSuchAfiliadoEntryException, SystemException, AfliadoYaTieneConyugeException, 
				ConyugeNoPuedeSerSolteroException, HijoNoPuedeSerCasadoException, TitularNoPuedeSerSolteroException {
		
		Afiliado afiliado = getInstance().getAfiliadoEntryInclusoDadoBaja(afi.getCuil_titular(), afi.getInte(), connection);
		
		Afiliado titular = getInstance().getAfiliadoEntryInclusoDadoBaja(afi.getCuil_titular(), 0, null);
//        Date bajaFechaTitular = titular.getBaja_fecha();
		
		Date bajaFecha = null;
		int motivoBaja = 0;
//		Date Id_ospim_baja_fecha = null;
//		Date Id_uoma_baja_fecha = null;
//		Date Id_amtima_baja_fecha = null;

		boolean actualizarDomicilio = false;
		// Regla del negocio que inserta nuevo domicilio como el domicilio
		// vigente, cuando se cambian datos del domicilio anterior
		String actualizaDom = null;
		//Valido que sea el titular
		if (afiliado.getInte() == 0) {
			if (afi.getDomicilioDefault().getProvinciaId()!= -1 
					&& afi.getDomicilioDefault().getLocalidadId() != -1) {
				Domicilio afiDom = afiliado.getDomicilioDefault();
				if (afi.getDomicilioDefault().getProvinciaId() != afiDom.getProvinciaId()
						|| afi.getDomicilioDefault().getLocalidadId() != afiDom.getLocalidadId()
						|| !afi.getDomicilioDefault().getPostal_codi().equalsIgnoreCase(afiDom.getPostal_codi())
						|| !afi.getDomicilioDefault().getCalle().equalsIgnoreCase(afiDom.getCalle())
						|| (afiDom.getNumero() != null && !afi.getDomicilioDefault().getNumero().equalsIgnoreCase(afiDom.getNumero()))
						|| !afi.getDomicilioDefault().getPiso().equalsIgnoreCase(afiDom.getPiso())
						|| !afi.getDomicilioDefault().getDepto().equalsIgnoreCase(afiDom.getDepto())
						|| !afi.getDomicilioDefault().getBarrio().equalsIgnoreCase(afiDom.getBarrio())
						|| !afi.getDomicilioDefault().getCod_area_telefono().equalsIgnoreCase(afiDom.getCod_area_telefono())
						|| !afi.getDomicilioDefault().getTelefono().equalsIgnoreCase(afiDom.getTelefono())
						|| !afi.getDomicilioDefault().getCod_area_celular().equalsIgnoreCase(afiDom.getCod_area_celular())
						|| !afi.getDomicilioDefault().getCelular().equalsIgnoreCase(afiDom.getCelular())
						|| !afi.getDomicilioDefault().getCod_area_tel_laboral().equalsIgnoreCase(afiDom.getCod_area_tel_laboral())
						|| !afi.getDomicilioDefault().getTel_laboral().equalsIgnoreCase(afiDom.getTel_laboral())
						|| !afi.getDomicilioDefault().getCelular().equalsIgnoreCase(afiDom.getCelular())
						) {
					actualizaDom = new String("actualizaDom");
				}
				actualizarDomicilio = true;
			}
		}

		String actualizaAfi = null;
		if (!afi.getNombre().equalsIgnoreCase(afiliado.getNombre())
				|| !afi.getApellido().equalsIgnoreCase(afiliado.getApellido())
				|| !afi.getSexo().equalsIgnoreCase(afiliado.getSexo())
				|| !afi.getDocumento_tipo().equalsIgnoreCase(afiliado.getDocumento_tipo())
				|| !afi.getDocu_numero().equalsIgnoreCase(afiliado.getDocu_numero())
				|| !afi.getCuil().equalsIgnoreCase(afiliado.getCuil())
				|| !afi.getVigen_fecha().equals(afiliado.getVigen_fecha())
				|| !afi.getNaci_fecha().equals(afiliado.getNaci_fecha())
				|| afi.getId_civil_esta() != afiliado.getId_civil_esta()
				|| afi.getNacionalidad() != afiliado.getNacionalidad()
				|| !afi.getDiscapacitado().equalsIgnoreCase(afiliado.getDiscapacitado())
				|| afi.getCenso2013() != afiliado.getCenso2013()
				|| (afi.getEmail() != null && !afi.getEmail().equalsIgnoreCase(afiliado.getEmail()))
				|| (afi.getEmail() == null && afiliado.getEmail() != null)
				|| afi.getClientePreferencial() != afiliado.getClientePreferencial()
				|| afi.getTieneAntecedentesJudiciales() != afiliado.getTieneAntecedentesJudiciales()
				|| (
						(afi.getProyecto()!=null&&afiliado.getProyecto()==null) 
						|| (afi.getProyecto()==null&&afiliado.getProyecto()!=null)
						|| (afi.getProyecto()!=null&&afiliado.getProyecto()!=null&&!afi.getProyecto().equalsIgnoreCase(afiliado.getProyecto())) 
					)
				|| afi.getId_parentesco() != afiliado.getId_parentesco()
				|| afi.getSeccional().getIdSeccional() != afiliado.getSeccional().getIdSeccional()
				|| afi.getAnterior_os() != afiliado.getAnterior_os()
				|| afi.getIdCorrespondencia() != afiliado.getIdCorrespondencia()
				|| ((afiliado.getObservaciones() != null || afi.getObservaciones() != null) && (!afi.getObservaciones().equalsIgnoreCase(afiliado.getObservaciones())))) {
			actualizaAfi = new String("actualizaAfi");
		}
		
		Map<String,Object> bajaCalculada = calcularBajayMotivo(afi, titular, connection, updateAfiBorrado, bajaCascada);
		
		motivoBaja = (Integer) bajaCalculada.get(BAJAMOTIVO_KEY);
		bajaFecha   = (Date)    bajaCalculada.get(BAJAFECHA_KEY);
		
		
//		// si el parentesco es conyuge o concubino, verifica si el cuil titular
//		// tiene conyuge o concubino
//		int inteConyuge = 0;
//		if (afi.getId_parentesco() == WebKeysAfiliados.CONCUBINO_DEFAULT
//			|| afi.getId_parentesco() == WebKeysAfiliados.CONYUGE_DEFAULT) {
//			inteConyuge = getInstance().getTieneConyugeGrupoCuil(afi.getCuil_titular(),connection);
//		}
//		// Si no tiene conyuge o si se está actualizando el conyuge mismo es
//		// posible actualizar el afiliado con parentésco conyuge o concubino, si
//		// no, se lanza la excepción
//		if (! ( inteConyuge == 0 || inteConyuge == afi.getInte())) {
//			throw new AfliadoYaTieneConyugeException();
//		}
//		if (afi.getId_parentesco() == WebKeysAfiliados.CONYUGE_DEFAULT 
//				&& afi.getId_civil_esta() == WebKeysAfiliados.ESTADO_CIVIL_SOLTERO) {
//			throw new ConyugeNoPuedeSerSolteroException();
//		}
//		if (((afi.getId_parentesco() == WebKeysAfiliados.CONCUBINO_DEFAULT
//				|| afi.getId_parentesco() == WebKeysAfiliados.CONYUGE_DEFAULT)
//				&& inteConyuge > 0) // existe el conyugue
//				&& titular.getId_civil_esta() == WebKeysAfiliados.ESTADO_CIVIL_SOLTERO) {
//			
//			throw new TitularNoPuedeSerSolteroException();
//		}
//		
//		if ((afi.getId_parentesco() == WebKeysAfiliados.HIJO_MENOR
//				|| afi.getId_parentesco() == WebKeysAfiliados.HIJO_MAYOR
//				|| afi.getId_parentesco() == WebKeysAfiliados.HIJO_MAYOR_CONYUGE 
//				|| afi.getId_parentesco() == WebKeysAfiliados.HIJO_MENOR_CONYUGE) 
//				&& afi.getId_civil_esta() == WebKeysAfiliados.ESTADO_CIVIL_CASADO
