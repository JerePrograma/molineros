	/**
	 * carga un nuevo afiliado / integrante
	 * 
	 * @param connection
	 * 
	 * @throws SystemException
	 *             , DuplicateAfiliadoIdException
	 */
	public static void cargaAfiliadoEntry(Afiliado afi, String opciones, String preCarga, String idPreAfi, String userName, 
			Date dado_baja, int motivo_baja, Connection connection)
			throws SystemException, DuplicateAfiliadoIdException {

		getInstance().insertaAfiliadoEntry(afi, opciones, preCarga, idPreAfi, userName, dado_baja, motivo_baja, connection);
	
	}

