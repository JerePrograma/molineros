		long diferencia = (c.getTimeInMillis() - domicilio.getModi_fecha().getTime() )/MILLSECS_PER_DAY;

		/*Solo muestro el domicilio si esta 90 dias sin verificar*/
		
		//DS 2024-12-03 Comentado para que aparezca siempre mientras dure campaña de pedido de datos		
/*		
		if(Math.abs(diferencia) > 90 
			||  
			StringUtils.checkEmpty(domicilio.getTelefono())
			|| StringUtils.checkEmpty(domicilio.getCelular()) ){
*/			
			renderRequest.setAttribute(WebKeysCrm.CRM_AFILIADO_DOMICILIO, domicilio);
			renderRequest.setAttribute(WebKeysCrm.CRM_AFILIADO_EMAIL, afiliado.getEmail());
/*		}*/
			
		ultimosContactos = CrmServiceUtil.buscarUltimosContactosCRM(cuilTitular, inte, fechaDesde, fechaHasta);
		
		//Observaciones internas
		List<AfiObservacion> obsInternasGrupoFliar =  AfiObservacionServiceUtil.getObservaciones(cuilTitular, inte);
		renderRequest.setAttribute(WebKeysAfiliados.OBSERVACIONES_GRUPO_FLIAR, obsInternasGrupoFliar);
		
		renderRequest.setAttribute(WebKeysCrm.CRM_AFILIADO, afiliado);
		renderRequest.setAttribute(WebKeysCrm.CRM_ULTIMOS_CONTACTOS, ultimosContactos);
