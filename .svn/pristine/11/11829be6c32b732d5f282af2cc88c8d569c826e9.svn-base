	}
	
	private void cargarCompanieroyUltimosContactos(RenderRequest renderRequest) 
			throws Exception, SystemException {

		EdificioSectorUsuarioLiferay compa = null;
		String edi = ParamUtil.getString(renderRequest, "edificio", "");
		String sec = ParamUtil.getString(renderRequest, "sector", "");
		String usu = ParamUtil.getString(renderRequest, "usuario", "");
		
		compa = new EdificioSectorUsuarioLiferay(edi, sec, usu);
		
		List<ContactoCRM> ultimosContactos = null;
		
		getPeriodoContactosHistoricos(renderRequest);
		
		User usuario = null;
		try{
			usuario = PortalUtil.getUser(renderRequest);

			_log.debug("CRM Companiero: " + usu);
			_log.debug("CRM usu carga: " + usuario.getScreenName());
			
			compa.setEmpresaDescripcion(OrganizationLocalServiceUtil.getOrganization(Long.parseLong(edi)).getName());
			compa.setSectorDescripcion(UserGroupLocalServiceUtil.getUserGroup(Long.parseLong(sec)).getName());
			compa.setUsuarioApeyNom(UserLocalServiceUtil.getUserByScreenName(10112, usu).getFullName());
		
			
		}catch (Exception e) {
			_log.error(e);

		}

		ultimosContactos = CrmServiceUtil.buscarUltimosContactosCRM(compa, usuario.getScreenName(), fechaDesde, fechaHasta);
		
		renderRequest.setAttribute(WebKeysCrm.CRM_COMPANIERO, compa);
		renderRequest.setAttribute(WebKeysCrm.CRM_ULTIMOS_CONTACTOS, ultimosContactos);
		
	}
	
	
}
