  				renderRequest.setAttribute(WebKeysCrm.CRM_ES_AFILIADO, contactoCrm.getAfiliado()!=null?true:false); // parametro de alta nuevo contacto
  				renderRequest.setAttribute(WebKeysCrm.CRM_ES_PERSONAL_SECCIONAL, contactoCrm.getContactoSeccional()!=null?true:false); // parametro de alta nuevo contacto
  				renderRequest.setAttribute(WebKeysCrm.CRM_ES_PRESTADOR, contactoCrm.getPrestador()!=null?true:false); // parametro de alta nuevo contacto prest
  				renderRequest.setAttribute(WebKeysCrm.CRM_ES_EMPRESA, contactoCrm.getEmpresa()!=null?true:false); // parametro de alta nuevo contacto emp
  				renderRequest.setAttribute(WebKeysCrm.CRM_ES_COMPANIERO, contactoCrm.getCompaniero()!=null?true:false); // parametro de alta nuevo contacto usu
  				
  				
				renderRequest.setAttribute(WebKeysCrm.CRM_CONTACTO_EN_VIEW, contactoCrm);
				// esta vista muestra de a 1 contacto
				return mapping.findForward(getForward(renderRequest,"portlet.crm.editar_contacto_entry"));
			}
			
//			if(cmd.equals(Constants.EDIT) ){ // Preapara para edicion un contacto. 
//				_log.debug("Usuario: " + usuario.getScreenName() + " cmd: " + cmd );
//	
//				int idSerialContrato = ParamUtil.getInteger(renderRequest, "idContactoSerial");
//				 
//				String mensajeOk =  ParamUtil.getString(renderRequest, "msgReturn",null);
//				if(mensajeOk!=null){ // hago esto para mostrar en edicion el ultimo contacto grabado c el mensaje de ok y nro de contacto generado
//					SessionMessages.add(renderRequest, "insertContactoOk");
//					renderRequest.setAttribute("msgContactoOk", mensajeOk);
//				}
//    			contactoCrm = CrmServiceUtil.buscarContactoCRM(idSerialContrato);
//				renderRequest.setAttribute(Constants.CMD, Constants.UPDATE);
//			}
			if(cmd.equals(Constants.UPDATE) ){ // actualiza
				_log.debug("Usuario: " + usuario.getScreenName() + " cmd: " + cmd );
				
				 contactoCrm = this.getContactoFromRequest(renderRequest, esPersonalSeccional, esPrestador, esEmpresa, esCompaniero);
	
				 CrmServiceUtil.actualizaContacto(contactoCrm, usuario.getScreenName(),
						 String.valueOf(UserUtil.getUserGroups(usuario.getUserId()).get(0).getUserGroupId()) );
				 
				 int idContacto = contactoCrm.getIdContacto();
				 contactoCrm = CrmServiceUtil.buscarContactoCRMbyIdContacto(idContacto);	
				 
				 int idSerialContacto = contactoCrm.getId();
 
				 msg = LanguageUtil.get(defaultLocale, "update-crm-contacto");
				 
				 msg = msg + " " + contactoCrm.getIdContacto();
				 
				 SessionMessages.add(renderRequest, "updateContactoOk");
				
				 _log.debug("Usuario: " + usuario.getScreenName() 
							+ " cmd: " + cmd 
							+ " id corr: " + idSerialContacto);

//				 esAfiliado = (contactoCrm.getAfiliado() == null);
//				 renderRequest.setAttribute(WebKeysCrm.CRM_ES_AFILIADO, !esAfiliado);
				 renderRequest.setAttribute("msgContactoOk", msg);
				 renderRequest.setAttribute("idContactoSerial", idSerialContacto);
				 
				 renderRequest.setAttribute(Constants.CMD, Constants.UPDATE);
				 
//				 esPersonalSeccional=(contactoCrm.getContactoSeccional()!=null);
//				 renderRequest.setAttribute(WebKeysCrm.CRM_ES_PERSONAL_SECCIONAL, esPersonalSeccional);
//				 if(esPersonalSeccional){
//					 renderRequest.setAttribute("idContacto",contactoCrm.getContactoSeccional().getIdContacto());
//				 }

			}
			
			if(esAfiliado && StringUtils.checkNotEmpty(cuilTitular)){
				cargarAfiliadoyUltimosContactos(renderRequest, cuilTitular, inte);
			}
			
			if(esPersonalSeccional) {
				cargarPersonalSeccionalyUltimosContactos(renderRequest);
			}
			if(esPrestador) {
				cargarPrestadoryUltimosContactos(renderRequest);
			}
			if(esEmpresa) {
				cargarEmpresayUltimosContactos(renderRequest);
			}
			if(esCompaniero) {
				cargarCompanieroyUltimosContactos(renderRequest);
			}
			
			renderRequest.setAttribute(WebKeysCrm.CRM_ES_AFILIADO, esAfiliado); // parametro de alta nuevo contacto
			renderRequest.setAttribute(WebKeysCrm.CRM_ES_PERSONAL_SECCIONAL, esPersonalSeccional); // parametro de alta nuevo contacto
			renderRequest.setAttribute(WebKeysCrm.CRM_ES_PRESTADOR, esPrestador); // parametro de alta nuevo contacto prest
			renderRequest.setAttribute(WebKeysCrm.CRM_ES_EMPRESA, esEmpresa); // parametro de alta nuevo contacto emp
			renderRequest.setAttribute(WebKeysCrm.CRM_ES_COMPANIERO, esCompaniero); // parametro de alta nuevo contacto usu
			
			
			session.setAttribute(WebKeysCrm.CRM_CONTACTO_EN_EDICION, contactoCrm);

		}
		
		return mapping.findForward(getForward(renderRequest,"portlet.crm.editar_contacto_entry"));

	}

	private void getPeriodoContactosHistoricos(RenderRequest renderRequest) {
		
		SimpleDateFormat formatoDeFecha = new SimpleDateFormat("dd/MM/yyyy");
//		Date fechaDesde = null;
//		Date fechaHasta = null;
		Calendar cal = Calendar.getInstance();
		
		
		String fechaDesdeDia=ParamUtil.getString(renderRequest, "fechaDesdeDia");
		String fechaDesdeMes=ParamUtil.getString(renderRequest, "fechaDesdeMes");
		String fechaDesdeAnio=ParamUtil.getString(renderRequest, "fechaDesdeAnio");
		String fechaHastaDia=ParamUtil.getString(renderRequest, "fechaHastaDia");
		String fechaHastaMes=ParamUtil.getString(renderRequest, "fechaHastaMes");
		String fechaHastaAnio=ParamUtil.getString(renderRequest, "fechaHastaAnio");

		try {
			fechaHasta = formatoDeFecha.parse(fechaHastaDia + "/"
					+ (Integer.parseInt(fechaHastaMes) + 1) + "/"
					+ fechaHastaAnio);
		} catch (Exception e) {
			fechaHasta = cal.getTime();
		}
		try {
			fechaDesde = formatoDeFecha.parse(fechaDesdeDia + "/"
					+ (Integer.parseInt(fechaDesdeMes) + 1) + "/"
					+ fechaDesdeAnio);
		} catch (Exception e) {
			cal.add(Calendar.DATE, DIAS_HISTORICO);
			fechaDesde = cal.getTime();
		}
	}
	
	private void cargarAfiliadoyUltimosContactos(RenderRequest renderRequest, String cuilTitular, Integer inte) 
			throws Exception, SystemException {

		Afiliado afiliado = null;
