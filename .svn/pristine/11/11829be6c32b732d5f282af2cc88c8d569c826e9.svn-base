	private void cargarPrestadoryUltimosContactos(RenderRequest renderRequest) 
			throws Exception, SystemException {

		Integer idPrestador =  ParamUtil.getInteger(renderRequest, "idPrestador", 0);
		Prestador prestador = null;
		List<ContactoCRM> ultimosContactos = null;
		
		getPeriodoContactosHistoricos(renderRequest);
		
		try{
			User usuario = PortalUtil.getUser(renderRequest);

			_log.debug("CRM Prestador: " + idPrestador);
			_log.debug("CRM usu carga: " + usuario.getScreenName());

			prestador = PrestadorServiceUtil.getPrestador(idPrestador);
		}catch (Exception e) {
			_log.error(e);

		}

//		ultimosContactos = CrmServiceUtil.buscarUltimosContactosCRM(cuilTitular, inte, fechaDesde, fechaHasta);
		
		renderRequest.setAttribute(WebKeysCrm.CRM_PRESTADOR, prestador);
		renderRequest.setAttribute(WebKeysCrm.CRM_ULTIMOS_CONTACTOS, ultimosContactos);
	}
	
