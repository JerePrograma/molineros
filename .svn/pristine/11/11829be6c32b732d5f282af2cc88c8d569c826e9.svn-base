		String cuilTitular = null;
		Integer inte = null;
		Boolean cambiarAfiliado = false;
		ContactoCRM contactoCrm = null;

		String msg = "", msgDerivacion="Derivado por: ";
		EdificioSectorUsuarioLiferay derivaUser = null;
		cargarListas(session);
		
		if (!StringUtils.checkEmpty(cmd)) {
			
			cuilTitular = ParamUtil.getString(renderRequest, "cuil_titular");
			inte = ParamUtil.getInteger(renderRequest, "integ");
			
			if(cmd.equals(Constants.ADD) ){ // prepara un contacto en blanco (vacio)
				_log.debug("Usuario: " + usuario.getScreenName() + " cmd: " + cmd );
				
//				renderRequest.setAttribute(WebKeysCrm.CRM_ES_AFILIADO, esAfiliado); // parametro de alta nuevo contacto
//				renderRequest.setAttribute(WebKeysCrm.CRM_ES_PERSONAL_SECCIONAL, esPersonalSeccional); // parametro de alta nuevo contacto
//				renderRequest.setAttribute(WebKeysCrm.CRM_ES_PRESTADOR, esPrestador); // parametro de alta nuevo contacto prest
//				renderRequest.setAttribute(WebKeysCrm.CRM_ES_EMPRESA, esEmpresa); // parametro de alta nuevo contacto emp
//				renderRequest.setAttribute(WebKeysCrm.CRM_ES_COMPANIERO, esCompaniero); // parametro de alta nuevo contacto usu
				
				cambiarAfiliado = ParamUtil.getBoolean(renderRequest, "cambiarAfiliado");
				// si la marca de cambiar afiliado es true, hay que redirigir a la busqueda de afiliados, 
				// sino, mantengo el mismo cuil_titular e inte que se selecciono previamente.
				if(cambiarAfiliado){
					renderRequest.setAttribute("tabs1", "afiliados");

					return mapping.findForward(getForward(renderRequest, "portlet.afiliados.view"));
