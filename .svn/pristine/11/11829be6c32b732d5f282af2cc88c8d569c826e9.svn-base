	private void cargarListas(HttpSession session){
		
		boolean estanPreCargadasLasListas = session.getAttribute(WebKeysCrm.CRM_LISTA_TIPOS)!=null 
				&& session.getAttribute(WebKeysCrm.CRM_LISTA_MOTIVOS)!=null
				&& session.getAttribute(WebKeysCrm.CRM_LISTA_CATEGORIAS)!=null;
		
		if(!estanPreCargadasLasListas){
			try{
				session.setAttribute(WebKeysCrm.CRM_LISTA_TIPOS, CrmServiceUtil.buscarTiposContacto());
				session.setAttribute(WebKeysCrm.CRM_LISTA_MOTIVOS, CrmServiceUtil.buscarMotivosContacto());
				session.setAttribute(WebKeysCrm.CRM_LISTA_CATEGORIAS, CrmServiceUtil.buscarCategoriasContacto());
			}catch (SystemException e) {
				_log.error("NO se pudieron cargas las listas ", e);
			}	
		}
//		no es en que momento sacarlas de memoria... pero son poquitos datos igualmete
	}
	
	private ContactoCRM getContactoFromRequest(RenderRequest renderRequest, boolean esContactoSec, 
			boolean esContactoPrest, boolean esContactoEmp, boolean esContactoComp){
		
		ContactoCRM contacto = new ContactoCRM();
		EdificioSectorUsuarioLiferay usuarioDeriva = null;
		Afiliado afi = null;
		NoAfiliado noAfi = null;
		
		String cuilTitular = ParamUtil.getString(renderRequest, "cuil_titular");
		String inte = ParamUtil.getString(renderRequest, "inte");
		//String inte = ParamUtil.getString(renderRequest, "integ");

		String nombre = ParamUtil.getString(renderRequest, "noafi_nombre");
		String apellido = ParamUtil.getString(renderRequest, "noafi_apellido");
		String docuTipo = ParamUtil.getString(renderRequest, "noafi_documento_tipo");
		String docuNumero = ParamUtil.getString(renderRequest, "noafi_documento_nro");
		String email = ParamUtil.getString(renderRequest, "noafi_email");
		String telefono = ParamUtil.getString(renderRequest, "noafi_telefono");
		
		int numeroContacto = ParamUtil.getInteger(renderRequest, "numero_contacto", 0);
		int idTipo = ParamUtil.getInteger(renderRequest, "tipo_contacto", 0);
		int idCategoria = ParamUtil.getInteger(renderRequest, "categoria_contacto", 0);
		int idMotivo = ParamUtil.getInteger(renderRequest, "motivo_contacto", 0);
		String estado = ParamUtil.getString(renderRequest, "estado_contacto", ""); 
		String descripcion = ParamUtil.getString(renderRequest, "descripcion_contacto", ""); 
		Integer idContactoRelacionado = ParamUtil.getInteger(renderRequest, "relacionado_con_contacto");
		String comentarioAvance = ParamUtil.getString(renderRequest, "comentarios_avance_nuevo", ""); 
		String comentarioCierre = ParamUtil.getString(renderRequest, "comentarios_contacto", ""); 
		int importancia=0; // normal
		int incumpleContrato=0; // si o no
		if(ParamUtil.getString(renderRequest,"importancia")!=null && ParamUtil.getString(renderRequest,"importancia").equalsIgnoreCase("on")){
			importancia = 1;
		}
		if(ParamUtil.getString(renderRequest,"incumplContrato")!=null && ParamUtil.getString(renderRequest,"incumplContrato").equalsIgnoreCase("on")){
			incumpleContrato = 1;
		}
		
		
//		analizamos si se cargo un Afiliado o un NoAfiliado
		if(!StringUtils.checkEmpty(cuilTitular)){
			afi = new Afiliado(cuilTitular, Integer.parseInt(inte));
		}else{
			noAfi = new NoAfiliado(docuTipo, docuNumero, apellido, nombre, telefono, email, null, null);
		}
			
		MotivoContacto mot = new MotivoContacto(idMotivo, "");
		TipoContacto tip = new TipoContacto(idTipo, "");
		CategoriaContacto cat = new CategoriaContacto(idCategoria, "");
		
		if(estado.equalsIgnoreCase(ContactoCRM.ESTADOS.DERIVADO.name())){
			
			usuarioDeriva = new EdificioSectorUsuarioLiferay(
					ParamUtil.getString(renderRequest, "edificio_destino", "") , 
					ParamUtil.getString(renderRequest, "sector_destino", "") , 
					ParamUtil.getString(renderRequest, "usuario_destino", "") );
			
		}
		
//DS - CRM contacto Seccional
//		boolean esPersonalSeccional = ParamUtil.getBoolean(renderRequest, "contactoSeccional");
		Integer idContactoSeccional = ParamUtil.getInteger(renderRequest, "id_contactoSeccional", 0);
		Contacto contactoSeccional=null;
		ContactoElectronico ce = new ContactoElectronico();
		if(esContactoSec && idContactoSeccional!=0){
			contactoSeccional= new Contacto();
			ce.setId(idContactoSeccional);
			contactoSeccional.setContacto(ce);
			contacto.setContactoSeccional(contactoSeccional);
		}
		
//DS - FIN
		Prestador prestador = null;
		if(esContactoPrest) {
			Integer idPrestador = ParamUtil.getInteger(renderRequest, "idPrestador", 0);
			try {
				prestador = PrestadorServiceUtil.getPrestador(idPrestador);
			} catch (Exception e) {
				_log.error(e);
			}
			contacto.setPrestador(prestador);
		}
		Empresa empresa = null;
		if(esContactoEmp) {
			String cuit = ParamUtil.getString(renderRequest, "cuit", "");
			String sucu = ParamUtil.getString(renderRequest, "sucursal", "");
			try {
				empresa = EmpresaServiceUtil.getEmpleadorCompleto(cuit, sucu);
			} catch (Exception e) {
				_log.error(e);
			}
			contacto.setEmpresa(empresa);
		}
		
		EdificioSectorUsuarioLiferay compa = null;
		if(esContactoComp) {
			String edi = ParamUtil.getString(renderRequest, "edificio", "");
			String sec = ParamUtil.getString(renderRequest, "sector", "");
			String usu = ParamUtil.getString(renderRequest, "usuario", "");
			
			compa = new EdificioSectorUsuarioLiferay(edi, sec, usu);
			contacto.setCompaniero(compa);
			usuarioDeriva = compa; // un crm a compañero se ve diferente pero es como una derivación común de crm, pero tenemos que hacer esta asignación
		}
		
		
		contacto.setAfiliado(afi);
		contacto.setNoAfiliado(noAfi);
		contacto.setCategoria(cat);
		contacto.setDescripcion(descripcion);
		contacto.setEstado(ContactoCRM.ESTADOS.valueOf(estado));
		contacto.setIdContacto(numeroContacto);
		contacto.setIdCrmRelacionado(idContactoRelacionado);
		contacto.setComentarioCierre(comentarioCierre);
		contacto.setMotivo(mot);
		contacto.setTipo(tip);
		contacto.setDerivacion(usuarioDeriva);
		contacto.setImportancia(importancia);
		contacto.setIncumplimientoDelContrato(incumpleContrato);
		contacto.setComentarioAvance(comentarioAvance);
		
		return contacto;
	}
	
	
	
