package ar.com.ospim.rrhh.exceptions;
	public class ImposibleBorrarTarjetaAcessoException  extends Exception {

		/**
		 * 
		 */
		private static final long serialVersionUID = 1L;

		public ImposibleBorrarTarjetaAcessoException() {
			super();
		}

		public ImposibleBorrarTarjetaAcessoException(String message, Throwable cause) {
			super(message, cause);
		}

		public ImposibleBorrarTarjetaAcessoException(String message) {
			super(message);
		}

		public ImposibleBorrarTarjetaAcessoException(Throwable cause) {
			super(cause);
		}

	}