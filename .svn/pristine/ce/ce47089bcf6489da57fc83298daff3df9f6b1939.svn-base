			_log.debug(e.getMessage());
			throw new SystemException(e);
		} finally {
			ConnectionHelper.cerrar(stmt, con);
		}
		return;
	}

	public List<AutorizacionPrestacional> getHistoricoAutorizaciones(int idTratamiento) throws SystemException {
	    Connection con = null;
	    PreparedStatement stmt = null;
	    ResultSet rs = null;

	    List<AutorizacionPrestacional> out = new ArrayList<AutorizacionPrestacional>();

	    try {
	        String sql = "SELECT * FROM autorizaciones.get_historial_aut_prestacional(?)";

	        con = ConnectionHelper.getConnection();
	        stmt = con.prepareStatement(sql);
	        stmt.setInt(1, idTratamiento);

	        rs = stmt.executeQuery();

	        while (rs.next()) {
	            AutorizacionPrestacional a = new AutorizacionPrestacional();

	            a.setId(idTratamiento);

	            Timestamp ts = rs.getTimestamp("alta_fecha");
	            if (ts != null) a.setModi_fecha(new Date(ts.getTime()));
	            a.setModi_usr(rs.getString("alta_usr"));

	            a.setEstado(rs.getInt("estado"));

	            Timestamp desde = rs.getTimestamp("periodo_desde");
	            if (desde != null) a.setPeriodo_desde(new Date(desde.getTime()));

	            Timestamp hasta = rs.getTimestamp("periodo_hasta");
	            if (hasta != null) a.setPeriodo_hasta(new Date(hasta.getTime()));

	            a.setCantidad(rs.getBigDecimal("cantidad"));
	            a.setImporte_total(rs.getBigDecimal("importe_total"));
	            a.setObservaciones(rs.getString("observaciones"));

	            out.add(a);
	        }

	        return out;

	    } catch (SQLException e) {
	        _log.error("Error obteniendo historico autorizacion prestacional id=" + idTratamiento, e);
	        throw new SystemException(e);
	    } finally {
	        ConnectionHelper.cerrar(stmt, con);
	    }
	}

}