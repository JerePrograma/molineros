package ar.com.ospim.tesoreria.beans;

import java.math.BigDecimal;
import java.sql.ResultSet;
import java.sql.SQLException;
import java.util.ArrayList;
import java.util.List;

import ar.com.ospim.global.beans.PlanCuentas;
import ar.com.ospim.tesoreria.beans.contabilidad.Asiento;
import ar.com.ospim.tesoreria.beans.contabilidad.Asiento.Detalle;
import ar.com.uoma.beans.CentroCosto;

public class BalanceSumasYSaldos implements Comparable<BalanceSumasYSaldos> {

	private String numeroCuenta;
	private String descripcionCuenta;
	private BigDecimal debe = BigDecimal.ZERO;
	private BigDecimal haber = BigDecimal.ZERO;
	private BigDecimal debeAjustado = BigDecimal.ZERO;
	private BigDecimal haberAjustado = BigDecimal.ZERO;
	private CentroCosto centro=new CentroCosto(0,"");

	public BalanceSumasYSaldos() {

	}

	public BalanceSumasYSaldos(PlanCuentas pc) {
		this.numeroCuenta = pc.getNumero();
		this.descripcionCuenta = pc.getCuenta();
	}

	public String getNumeroCuenta() {
		return numeroCuenta;
	}

	public void setNumeroCuenta(String numeroCuenta) {
		this.numeroCuenta = numeroCuenta;
	}

	public String getDescripcionCuenta() {
		return descripcionCuenta;
	}

	public void setDescripcionCuenta(String descripcionCuenta) {
		this.descripcionCuenta = descripcionCuenta;
	}

	public BigDecimal getDebe() {
		return debe;
	}

	public void setDebe(BigDecimal debe) {
		this.debe = debe;
	}

	public BigDecimal getHaber() {
		return haber;
	}

	public void setHaber(BigDecimal haber) {
		this.haber = haber;
	}

	public static BalanceSumasYSaldos getMapping(ResultSet rs)
			throws SQLException {
		BalanceSumasYSaldos sumas = new BalanceSumasYSaldos();
		sumas.setDebe(rs.getBigDecimal("debe"));
		sumas.setHaber(rs.getBigDecimal("haber"));
		sumas.setDescripcionCuenta(rs.getString("plan_cuentas_cuenta"));
		sumas.setNumeroCuenta(rs.getString("plan_cuentas_numero"));
		try {
			CentroCosto centro=new CentroCosto(rs.getInt("id_centro_costo"),rs.getString("desc_centro_costo"));
			sumas.setCentro(centro);
		}catch(Exception e) {}
		
		return sumas;
	}

	@Override
	public int hashCode() {
		final int prime = 31;
		int result = 1;
		result = prime * result
				+ ((numeroCuenta == null) ? 0 : numeroCuenta.hashCode());
		return result;
	}

	@Override
	public boolean equals(Object obj) {
		if (this == obj)
			return true;
		if (obj == null)
			return false;
		if (getClass() != obj.getClass())
			return false;
		BalanceSumasYSaldos other = (BalanceSumasYSaldos) obj;
		if (numeroCuenta == null) {
			if (other.numeroCuenta != null)
				return false;
		} else if (!numeroCuenta.equals(other.numeroCuenta)) {
			return false;
	    }else if(numeroCuenta.equals(other.numeroCuenta) && !centro.getId().equals(other.centro.getId())) {
	    	return false;
	    }
		return true;
	}

	public int compareTo(BalanceSumasYSaldos arg0) {
		return numeroCuenta.compareTo(arg0.numeroCuenta);
	}

	public static List<BalanceSumasYSaldos> buildBalanceFromAsientos(
			List<Asiento> asientos) {
		List<BalanceSumasYSaldos> balance = null;
		if (asientos != null) {
			balance = new ArrayList<BalanceSumasYSaldos>();
			for (Asiento asiento : asientos) {
				if (asiento.getDetalle() != null) {
					for (Detalle detalle : asiento.getDetalle()) {
						BalanceSumasYSaldos balanceNuevo = new BalanceSumasYSaldos(
								detalle.getCuenta());
						int indexOf = balance.indexOf(balanceNuevo);
						if (indexOf != -1) {
							BalanceSumasYSaldos balanceSumasYSaldos = balance
									.get(indexOf);
							balanceSumasYSaldos.setDebe(balanceSumasYSaldos
									.getDebe().add(detalle.getDebe()));
							balanceSumasYSaldos.setHaber(balanceSumasYSaldos
									.getHaber().add(detalle.getHaber()));
						} else {
							balanceNuevo.setDebe(detalle.getDebe());
							balanceNuevo.setHaber(detalle.getHaber());
							balance.add(balanceNuevo);
						}
					}
				}
			}
		}
		return balance;
	}

	public BigDecimal getDebeAjustado() {
		return debeAjustado;
	}

	public void setDebeAjustado(BigDecimal debeAjustado) {
		this.debeAjustado = debeAjustado;
	}

	public BigDecimal getHaberAjustado() {
		return haberAjustado;
	}

	public void setHaberAjustado(BigDecimal haberAjustado) {
		this.haberAjustado = haberAjustado;
	}

	public CentroCosto getCentro() {
		return centro;
	}

	public void setCentro(CentroCosto centro) {
		this.centro = centro;
	}
	
	
	
}
