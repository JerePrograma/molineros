	public String getCuotasPlanString() {
		if (null != this.importeComprobanteOriginal) {
			BigDecimal cuotas = this.importeComprobanteOriginal.divide(
					new BigDecimal(cantCuotas), 2, RoundingMode.HALF_UP);
			BigDecimal totalUsado = null;
			// VIENE DE BUSQUEDA DE OP
			if (this.importeComprobanteOriginal.subtract(this.getSaldo())
					.add(importeComprobante)
					.compareTo(this.importeComprobanteOriginal) > 0) {
				totalUsado = new BigDecimal(this.nroAnticipo);
			} else {
				totalUsado = this.importeComprobanteOriginal
						.subtract(this.getSaldo()).add(importeComprobante)
						.divide(cuotas, 2, RoundingMode.HALF_UP);
			}
			return totalUsado.toString() + "/" + String.valueOf(cantCuotas);
		} else {
			return "1";
		}
	}

