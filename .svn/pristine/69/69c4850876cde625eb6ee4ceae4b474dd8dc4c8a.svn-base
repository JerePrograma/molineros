	public Comprobante(int ptoVenta, String tipoComprobante,
			String nroComprobante, String cuitEmisor, Date fechaEmision,
			Date fechaRecepcion, BigDecimal importeComprobante,
			String letraComprobante, int sucuComprobante,
			Date fechaVencimiento, Empresa empresaAcreedora, Date periodo) {
		this.ptoVenta = ptoVenta;
		this.tipoComprobante = tipoComprobante;
		this.nroComprobante = nroComprobante;
		this.cuitEmisor = cuitEmisor;
		this.fechaEmision = fechaEmision;
		this.fechaRecepcion = fechaRecepcion;
		this.importeComprobante = importeComprobante;
		this.letraComprobante = letraComprobante;
		this.sucuComprobante = sucuComprobante;
		this.fechaVencimiento = fechaVencimiento;
		this.acreedorEmpresa = empresaAcreedora;
		this.periodoPrestacion = periodo;
		calcularDebitoCredito();
	}

	public Comprobante clone() {
		Comprobante compro = new Comprobante();
		compro.setPtoVenta(this.ptoVenta);
		compro.setTipoComprobante(this.tipoComprobante);
		compro.setNroComprobante(this.nroComprobante);
		compro.setCuitEmisor(this.cuitEmisor);
		compro.setFechaEmision(this.fechaEmision);
		compro.setFechaRecepcion(this.fechaRecepcion);
		compro.setImporteComprobante(this.importeComprobante);
		compro.setLetraComprobante(this.letraComprobante);
		compro.setSucuComprobante(this.sucuComprobante);
		compro.setFechaVencimiento(this.fechaVencimiento);
		compro.setAcreedorEmpresa(this.acreedorEmpresa);
		compro.setPeriodoPrestacion(this.periodoPrestacion);
		compro.setContPagoParcial(this.contPagoParcial);
		compro.setSeccional(this.seccional);
		calcularDebitoCredito(compro);
		return compro;
	}

	private void calcularDebitoCredito() {
		if ((tipoComprobante
				.equalsIgnoreCase(WebKeysGlobal.COMPROBANTE_NOTA_CREDITO) || tipoComprobante
				.equalsIgnoreCase(WebKeysGlobal.COMPROBANTE_NOTA_CREDITO_BIS))
				&& !isCuitUOMA(cuitEmisor)) {
			this.debitoParaEgreso = true;
		} else if ((tipoComprobante
				.equalsIgnoreCase(WebKeysGlobal.COMPROBANTE_NOTA_DEBITO) || tipoComprobante
				.equalsIgnoreCase(WebKeysGlobal.COMPROBANTE_NOTA_DEBITO_FARMACIA))
				&& isCuitUOMA(cuitEmisor)) {
			this.debitoParaEgreso = true;
		} else {
			this.debitoParaEgreso = false;
		}
	}

	private void calcularDebitoCredito(Comprobante obj) {
		if ((obj.getTipoComprobante().equalsIgnoreCase(
				WebKeysGlobal.COMPROBANTE_NOTA_CREDITO) || obj
				.getTipoComprobante().equalsIgnoreCase(
						WebKeysGlobal.COMPROBANTE_NOTA_CREDITO_BIS))
				&& !isCuitUOMA(obj.getCuitEmisor())) {
			obj.setDebitoParaEgreso(true);
		} else if ((obj.getTipoComprobante().equalsIgnoreCase(
				WebKeysGlobal.COMPROBANTE_NOTA_DEBITO) || obj
				.getTipoComprobante().equalsIgnoreCase(
						WebKeysGlobal.COMPROBANTE_NOTA_DEBITO_FARMACIA))
				&& isCuitUOMA(obj.getCuitEmisor())) {
			obj.setDebitoParaEgreso(true);
		} else {
			obj.setDebitoParaEgreso(false);
		}
	}

