	@Override
	public int hashCode() {
		final int prime = 31;
		int result = 1;
		result = prime * result
				+ ((cuitEmisor == null) ? 0 : cuitEmisor.hashCode());
		result = prime
				* result
				+ ((letraComprobante == null) ? 0 : letraComprobante.hashCode());
		result = prime * result
				+ ((nroComprobante == null) ? 0 : nroComprobante.hashCode());
		result = prime * result + ptoVenta;
		result = prime * result + sucuComprobante;
		result = prime * result
				+ ((tipoComprobante == null) ? 0 : tipoComprobante.hashCode());
		return result;
	}

	@Override
	public boolean equals(Object obj) {
		if (this == obj)
			return true;
		if (obj == null)
			return false;
		if (getClass() != obj.getClass())
			return false;
		Comprobante other = (Comprobante) obj;
		if (cuitEmisor == null) {
			if (other.cuitEmisor != null)
				return false;
		} else if (!cuitEmisor.equals(other.cuitEmisor))
			return false;
		if (letraComprobante == null) {
			if (other.letraComprobante != null)
				return false;
		} else if (!letraComprobante.equals(other.letraComprobante))
			return false;
		if (nroComprobante == null) {
			if (other.nroComprobante != null)
				return false;
		} else if (!nroComprobante.equals(other.nroComprobante))
			return false;
		if (ptoVenta != other.ptoVenta)
			return false;
		if (sucuComprobante != other.sucuComprobante)
			return false;
		if (tipoComprobante == null) {
			if (other.tipoComprobante != null)
				return false;
		} else if (!tipoComprobante.equals(other.tipoComprobante)) {
			return false;
		}
		if (nroAnticipo != other.nroAnticipo) {
			return false;
		}
		if ((idOp > 1 && other.idOp > 1) && idOp != other.idOp) {// OP=1 SON FP
			return false;
		}

		return true;
	}

