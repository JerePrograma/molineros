	public static Comprobante getMapping(ResultSet rs) throws SQLException {
		return getMapping(rs, "");
	}

	public static Comprobante getMapping(ResultSet rs, String prefix)
			throws SQLException {
		Comprobante comp = new Comprobante();
		comp.setFechaEmision(rs.getDate(prefix + "fecha_emision"));
		comp.setFechaRecepcion(rs.getDate(prefix + "fecha_recepcion"));
		comp.setImporteComprobante(rs.getBigDecimal(prefix
				+ "importe_comprobante"));
		comp.setImporteComprobanteOriginal(rs.getBigDecimal(prefix
				+ "importe_comprobante"));
		comp.setNroComprobante(rs.getString(prefix + "nro"));
		comp.setTipoComprobante(rs.getString(prefix + "tipo"));
		comp.setPtoVenta(rs.getInt(prefix + "id_punto_venta"));
		comp.setCuitEmisor(rs.getString(prefix + "cuit"));
		comp.setAlta_fecha(rs.getDate(prefix + "alta_fecha"));
		comp.setAlta_usr(rs.getString(prefix + "alta_usr"));
		comp.setModi_fecha(rs.getDate(prefix + "modi_fecha"));
		comp.setModi_usr(rs.getString(prefix + "modi_usr"));
		comp.setBaja_fecha(rs.getDate(prefix + "baja_fecha"));
		comp.setBaja_usr(rs.getString(prefix + "baja_usr"));
		comp.setLetraComprobante(rs.getString(prefix + "compro_letra"));
		comp.setSucuComprobante(rs.getInt(prefix + "compro_sucu"));

		String cuitAcreedor = rs.getString(prefix + "cuit_acreedor");
		String sucuAcreedor = rs.getString(prefix + "sucu_acreedor");
		int seccional = rs.getInt(prefix + "seccional");

		comp.setAcreedorEmpresa(new Empresa(cuitAcreedor, sucuAcreedor, null));
		comp.setSeccional(new Seccional(seccional, null));
		comp.setPeriodoPrestacion(rs.getDate(prefix + "periodo_prestacion"));
		try {
			comp.setObservaciones(rs.getString(prefix + "observaciones"));
			comp.setCantCuotas(rs.getInt("cant_cuotas"));
		} catch (Exception e) {
		}

		try {
			comp.setFechaVencimiento(rs.getDate(prefix + "vto"));
		} catch (Exception e) {
		}

		try {
			comp.setAnulacion_fecha(rs.getDate("anulado_fecha"));
			comp.setAnulacion_usr(rs.getString("anulado_usr"));
		} catch (Exception e) {
		}
		try {
			String cuil_titular = rs.getString("cuil_titular");
			int inte = rs.getInt("inte");
			if (null != cuil_titular) {
				Afiliado afiliado = new Afiliado(cuil_titular, inte);
				comp.setAfiliado(afiliado);
			}
		} catch (Exception e) {
//			_log.info("no afiliado");
		}

		try {
			comp.setObleaCorreo(rs.getString("oblea_correo"));
		}catch(Exception e) {}
		
		return comp;
	}

