	public String toString() {
		if (nroComprobante != null && tipoComprobante != null) {
			if (nroComprobante.indexOf("&") > 0) {
				nroComprobante = nroComprobante.substring(0,
						nroComprobante.indexOf("&"));
			}
			return tipoComprobante+ "-" + (letraComprobante!=null?letraComprobante:"")
                    + "-" + StringUtil.valueOf(ptoVenta)
					+ "-" + nroComprobante + "  "
					+ DateUtils.format(fechaRecepcion, DateUtils.SHORT);
		}
		return "";
	}
	
