				|| cuitEmisor.equalsIgnoreCase(WebKeysGlobal.CUIT_UOMA)
				|| cuitEmisor.equalsIgnoreCase(WebKeysGlobal.CUIT_OSPIM)) {
			return true;
		}
		return false;
	}

