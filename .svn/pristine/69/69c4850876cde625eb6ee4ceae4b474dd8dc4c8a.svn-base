	public Comprobante(Comprobante comp) {
		this.setNroComprobante(comp.getNroComprobante());
		this.setTipoComprobante(comp.getTipoComprobante());
		this.setLetraComprobante(comp.getLetraComprobante());
		this.setSucuComprobante(comp.getSucuComprobante());
		this.setFechaRecepcion(comp.getFechaRecepcion());
		this.setFechaEmision(comp.getFechaEmision());
		this.setFechaVencimiento(comp.getFechaVencimiento());
		this.setImporteComprobante(comp.getImporteComprobante());
		this.setPtoVenta(comp.getPtoVenta());
		this.setCuitEmisor(comp.getCuitEmisor());
		this.setPeriodoPrestacion(comp.getPeriodoPrestacion());
		this.setConceptos(comp.getConceptos());
		this.setSeccional(comp.getSeccional());
		this.setAcreedorEmpresa(comp.getAcreedorEmpresa());
		this.debitoParaEgreso = comp.isDebitoParaEgreso();
		this.setPagado(comp.isPagado());
		this.setOpExistente(comp.isOpExistente());
		this.setAnulacion_fecha(comp.getAnulacion_fecha());
		this.setAnulacion_usr(getAnulacion_usr());

	}

	public boolean isDebitoParaEgreso() {
		calcularDebitoCredito();
		return debitoParaEgreso;
	}

	public String getNroComprobante() {
		String nro = nroComprobante;
		if (nroComprobante != null && tipoComprobante != null
				&& ar.com.ospim.util.StringUtils.checkNotEmpty(nroComprobante)) {
			if (!(tipoComprobante.equals(WebKeysGlobal.COMPROBANTE_ANTICIPO)
					|| tipoComprobante
							.equals(WebKeysGlobal.COMPROBANTE_NOTA_DEBITO)
					|| tipoComprobante.equals(WebKeysGlobal.COMPROBANTE_VARIOS) || tipoComprobante
						.equals(WebKeysGlobal.COMPROBANTE_REINTEGRO))) {
				nro = StringUtils.leftPad(nro, 8, "0");
			}
		}
		return nro;
	}

