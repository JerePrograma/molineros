				if (other.conceptoComprobante != null)
					return false;
			} else if (!conceptoComprobante.equals(other.conceptoComprobante)){
				return false;
			} else if (centroCosto == null) {
					if (other.centroCosto != null)
						return false;
			} else if (!centroCosto.getId().equals(other.centroCosto==null || other.centroCosto.getId()==null?0:other.centroCosto.getId()))return false;	
			return true;
		}
*/

		@Override
		public boolean equals(Object obj) {
			if (this == obj)
				return true;
			if (obj == null)
				return false;
			if (getClass() != obj.getClass())
				return false;
			ComprobanteConcepto other = (ComprobanteConcepto) obj;
			if (conceptoComprobante == null) {
				if (other.conceptoComprobante != null)
					return false;
			} else if (!conceptoComprobante.equals(other.conceptoComprobante)){
				return false;
			} else if (centroCosto == null) {
					if (other.centroCosto != null)
						return false;
			} else if ( centroCosto!=null && other.centroCosto!=null && 
					   centroCosto.getId()!=null && other.centroCosto.getId()!=null && 
					     !centroCosto.getId().equals(other.centroCosto==null || other.centroCosto.getId()==null?0:other.centroCosto.getId())) {
				return false;	
			} else if (tasaIva==null) {
				if(other.tasaIva !=null) {
				   return false;	
				}
			}else if(tasaIva!=null && other.tasaIva==null) return false; 
			 else if(Double.compare(tasaIva,other.tasaIva)!=0 ) return false;
			 else if(importe!=null && other.importe==null) return false; 
			 else if(importe==null && other.importe!=null) return false;
			 else if(Double.compare(importe.doubleValue() ,other.importe.doubleValue())!=0 ) return false;
			return true;
		}
		
		
		
