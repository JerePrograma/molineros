package ar.com.ospim.farmaciaOspim.services;

import java.sql.SQLException;
import java.util.List;
import com.liferay.portal.SystemException;
import com.liferay.portal.kernel.log.Log;
import com.liferay.portal.kernel.log.LogFactoryUtil;
import com.liferay.portal.model.User;
import ar.com.ospim.farmaciaOspim.beans.ArchivoMedEspecial;
import ar.com.ospim.farmaciaOspim.beans.ItemFarmaciaTotal;
import ar.com.ospim.procesaArchivos.beans.farmaciaospim.DetalleDesglose;
import ar.com.ospim.farmaciaOspim.beans.TiposDeVentas;
import ar.com.ospim.farmaciaOspim.exceptions.ImposibleBorrarFarmaciaOspimException;
import ar.com.ospim.farmaciaOspim.exceptions.ImposibleCerrarVademecumFarmaciaOspimException;
import ar.com.ospim.global.beans.Farmacia;
import ar.com.ospim.procesaArchivos.beans.ArchivoVademecum;
import ar.com.ospim.procesaArchivos.beans.farmaciaospim.ArchivoAdmifarm;
import ar.com.ospim.procesaArchivos.beans.farmaciaospim.ArchivoDesglose;
import ar.com.ospim.procesaArchivos.beans.farmaciaospim.DetalleAdmifarm;

	
	public class FarmaciaServiceUtil {
		
	
	private static FarmaciaServiceImpl instance = null;
	
	private static Log _log = LogFactoryUtil
			.getLog(FarmaciaServiceUtil.class);

	private static FarmaciaServiceImpl getInstance() {
		if (null == instance) {
			instance = new FarmaciaServiceImpl();
		}
		return instance;
	}
	
	public static List<Farmacia>  getFarmaciasOspim (String cuitFarmacia , String descripcionFarmacia , int provincia , int localidad , String  codigoMandataria ) throws SystemException {
		
		return getInstance().getFarmaciasOspim(cuitFarmacia, descripcionFarmacia, provincia , localidad ,codigoMandataria);
		
	}
    
	public static List<ItemFarmaciaTotal>  getFarmaciasOspimTotal (String cuitFarmacia , String descripcionFarmacia , int provincia , int localidad , String  codigoMandataria , int pagina  ) throws SystemException {
		
		return getInstance().getFarmaciasOspimTotal(cuitFarmacia, descripcionFarmacia, provincia , localidad ,codigoMandataria, pagina  );
		
	}
	
	public static List<ItemFarmaciaTotal>  getFarmaciasOspimTotal2 (String cuitFarmacia , String descripcionFarmacia , int provincia , int localidad , String  codFarmacia , int pagina  ) throws SystemException {
		
		return getInstance().getFarmaciasOspimTotal2(cuitFarmacia, descripcionFarmacia, provincia , localidad ,codFarmacia, pagina  );
		
	}
	
	public static List<ArchivoMedEspecial> getArchivosSubidosMedEspecial ()
			throws SystemException {
		return getInstance().getArchivosSubidosMedEspecial ();
	}
	
	public static List<ArchivoVademecum> getArchivosSubidosVademecum ()
			throws SystemException {
		return getInstance().getArchivosSubidosVademecum();
	}	
	
	public static void  cerrarVademecum  (int id , User user )
			throws ImposibleCerrarVademecumFarmaciaOspimException , SQLException, java.sql.SQLException {		
		    getInstance().cerrarVademecum(id, user); 
	}	

	public static List<ArchivoDesglose> getArchivosSubidosDesgloseFarmacia ()
			throws SystemException {
		return getInstance().getArchivosSubidosDesgloseFarmacia();
	}
	
	public static List<ArchivoAdmifarm> getArchivosSubidosAdmifarm()
			throws SystemException {
	return getInstance().getArchivosSubidosAdmifarm();
	}

	public static List<DetalleAdmifarm> getListaDetalleAdmifarm(String nombreTabla)
	        throws SystemException {
	    return getInstance().getListaDetalleAdmifarm(nombreTabla);
	}
	
	public static List<TiposDeVentas> getTipoDeVentas() {
		return getInstance().getTipoDeVentas();
	}

	public static void borrar(int id, User user)
			throws ImposibleBorrarFarmaciaOspimException,
			SQLException, java.sql.SQLException {
		    getInstance().borrar(id, user.getScreenName());
	}
	
	public static void borrar2(long id, User user)
			throws ImposibleBorrarFarmaciaOspimException,
			SQLException, java.sql.SQLException {
		    getInstance().borrar2(id, user.getScreenName());
	}
   
	public static List<DetalleDesglose> getListaDesgloseArchivoFarmacia  (String nombreArchvioDesglose)
			throws SystemException {
		return getInstance().getListaDesgloseArchivoFarmacia  (nombreArchvioDesglose);
	}

	public static Farmacia  getFarmacia(int idFarmacia ) throws Exception {		
		return getInstance().getFarmacia(idFarmacia ) ;
	}
	
	public static Farmacia  getFarmacia2(long idFarmacia ) throws Exception {		
		return getInstance().getFarmacia2(idFarmacia ) ;
	}
	
	public static int insertar(Farmacia  farmacia , User user) throws Exception{
		int idFarmacia = 0;			
		idFarmacia = getInstance().insertar(farmacia , user);
		return idFarmacia ;
	}
	
	public static long insertar2(Farmacia farmacia, User user) throws Exception {
	    long idFarmacia = 0;
	    idFarmacia = getInstance().insertar2(farmacia, user);
	    return idFarmacia;
	}

	public static void actualizar(Farmacia  farmacia , User user) throws Exception{
		getInstance().actualizar(farmacia , user );
	}

	public static void actualizar2(Farmacia  farmacia , User user) throws Exception{
		getInstance().actualizar2(farmacia , user );
	}

}
