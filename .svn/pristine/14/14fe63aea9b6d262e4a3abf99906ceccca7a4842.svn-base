	private List<String> procesarZipFacturacionHoteles(ActionRequest actionRequest, File zip)
			throws IOException {
		
		User user = null;
		try {
			user = PortalUtil.getUser(actionRequest);
		} catch (PortalException e1) {
			user = null;
		} catch (SystemException e1) {
			user=null;
		}
		
        Map<String,Factura> facturas= new HashMap<String,Factura>();
        List<String> errores = new ArrayList<String>();
		ZipInputStream in = new ZipInputStream(new FileInputStream(zip));
		ZipEntry entry = in.getNextEntry();
		while (entry != null) {
			String upperName = entry.getName().toUpperCase();
			logger.debug(upperName);
			BufferedReader reader = new BufferedReader(new InputStreamReader(
					in, "UTF-8"));
			try {
				if (upperName.toUpperCase().contains("VCABECER") && upperName.endsWith(".TXT")) {
					new ProcesaArchivos().procesarCabeceraFacturaHotel(reader,facturas);
				} else if ((upperName.startsWith("VITEMS") && upperName.endsWith(".TXT") )) {
					new ProcesaArchivos().procesarItemsFacturaHotel(reader,facturas);
				} else if ((upperName.startsWith("VMEDPAGO") && upperName.endsWith(".TXT") )) {
					new ProcesaArchivos().procesarPagosFacturaHotel(reader,facturas);
				}  else if ((upperName.startsWith("VREGESP") && upperName.endsWith(".TXT") )) {
					new ProcesaArchivos().procesarPercepcionesFacturaHotel(reader,facturas);
				} 			
			}catch (Exception e) {
				logger.debug("Error al procesar archivo " + entry.getName(), e);
				errores.add(entry.getName());
			}
			entry = in.getNextEntry();
		}
		in.close();
		
		if(facturas.size()>0) {
		  for(Factura f : facturas.values()) { 	
			try {
			  if("NCR".equals(f.getTipo()) ||
					  "NCE".equals(f.getTipo())) {
				  f.setTotalExento(f.getImporteExento().abs().multiply(new BigDecimal(-1)));
				  f.setTotalNeto(f.getImporteNeto().abs().multiply(new BigDecimal(-1)));
				  f.setIva(f.getIva().abs().multiply(new BigDecimal(-1)));
				  f.setPercepcion(f.getPercepcion().abs().multiply(new BigDecimal(-1)));
				  f.setTotal(f.getImporteTotal().abs().multiply(new BigDecimal(-1)));
			  }
	          FacturacionServiceUtil.saveFactura(f,user.getScreenName());			
			}catch(Exception e) {
				
				if(e.getMessage().contains("llave duplicada")) {
					errores.add(f.getTipo()+" "+f.getLetra()+" "+f.getSucursal() + " "+
							f.getNumero()+ " ---> " + " Comprobante ya procesado ");	
				}else {
				
				  errores.add(f.getTipo()+" "+f.getLetra()+" "+f.getSucursal() + " "+
						f.getNumero()+ " ---> " + e.getMessage());
				}
				
			}
		  }		
		}
		
		return errores;
	}

	
	
	private List<String> procesarTxtJubiladosSitaci(ActionRequest actionRequest, File zip, String fileName)
			throws IOException {

		User user = null;
		try {
			user = PortalUtil.getUser(actionRequest);
		} catch (PortalException e1) {
			user = null;
		} catch (SystemException e1) {
			user=null;
		}
				
		
		List<String> errores = new ArrayList<String>();
		
		FileInputStream in = new FileInputStream(zip);
		String upperName = zip.getName().toUpperCase();
		logger.debug(upperName);
		BufferedReader reader = new BufferedReader(new InputStreamReader(in,"UTF-8"));
		try {
			String periodo = ParamUtil.getString(actionRequest,"periodoliquidacion", "");
			
			if ((fileName.toUpperCase().startsWith("PIMME"))) {
				new ProcesaArchivos().procesarArchivoJubiladosSitaciPIMME(reader,user,periodo);    
			}else if ((fileName.toUpperCase().startsWith("PIMIM"))) {
				new ProcesaArchivos().procesarArchivoJubiladosSitaciPIMIM(reader,user,periodo);    
			}
		} catch (Exception e) {
			logger.debug("Error al procesar archivo " + zip.getName(), e);
			errores.add(zip.getName()+" "+e.getCause()+" "+e.getLocalizedMessage()+" "+e.getMessage());
		}

		in.close();
		return errores;
	}
	
	
	public ActionForward render(ActionMapping mapping, ActionForm form,
			PortletConfig portletConfig, RenderRequest renderRequest,
			RenderResponse renderResponse) throws Exception {

		return mapping.findForward(getForward(renderRequest, "portlet.tesoreria.view"));
	}

}
