public class UploadArchivoAfipAction extends PortletAction {

	private static Log logger = LogFactoryUtil
			.getLog(UploadArchivoAfipAction.class);

	public void processAction(ActionMapping mapping, ActionForm form,
			PortletConfig portletConfig, ActionRequest actionRequest,
			ActionResponse actionResponse) throws Exception {

		UploadPortletRequest uploadReq = PortalUtil
				.getUploadPortletRequest(actionRequest);
		List<String> errores = null;
		Boolean proceso=false;
		String nombreArchivo="";
		try {
			String fileName = uploadReq.getFileName("archivo").toLowerCase();
			nombreArchivo=fileName;
			if (fileName != null) {
				File zip = uploadReq.getFile("archivo");
				if (fileName.toUpperCase().startsWith("EXPORT") && fileName.endsWith(".zip")){
					proceso=true;
					errores = procesarZipFacturacionHoteles(actionRequest, zip);
			    }else if (fileName.endsWith(".zip")) {
					proceso=true;
					errores = procesarZip(actionRequest, zip);
				}else if ((fileName.toUpperCase().startsWith("ORGANS_TRANSFER") 
						      || fileName.toUpperCase().startsWith("DJ") || fileName.toUpperCase().startsWith("DDJJ")
						      || fileName.toUpperCase().startsWith("SUMARTEGF")
						      || fileName.toUpperCase().startsWith("SUMAGF")
						      || fileName.toUpperCase().startsWith("SUMA65GF")
						  ) 
						&& fileName.toUpperCase().endsWith(".TXT")) {
					proceso=true;
					errores = procesarTxt(actionRequest, zip, fileName);					
				}else if (fileName.toUpperCase().startsWith("0DK2") || fileName.toUpperCase().startsWith("0DJU")){
					proceso=true;
					errores = procesarTxtLinkPagos(actionRequest, zip, fileName);
				}else if (fileName.toUpperCase().startsWith("COB") ){
					proceso=true;
					errores = procesarTxtPagoMisCuentas(actionRequest, zip, fileName);
				}else if (fileName.toUpperCase().startsWith("PIMME") || fileName.toUpperCase().startsWith("PIMIM") ){
					proceso=true;
					errores = procesarTxtJubiladosSitaci(actionRequest, zip, fileName);
				}else if (fileName.toUpperCase().startsWith("BASE") 
						   && fileName.toUpperCase().endsWith(".TXT")) {
					proceso=true;
					errores = procesarTxt(actionRequest, zip, fileName);					
				}else if ((fileName.startsWith("RECIBOS") || fileName.startsWith("recibos")) && fileName.endsWith(".xls")) {
					proceso=true;
					errores = new ProcesaArchivos().procesarXLSRecibosHoteles(actionRequest, zip,fileName);
				}else if ((fileName.startsWith("RETENCIONES") || fileName.startsWith("retenciones")) && fileName.endsWith(".xls")) {
					proceso=true;
					errores = new ProcesaArchivos().procesarXLSRecibosRetencionesHoteles(actionRequest, zip,fileName);
				}	
			}		
		} catch (Exception e) {
			SessionErrors.add(actionRequest, e.getClass().getName());
		}
		if (null!=errores && !errores.isEmpty()) {
			actionRequest.setAttribute("errores", errores);
			ErrorProcesandoArchivosAfipException e = new ErrorProcesandoArchivosAfipException();
			SessionErrors.add(actionRequest, e.getClass().getName());
		}
		
		if (SessionErrors.isEmpty(actionRequest) && !proceso) {
			errores= new ArrayList<String>();
			errores.add("No se proceso el archivo solicitado");
			actionRequest.setAttribute("errores", errores);
			ErrorProcesandoArchivosAfipException e = new ErrorProcesandoArchivosAfipException();
			SessionErrors.add(actionRequest,e.getClass().getName());
		}
		if (SessionErrors.isEmpty(actionRequest)) {
			String successMessage = ParamUtil.getString(actionRequest,
					"successMessage");
			SessionMessages.add(actionRequest, "request_processed",
					successMessage);
		}
		
		
//		if (actionResponse.getNamespace().equals("_AFI_1_")){
//			setForward(actionRequest, "portlet.afiliados.view");
//			actionRequest.setAttribute("tabs1", "subir-archivo");
//		}else 
		
		
		if(nombreArchivo.toUpperCase().startsWith("PIMME")|| nombreArchivo.toUpperCase().startsWith("PIMIM") ) {
			setForward(actionRequest, "portlet.tesoreria.view");
			actionRequest.setAttribute("tabs1", "liquidar-jubilados");
		}else if (actionResponse.getNamespace().equals("_UOM_1_")){
		//	actionRequest.setAttribute("archivoSubidoBco", AfipServiceUtil.getArchivosSubidosBco());
			setForward(actionRequest, "portlet.uoma.view");
			actionRequest.setAttribute("tabs1", "subir-archivo");
		}else if (actionResponse.getNamespace().equals("_FAR_1_")){
		//	actionRequest.setAttribute("archivoSubidoBco", AfipServiceUtil.getArchivosSubidosBco());
			setForward(actionRequest, "portlet.farmacia.view");
			actionRequest.setAttribute("tabs1", "subir-archivo");
		}else{
			actionRequest.setAttribute("archivoSubidoAfip", AfipServiceUtil.getArchivosSubidosAfip());
			setForward(actionRequest, "portlet.tesoreria.view");
			actionRequest.setAttribute("tabs1", "subir-archivo-afip");
		}
	}

	private List<String> procesarTxt(ActionRequest actionRequest, File zip, String fileName)
			throws IOException {

		User user = null;
		try {
			user = PortalUtil.getUser(actionRequest);
		} catch (PortalException e1) {
			user = null;
		} catch (SystemException e1) {
			user=null;
		}
				
		
		List<String> errores = new ArrayList<String>();
		
		FileInputStream in = new FileInputStream(zip);
		String upperName = zip.getName().toUpperCase();
		logger.debug(upperName);
		BufferedReader reader = new BufferedReader(new InputStreamReader(in,"UTF-8"));
		try {
			if (fileName.toUpperCase().startsWith("ORGANS_TRANSFER") && fileName.toUpperCase().endsWith(".TXT")) {
				new ProcesaArchivos().procesarArchivoOS(reader);
			}
			if ((fileName.toUpperCase().startsWith("DJ") || fileName.toUpperCase().startsWith("DDJJ") ) && 
					fileName.toUpperCase().endsWith(".TXT")) {
				new ProcesaArchivos().procesarArchivoDJ(reader);
			}
			
			if (fileName.toUpperCase().startsWith("BASE") && fileName.toUpperCase().endsWith(".TXT")) {
				reader = new BufferedReader(new InputStreamReader(in,"UTF-8"),10*1024);
				new ProcesaArchivos().procesarArchivoBASEAFIP(reader);
			}
			
			if(( fileName.toUpperCase().startsWith("SUMARTEGF") || fileName.toUpperCase().startsWith("SUMAGF") || fileName.toUpperCase().startsWith("SUMA65GF"))
					&& fileName.toUpperCase().endsWith(".TXT")) {
				new ProcesaArchivos().procesarArchivoSUMARGF(reader);
			}
		} catch (Exception e) {
			logger.debug("Error al procesar archivo " + zip.getName(), e);
			errores.add(zip.getName()+" "+e.getCause()+" "+e.getLocalizedMessage()+" "+e.getMessage());
		}

		in.close();
		return errores;
	}

	private List<String> procesarZip(ActionRequest actionRequest, File zip)
			throws IOException, RendicionBancoNacionRegistroDuplicado {

		User user = null;
		try {
			user = PortalUtil.getUser(actionRequest);
		} catch (PortalException e1) {
			user = null;
		} catch (SystemException e1) {
			user=null;
		}
		
		List<String> errores = new ArrayList<String>();
		ZipInputStream in = new ZipInputStream(new FileInputStream(zip));
		ZipEntry entry = in.getNextEntry();
		while (entry != null) {
			String upperName = entry.getName().toUpperCase();
			logger.debug(upperName);
			BufferedReader reader = new BufferedReader(new InputStreamReader(
					in, "UTF-8"));
			try {
				if (upperName.toUpperCase().contains("ORGANS_TRANSFER") && upperName.endsWith(".TXT")) {
					new ProcesaArchivos().procesarArchivoOS(reader);
				} else if ((upperName.startsWith("DJ") || upperName
						.startsWith("DDJJ"))) {
					// internamente se llama al procesarArchivoPA porque solo
					// puedo
					// saberlo cuando empiezo a leer el archivo
					new ProcesaArchivos().procesarArchivoDJ(reader);
				} else if (upperName.startsWith("DESEMPLEO")
						&& upperName.endsWith(".TXT")) {
					// ARCHIVO DE DESEMPLEO
					new ProcesaArchivos().procesarArchivoDesempleo(reader);

				} else if (upperName.startsWith("SO")
						&& upperName.contains(".TXT")) {
					new ProcesaArchivos().procesarArchivoSO(reader);
				} else if (upperName.startsWith("EB")) {
					new ProcesaArchivos()
							.procesarArchivoExtraccionBancaria(reader);
				} else if (upperName.startsWith("EX")) {
					new ProcesaArchivos()
							.procesarArchivoTransferenciaExterna(reader);
				} else if (upperName.startsWith("B2")) {
					new ProcesaArchivos()
					.procesarArchivoBajaOpciones(reader);
//				} else if (upperName.startsWith("A112608")) {
//					new ProcesaArchivos()
//					.procesarArchivoAltasOpciones(reader);	
//				} else if (upperName.startsWith("AM112608")) {
//					new ProcesaArchivos()
//					.procesarArchivoAltasOpcionesMonotrib(reader);	
				} else if (upperName.startsWith("00005782") || upperName.startsWith("RENDICION RECAUDACIONES-MR")
							|| upperName.startsWith("00005783") || upperName.startsWith("00005784") 
							|| upperName.startsWith("00005785")
						    || upperName.startsWith("AMTIMA") || upperName.startsWith("00005652") ){
					new ProcesaArchivos()
					.procesarArchivoRendicionNacion(reader, Integer.parseInt(upperName.startsWith("AMTIMA")?"00005652":upperName.startsWith("RENDICION")?"00005782":upperName.substring(0,8)));					
				} else if (upperName.startsWith("CONSTA")){
				new ProcesaArchivos()
				.procesarArchivoPadronEmpresa(reader);
//				SUMARTE_OS112608.txt.zip
				} else if (upperName.startsWith("SUMARTE_")
						&& upperName.contains(".TXT")) {
					new ProcesaArchivos().procesarArchivoSUMARTE(reader);
				}
//				SUMA70_OS112608.txt.zip
				else if (upperName.startsWith("SUMA70_")
						&& upperName.contains(".TXT")) {
					new ProcesaArchivos().procesarArchivoSUMA70(reader);
				}
//				SUMA70_OS112608.txt.zip
				else if (upperName.startsWith("SUMA_")
						&& upperName.contains(".TXT")) {
					new ProcesaArchivos().procesarArchivoSUMA(reader);
				}else if (upperName.startsWith("SUBASI_")
						&& upperName.contains(".TXT")) {
					new ProcesaArchivos().procesarArchivoSUBASI(reader);
				}else if (upperName.startsWith("RG830")
					&& upperName.contains(".TXT")) {
					new ProcesaArchivos().procesarArchivoAFIPrg830(reader, user);
				}else if (upperName.startsWith("PADRONRGSRET")
						&& upperName.contains(".TXT")) {
						new ProcesaArchivos().procesarArchivoARBARetenciones(reader, user.getScreenName());
				}
			}catch(RendicionBancoNacionRegistroDuplicado e){
				logger.debug("Error al procesar archivo " + entry.getName(), e);
				errores.add(entry.getName());
				throw e;
			}catch (Exception e) {
				logger.debug("Error al procesar archivo " + entry.getName(), e);
				errores.add(entry.getName());
			}
			entry = in.getNextEntry();
		}
		in.close();
		return errores;
	}

	
	private List<String> procesarTxtLinkPagos(ActionRequest actionRequest, File zip, String fileName)
			throws IOException {

		User user = null;
		try {
			user = PortalUtil.getUser(actionRequest);
		} catch (PortalException e1) {
			user = null;
		} catch (SystemException e1) {
			user=null;
		}
				
		
		List<String> errores = new ArrayList<String>();
		
		FileInputStream in = new FileInputStream(zip);
		String upperName = zip.getName().toUpperCase();
		logger.debug(upperName);
		BufferedReader reader = new BufferedReader(new InputStreamReader(in,"UTF-8"));
		try {
			
			if ((fileName.toUpperCase().startsWith("0DK2"))) {
				new ProcesaArchivos().procesarArchivoLinkPagos(reader,"AMTIMA");    
			}
			if ((fileName.toUpperCase().startsWith("0DJU"))) {
				new ProcesaArchivos().procesarArchivoLinkPagos(reader,"UOMA");    
			}
		} catch (Exception e) {
			logger.debug("Error al procesar archivo " + zip.getName(), e);
			errores.add(zip.getName()+" "+e.getCause()+" "+e.getLocalizedMessage()+" "+e.getMessage());
		}

		in.close();
		return errores;
	}
	
	
