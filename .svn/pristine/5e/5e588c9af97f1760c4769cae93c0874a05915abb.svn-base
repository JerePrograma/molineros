package ar.com.ospim.liquidaciones.reportes.bean;

import java.math.BigDecimal;

public class DebitosLiquidacionesPendientes {
	
	private BigDecimal numero;
	private String hospitalesAutogestion;
	private String factura;
	private BigDecimal monto;
	private BigDecimal cargoPrestadora;	
	private BigDecimal cargoPrestadoraReclamo;
	private Boolean status;

	public Boolean getStatus() { return status; }
	public void setStatus(Boolean status) { this.status = status; }
	
	public DebitosLiquidacionesPendientes() {
		
	}
	
	
	public String getHospitalesAutogestion() {
		return hospitalesAutogestion;
	}
	public String getFactura() {
		return factura;
	}
	public BigDecimal getMonto() {
		return monto;
	}
	public void setHospitalesAutogestion(String hospitalesAutogestion) {
		this.hospitalesAutogestion = hospitalesAutogestion;
	}
	public void setFactura(String factura) {
		this.factura = factura;
	}
	public void setMonto(BigDecimal monto) {
		this.monto = monto;
	}


	public BigDecimal getCargoPrestadora() {
		return cargoPrestadora;
	}


	public void setCargoPrestadora(BigDecimal cargoPrestadora) {
		this.cargoPrestadora = cargoPrestadora;
	}



	public BigDecimal getCargoPrestadoraReclamo() {
		return cargoPrestadoraReclamo;
	}


	public void setCargoPrestadoraReclamo(BigDecimal cargoPrestadoraReclamo) {
		this.cargoPrestadoraReclamo = cargoPrestadoraReclamo;
	}


	public BigDecimal getNumero() {
		return numero;
	}


	public void setNumero(BigDecimal numero) {
		this.numero = numero;
	}


	



	
}
