package ar.com.ospim.tesoreria.service;

import java.math.BigDecimal;
import java.sql.Connection;
import java.util.ArrayList;
import java.util.Date;
import java.util.HashMap;
import java.util.List;

import ar.com.ospim.global.beans.PlanCuentas;
import ar.com.ospim.tesoreria.beans.BalanceSumasYSaldos;
import ar.com.ospim.tesoreria.beans.contabilidad.Asiento;
import ar.com.ospim.tesoreria.beans.contabilidad.Asiento.Detalle;
import ar.com.ospim.util.ConnectionHelper;
import ar.com.uoma.centro_costo.CuentaAsientoDetalle;

import com.liferay.portal.model.User;

public class AsientoServiceUtil {
	public static List<Asiento> buscarAsientos(Date desde, Date hasta, int entidad) {
		return AsientoServiceImpl.getInstance().buscarAsientos(desde, hasta,
				null, null, true, true, entidad);
	}

	public static List<Asiento> buscarAsientosConDetalle(Date desde,
			Date hasta, Integer desdeNroAsiento, Integer hastaNroAsiento,
			boolean incluirAutomaticos, boolean incluirManuales, int entidad) {

		List<Asiento> asientos = AsientoServiceImpl.getInstance()
				.buscarAsientos(desde, hasta, desdeNroAsiento, hastaNroAsiento,
						incluirAutomaticos, incluirManuales, entidad);
		List<Asiento> detalle = buscarDetalleAsientos(desde, hasta,
				desdeNroAsiento, hastaNroAsiento, incluirAutomaticos,
				incluirManuales, entidad);

		if (asientos == null) {
			return null;
		}

		for (Asiento det : detalle) {
			int indexOf = asientos.indexOf(det);
			Asiento asiento = asientos.get(indexOf);
			if (asiento.getDetalle() == null) {
				asiento.setDetalle(new ArrayList<Detalle>());
			}
			asiento.getDetalle().addAll(det.getDetalle());
		}

		return asientos;
	}

	public static List<Asiento> buscarDetalleAsientos(Date desde, Date hasta, int entidad) {
		List<Asiento> detalle = AsientoServiceImpl.getInstance()
				.buscarDetalleAsientos(desde, hasta, null, null, true, true, entidad);

		return detalle;
	}

	public static List<Asiento> buscarDetalleAsientos(Date desde, Date hasta,
			Integer desdeNroAsiento, Integer hastaNroAsiento,
			boolean incluirAutomaticos, boolean incluirManuales, int entidad) {
		List<Asiento> detalle = AsientoServiceImpl.getInstance()
				.buscarDetalleAsientos(desde, hasta, desdeNroAsiento,
						hastaNroAsiento, incluirAutomaticos, incluirManuales, entidad);

		return detalle;
	}

	public static void save(Asiento asiento, User user, int entidad) throws Exception {
		Connection con = null;
		try {
			con = ConnectionHelper.getConnectionForTransaction();
			AsientoServiceImpl.getInstance().save(asiento, con,
					user.getScreenName(),entidad);
			for (Detalle det : asiento.getDetalle()) {
				AsientoServiceImpl.getInstance().save(asiento, det, con, entidad);
			}
			
			con.commit();
		} catch (Exception e) {
			ConnectionHelper.rollback(con);
			throw e;
		} finally {
			ConnectionHelper.cerrar(con);
		}
	}

	public static void update(Asiento asiento,
			List<Detalle> detalleBajasLogicas, User user, int entidad) {
		Connection con = null;
		try {
			con = ConnectionHelper.getConnectionForTransaction();
			AsientoServiceImpl.getInstance().update(asiento, con,
					user.getScreenName(), entidad);

			for (Detalle det : asiento.getDetalle()) {
				if (det.getId() != 0) {
					AsientoServiceImpl.getInstance().update(asiento, det, con, entidad);
				} else {
					AsientoServiceImpl.getInstance().save(asiento, det, con, entidad);
				}
			}

			if (detalleBajasLogicas != null) {
				for (Detalle det : detalleBajasLogicas) {
					AsientoServiceImpl.getInstance().eliminarDetalle(det, con, entidad);
				}
			}

			con.commit();
		} catch (Exception e) {
			ConnectionHelper.rollback(con);
		} finally {
			ConnectionHelper.cerrar(con);
		}
	}

	public static Asiento buscarAsiento(Asiento asiento, int entidad) {
		Asiento asientoBD = AsientoServiceImpl.getInstance().buscar(asiento, entidad);
		asientoBD.setDetalle(AsientoServiceImpl.getInstance().buscarDetalle(
				asientoBD, entidad));
		return asientoBD;
	}

	public static void saveAutomatico(Asiento asiento, User user, int entidad, boolean vacio)
			throws Exception {
		Connection con = null;
		try {
			con = ConnectionHelper.getConnectionForTransaction();
			AsientoServiceImpl.getInstance().saveAutomatico(asiento, con,
					user.getScreenName(), entidad, vacio);
			if(!vacio){				
				for (Detalle det : asiento.getDetalle()) {					
					AsientoServiceImpl.getInstance().save(asiento, det, con, entidad);					
				}
				//SOLO PARA COMPROBANTES A PAGAR
				if(asiento.getDescripcion().contains("Comprobante")){
					
					AsientoServiceImpl.getInstance().quitarBalanceadosReordenarConCentroCosto(asiento.getId(),con, entidad);
					//AsientoServiceImpl.getInstance().quitarBalanceadosReordenar(asiento.getId(),con, entidad);
				}else{
					AsientoServiceImpl.getInstance().quitarNegativosReordenar(asiento.getId(),con, entidad);
				}
			}
			con.commit();
		} catch (Exception e) {
			ConnectionHelper.rollback(con);
			throw e;
		} finally {
			ConnectionHelper.cerrar(con);
		}
	}

	public static void eliminar(Asiento asiento, int entidad) throws Exception {
		AsientoServiceImpl.getInstance().eliminar(asiento, entidad);
	}	
	

	public static List<BalanceSumasYSaldos> buscarBalanceSumasYSaldos(
			Date desde, Date hasta, boolean incluirAutomaticos,
			boolean incluirManuales, boolean incluirAsientoInicial, int entidad) {
		return AsientoServiceImpl.getInstance().buscarBalanceSumasYSaldos(
				desde, hasta, incluirAutomaticos, incluirManuales,
				incluirAsientoInicial, entidad);
	}
	
	
	public static void updateCierre(Asiento asiento, int entidad) throws Exception {
		AsientoServiceImpl.getInstance().updateCierre(asiento,null, entidad);
	}
	
	public static List<Asiento> buscarAsientoCierre(Date desde, Date hasta, int entidad) {
		List<Asiento> detalle = AsientoServiceImpl.getInstance()
				.buscarAsientoCierre(desde, hasta, entidad);

		return detalle;
	}
	
	public static void updateApertura(Asiento asiento, int entidad) throws Exception {
		AsientoServiceImpl.getInstance().updateApertura(asiento,null, entidad);
	}
	
	public static List<Asiento> buscarAsientoApertura(Date desde, Date hasta, int entidad) {
		List<Asiento> detalle = AsientoServiceImpl.getInstance()
				.buscarAsientoApertura(desde, hasta, entidad);

		return detalle;
	}
	
	
	public static List<CuentaAsientoDetalle> buscarCuentasAsientosDetalles(String id_cuentas, String id_centros_costos, Date desde, Date hasta, int entidad){
		List<CuentaAsientoDetalle> asientoDetalle = AsientoServiceImpl.getInstance()
				.buscarCuentasAsientosDetalles(id_cuentas, id_centros_costos, desde, hasta, entidad);
		return asientoDetalle;
	}

	
	public static List<BalanceSumasYSaldos> buscarBalanceSumasYSaldosConCentroDeCosto(
			Date desde, Date hasta, boolean incluirAutomaticos,
			boolean incluirManuales, boolean incluirAsientoInicial, int entidad) {
		return AsientoServiceImpl.getInstance().buscarBalanceSumasYSaldosConCentroDeCosto(
				desde, hasta, incluirAutomaticos, incluirManuales,
				incluirAsientoInicial, entidad);
	}
}
