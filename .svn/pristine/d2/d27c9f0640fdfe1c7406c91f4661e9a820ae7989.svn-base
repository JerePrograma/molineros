package ar.com.ospim.autorizaciones.action;

import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;

import org.apache.log4j.Logger;
import org.apache.struts.action.ActionForm;
import org.apache.struts.action.ActionMapping;

import com.liferay.portal.kernel.log.Log;
import com.liferay.portal.kernel.log.LogFactoryUtil;
import com.liferay.portal.kernel.util.ParamUtil;
import com.liferay.portal.struts.JSONAction;

import ar.com.ospim.afiliados.action.ActionUtil;
import ar.com.ospim.afiliados.beans.AfiTercerizadoraServicio;
import ar.com.ospim.afiliados.beans.Afiliado;
import ar.com.ospim.afiliados.services.TercerizadoraServiceUtil;
import ar.com.ospim.automatico.Thread.EnviaEmailsThread;
import ar.com.ospim.autorizaciones.beans.AutorizacionPrestacional;
import ar.com.ospim.autorizaciones.services.AutorizacionPrestacionalServiceUtil;
import ar.com.ospim.global.services.TraeListasServiceUtil;
import ar.com.ospim.util.StringUtils;

public class EmailPrestadorJSONAction extends JSONAction {

	private Logger _log = Logger.getLogger(this.getClass());
	
	@Override
	public String getJSON(ActionMapping arg0, ActionForm arg1,
			HttpServletRequest req, HttpServletResponse arg3) throws Exception {
		
		Afiliado afiliado = null;
		Afiliado afiliadoTitular = null;
		String tercMONO =TraeListasServiceUtil.getSystemConfig("PREAUTORIZACION_TERCERIZADORA_MONOTRIBUTO"); 
		
		int idTratamiento = ParamUtil.getInteger(req, "tratamiento_id");
		try {

			_log.debug(idTratamiento);
			AutorizacionPrestacional tratamiento = null;
			tratamiento = AutorizacionPrestacionalServiceUtil.getAutorizacionPrestacional(idTratamiento);
			AfiTercerizadoraServicio ats = TercerizadoraServiceUtil.getInstance().buscarUltimaTercerizadoraDelAfiliado(null, tratamiento.getAfiliado().getCuil_titular());
			boolean esMonotributo = tercMONO.equals(ats.getTercerizadora().getId_tercerizadora());
			//if (tratamiento.getIdPreautorizacion() != 0 && !tratamiento.isMailPrestadorEnviado() && tratamiento.getEstado() == 1) {
			//DS -2023-08-18 Comentado a pedido de VFranco y AComas
			if ( !tratamiento.isMailPrestadorEnviado() && tratamiento.getEstado() == 1) {
				afiliado = ActionUtil.getAfiliadoInclusoDadoBajaByCuilInte(tratamiento.getAfiliado().getCuil_titular(),tratamiento.getAfiliado().getInte());
				
				if(tratamiento.isDiscapacitado() && !esMonotributo){					
					AutorizacionPrestacionalEmail.getInstance().enviarEmailPrestador(tratamiento.getPrestador().getId_prestador(),tratamiento.getNroAutorizacion(), afiliado.getDocu_numero(),idTratamiento, tratamiento.isDiscapacitado());
					
					AutorizacionPrestacionalServiceUtil.marcaEmailSendPrestador(idTratamiento);
					
					// Envio e-mail a Seccional
					AutorizacionPrestacionalEmail.getInstance().enviarEmailSeccional(tratamiento.getIdPreautorizacion(),tratamiento.getNroAutorizacion(), afiliado.getDocu_numero(), idTratamiento, tratamiento.isDiscapacitado());
					
					afiliadoTitular = ActionUtil.getAfiliadoInclusoDadoBajaByCuilInte(tratamiento.getAfiliado().getCuil_titular(),0);
					if (afiliadoTitular != null && afiliadoTitular.getEmail()!=null && !StringUtils.checkEmpty(afiliadoTitular.getEmail())) {
						AutorizacionPrestacionalEmail.getInstance().enviarEmailAfilaido("", idTratamiento,tratamiento.getNroAutorizacion(), afiliado.getDocu_numero(),afiliadoTitular.getEmail());
					} else {// Envia email aviso de error en casilla
						AutorizacionPrestacionalEmail.getInstance().enviarEmailAfilaido("Error ", idTratamiento,tratamiento.getNroAutorizacion(), afiliado.getDocu_numero(),"autorizaciones@ospim.org.ar");
					}
				}else if(tratamiento.isDiscapacitado() && esMonotributo){
					AutorizacionPrestacionalEmail.getInstance().enviarEmailPrestador(tratamiento.getPrestador().getId_prestador(),tratamiento.getNroAutorizacion(), afiliado.getDocu_numero(),idTratamiento, tratamiento.isDiscapacitado());				
					AutorizacionPrestacionalServiceUtil.marcaEmailSendPrestador(idTratamiento);
					
					afiliadoTitular = ActionUtil.getAfiliadoInclusoDadoBajaByCuilInte(tratamiento.getAfiliado().getCuil_titular(),0);
					if (afiliadoTitular != null && afiliadoTitular.getEmail()!=null && !StringUtils.checkEmpty(afiliadoTitular.getEmail())) {
						String emailAux =TraeListasServiceUtil.getSystemConfig("EMAIL_MONOTRIBUTISTA_DISCAPACITADO");
						AutorizacionPrestacionalEmail.getInstance().enviarEmailAfilaido("", idTratamiento,tratamiento.getNroAutorizacion(), afiliado.getDocu_numero(),afiliadoTitular.getEmail());
						AutorizacionPrestacionalEmail.getInstance().enviarEmailAfilaido("", idTratamiento,tratamiento.getNroAutorizacion(), afiliado.getDocu_numero(),emailAux);
					} else {// Envia email aviso de error en casilla
						AutorizacionPrestacionalEmail.getInstance().enviarEmailAfilaido("Error ", idTratamiento,tratamiento.getNroAutorizacion(), afiliado.getDocu_numero(),"autorizaciones@ospim.org.ar");
					}
					
				}else if(esMonotributo){
					afiliadoTitular = ActionUtil.getAfiliadoInclusoDadoBajaByCuilInte(tratamiento.getAfiliado().getCuil_titular(),0);
					if (afiliadoTitular != null && afiliadoTitular.getEmail()!=null && !StringUtils.checkEmpty(afiliadoTitular.getEmail())) {
						AutorizacionPrestacionalEmail.getInstance().enviarEmailAfilaido("", idTratamiento,tratamiento.getNroAutorizacion(), afiliado.getDocu_numero(),afiliadoTitular.getEmail());
					} else {// Envia email aviso de error en casilla
						AutorizacionPrestacionalEmail.getInstance().enviarEmailAfilaido("Error ", idTratamiento,tratamiento.getNroAutorizacion(), afiliado.getDocu_numero(),"autorizaciones@ospim.org.ar");
					}
				}else{
					// NO DISCA y NO MONOTRIBUTO no envia ningun correo
				}
			}

		} catch (Exception e) {
			return "{\"status\":\"falla_inesperada\"}";
		}
		
		return "{\"status\":\"ok\"}";
		
	}
	
}
