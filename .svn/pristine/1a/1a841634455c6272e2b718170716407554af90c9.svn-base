public class CentroCostoAction extends PortletAction {
	
	private Logger _log = Logger.getLogger(this.getClass());
	SimpleDateFormat formatoDeFechas = new SimpleDateFormat("dd/MM/yyyy");
	public void processAction(ActionMapping mapping, ActionForm form,
							  PortletConfig portletConfig, ActionRequest actionRequest,
							  ActionResponse actionResponse) throws Exception {
//		procesarMostrarBusquedaComprobantes(actionRequest);
	}
	
	@SuppressWarnings("deprecation")
	public ActionForward render(ActionMapping mapping, ActionForm form,
			PortletConfig portletConfig, RenderRequest renderRequest,
			RenderResponse renderResponse) throws Exception {
			
		HttpServletRequest httpServletRequest = PortalUtil.getHttpServletRequest(renderRequest);
		HttpSession session = (HttpSession) httpServletRequest.getSession();
		User user = PortalUtil.getUser(renderRequest);
		SimpleDateFormat format = new SimpleDateFormat("dd/MM/yyyy");
		String cmd = ParamUtil.getString(renderRequest, Constants.CMD, null);
		
		CentroCosto centroCosto = null;
		
		Integer idCentroCosto = 0;
		String msg = "";
		
		
        int entidad=WebKeysGlobal.OSPIM;
		if(renderResponse.getNamespace().equals("_FAR_1_")){
			entidad=WebKeysGlobal.AMTIMA;
		}else if(renderResponse.getNamespace().equals("_UOM_1_")){
			entidad=WebKeysGlobal.UOMA;
		}
		
		if (!StringUtils.checkEmpty(cmd)) {
			idCentroCosto = ParamUtil.getInteger(renderRequest,"id_centro_costo", 0);
			
			if("NEW".equals(cmd) ){ // lo voy a usar como -NEW, para crear nuevas entradas en blanco
				
				centroCosto = new CentroCosto();
				
				session.setAttribute(WebKeysUOMA.CENTRO_COSTO_EN_EDICION, centroCosto);
				
				_log.debug("Usuario: " + user.getScreenName() 
						+ " cmd: " + cmd 
						);
				
				return mapping.findForward(getForward(renderRequest,
						"portlet.uoma.centrocosto.editar_centro_costo"));
			}
			
			if(cmd.equals(Constants.EDIT) ){ 
				
            	centroCosto = CentroCostoServiceUtil.get(idCentroCosto,entidad ); 
            	session.setAttribute(WebKeysUOMA.CENTRO_COSTO_EN_EDICION, centroCosto);
				return mapping.findForward(getForward(renderRequest,
						"portlet.uoma.centrocosto.editar_centro_costo"));
			}
			
			if(cmd.equals("filtrar") ){
				
				filtrarCentros(renderRequest,session);		   	
						
		   		return mapping.findForward(getForward(renderRequest,
								"portlet.uoma.centrocosto.result"));	
			}
			
			if(cmd.equals("atras") ){
				return mapping
        				.findForward("portlet.uoma.centrocosto.abm");
				
			}
			
			if(cmd.equals(Constants.DELETE) ){
				
                CentroCostoServiceUtil.delete(idCentroCosto, user.getScreenName(),entidad);
            	
            	List<CentroCosto> lista = new ArrayList<CentroCosto>();
            	List<CentroCosto> archivos=(List<CentroCosto>)session.getAttribute(WebKeysUOMA.CENTRO_COSTO_FILTRO);
            	
            	
           	    for(CentroCosto n:archivos){
           	    	if(n.getId()!=idCentroCosto){
           	    		lista.add(n);
           	    	}
            	}
            	session.setAttribute(WebKeysUOMA.CENTRO_COSTO_FILTRO,lista);
            	
				msg = LanguageUtil.get(defaultLocale, "delete-centro-costo");
				msg = msg + " " + idCentroCosto;
				SessionMessages.add(renderRequest, "updateCabOk");
				renderRequest.setAttribute("msgCabOk", msg);
				return mapping.findForward("portlet.uoma.centrocosto.result");
				
				
			}
			
            if(cmd.equals("filtrarTablero") ){
				
				filtrarCentrosTablero(renderRequest,session);		   	
						
		   		return mapping.findForward(getForward(renderRequest,
								"portlet.uoma.centrocosto.tablero.result"));	
			}
			
            if(cmd.equals("detalleComprobantes") ){
            	
				detalleTablero(idCentroCosto,renderRequest,session);		
				
				return mapping.findForward(getForward(renderRequest,
								"portlet.uoma.centrocosto.tablero.detalle"));	
			}
            
            if(cmd.equals("atrasDetalle") ){
				return mapping
        				.findForward("portlet.uoma.centrocosto.tablero");
				
			}
			if(cmd.equals(Constants.UPDATE) ){
				
				 centroCosto = (CentroCosto) session.getAttribute(WebKeysUOMA.CENTRO_COSTO_EN_EDICION);
				 actualizaCentroCosto(centroCosto,renderRequest);
				 if(idCentroCosto==0){
					 idCentroCosto = insertCentroCosto(centroCosto, user.getScreenName(),entidad); 
					 centroCosto.setId(idCentroCosto);
					 msg = LanguageUtil.get(defaultLocale, "insert-centro-costo");
					 msg = msg + " " +idCentroCosto;
					 SessionMessages.add(renderRequest, "insertCabOk");
					  renderRequest.setAttribute("msgCabOk", msg);
					  
				 }else  if(idCentroCosto!=0){
					 idCentroCosto = updateCentroCosto(centroCosto, user.getScreenName(),entidad);
						msg = LanguageUtil.get(defaultLocale, "update-centro-costo");
						msg = msg +" " + idCentroCosto;
						SessionMessages.add(renderRequest, "updateCabOk");
						renderRequest.setAttribute("msgCabOk", msg);
						_log.debug("Usuario: " + user.getScreenName() 
								+ " cmd: " + cmd 
								+ " id centro costo: " + idCentroCosto
								);
				 }
			}
			
		}///////////
		
		session.setAttribute(WebKeysUOMA.CENTRO_COSTO_EN_EDICION , centroCosto);
		return mapping.findForward("portlet.uoma.centrocosto.editar_centro_costo");
		
	}
	
	
	private Integer insertCentroCosto(CentroCosto centroCosto, String user,int entidad) throws Exception{
		Integer id = 0;
		
		id = CentroCostoServiceUtil.add(centroCosto, user, entidad);
		return id;
	}
	
	
	private Integer updateCentroCosto(CentroCosto centroCosto, String user,int entidad) throws Exception{
		Integer id = 0;
		
		id = CentroCostoServiceUtil.update(centroCosto, user, entidad);
		return id;
	}
	
	private void actualizaCentroCosto(CentroCosto centroCosto,RenderRequest renderRequest){
		String descripcion = ParamUtil.getString(renderRequest, "descripcionCentroCosto", null);
		String observaciones = ParamUtil.getString(renderRequest, "observacionesCentroCosto", null);
		Double presupuesto=ParamUtil.getDouble(renderRequest,"presupuestoCentroCosto",0);
		
		String fechaVigenciaDdeDia = ParamUtil.getString(renderRequest,"fechaDesdeDia");
		String fechaVigenciaDdeMes = ParamUtil.getString(renderRequest,"fechaDesdeMes");
		String fechaVigenciaDdeAnio = ParamUtil.getString(renderRequest,"fechaDesdeAnio");
		
		Date fechaVigenciaDde = null;
		try {
			fechaVigenciaDde = formatoDeFechas.parse(fechaVigenciaDdeDia + "/"
					+ (Integer.parseInt(fechaVigenciaDdeMes) + 1) + "/"
					+ fechaVigenciaDdeAnio);
		} catch (Exception e) {
			fechaVigenciaDde = new Date();
		}
		
		
		String fechaVigenciaHtaDia = ParamUtil.getString(renderRequest,"fechaHastaDia");
		String fechaVigenciaHtaMes = ParamUtil.getString(renderRequest,"fechaHastaMes");
		String fechaVigenciaHtaAnio = ParamUtil.getString(renderRequest,"fechaHastaAnio");
		Date fechaVigenciaHta = null;
		try {
			fechaVigenciaHta = formatoDeFechas.parse(fechaVigenciaHtaDia + "/"
					+ (Integer.parseInt(fechaVigenciaHtaMes) + 1) + "/"
					+ fechaVigenciaHtaAnio);
		} catch (Exception e) {
//			fechaVigenciaHta = new Date();
		}
		
		boolean contable = ParamUtil.getBoolean(renderRequest, "contable");
		
		centroCosto.setDescripcion(descripcion);
		centroCosto.setObservaciones(observaciones);
		centroCosto.setPresupuesto(presupuesto);
		centroCosto.setVigenciaDde(fechaVigenciaDde);
		centroCosto.setVigenciaHta(fechaVigenciaHta);
		centroCosto.setEsContable(contable);
		
	}
	
	private void filtrarCentros(RenderRequest renderRequest,HttpSession session) throws Exception{
		String descripcion=ParamUtil.getString(renderRequest,"descripcioncentro",null);
		Integer entidad = ParamUtil.getInteger(renderRequest, "entidadcentro");
		Integer id = ParamUtil.getInteger(renderRequest, "id",0);
		Boolean contable= ParamUtil.getBoolean(renderRequest, "contable");
		session.removeAttribute(WebKeysUOMA.CENTRO_COSTO_FILTRO);
			
		List<CentroCosto>lista=CentroCostoServiceUtil.list(descripcion, entidad, id,contable);
				
		
		session.setAttribute(WebKeysUOMA.CENTRO_COSTO_FILTRO,lista);
		
	}
	
	private void filtrarCentrosTablero(RenderRequest renderRequest,HttpSession session) throws Exception{
		String descripcion=ParamUtil.getString(renderRequest,"descripcioncentro",null);
		Integer entidad = ParamUtil.getInteger(renderRequest, "entidadcentro");
		Integer id = ParamUtil.getInteger(renderRequest, "id",0);
		
		session.removeAttribute(WebKeysUOMA.CENTRO_COSTO_FILTRO);
		
		List<CentroCosto>lista=CentroCostoServiceUtil.list(descripcion, entidad, id,null);
		for(CentroCosto c:lista){
			Double ejecutado=CentroCostoServiceUtil.ejecucionPorCentroDeCosto(c.getId(), entidad, null);
			c.setEjecutado(ejecutado);
		}
		
		session.setAttribute(WebKeysUOMA.CENTRO_COSTO_FILTRO,lista);
		
	}
	
	
	private void detalleTablero(Integer idCentro,RenderRequest renderRequest,HttpSession session) throws Exception{
		Integer entidad = ParamUtil.getInteger(renderRequest, "entidad_centro");
		
		session.removeAttribute(WebKeysUOMA.CENTRO_COSTO_EN_EDICION );
		session.removeAttribute(WebKeysUOMA.CENTRO_COSTO_COMPROBANTES );
		int registrosTotalBusqueda = 0;
		int pagina_sel = ParamUtil.getInteger(renderRequest, "pagina", 1);
		pagina_sel--;
		
		CentroCosto centro =CentroCostoServiceUtil.get(idCentro, entidad);
		
//		List<ComprobanteCajaChica> cptesAux = CentroCostoServiceUtil.comprobantesPorCentroCosto(idCentro, entidad, null);
		Double ejecutado=0D;
		ejecutado=CentroCostoServiceUtil.ejecucionPorCentroDeCosto(idCentro, entidad, null);
/*		
		for(ComprobanteCajaChica cp:cptesAux){
			ejecutado += cp.getImporteComprobante().doubleValue();
		}
*/		
		centro.setEjecutado(ejecutado);
		List<ComprobanteCajaChica> cptes = CentroCostoServiceUtil.comprobantesPorCentroCostoOffset(idCentro, entidad,pagina_sel ,null);
		
		if(cptes != null && cptes.size() > 0){
			registrosTotalBusqueda = cptes.get(0).getTotalRegistros();
			
			session.setAttribute("total_registros", registrosTotalBusqueda);
			session.setAttribute("offset_reg", pagina_sel);
		}else{
			session.setAttribute("total_registros",0 );
			session.setAttribute("offset_reg", 0);
		}
		
		session.setAttribute(WebKeysUOMA.CENTRO_COSTO_EN_EDICION ,centro);
		session.setAttribute(WebKeysUOMA.CENTRO_COSTO_COMPROBANTES ,cptes);
		
	}
	
}
