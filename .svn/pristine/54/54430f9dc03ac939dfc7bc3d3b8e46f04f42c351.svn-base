package ar.com.ospim.liquidaciones;

public class ComprobanteImoprteConceptoInvalidoException extends Exception {

	private static final long serialVersionUID = -6579512944222084107L;

	public ComprobanteImoprteConceptoInvalidoException() {
		super();
	}

	public ComprobanteImoprteConceptoInvalidoException(String message,
			Throwable cause) {
		super(message, cause);
	}

	public ComprobanteImoprteConceptoInvalidoException(String message) {
		super(message);
	}

	public ComprobanteImoprteConceptoInvalidoException(Throwable cause) {
		super(cause);
	}

}
