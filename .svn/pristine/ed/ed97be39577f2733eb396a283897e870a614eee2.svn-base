package ar.com.ospim.afiliados.action;

import java.util.ArrayList;
import java.util.Collections;
import java.util.List;
import java.util.Map;

import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;

import org.apache.struts.action.ActionForm;
import org.apache.struts.action.ActionMapping;

import ar.com.ospim.afiliados.WebKeysAfiliados;
import ar.com.ospim.global.beans.Localidad;

import com.liferay.portal.struts.JSONAction;

public class IdProvinciaLocalidadAction extends JSONAction {

    @Override
    public String getJSON(ActionMapping arg0, ActionForm arg1,
            HttpServletRequest req, HttpServletResponse resp) throws Exception {

        String idProvincia = req.getParameter("idProvincia");

        //devolver solo la opción por defecto
        if (idProvincia == null || idProvincia.trim().isEmpty()) {
            return "{\"listaFiltrada\":[\"<option selected value='0'>Seleccione una localidad</option>\"]}";
        }

        int idProv;
        try {
            idProv = Integer.parseInt(idProvincia);
        } catch (NumberFormatException e) {
            return "{\"listaFiltrada\":[\"<option selected value='0'>Seleccione una localidad</option>\"]}";
        }

        //Trae map de sesión
        Map<Integer, ArrayList<Localidad>> map =
            (Map<Integer, ArrayList<Localidad>>) req.getSession()
                .getAttribute(WebKeysAfiliados.LOCALIDADES_EN_SESSION_POR_PROVINCIA);

        if (map == null) {
            // si no está cargado en sesión, se devuelve vacío sin romper
            return "{\"listaFiltrada\":[\"<option selected value='0'>Seleccione una localidad</option>\"]}";
        }

        List<Localidad> lista = map.get(idProv);
        if (lista == null) lista = Collections.emptyList();

        StringBuilder json = new StringBuilder(1024);
        json.append("{\"listaFiltrada\":[");
        json.append("\"<option selected value='0'>Seleccione una localidad</option>\"");

        for (Localidad loc : lista) {
            if (loc == null) continue;
            json.append(",\"<option value='")
                .append(loc.getId())
                .append("'> ")
                .append(escapeForHtml(loc.getDescripcion()))
                .append("</option>\"");
        }

        json.append("]}");
        return json.toString();
    }

    //si hay caracteres raros
    private String escapeForHtml(String s) {
        if (s == null) return "";
        return s.replace("&", "&amp;")
                .replace("<", "&lt;")
                .replace(">", "&gt;")
                .replace("\"", "&quot;")
                .replace("'", "&#39;");
    }
}
