	public BigDecimal insertaAfiPlan(Connection connectionParameter, AfiPlan afiPlan, String screenName) throws SystemException {

		BigDecimal idPlanSerial = null; // clave unica para cada plan de afiliado insertado a afi_plan
		Connection con = null;
		if(connectionParameter==null){
			con = ConnectionHelper.getConnection();
		}else{
			con = connectionParameter;
		}
		
		CallableStatement stmt = null;
		try {	
			// se hace desde afuera la gran transaccion junto a situ laborales y tercerizadoras
			
			String sql = "{call inserta_afi_plan_con_aportes_autom(?, ?, ?, ?, ?, ?, ?, ?)}";
							
			stmt = con.prepareCall(sql.toString());
			stmt.setString(1, afiPlan.getCuil_titular());
			stmt.setInt(2, afiPlan.getInte());
			stmt.setDate(3, new java.sql.Date(afiPlan.getVigenDesde().getTime()));
			// va sin vigen_hasta si es un nuevo plan con vigencia, si es x baja con regla 1, 
			//el plan tiene n meses de vigencia ya establecidos
			if(afiPlan.getVigenHasta() == null){
				stmt.setNull(4, Types.DATE);
				stmt.setNull(5, Types.INTEGER);
			}else{
				stmt.setDate(4, new java.sql.Date(afiPlan.getVigenHasta().getTime()));
				stmt.setInt(5, afiPlan.getMotivoBaja().getId_motivo_baja());
			}
			stmt.setInt(6, afiPlan.getPlan().getId());
			if(afiPlan.getId_plan_omint()>0){
				stmt.setInt(7, afiPlan.getId_plan_omint());
			}else{
				stmt.setNull(7, Types.INTEGER);				
			}
			stmt.setString(8, screenName);
			
			ResultSet rs = stmt.executeQuery(); 
			while (rs.next()) {
				idPlanSerial = rs.getBigDecimal(1);
				
				afiPlan.setId(idPlanSerial.toBigInteger());
			}

		} catch (SQLException e) {
			_log.error("Error al insertar afi_plan", e);
			throw new SystemException(e);
		} finally {
			if(connectionParameter==null){
				ConnectionHelper.cerrar(stmt,con);
			}else{
				ConnectionHelper.cerrar(stmt);
			}
		}
		
		return idPlanSerial;
		
	}
	
	
	public int actualizaAfiPlan(Connection connectionParameter, AfiPlan afiPlan, String screenName) throws SystemException {
		
		Connection con = null;
		if(connectionParameter==null){
			con = ConnectionHelper.getConnection();
		}else{
			con = connectionParameter;
		}
		CallableStatement stmt = null;
		try {	
			// se hace desde afuera la gran transaccion junto a situ laborales y tercerizadoras
			
			String sql = "{call actualiza_afi_plan_con_aportes_autom(?, ?, ?, ?, ?, ?, ?, ?, ?)}";
							
			stmt = con.prepareCall(sql.toString());
			stmt.setDouble(1, afiPlan.getId().doubleValue());
			stmt.setString(2, afiPlan.getCuil_titular());
			stmt.setInt(3, afiPlan.getInte());
			stmt.setDate(4, new java.sql.Date(afiPlan.getVigenDesde().getTime()));
			// va sin vigen_hasta si es un nuevo plan con vigencia, si es x baja con regla 1, 
			//el plan tiene n meses de vigencia ya establecidos
			if(afiPlan.getVigenHasta() == null){
				stmt.setNull(5, Types.DATE);
				stmt.setNull(6, Types.INTEGER);
			}else{
				stmt.setDate(5, new java.sql.Date(afiPlan.getVigenHasta().getTime()));
				stmt.setInt(6, afiPlan.getMotivoBaja().getId_motivo_baja());
			}
			stmt.setInt(7, afiPlan.getPlan().getId());
			if(afiPlan.getId_plan_omint()>0){
				stmt.setInt(8, afiPlan.getId_plan_omint());
			}else{
				stmt.setNull(8, Types.INTEGER);				
			}
			stmt.setString(9, screenName);
			
			stmt.executeUpdate(); 

		} catch (SQLException e) {
			_log.error("Error al actualizar afi_plan", e);
			throw new SystemException(e);
		} finally {
			if(connectionParameter==null){
				ConnectionHelper.cerrar(stmt,con);
			}else{
				ConnectionHelper.cerrar(stmt);
			}
			
		}
		
		return 1;
		
	}
	
