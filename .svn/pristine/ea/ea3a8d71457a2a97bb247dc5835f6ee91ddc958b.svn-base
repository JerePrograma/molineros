	public List<Plan> buscaTodosPlanes() throws Exception {
		
		List<Plan> listaPlanes = new ArrayList<Plan>();
		Plan p = null;
		
		Connection con = null;
		CallableStatement stmt = null;

		try {
			con = ConnectionHelper.getConnection();
//			String sql = "select p.*, po.descripcion as descripcion_omint, po.id_plan_omint " +
//						 "from plan p left join plan_omint po on p.id_plan = po.id_plan order by p.descripcion";
//
//			
			String sql = "{call buscar_todos_planes()}";
			
			stmt = con.prepareCall(sql.toString());

			ResultSet rs = stmt.executeQuery();
				
			while (rs.next()) { 
				
				p = Plan.getMappingPlanOmint(rs,"plan_");
				
				listaPlanes.add(p);
			}
			
		} catch (SQLException e) {
			_log.error(e);
		} catch (Exception e) {
			_log.error(e);
		} finally {
			ConnectionHelper.cerrar(stmt, con);
		}
		
		return listaPlanes;
	}

	public Plan buscaPlanPorId(int idPlan) throws Exception {
		
		Plan plan = null;
		
		Connection con = null;
		CallableStatement stmt = null;

