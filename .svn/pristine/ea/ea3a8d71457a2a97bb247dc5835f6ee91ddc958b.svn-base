	public AfiPlan buscarUltimoPlanAportes(String cuilTitular) throws Exception {
		
		BigInteger idPlanSerial = null;
		
		AfiPlan ap = null;
		AfiAportes afiAporte = null;
		List<AfiAportes> listaAfiAportes = null;
		Plan plan = null;
		List<TipoAporte> listaAportes = null;
		
		Connection con = null;
//		PreparedStatement stmt = null;
		CallableStatement stmt = null, stmt1 = null;
		
		try {
			_log.debug("buscarUltimoPlanAportes " + cuilTitular);
			
			con = ConnectionHelper.getConnection();

//			String sql = "select ap.*, p.*, po.descripcion as descripcion_omint, po.id_plan_omint, "+
//						 "mb.id_motivo_baja as motbaja_id_motivo_baja, "+
//						 "mb.descripcion as motbaja_descripcion, "+
//						 "mb.observaciones as motbaja_observaciones, "+
//						 "mb.alta_fecha as motbaja_alta_fecha, "+
//						 "mb.alta_usr as motbaja_alta_usr, "+
//						 "mb.modi_fecha as motbaja_modi_fecha, "+
//						 "mb.modi_usr as motbaja_modi_usr, "+
//						 "mb.baja_fecha as motbaja_baja_fecha, "+
//						 "mb.baja_usr as motbaja_baja_usr, "+
//						 "mb.meses_a_baja as motbaja_meses_a_baja "+
//						 "from afi_plan ap inner join plan p on ap.id_plan=p.id_plan "+ 
//						 "left join motivo_baja mb on ap.id_motivo_baja = mb.id_motivo_baja "+
//						 "left join plan_omint po on p.id_plan = po.id_plan "+
//						 "where cuil_titular = ? "+
//						 "and ap.vigen_desde = (select max(ap_.vigen_desde) from afi_plan ap_ "+
//						 "where ap_.cuil_titular = ap.cuil_titular );"; 
			String sql = "{call buscar_ultimo_plan_aportes(?)}";
					
//			stmt = con.prepareStatement(sql.toString());
			stmt = con.prepareCall(sql.toString());
			stmt.setString(1, cuilTitular);

			ResultSet rs = stmt.executeQuery();
			
//			if(rs == null){
//				throw new AfiliadoSinPlanException("El Afiliado no posee ningun plan cargado");
//			}	
			while (rs.next()) { 
				
//				ap = AfiPlan.getMapping(rs);
				ap = AfiPlan.getMappingConMotivoBaja(rs, "afiplan_");
				plan = Plan.getMappingPlanOmint(rs,"plan_");
			}
			if(ap == null){ // en las altas de afi, esto no retorna nada...
				return ap;
			}
			listaAportes = this.buscaAportesPorPlan(plan.getId());
			plan.setAportes(listaAportes);
			
			ap.setPlan(plan);
			
			idPlanSerial = ap.getId();
			
			sql = "{call buscar_afiaportes_por_afiplan(?)}";
				
			stmt1 = con.prepareCall(sql.toString());
			stmt1.setDouble(1, idPlanSerial.doubleValue());

			rs = stmt1.executeQuery();
			
			listaAfiAportes = new ArrayList<AfiAportes>();
			
			while (rs.next()) { 
				
				afiAporte = AfiAportes.getMapping("afiaporte_",rs);
				listaAfiAportes.add(afiAporte);
			}
			
			if(listaAfiAportes.size() > 0){
				ap.setAportes(listaAfiAportes);
			}else{
				ap.setAportes(null);
			}
			

		} catch (SQLException e) {
			_log.error(e);
		} catch (Exception e) {
			_log.error(e);
		} finally {
			ConnectionHelper.cerrar(stmt, con);
		}
		
		return ap;
	}
	
	public AfiPlan buscarPenultimoPlanAportes(String cuilTitular) throws Exception {
		
		BigInteger idPlanSerial = null;
		
		AfiPlan ap = null;
		AfiAportes afiAporte = null;
		List<AfiAportes> listaAfiAportes = null;
		Plan plan = null;
		List<TipoAporte> listaAportes = null;
		
		Connection con = null;
		CallableStatement stmt = null, stmt1 = null;
		
		try {
			con = ConnectionHelper.getConnection();

			String sql = "{call buscar_penultimo_plan_aportes(?)}";
					
			stmt = con.prepareCall(sql.toString());
			stmt.setString(1, cuilTitular);

			ResultSet rs = stmt.executeQuery();
			
			while (rs.next()) { 
				
				ap = AfiPlan.getMappingConMotivoBaja(rs, "afiplan_");
				plan = Plan.getMappingPlanOmint(rs,"plan_");
			}
			if(ap == null){ // en las altas de afi, esto no retorna nada...
				return ap;
			}
			listaAportes = this.buscaAportesPorPlan(plan.getId());
			plan.setAportes(listaAportes);
			
			ap.setPlan(plan);
			
			idPlanSerial = ap.getId();
			
			sql = "{call buscar_afiaportes_por_afiplan(?)}";
				
			stmt1 = con.prepareCall(sql.toString());
			stmt1.setDouble(1, idPlanSerial.doubleValue());

			rs = stmt1.executeQuery();
			
			listaAfiAportes = new ArrayList<AfiAportes>();
			
			while (rs.next()) { 
				
				afiAporte = AfiAportes.getMapping("afiaporte_",rs);
				listaAfiAportes.add(afiAporte);
			}
			
			if(listaAfiAportes.size() > 0){
				ap.setAportes(listaAfiAportes);
			}else{
				ap.setAportes(null);
			}

			
		} catch (SQLException e) {
			_log.error(e);
		} catch (Exception e) {
			_log.error(e);
		} finally {
			ConnectionHelper.cerrar(stmt, con);
		}
		
		return ap;
	}
	
	public List<TipoAporte> buscaAportesPorPlan(int idPlan) throws Exception {
		
		TipoAporte aporte = null;
		List<TipoAporte> aportes = new ArrayList<TipoAporte>();
		
		Connection con = null;
		CallableStatement stmt = null;

		try {
			con = ConnectionHelper.getConnection();

			String sql = "{call buscar_aportes_por_plan(?)}";
					
			stmt = con.prepareCall(sql.toString());
			stmt.setInt(1, idPlan);
			
			ResultSet rs = stmt.executeQuery();
				
			while (rs.next()) { 
				
				aporte = TipoAporte.getMapping(rs);
				
				aportes.add(aporte);
			}
			
		} catch (SQLException e) {
			_log.error(e);
		} catch (Exception e) {
			_log.error(e);
		} finally {
			ConnectionHelper.cerrar(stmt, con);
		}
		
		return aportes;
	}

	/**
	 * insertaPlanyAportes: inserta un plan con sus aportes para un afiliado. 
	 * genera ids de cada aporte si corresponde y los actualiza al afiliado. 
	 * 
	 * @author sergio 
	 * @param afiPlan
	 * @param screenName
	 * @return boolean si pudo o no transaccionar
	 * @throws SystemException
	 */
	public boolean insertaPlanyAportes(Connection connectionParameter, AfiPlan afiPlan, Map<Integer,Boolean> aporteGeneraIdsSocio, String screenName) throws SystemException {

		_log.debug("Inserta Plan: " + afiPlan.getPlan().getId() + " para Afiliado: "+ afiPlan.getCuil_titular());
		boolean result = false;
		Connection con = null;
		BigDecimal idPlanSerial = null; // clave unica para cada plan de afiliado insertado a afi_plan
		BigDecimal idAporteSerial = null; // clave unica para cada aporte del afiliado insertado a afi_aportes
		
		if(connectionParameter == null){
			con = ConnectionHelper.getConnection();
		}else{
			con = connectionParameter;
		}
		CallableStatement stmtPlan = null;
		CallableStatement stmtAporte = null;
		try {	
			// se hace desde afuera la gran transaccion junto a situ laborales y tercerizadoras
			
			String sqlPlan = "{call inserta_afi_plan(?, ?, ?, ?, ?, ?, ?, ?)}";
							
			stmtPlan = con.prepareCall(sqlPlan.toString());
			stmtPlan.setString(1, afiPlan.getCuil_titular());
			stmtPlan.setInt(2, afiPlan.getInte());
			stmtPlan.setDate(3, new java.sql.Date(afiPlan.getVigenDesde().getTime()));
			// va sin vigen_hasta si es un nuevo plan con vigencia, si es x baja con regla 1, 
			//el plan tiene n meses de vigencia ya establecidos
			if(afiPlan.getVigenHasta() == null){
				stmtPlan.setNull(4, Types.DATE);
				stmtPlan.setNull(5, Types.INTEGER);
			}else{
				stmtPlan.setDate(4, new java.sql.Date(afiPlan.getVigenHasta().getTime()));
				stmtPlan.setInt(5, afiPlan.getMotivoBaja().getId_motivo_baja());
			}
			stmtPlan.setInt(6, afiPlan.getPlan().getId());
			if(afiPlan.getId_plan_omint()>0){
				stmtPlan.setInt(7, afiPlan.getId_plan_omint());
			}else{
				stmtPlan.setNull(7, Types.INTEGER);				
			}
			stmtPlan.setString(8, screenName);
			
			ResultSet rsPlan = stmtPlan.executeQuery(); 
			while (rsPlan.next()) {
				idPlanSerial = rsPlan.getBigDecimal(1);
				
				afiPlan.setId(idPlanSerial.toBigInteger());
				
				if(idPlanSerial != null){
					result = true;
				}
			}
			
			String sqlAporte = "{call inserta_afi_aporte(?, ?, ?, ?, ?, ?, ?, ?, ?, ?) }";		
					 
			boolean debeGenerarIdSocio = false;
			for (Iterator<TipoAporte> iterator = afiPlan.getPlan().getAportes().iterator(); iterator.hasNext();) {
				TipoAporte ta = iterator.next();
			
				debeGenerarIdSocio = aporteGeneraIdsSocio.get(ta.getId_aporte());
				
				stmtAporte = con.prepareCall(sqlAporte.toString());			
				stmtAporte.setBoolean(1, debeGenerarIdSocio);
				stmtAporte.setString(2, afiPlan.getCuil_titular());
				stmtAporte.setInt(3, afiPlan.getInte());
				stmtAporte.setInt(4, ta.getId_aporte());
				stmtAporte.setDate(5, new java.sql.Date(afiPlan.getVigenDesde().getTime()) );
				if(afiPlan.getVigenHasta() == null){
					stmtAporte.setNull(6, Types.DATE);
					stmtAporte.setNull(7, Types.INTEGER);
				}else{
					stmtAporte.setDate(6, new java.sql.Date(afiPlan.getVigenHasta().getTime()));
					stmtAporte.setInt(7, afiPlan.getMotivoBaja().getId_motivo_baja());
				}
				stmtAporte.setBigDecimal(8, idPlanSerial ); //afiPlan.getId().doubleValue()
				stmtAporte.setString(9, ta.getGenera_id_socio()!=null?ta.getGenera_id_socio().toString():"");
				stmtAporte.setString(10, screenName);
				
				ResultSet rsAporte = stmtAporte.executeQuery();
				while (rsAporte.next()) {
					idAporteSerial = rsAporte.getBigDecimal(1);
					
					if(idAporteSerial != null){
						result = result && true;
					}
				} 
			}

		} catch (SQLException e) {
			_log.error("Error al insertar afi_plan y afi_aportes", e);
			throw new SystemException(e);
		} finally {
			ConnectionHelper.cerrar(stmtPlan);
			ConnectionHelper.cerrar(stmtAporte);
			if(connectionParameter == null){
				ConnectionHelper.cerrar(con);
			}
		}
		_log.debug("Resultado insert plan: "+ result +" Afiliado: "+ afiPlan.getCuil_titular() + " ");
		
		return result;
		
	}
	
	/**
	 * actualizaPlanyAportes: inserta un plan con sus aportes para un afiliado. 
	 * genera ids de cada aporte si corresponde y los actualiza al afiliado. 
	 * 
	 * @author sergio 
	 * @param afiPlan
	 * @param screenName
	 * @return boolean si pudo o no transaccionar
	 * @throws SystemException
	 */
	public boolean actualizaPlanyAportes(Connection connectionParameter, AfiPlan afiPlan, Map<Integer,Boolean> aporteGeneraIdsSocio, String screenName) throws SystemException {

		_log.debug("Actualiza Plan: " + afiPlan.getPlan().getId() + " para Afiliado: "+ afiPlan.getCuil_titular());
		
		boolean result = false;
        Connection con = null;
        
		if(connectionParameter == null){
			con = ConnectionHelper.getConnection();
		}else{
			con = connectionParameter;
		}
		CallableStatement stmtPlanYAportes = null;

		try {	
			// se hace desde afuera la gran transaccion junto a situ laborales y tercerizadoras
			String sqlPlanYAportes = "{call actualiza_afi_plan_y_aportes(?, ?, ?, ?, ?)}";
			
			stmtPlanYAportes = con.prepareCall(sqlPlanYAportes.toString());
			stmtPlanYAportes.setDate(1, new java.sql.Date(afiPlan.getVigenDesde().getTime()));
			if(afiPlan.getMotivoBaja() != null){
				stmtPlanYAportes.setInt(2, afiPlan.getMotivoBaja().getId_motivo_baja());
				stmtPlanYAportes.setDate(3, new java.sql.Date(afiPlan.getVigenHasta().getTime()));
			}else{
				stmtPlanYAportes.setNull(2, Types.INTEGER);
				stmtPlanYAportes.setNull(3, Types.DATE);
			}
			
			stmtPlanYAportes.setDouble(4, afiPlan.getId().doubleValue());  // clave unica para cada plan de afiliado insertado a afi_plan
			stmtPlanYAportes.setString(5, screenName);
			
			int updateOk = stmtPlanYAportes.executeUpdate(); 
			
			if(updateOk == 0){
				result = true;
			}

		} catch (SQLException e) {
			_log.error("Error al actualizar afi_plan y afi_aportes", e);
			throw new SystemException(e);
		} finally {
			if(connectionParameter==null){
				ConnectionHelper.cerrar(stmtPlanYAportes,con);
			}else{
				ConnectionHelper.cerrar(stmtPlanYAportes);
			}
		}
		_log.debug("Resultado actualiza plan: "+ result +" Afiliado: "+ afiPlan.getCuil_titular());
		
		return result;
	}
	
	@Deprecated	
	public List<AfiAportes> buscaUltimosIdsSocio(String cuil_titular) throws Exception {
		
		AfiAportes afiAporteOspim, afiAporteUoma, afiAporteAmtima = null;
		List<AfiAportes> aportes = new ArrayList<AfiAportes>();
		
		Connection con = null;
		CallableStatement stmt = null;

		try {
			con = ConnectionHelper.getConnection();

			String sql = "{call consulta_ultimos_ids_socio(?)}";
					
			stmt = con.prepareCall(sql.toString());
			stmt.setString(1, cuil_titular);
				
			ResultSet rs = stmt.executeQuery();
				
			while (rs.next()) { 
				
				afiAporteOspim = new AfiAportes(); 
				afiAporteOspim.setFechaIngre(rs.getDate("f_inicio_id_ospim"));
				afiAporteOspim.setFechaEgre(rs.getDate("f_fin_id_ospim"));
				afiAporteOspim.setIdSocio(rs.getInt("id_ospim"));
				afiAporteOspim.setTipoIdSocio("Ospim");
				afiAporteOspim.setModi_fecha(rs.getDate("modi_fecha_ospim"));
				afiAporteOspim.setModi_usr(rs.getString("modi_user_ospim"));
				
				afiAporteAmtima = new AfiAportes();
				afiAporteAmtima.setFechaIngre(rs.getDate("f_inicio_id_amtima"));
				afiAporteAmtima.setFechaEgre(rs.getDate("f_fin_id_amtima"));
				afiAporteAmtima.setIdSocio(rs.getInt("id_amtima"));
				afiAporteAmtima.setTipoIdSocio("Amtima");
				afiAporteAmtima.setModi_fecha(rs.getDate("modi_fecha_amtima"));
				afiAporteAmtima.setModi_usr(rs.getString("modi_user_amtima"));
				
				afiAporteUoma = new AfiAportes();
				afiAporteUoma.setFechaIngre(rs.getDate("f_inicio_id_uoma"));
				afiAporteUoma.setFechaEgre(rs.getDate("f_fin_id_uoma"));
				afiAporteUoma.setIdSocio(rs.getInt("id_uoma"));
				afiAporteUoma.setTipoIdSocio("Uoma");
				afiAporteUoma.setModi_fecha(rs.getDate("modi_fecha_uoma"));
				afiAporteUoma.setModi_usr(rs.getString("modi_user_uoma"));
				
				
				aportes.add(afiAporteOspim);
				aportes.add(afiAporteAmtima);
				aportes.add(afiAporteUoma);
			}
			
		} catch (SQLException e) {
			_log.error(e);
		} catch (Exception e) {
			_log.error(e);
		} finally {
			ConnectionHelper.cerrar(stmt, con);
		}
		
		return aportes;
	}
	
	public List<AfiAportes> consultaUltimosComponentesPlanVigente(String cuil_titular) throws Exception {
		List<AfiAportes> result = new ArrayList<AfiAportes>();
		AfiAportes aa = null;
		TipoAporte ta = null;
		
		Connection con = null;
		CallableStatement stmt = null;

		try {
			con = ConnectionHelper.getConnection();

			String sql = "{call consulta_ultimos_componentes_plan_vig(?)}";
					
			stmt = con.prepareCall(sql.toString());
			stmt.setString(1, cuil_titular);
				
			ResultSet rs = stmt.executeQuery();
				
			while (rs.next()) { 
				ta = new TipoAporte(rs.getInt("id_aporte"), rs.getString("descripcion"));
				aa = new AfiAportes();
				aa.setAporte(ta);
				aa.setFechaIngre(rs.getDate("fecha_ingre"));
				aa.setFechaEgre(rs.getDate("fecha_egre"));
				aa.setIdSocio(rs.getInt("id_socio"));
				aa.setTipoIdSocio(rs.getString("tipo_aporte"));
				aa.setModi_fecha(rs.getDate("modi_fecha"));
				aa.setModi_usr(rs.getString("modi_usr"));
				
				result.add(aa);
			}
			
		} catch (SQLException e) {
			_log.error(e);
		} catch (Exception e) {
			_log.error(e);
		} finally {
			ConnectionHelper.cerrar(stmt, con);
		}
		
		return result;
	}
	
	
