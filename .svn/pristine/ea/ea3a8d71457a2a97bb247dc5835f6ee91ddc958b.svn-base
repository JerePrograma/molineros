	public List<AfiPlan> historicoPlanyAportes(String cuilTitular) throws Exception {
		
		BigInteger idPlanSerial = null;
		
		List<AfiPlan> historico = null;
		
		AfiPlan ap = null;
		AfiAportes afiAporte = null;
		List<AfiAportes> listaAfiAportes = null;
		Plan plan = null;
		List<TipoAporte> listaAportes = null;
		
		Connection con = null;
//		PreparedStatement stmt = null;
		CallableStatement stmt = null, stmt1 = null;
		
		try {
			con = ConnectionHelper.getConnection();

			String sql = "{call buscar_historico_planes_y_aportes(?)}";
					
			stmt = con.prepareCall(sql.toString());
			stmt.setString(1, cuilTitular);

			ResultSet rs = stmt.executeQuery();
			ResultSet rs1 = null;
			
//			Ahora traemos un plan o varios, por lo tanto debemos hacer la busqueda de aportes por
//			cada plan que venga, y aunque no me guste, sale una consulta por cada uno, mientras recorremos los planes
			historico = new ArrayList<AfiPlan>();
			
			while (rs.next()) { 
				
				ap = AfiPlan.getMappingConMotivoBaja(rs, "afiplan_");
				plan = Plan.getMappingPlanOmint(rs,"plan_");
				
				listaAportes = this.buscaAportesPorPlan(plan.getId());
				plan.setAportes(listaAportes);
				
				ap.setPlan(plan);
				
				idPlanSerial = ap.getId();
				
				sql = "{call buscar_afiaportes_por_afiplan(?)}";
					
				stmt1 = con.prepareCall(sql.toString());
				stmt1.setDouble(1, idPlanSerial.doubleValue());

				rs1 = stmt1.executeQuery();
				
				listaAfiAportes = new ArrayList<AfiAportes>();
				
				while (rs1.next()) { 
					
					afiAporte = AfiAportes.getMapping("afiaporte_",rs1);
					listaAfiAportes.add(afiAporte);
				}
				
				if(listaAfiAportes.size() > 0){
					ap.setAportes(listaAfiAportes);
				}else{
					ap.setAportes(null);
				}
				
				historico.add(ap);
			}

						

		} catch (SQLException e) {
			_log.error(e);
		} catch (Exception e) {
			_log.error(e);
		} finally {
			ConnectionHelper.cerrar(stmt, con);
			ConnectionHelper.cerrar(stmt1);
		}
		
		return historico;
	}
	
