<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="report name" pageWidth="595" pageHeight="842" columnWidth="595" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="336"/>
	<parameter name="id_ini" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select td_id as td_id_tratamiento, td_importe_total,  a_nombre  || ', ' || a_apellido  as afiliado_string,  TO_CHAR(localtimestamp, 'DD/MM/YYYY') as fecha_actual, prestador_string,
n_descripcion, cast (a_docu_numero as character varying) as a_id_ospim, s_descripcion, cast(TO_CHAR(td_periodo_desde,'YYYY') as character varying) as anio_actual,
cast (td_cantidad as numeric) as td_cantidad, TO_CHAR(td_periodo_desde, 'DD/MM/YYYY') as td_periodo_desde,
TO_CHAR(td_periodo_hasta, 'DD/MM/YYYY') as td_periodo_hasta, '(' || td_periodicidad || ')' as td_periodicidad,td_alta_fecha,
coalesce(p.descripcion,'') as plan_molineros,coalesce(po.descripcion_prevencion,'') as plan_tercerizadora,n_codigo,td_cuit,td_razon_soc,td_observaciones,td_nro_autorizacion,td_dependencia,td_discapacitado,coalesce(td_copago,0) as td_copago
from autorizaciones.buscar_autorizacion_prestacional_by_id(cast ($P{id_ini} as integer)) ap
left join afiliado af on ap.a_cuil_titular=af.cuil_titular and ap.a_inte=af.inte
left join afi_plan afp on afp.cuil_titular = ap.a_cuil_titular and 0=afp.inte and
          afp.id in(select max(id) from afi_plan afp1 where afp.cuil_titular=afp1.cuil_titular and 0=afp1.inte)
left join plan p on afp.id_plan=p.id_plan
left join plan_omint po on afp.id_plan=po.id_plan
where td_estado not in(6)]]>
	</queryString>
