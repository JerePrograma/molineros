package ar.com.ospim.procesaArchivos.exception;

public class ArchivoAdmifarmIncorrectoException extends Exception {

    private static final long serialVersionUID = 1L;
    
    private int code;

    public ArchivoAdmifarmIncorrectoException(int code) {
        super();
        this.code = code;
    }

    public ArchivoAdmifarmIncorrectoException(int code, String message) {
        super(message);
        this.code = code;
    }

    public int getCode() {
        return code;
    }
}
