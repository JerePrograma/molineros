	public Integer insertaPreAutorizacion(PreAutorizacion preautorizacion, String screenName,String sector,Integer seccional,Connection connectionParameter) throws SystemException, SQLException {
		Connection con = null;
		CallableStatement stmt = null;

		Integer id_preautorizacion = 0;
		try {
			
			if (connectionParameter == null) {
				con = ConnectionHelper.getConnection();
			} else {
				con = connectionParameter;
			}

			String sql = "{call autorizaciones.inserta_preautorizacion(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)}";
			stmt = con.prepareCall(sql.toString());
			

			if(preautorizacion.getFecha() ==null){
				  stmt.setNull(1, Types.DATE );	
			}else{
				  stmt.setDate(1, new java.sql.Date (preautorizacion.getFecha().getTime()));
			}
			stmt.setString(2, preautorizacion.getAfiliado().getCuil_titular());
			stmt.setInt(3,preautorizacion.getAfiliado().getInte());
			
			if(preautorizacion.getFechaRespuestaPS() ==null){
				  stmt.setNull(4, Types.DATE );	
			}else{
				  stmt.setDate(4, new java.sql.Date (preautorizacion.getFechaRespuestaPS().getTime()));
			}
			
			if(preautorizacion.getFechaNotificacionAfiliado() ==null){
				  stmt.setNull(5, Types.DATE );	
			}else{
				  stmt.setDate(5, new java.sql.Date (preautorizacion.getFechaNotificacionAfiliado().getTime()));
			}
			
			if(preautorizacion.getFechaEntregaRespuesta() ==null){
				  stmt.setNull(6, Types.DATE );	
			}else{
				  stmt.setDate(6, new java.sql.Date (preautorizacion.getFechaEntregaRespuesta().getTime()));
			}
			
			if(preautorizacion.getTipoEntrega() ==null){
				  stmt.setNull(7, Types.VARCHAR );	
			}else{
				  stmt.setString(7,preautorizacion.getTipoEntrega());
			}
			
			stmt.setString(8, screenName);
			
			if(preautorizacion.getObservaciones()==null){
				stmt.setNull(9, Types.VARCHAR );	
			}else{
				stmt.setString(9,preautorizacion.getObservaciones());
			}
			
			if(preautorizacion.getObservacionesTercerizadoras()==null){
				stmt.setNull(10, Types.VARCHAR );	
			}else{
				stmt.setString(10,preautorizacion.getObservacionesTercerizadoras());
			}
			
			if(sector ==null){
				  stmt.setNull(11, Types.VARCHAR );	
			}else{
				  stmt.setString(11,sector);
			}
			
			stmt.setBoolean(12,preautorizacion.isHistoriaClinica());
			stmt.setBoolean(13,preautorizacion.isEstudiosComplementarios());
			stmt.setBoolean(14, preautorizacion.isBiopsia());
			stmt.setBoolean(15, preautorizacion.isAnatomiaPatologica());
			
			if(seccional ==null){
				  stmt.setNull(16, Types.INTEGER );	
			}else{
				  stmt.setInt(16,seccional);
			}
			stmt.setBoolean(17,preautorizacion.isAlertaRoja());
			stmt.setBoolean(18,preautorizacion.isDiscapacidad());
			
			
			if(preautorizacion.getFechaEnvioTercerizadora() ==null){
				  stmt.setNull(19, Types.DATE );	
			}else{
				  stmt.setDate(19, new java.sql.Date (preautorizacion.getFechaEnvioTercerizadora().getTime()));
			}
			
			if(preautorizacion.getFechaRecepcionTercerizadora() ==null){
				  stmt.setNull(20, Types.DATE );	
			}else{
				  stmt.setDate(20, new java.sql.Date (preautorizacion.getFechaRecepcionTercerizadora().getTime()));
			}
			
			stmt.setBoolean(21,preautorizacion.isSupra());
			
			stmt.setBoolean(22,preautorizacion.isMedicamento());
			
			if(preautorizacion.getDiagnostico() ==null){
				  stmt.setNull(23, Types.VARCHAR );	
			}else{
				  stmt.setString(23,preautorizacion.getDiagnostico().getId());
			}
			stmt.setBoolean(24,preautorizacion.isProtesisOrtesis());
			
			stmt.setBoolean(25,preautorizacion.isART());
			
			if(preautorizacion.getPrestador()!=null && preautorizacion.getPrestador().getId_prestador()>0) {
			   stmt.setInt(26,preautorizacion.getPrestador().getId_prestador());
			}else {
			   stmt.setNull(26,Types.INTEGER);	
			}
			
			ResultSet rs = stmt.executeQuery();

			while (rs.next()) {
				id_preautorizacion = rs.getInt(1);
			}
		} catch (SQLException e) {
			_log.error("Error al insertar PreAutorizacion", e);
			throw new SystemException(e);
		} finally {
			if (connectionParameter == null) {
				ConnectionHelper.cerrar(stmt, con);
			}else{
				ConnectionHelper.cerrar(stmt);
			}
		}
		return id_preautorizacion;
	}
	
	public long insertaPreAutorizacionEstado(Integer preautorizacionId,PreAutorizacion preautorizacion,String screenName,Connection connectionParameter) throws SystemException, SQLException {
		Connection con = null;
		CallableStatement stmt = null;

		int id_preautorizacion = 0;
		try {
			if (connectionParameter == null) {
				con = ConnectionHelper.getConnection();
			} else {
				con = connectionParameter;
			}

			String sql = "{call autorizaciones.inserta_preautorizacion_estado(?,?,?,?)}";

			stmt = con.prepareCall(sql.toString());
			
			stmt.setInt(1,preautorizacionId);
			
			if(preautorizacion.getUltimoEstado()  != null && preautorizacion.getUltimoEstado().getId() !=null  ){
				stmt.setString(2,preautorizacion.getUltimoEstado().getId());
			}else{
				stmt.setNull(2, Types.VARCHAR);
			}
			if(preautorizacion.getUltimoEstado()  != null && StringUtils.checkNotEmpty(preautorizacion.getUltimoEstado().getMotivoRechazo()) ){
				stmt.setString(3,preautorizacion.getUltimoEstado().getMotivoRechazo());
			}else{
				stmt.setNull(3, Types.VARCHAR);
			}
			stmt.setString(4, screenName);
			
			ResultSet rs = stmt.executeQuery();

			while (rs.next()) {
				id_preautorizacion = rs.getInt(1);
			}
		} catch (SQLException e) {
			_log.error("Error al insertar preautorizacion - estado ", e);
			throw new SystemException(e);
		} finally {
			if (connectionParameter == null) {
				ConnectionHelper.cerrar(stmt, con);
			}else {
				ConnectionHelper.cerrar(stmt);
			}	
		}
		return id_preautorizacion;
	}

	
