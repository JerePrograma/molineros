	public Integer updatePreautorizacionMedicamento(Integer preAutorizacionMedicamentoId,PreAutorizacionMedicamento detalle,String screenName,Connection connectionParameter) throws SystemException, SQLException {
		Connection con = null;
		CallableStatement stmt = null;
		
		int id_preautorizacion = 0;
		try {
			if (connectionParameter == null) {
				con = ConnectionHelper.getConnection();
			} else {
				con = connectionParameter;
			}

			String sql = "{call autorizaciones.update_preautorizacion_medicamento(?,?,?,?,?)}";

			stmt = con.prepareCall(sql.toString());
			
			stmt.setInt(1,preAutorizacionMedicamentoId);
			
			if(detalle.getCantidad()!=null){
				stmt.setDouble(2, detalle.getCantidad());
			}else{
				stmt.setNull(2,Types.DOUBLE);
			}
			
			if(detalle.getImporte()!=null){
				stmt.setDouble(3, detalle.getImporte());
			}else{
				stmt.setNull(3,Types.DOUBLE);
			}
			
			if(detalle.getFechaBaja() != null){
				stmt.setDate(4,new java.sql.Date(detalle.getFechaBaja().getTime()));
			}else{
				stmt.setNull(4, Types.DATE);
			}
			
			stmt.setString(5, screenName);
			
			ResultSet rs = stmt.executeQuery();

			while (rs.next()) {
				id_preautorizacion = rs.getInt(1);
			}
		} catch (SQLException e) {
			_log.error("Error al actualizar Preautorizacion - medicamento ", e);
			throw new SystemException(e);
		} finally {
			if (connectionParameter == null) {
				ConnectionHelper.cerrar(stmt, con);
			}else{
				ConnectionHelper.cerrar(stmt);
			}
		}
		return id_preautorizacion;
	}
	
	public static int clonarPreautorizacion(int idPreautOrigen, String screenName, String sector, Integer seccional ) throws SystemException {
		Connection con = null;
		CallableStatement stmt = null;
		
		int id_preautorizacion = 0;
		try {
			
			con = ConnectionHelper.getConnection();
			
			String sql = "{call autorizaciones.clonar_preautorizacion(?,?,?,?)}";

			stmt = con.prepareCall(sql.toString());
			
			stmt.setInt(1,idPreautOrigen);
			stmt.setString(2, screenName);
			stmt.setString(3, sector);
			stmt.setInt(4, seccional);
			
			ResultSet rs = stmt.executeQuery();

			while (rs.next()) {
				id_preautorizacion = rs.getInt(1);
			}
		} catch (SQLException e) {
			_log.error("Error al clonar Preautorizacion", e);
			throw new SystemException(e);
		} finally {
			ConnectionHelper.cerrar(stmt, con);
			
		}
		return id_preautorizacion;
	}
	
