	public List<PreAutorizacion> getAlertaPreAutorizaciones()
			throws SystemException {
		Connection con = null;
		CallableStatement stmt = null;
		List<PreAutorizacion> list = null;
		
		String idSeccional=null;
		
		try {
			String sql = "{call autorizaciones.reporte_alerta_preautorizaciones()}";
			con = ConnectionHelper.getConnection();
			stmt = con.prepareCall(sql.toString());
			
			
			ResultSet rs = stmt.executeQuery();
			list = new ArrayList<PreAutorizacion>();
			
			while (rs.next()) {
				PreAutorizacion preAutoriz = new PreAutorizacion();
				
				preAutoriz.setFecha(rs.getDate("fecha"));
				Afiliado afiliado = new Afiliado();
				afiliado.setCuil_titular(rs.getString("cuil_titular"));
				afiliado.setInte(rs.getInt("inte"));
				afiliado.setApellido(rs.getString("apellido"));
				afiliado.setNombre(rs.getString("nombre"));
				afiliado.setDocu_numero(rs.getString("docu_nro"));
				afiliado.setDocumento_tipo(rs.getString("docu_tipo"));
				
				Seccional seccional = new Seccional();
				
				idSeccional="";
				
				try{
				
				  User ur= UserLocalServiceUtil.getUserByScreenName(10112, rs.getString("alta_usr"));	
				  //128003 -- TableId User_
				  //128004 -- Campo Añadido id_seccional de la tabla user_
				  //10112  -- Company
				  ExpandoValue ep =ExpandoValueLocalServiceUtil.getValue(128003, 128004, ur.getUserId());
				  idSeccional = ep.getData();
				  if(idSeccional!=null && !"".equalsIgnoreCase(idSeccional) && !"0".equalsIgnoreCase(idSeccional)){
					  seccional=SeccionalServiceUtil.buscarSeccionalById(Integer.valueOf(idSeccional));
				  }else{
					  seccional.setId_seccional(rs.getInt("seccional_id"));
					  seccional.setDescripcion(rs.getString("seccional_descripcion"));  
				  }
				  
				  for(Organization o:  ur.getOrganizations()){
						if(o.getOrganizationId()==11337){ //OSPIM
						  seccional.setId_seccional(0);
						  seccional.setDescripcion("CENTRAL");
						  break;
						}
				  }
				  
				}catch(Exception e){
				  seccional.setId_seccional(rs.getInt("seccional_id"));
				  seccional.setDescripcion(rs.getString("seccional_descripcion"));
				}
				
				afiliado.setSeccional(seccional);
				AfiPlan afiPlan = new AfiPlan();
				Plan plan = new Plan();
				plan.setId(rs.getInt("plan_id"));
				plan.setDescripcion(rs.getString("descripcion_prevencion"));
				plan.setDescripcionEnsalud(rs.getString("plan_descripcion"));
				plan.setFarmaciaPrevencion(rs.getString("plan_farmacia"));
				afiPlan.setPlan(plan);
				afiliado.setAfiPlan(afiPlan);
				
				preAutoriz.setAfiliado(afiliado);
				preAutoriz.setTipoEntrega(rs.getString("tipo_entrega"));
				
	

				Estado estado = new Estado();
				estado.setId(rs.getString("estado_id"));
				preAutoriz.setUltimoEstado(estado);
				preAutoriz.setId(rs.getInt("id"));
				preAutoriz.setObservaciones(rs.getString("observaciones"));
				preAutoriz.setPrestaciones(rs.getString("prestaciones"));
				preAutoriz.setFechaEmail(rs.getTimestamp("email_fecha"));
				preAutoriz.setAlertaRoja(rs.getBoolean("alerta_roja"));
				preAutoriz.setAlertaRojaFecha(rs.getDate("alerta_roja_fecha"));
				preAutoriz.setDiscapacidad(rs.getBoolean("discapacidad"));
				preAutoriz.setIdAutorizacionWS(rs.getInt("id_autorizacion_ws"));
				preAutoriz.setSupra(rs.getBoolean("supra"));
				preAutoriz.setMedicamento(rs.getBoolean("medicamento"));
				preAutoriz.setCirugia(rs.getBoolean("cirugia"));
				preAutoriz.setART(rs.getBoolean("posible_art"));
				
				list.add(preAutoriz);
			}
		} catch (Exception e) {
			_log.error("Error al buscar Alerta Preautorizacion", e);
			throw new SystemException(e);
		} finally {
			ConnectionHelper.cerrar(stmt, con);
		}
		return list;
	}


