	public List<Estado> getEstadisticoEstados(Date fecha,Date fechaHta)
			throws SystemException {
		Connection con = null;
		CallableStatement stmt = null;
		List<Estado> list = null;
		try {
			String sql = "{call autorizaciones.estadistica_estados(?,?)}";
			con = ConnectionHelper.getConnection();
			stmt = con.prepareCall(sql.toString());
			
			if (null != fecha) {
				stmt.setDate(1,  new java.sql.Date(fecha.getTime()));
			} else {
				stmt.setNull(1, Types.DATE);
			}
			
			if (null != fechaHta) {
				stmt.setDate(2,  new java.sql.Date(fechaHta.getTime()));
			} else {
				stmt.setNull(2, Types.DATE);
			}
			
			ResultSet rs = stmt.executeQuery();
			list = new ArrayList<Estado>();
			while (rs.next()) {
				Estado estado = new Estado();
				estado.setId(rs.getString("estado"));
				estado.setDescripcion(rs.getString("estado_venc"));
				estado.setCantidadOcurrencias(rs.getInt("total"));
				list.add(estado);
			}
		} catch (Exception e) {
			_log.error("Error al buscar Preautorizacion Estadistico Estados", e);
			throw new SystemException(e);
		} finally {
			ConnectionHelper.cerrar(stmt, con);
		}
		return list;
	}
	
