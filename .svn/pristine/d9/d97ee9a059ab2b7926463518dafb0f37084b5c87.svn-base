	public PreAutorizacion buscarPreautorizacionGestionOspimPorId(
			int id,Connection connectionParameter) throws SystemException {

		Connection con = null;
		CallableStatement stmt = null;
		
		if (connectionParameter == null) {
			con = ConnectionHelper.getConnection();
		} else {
			con = connectionParameter;
		}
		
		PreAutorizacion preautorizacion = new PreAutorizacion();
		try {
			
			String sql = "{ call autorizaciones.busca_preautorizacion_gestion_ospim_por_idpreautorizacion(?) }";
			stmt = con.prepareCall(sql.toString());
			stmt.setInt(1, id);
			ResultSet rst = stmt.executeQuery();
			while (rst.next()) {
				//PreAutorizacion pp= new PreAutorizacion();
				preautorizacion.setTipoPedidoGestionOSPIM(rst.getString("tipo_pedido"));
				preautorizacion.setTipoGestionOSPIM(rst.getString("tipo_gestion"));
				preautorizacion.setObservacionesOSPIM(rst.getString("observaciones"));
				preautorizacion.setIdReclamoPrestacional(rst.getInt("reclamoprestacional_id"));
				Estado estado=new Estado();
				estado.setId(rst.getString("estado_id"));
				preautorizacion.setUltimoEstadoOSPIM(estado);
			}
			
			
			
		} catch (Exception e) {
			_log.error("error al buscar Preautorizacion Gestion Ospim por Id", e);
			throw new SystemException(e);
		} finally {
			
			if (connectionParameter == null) {
				ConnectionHelper.cerrar(stmt, con);
			}else{
				ConnectionHelper.cerrar(stmt);
			}
		}
		return preautorizacion;
	}

