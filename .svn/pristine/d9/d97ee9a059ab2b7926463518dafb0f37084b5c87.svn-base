				Estado estado = new Estado(rs.getString("estado_id"),"", 
									rs.getString("motivo_rechazo"),
									rs.getString("observaciones_externas"));
				
				preAutoriz.setUltimoEstado(estado);
				preAutoriz.setId(rs.getInt("id"));
				preAutoriz.setObservaciones(rs.getString("observaciones"));
				preAutoriz.setPrestaciones(rs.getString("prestaciones"));
				preAutoriz.setFechaEmail(rs.getTimestamp("email_fecha"));
				preAutoriz.setDiscapacidad(rs.getBoolean("discapacidad"));
				preAutoriz.setIdAutorizacionWS(rs.getInt("id_autorizacion_ws"));
				preAutoriz.setSupra(rs.getBoolean("supra"));
				preAutoriz.setMedicamento(rs.getBoolean("medicamento"));
				preAutoriz.setCirugia(rs.getBoolean("cirugia"));
				preAutoriz.setART(rs.getBoolean("posible_art"));
				
				list.add(preAutoriz);
			}
		} catch (Exception e) {
			_log.error("Error al buscar Alerta Preautorizacion", e);
			throw new SystemException(e);
		} finally {
			ConnectionHelper.cerrar(stmt, con);
		}
		return list;
	}
	
