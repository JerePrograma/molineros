		return id_preautorizacion;
	}
	
	//metodo para mostrar id de la preautorizacion app en preautorizacion_edit
	public static Integer obtenerIdPreautorizacionAPP(int idPedidoApp) throws SystemException {
        Connection con = null;
        CallableStatement stmt = null;
        try {
            con = ConnectionHelper.getConnection();
            stmt = con.prepareCall("{ ? = call autorizaciones.obtener_id_pedido_app(?) }");
            stmt.registerOutParameter(1, java.sql.Types.INTEGER);
            stmt.setInt(2, idPedidoApp);
            stmt.execute();
            return stmt.getInt(1);
        } catch (Exception e) {
            throw new SystemException("Error al obtener id_pedido_app para preautorizacion id: " + idPedidoApp, e);
        } finally {
            ConnectionHelper.cerrar(stmt, con);
        }
    }
}
