	public static void saveLoteDetalleRespuestaWS(Integer nroLote, RespuestaPreAutorizPSDTO rta, 
			String screenName, Connection connectionParameter) throws Exception {		
		
		Connection con = null;
		CallableStatement stmt = null;

		try {
			
			if (connectionParameter == null) {
				con = ConnectionHelper.getReportesOspimConnection();
			} else {
				con = connectionParameter;
			}

			String sql = "{call autorizaciones.inserta_preautorizacion_lote_detalle_respuesta_ws(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)}";

			stmt = con.prepareCall(sql.toString());

		    
			stmt.setInt(1,nroLote);
			stmt.setString(2,rta.getFinishDate());
			stmt.setString(3, rta.getTributaryCodeNumber());
			stmt.setInt(4, rta.getTransactionId()!=null?rta.getTransactionId():0);
			stmt.setString(5, rta.getAuthorizationProposalNumber().toString());
			stmt.setString(6, rta.getAfiliadoApeyNom());
			stmt.setString(7, rta.getMedicalPractice());
			stmt.setString(8, rta.getMedicalPracticeDescription());
			stmt.setString(9, rta.getMedicalPracticeStatus());
			stmt.setInt(10,rta.getSeccional()!=null?rta.getSeccional().getId_seccional():201);
			stmt.setString(11, rta.getSeccional()!=null?rta.getSeccional().getDescripcion():"no encontrada");
			stmt.setString(12, rta.getAuthorizationStatus());
			stmt.setInt(13, 1);
			stmt.setString(14, rta.getDeleteReason());
			stmt.setString(15, rta.getExternalObservations());
			stmt.setString(16, screenName);
			
			stmt.executeQuery();

			
		} catch (Exception e) {
			_log.error("Error al grabar preautorizacion lote detalle", e);
			throw new SystemException(e);
		} finally {
			if (connectionParameter == null) {
				ConnectionHelper.cerrar(stmt, con);
			}else{
				ConnectionHelper.cerrar(stmt);
			}
		}
		
	}

