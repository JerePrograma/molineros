	public List<PreAutorizacion> getExisteMedicamentoPendiente(Integer idMedicamento,String cuil,Integer inte)
			throws SystemException {
		Connection con = null;
		CallableStatement stmt = null;
		List<PreAutorizacion> list = null;
		try {
			String sql = "{call autorizaciones.busca_preautorizaciones_medicamento_pendiente(?,?,?)}";
			con = ConnectionHelper.getConnection();
			stmt = con.prepareCall(sql.toString());
			
			if (idMedicamento>0) {
				stmt.setInt(1, idMedicamento);
			} else {
				stmt.setNull(1, Types.INTEGER);
			}
			if (null != cuil && cuil.trim().length() > 0) {
				stmt.setString(2, cuil);
			} else {
				stmt.setNull(2, Types.VARCHAR);
			}
			if (inte != null) {
				stmt.setInt(3, inte);
			} else {
				stmt.setNull(3, Types.INTEGER);
			}
			
			
			ResultSet rs = stmt.executeQuery();
			list = new ArrayList<PreAutorizacion>();
			while (rs.next()) {
				PreAutorizacion archivo = new PreAutorizacion();
				archivo.setId(rs.getInt("id"));
				list.add(archivo);
			}
		} catch (Exception e) {
			_log.error("Error al buscar Preautorizacion Medicacion Pendiente", e);
			throw new SystemException(e);
		} finally {
			ConnectionHelper.cerrar(stmt, con);
		}
		return list;
	}
	
