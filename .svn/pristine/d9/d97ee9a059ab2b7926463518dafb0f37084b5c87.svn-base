			if (null != cuil && cuil.trim().length() > 0) {
				stmt.setString(1, cuil);
			} else {
				stmt.setNull(1, Types.VARCHAR);
			}
			if (null != inte) {
				stmt.setInt(2, inte);
			} else {
				stmt.setNull(2, Types.INTEGER);
			}
			ResultSet rs = stmt.executeQuery();
			while (rs.next()) {
				validaPlan = rs.getBoolean(1);
