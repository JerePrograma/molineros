	}
	
	public List<EstadisticaPrestAutorizada> estadisticaPrestacionesAutorizadas(Date periodo)throws SystemException {
		
		Connection con = null;
		CallableStatement stmt = null;
		List<EstadisticaPrestAutorizada> lista = null;
		
		try {
			String sql = "{call autorizaciones.estadistica_respuesta_prevencion(?)}";
			con = ConnectionHelper.getConnection();
			stmt = con.prepareCall(sql.toString());

			stmt.setDate(1, new java.sql.Date(periodo.getTime()));

			ResultSet rs = stmt.executeQuery();
			lista = new ArrayList<EstadisticaPrestAutorizada>();
			while (rs.next()) {
				EstadisticaPrestAutorizada epa = EstadisticaPrestAutorizada.getMapping("", rs);
				lista.add(epa);
			}
		} catch (Exception e) {
			_log.error("Error en reporte prestaciones autorizadas por PS", e);
			throw new SystemException(e);
		} finally {
			ConnectionHelper.cerrar(stmt, con);
		}
		return lista;
	}
	
	public long updatePreAutorizacionAlojamiento(Integer preautorizacionId,PreAutorizacion preautorizacion,String screenName,Connection connectionParameter) throws SystemException, SQLException {
		Connection con = null;
		CallableStatement stmt = null;

		int id_preautorizacion = 0;
		try {
			if (connectionParameter == null) {
				con = ConnectionHelper.getConnection();
			} else {
				con = connectionParameter;
			}

			String sql = "{call autorizaciones.update_preautorizacion_alojamiento(?,?,?,?,?)}";

			stmt = con.prepareCall(sql.toString());
			
			stmt.setInt(1,preautorizacionId);
			
			stmt.setBoolean(2, preautorizacion.isAlojamiento());
			
			if (preautorizacion.isAlojamiento() ) {
				stmt.setDate(3,  new java.sql.Date(preautorizacion.getAlojamientoDesde().getTime()));
				stmt.setDate(4,  new java.sql.Date(preautorizacion.getAlojamientoHasta().getTime()));
			} else {
				stmt.setNull(3, Types.DATE);
				stmt.setNull(4, Types.DATE);
			}
			stmt.setString(5, screenName);
			
			ResultSet rs = stmt.executeQuery();

			while (rs.next()) {
				id_preautorizacion = rs.getInt(1);
			}
		} catch (SQLException e) {
			_log.error("Error al update preautorizacion - alojamiento ", e);
			throw new SystemException(e);
		} finally {
			if (connectionParameter == null) {
				ConnectionHelper.cerrar(stmt, con);
			}else {
				ConnectionHelper.cerrar(stmt);
			}	
		}
		return id_preautorizacion;
	}

	public boolean existeWSPendiente(Integer preautorizacion_id) throws SystemException {
		Connection con = null;
		CallableStatement stmt = null;
		boolean pendiente = false;
		try {
			String sql = "{call autorizaciones.preautorizaciones_ws_pendiente(?)}";
			con = ConnectionHelper.getConnection();
			stmt = con.prepareCall(sql.toString());
			
			if (null != preautorizacion_id) {
				stmt.setInt(1, preautorizacion_id);
			} else {
				stmt.setNull(1, Types.INTEGER);
			}
			ResultSet rs = stmt.executeQuery();
			while (rs.next()) {
				pendiente = rs.getBoolean(1);
			}
		} catch (Exception e) {
			_log.error("Error al validar ws pendiente preautorizaciones", e);
		} finally {
			ConnectionHelper.cerrar(stmt, con);
		}
		return pendiente;
	}

