	public FooterOSAportes(String line, boolean tieneTn) throws ParseException {

		SimpleDateFormat sdf = new SimpleDateFormat("yyyyMMdd");
		this.tipo_registro = line.substring(0, 2);
		this.codigo_archivo = line.substring(2, 12);
		this.subcodigo_archivo = line.substring(12, 16);
		this.uso_futuro1 = line.substring(16, 22);
		this.fecha_proceso = sdf.parse(line.substring(22, 30));
		this.hora_proceso = line.substring(30, 36);
		this.cantidad_registros = Integer.parseInt(line.substring(36, 45));
		this.importe_total = new BigDecimal(line.substring(45, 58) + "."
				+ line.substring(58, 60));
		this.debito_credito1 = line.substring(60, 61).trim();
		
		if (debito_credito1!= null && debito_credito1.trim().toUpperCase().equals("D")){
			importe_total = importe_total.negate();
		}
		
		String cant_reg_tn = line.substring(61, 68).trim();
		if (cant_reg_tn.equals("")) {
			cant_reg_tn = "0";
		}
		this.cantidad_reg_tn = Integer.parseInt(cant_reg_tn);
		String cant_trf = line.substring(68, 75).trim();
		if (cant_trf.equals("")) {
			cant_trf = "0";
		}
		if (tieneTn) {
			this.cantidad_trf_nominada = Integer.parseInt(cant_trf);
			String importeParte1 = line.substring(75, 88).trim();
			String importeParte2 = line.substring(88, 90).trim();
			if (importeParte1.equals("")) {
				importeParte1 = "0";
			}
			if (importeParte2.equals("")) {
				importeParte2 = "0";
			}
			this.importe_trf_nom = new BigDecimal(importeParte1 + "."
					+ importeParte2);
		} else {
			cantidad_trf_nominada = Integer.parseInt("0");
			importe_trf_nom = new BigDecimal("0");
		}
		this.debito_credito2 = line.substring(90, 91).trim();
		if (line.length() > 91) {
			this.uso_futuro2 = line.substring(91, 94).trim();
		}
		if (line.length() > 94) {
			this.high_value = line.substring(94, 100).trim();
		}
		
		if (debito_credito2!= null && debito_credito2.trim().toUpperCase().equals("D")){
			importe_trf_nom = importe_trf_nom.negate();
		}
	}

	
	public String getTipo_registro() {
		return tipo_registro;
	}

	public void setTipo_registro(String tipoRegistro) {
		tipo_registro = tipoRegistro;
	}

	public String getCodigo_archivo() {
		return codigo_archivo;
	}

	public void setCodigo_archivo(String codigoArchivo) {
		codigo_archivo = codigoArchivo;
	}

	public String getSubcodigo_archivo() {
		return subcodigo_archivo;
	}

	public void setSubcodigo_archivo(String subcodigoArchivo) {
		subcodigo_archivo = subcodigoArchivo;
	}

	public String getUso_futuro1() {
		return uso_futuro1;
	}

	public void setUso_futuro1(String usoFuturo1) {
