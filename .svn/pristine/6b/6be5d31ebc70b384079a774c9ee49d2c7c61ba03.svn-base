public class CentroCostoServiceImpl {
	private static Log _log = LogFactoryUtil.getLog(CentroCostoServiceImpl.class);

	private static CentroCostoServiceImpl instance = null;

	public static CentroCostoServiceImpl getInstance() {
		if (null == instance) {
			instance = new CentroCostoServiceImpl();
		}
		return instance;
	}

	public Integer add(CentroCosto centroCosto, String screenName,int entidad,Connection connectionParameter) throws SystemException, SQLException {
		Connection con = null;
		CallableStatement stmt = null;
		
		if (connectionParameter == null) {
			con = ConnectionHelper.getConnection();			
		} else {
			con = connectionParameter;
		}
		
		Integer id_centroCosto = 0;
		try {
			
			String sql ="";
			if(entidad==WebKeysGlobal.OSPIM){
				sql = "{call inserta_centro_costo(?,?,?,?,?,?,?)}";	
			}else if(entidad==WebKeysGlobal.UOMA){
				sql = "{call uoma.inserta_centro_costo(?,?,?,?,?,?,?)}";	
			}else if(entidad==WebKeysGlobal.AMTIMA){
				sql = "{call inserta_centro_costo_amtima(?,?,?,?,?,?,?)}";	
			}
			stmt = con.prepareCall(sql.toString());
			
			stmt.setString(1,centroCosto.getDescripcion());
			stmt.setString(2, centroCosto.getObservaciones());
			stmt.setDouble(3, centroCosto.getPresupuesto());
			stmt.setDate(4,new java.sql.Date(centroCosto.getVigenciaDde().getTime()));
			
			if(centroCosto.getVigenciaHta()!=null){
				stmt.setDate(5,new java.sql.Date(centroCosto.getVigenciaHta().getTime()));
			}else{
				stmt.setNull(5,Types.DATE);
			}
			stmt.setString(6,screenName);
			stmt.setBoolean(7, centroCosto.getEsContable());
			
			ResultSet rs = stmt.executeQuery();
			while (rs.next()) {
				id_centroCosto = rs.getInt(1);
			}
		} catch (SQLException e) {
			_log.error("Error al insertar Centro de Costo", e);
			throw new SystemException(e);
		} finally {
			if (connectionParameter == null) {
				ConnectionHelper.cerrar(stmt, con);
			}else{
				ConnectionHelper.cerrar(stmt);
			}
		}
		return id_centroCosto;
	}
	
	public List<CentroCosto> list(String descripcion,int entidad,int id,Boolean contable,Connection connectionParameter)
			throws SystemException {
		Connection con = null;
		CallableStatement stmt = null;
		List<CentroCosto> list = null;
		try {
			String sql = "";
			if(entidad==WebKeysGlobal.OSPIM){
				sql = "{call trae_centros_costos(?,?,?)}";
			}
			if(entidad==WebKeysGlobal.UOMA){
				sql = "{call uoma.trae_centros_costos(?,?,?)}";
			}
			
			if(entidad==WebKeysGlobal.AMTIMA){
				sql = "{call trae_centros_costos_amtima(?,?,?)}";
			}
			
			if (connectionParameter == null) {
				con = ConnectionHelper.getConnection();			
			} else {
				con = connectionParameter;
			}
			
			stmt = con.prepareCall(sql.toString());
			
			if (null != descripcion && descripcion.trim().length() > 0) {
				stmt.setString(1, descripcion);
			} else {
				stmt.setNull(1, Types.VARCHAR);
			}
			if (id>0) {
				stmt.setInt(2,id);
			} else {
				stmt.setNull(2, Types.INTEGER);
			}
			if (contable!=null) {
				stmt.setBoolean(3, contable);
			} else {
				stmt.setNull(3, Types.BOOLEAN);
			}
			
			ResultSet rs = stmt.executeQuery();
			list = new ArrayList<CentroCosto>();
			while (rs.next()) {
				CentroCosto archivo = CentroCosto.getMapping(rs);
				list.add(archivo);
			}
		} catch (Exception e) {
			_log.error("Error al buscar Centros de Costo", e);
			throw new SystemException(e);
		} finally {
			
			if (connectionParameter == null) {
				ConnectionHelper.cerrar(stmt, con);
			}else{
				ConnectionHelper.cerrar(stmt);
			}
			
			
		}
		return list;
	}
	
	public Integer update(CentroCosto centroCosto, String screenName,int entidad,Connection connectionParameter) throws SystemException, SQLException {
		Connection con = null;
		CallableStatement stmt = null;
		
		if (connectionParameter == null) {
			con = ConnectionHelper.getConnection();			
		} else {
			con = connectionParameter;
		}
		
		Integer id_centroCosto = 0;
		try {
			
			String sql ="";
			if(entidad==WebKeysGlobal.OSPIM){
				sql = "{call update_centro_costo(?,?,?,?,?,?,?,?)}";	
			}else if(entidad==WebKeysGlobal.UOMA){
				sql = "{call uoma.update_centro_costo(?,?,?,?,?,?,?,?)}";	
			}else if(entidad==WebKeysGlobal.AMTIMA){
				sql = "{call update_centro_costo_amtima(?,?,?,?,?,?,?,?)}";	
			}
			stmt = con.prepareCall(sql.toString());
			
			stmt.setInt(1, centroCosto.getId());
			stmt.setString(2, centroCosto.getDescripcion());
			stmt.setDouble(3,centroCosto.getPresupuesto() );
			stmt.setDate(4,new java.sql.Date(centroCosto.getVigenciaDde().getTime()));
			if(centroCosto.getVigenciaHta()!=null){
				stmt.setDate(5,new java.sql.Date(centroCosto.getVigenciaHta().getTime()));
			}else{
				stmt.setNull(5,Types.DATE);
			}
			stmt.setString(6, centroCosto.getObservaciones());
			stmt.setString(7,screenName);
			stmt.setBoolean(8, centroCosto.getEsContable());
			
			ResultSet rs = stmt.executeQuery();

			while (rs.next()) {
				id_centroCosto = rs.getInt(1);
			}
		} catch (SQLException e) {
			_log.error("Error al modificar Centro Costo", e);
			throw new SystemException(e);
		} finally {
			if (connectionParameter == null) {
				ConnectionHelper.cerrar(stmt, con);
			}else{
				ConnectionHelper.cerrar(stmt);
			}
		}
		return id_centroCosto;
	}

	public Integer delete(Integer idCentroCosto, String screenName,int entidad,Connection connectionParameter) throws SystemException, SQLException {
		Connection con = null;
		CallableStatement stmt = null;
		
		if (connectionParameter == null) {
			con = ConnectionHelper.getConnection();			
		} else {
			con = connectionParameter;
		}
		
		Integer id_centroCosto = 0;
		try {
			
			String sql ="";
			if(entidad==WebKeysGlobal.OSPIM){
				sql = "{call delete_centro_costo_por_id(?)}";	
			}else if(entidad==WebKeysGlobal.UOMA){
				sql = "{call uoma.delete_centro_costo(?,?)}";	
			}else if(entidad==WebKeysGlobal.AMTIMA){
				sql = "{call delete_centro_costo_por_id_amtima(?)}";	
			}
			stmt = con.prepareCall(sql.toString());
			
			stmt.setInt(1, idCentroCosto);
			if(entidad==WebKeysGlobal.UOMA){
			   stmt.setString(2,screenName);
			}
			ResultSet rs = stmt.executeQuery();

			while (rs.next()) {
				id_centroCosto = rs.getInt(1);
			}
		} catch (SQLException e) {
			_log.error("Error al eliminar Centro Costo", e);
			throw new SystemException(e);
		} finally {
			if (connectionParameter == null) {
				ConnectionHelper.cerrar(stmt, con);
			}else{
				ConnectionHelper.cerrar(stmt);
			}
		}
		return id_centroCosto;
	}

	public List<ComprobanteCajaChica> comprobantesPorCentroCosto(int id,int entidad,Connection connectionParameter)
			throws SystemException {
		Connection con = null;
		CallableStatement stmt = null;
		List<ComprobanteCajaChica> list = null;
		try {
			String sql = "";
			if(entidad==WebKeysGlobal.OSPIM){
			}
			if(entidad==WebKeysGlobal.UOMA){
				sql = "{call uoma.trae_comprobantes_centro_costo_por_id(?)}";
			}
			
			if (connectionParameter == null) {
				con = ConnectionHelper.getConnection();			
			} else {
				con = connectionParameter;
			}
			
			stmt = con.prepareCall(sql.toString());
			
			if (id>0) {
				stmt.setInt(1,id);
			} else {
				stmt.setNull(1, Types.INTEGER);
			}
			
			ResultSet rs = stmt.executeQuery();
			list = new ArrayList<ComprobanteCajaChica>();
			while (rs.next()) {
                ComprobanteCajaChica archivo = new ComprobanteCajaChica(); 	
                archivo.setConceptos(new ArrayList<ComprobanteConcepto>());
                
                archivo.setFechaEmision(rs.getDate("fecha_emision"));
                archivo.setTipoComprobante(rs.getString("tipo"));
                archivo.setPtoVenta(rs.getInt("id_punto_venta"));
                archivo.setLetraComprobante(rs.getString("compro_letra"));
                archivo.setNroComprobante(rs.getString("nro"));
                archivo.setCuit(rs.getString("cuit_acreedor"));
                archivo.setSucuComprobante(rs.getInt("sucu_acreedor"));
                
                Empresa empresa = new Empresa();
                empresa.setRazon_soc(rs.getString("razon_social"));
                archivo.setAcreedorEmpresa(empresa);
                
                ComprobanteConcepto concepto = new ComprobanteConcepto(new Concepto(rs.getInt("concepto_id"),rs.getString("concepto_descripcion")));
        		archivo.getConceptos().add(concepto);
              
                archivo.setImporteComprobante(rs.getBigDecimal("importe_comprobante"));
                archivo.setOrdenPago(rs.getInt("origen"));
				list.add(archivo);
			}
		} catch (Exception e) {
			_log.error("Error al buscar Comprobantes de Centros de Costo", e);
			throw new SystemException(e);
		} finally {
			
			if (connectionParameter == null) {
				ConnectionHelper.cerrar(stmt, con);
			}else{
				ConnectionHelper.cerrar(stmt);
			}
			
			
		}
		return list;
	}
	
	public List<ComprobanteCajaChica> comprobantesPorCentroCostoOffset(int id,int entidad,int offset,Connection connectionParameter)
			throws SystemException {
		Connection con = null;
		CallableStatement stmt = null;
		List<ComprobanteCajaChica> list = null;
		try {
			String sql = "";
			if(entidad==WebKeysGlobal.OSPIM){
			}
			if(entidad==WebKeysGlobal.UOMA){
				sql = "{call uoma.trae_comprobantes_centro_costo_por_id_offset(?,?)}";
			}
			
			if (connectionParameter == null) {
				con = ConnectionHelper.getConnection();			
			} else {
				con = connectionParameter;
			}
			
			stmt = con.prepareCall(sql.toString());
			
			if (id>0) {
				stmt.setInt(1,id);
			} else {
				stmt.setNull(1, Types.INTEGER);
			}
			stmt.setInt(2,offset);
			
			ResultSet rs = stmt.executeQuery();
			list = new ArrayList<ComprobanteCajaChica>();
			while (rs.next()) {
                ComprobanteCajaChica archivo = new ComprobanteCajaChica(); 	
                archivo.setConceptos(new ArrayList<ComprobanteConcepto>());
                
                archivo.setFechaEmision(rs.getDate("fecha_emision"));
                archivo.setTipoComprobante(rs.getString("tipo"));
                archivo.setPtoVenta(rs.getInt("id_punto_venta"));
                archivo.setLetraComprobante(rs.getString("compro_letra"));
                archivo.setNroComprobante(rs.getString("nro"));
                archivo.setCuit(rs.getString("cuit_acreedor"));
                archivo.setSucuComprobante(rs.getInt("sucu_acreedor"));
                
                Empresa empresa = new Empresa();
                empresa.setRazon_soc(rs.getString("razon_social"));
                archivo.setAcreedorEmpresa(empresa);
                
                ComprobanteConcepto concepto = new ComprobanteConcepto(new Concepto(rs.getInt("concepto_id"),rs.getString("concepto_descripcion")));
        		archivo.getConceptos().add(concepto);
              
                archivo.setImporteComprobante(rs.getBigDecimal("importe_comprobante"));
                archivo.setTotalRegistros(rs.getInt("total_registros"));
                archivo.setOrdenPago(rs.getInt("origen"));
				list.add(archivo);
			}
		} catch (Exception e) {
			_log.error("Error al buscar Comprobantes de Centros de Costo", e);
			throw new SystemException(e);
		} finally {
			
			if (connectionParameter == null) {
				ConnectionHelper.cerrar(stmt, con);
			}else{
				ConnectionHelper.cerrar(stmt);
			}
			
			
		}
		return list;
	}

