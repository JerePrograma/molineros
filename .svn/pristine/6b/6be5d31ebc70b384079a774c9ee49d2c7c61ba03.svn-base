	public List<CentroCosto> getContables(Date fecha,int entidad,Connection connectionParameter)
			throws SystemException {
		Connection con = null;
		CallableStatement stmt = null;
		List<CentroCosto> list = null;
		try {
			String sql = "";
			if(entidad==WebKeysGlobal.OSPIM){
				sql = "{call trae_centros_costos_contables(?)}";
			}
			if(entidad==WebKeysGlobal.UOMA){
				sql = "{call uoma.trae_centros_costos_contables(?)}";
			}
			
			if(entidad==WebKeysGlobal.AMTIMA){
				sql = "{call trae_centros_costos_contables_amtima(?)}";
			}
			
			if (connectionParameter == null) {
				con = ConnectionHelper.getConnection();			
			} else {
				con = connectionParameter;
			}
			
			stmt = con.prepareCall(sql.toString());
			
			stmt.setDate(1, new java.sql.Date(fecha.getTime()));
			
			ResultSet rs = stmt.executeQuery();
			list = new ArrayList<CentroCosto>();
			while (rs.next()) {
				CentroCosto archivo = CentroCosto.getMapping(rs);
				list.add(archivo);
			}
		} catch (Exception e) {
			_log.error("Error al buscar Centros de Costo contables", e);
			throw new SystemException(e);
		} finally {
			
			if (connectionParameter == null) {
				ConnectionHelper.cerrar(stmt, con);
			}else{
				ConnectionHelper.cerrar(stmt);
			}
			
			
		}
		return list;
	}
	
    public static List<CentroCosto> getCentroCostosReporteFinal(String entidad){
		
		Connection con = null;
		List <CentroCosto> listaCentroCosto = null;
		CallableStatement stmt = null;
		
		try {
			
			String sql = "";
			if(Integer.parseInt(entidad)==WebKeysGlobal.OSPIM) {
				sql = "{call trae_centros_costos_reporte_final_ospim()}";
			}else if(Integer.parseInt(entidad)==WebKeysGlobal.UOMA) {
				sql = "{call uoma.trae_centros_costos_reporte_final()}";
			}else if(Integer.parseInt(entidad)==WebKeysGlobal.AMTIMA) {
				sql = "{call trae_centros_costos_reporte_final_amtima()}";
			}
			
			con = ConnectionHelper.getConnection();
			stmt = con.prepareCall(sql.toString());
			
			ResultSet rs = stmt.executeQuery();
			listaCentroCosto = new ArrayList<CentroCosto>();
			
			while(rs.next()) {
				CentroCosto cc = CentroCosto.getMapping(rs);
				listaCentroCosto.add(cc);
			}
			
		}catch(Exception e) {
			
			_log.error(e);
		}
		
		return listaCentroCosto;
	}
	
}
