CREATE TABLE tipo_nomenclador (
    id_tipo_nomenclador integer NOT NULL,
    descripcion character varying(150) NOT NULL,
    cod_tipo_nomenclador character(2)
);


ALTER TABLE public.tipo_nomenclador OWNER TO postgres;

SET default_with_oids = true;

--
ALTER TABLE ONLY tipo_nomenclador
    ADD CONSTRAINT pk_tipo_nomenclador PRIMARY KEY (id_tipo_nomenclador);


