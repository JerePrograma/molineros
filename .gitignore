# --- Sistema operativo ---
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
.Spotlight-V100/
.Trashes/

# --- Temporales de editores ---
*~
*.swp
*.swo
*.tmp

# --- IDEs / editores ---
# NO ignorar .idea completa: puede tener configuraci�n �til del proyecto.
# Se ignoran solo archivos vol�tiles/locales.
.vscode/
