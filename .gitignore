# ------------------------------------------------------------
# OSPIM / Liferay ext (Ant) - ignores solo de artefactos locales
# ------------------------------------------------------------

# --- Sistema operativo ---
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
.Spotlight-V100/
.Trashes/

# --- Archivos temporales de editores ---
*~
*.swp
*.swo
*.tmp

# --- IDEs / editores ---
.vscode/

# IntelliJ IDEA: este repo ya versiona gran parte de .idea,
# por eso solo se ignoran archivos de estado local.
.idea/workspace.xml
.idea/tasks.xml
.idea/shelf/
.idea/httpRequests/
.idea/dataSources/
.idea/dataSources.local.xml

# Eclipse / STS
.classpath
.project
.settings/

# NetBeans
nbproject/private/

# --- Build local / salidas temporales ---
**/tmp/
**/work/
**/logs/

out/
target/
build/
output/

# --- Reportes y volcados de runtime ---
*.log
hs_err_pid*
replay_pid*

# --- Cobertura / análisis ---
coverage/
.coverage

# --- Tooling local opcional ---
.gradle/
node_modules/

# --- Archivos de entorno local ---
.env
.env.*
*.local

# --- Java / build artifacts ---
*.class
*.ser
*.jar

# --- Liferay EXT deploy/build local ---
/ext-impl/classes/
/ext-impl/ext-impl.jar
/ext-service/ext-service.jar

# --- Backups locales generados por scripts ---
_backup_*/
*.bak
*.bak-*
*.backup
*.backup-*