# ------------------------------------------------------------
# OSPIM / Liferay EXT (Ant)
# Ignorar basura local/generada + exclusiones completas pedidas.
# ------------------------------------------------------------

# --- Sistema operativo ---
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
.Spotlight-V100/
.Trashes/

# --- Temporales de editores ---
*~
*.swp
*.swo
*.tmp

# --- IDEs / editores ---
# NO ignorar .idea completa: puede tener configuración útil del proyecto.
# Se ignoran solo archivos volátiles/locales.
.vscode/
.recommenders/

.idea/workspace.xml
.idea/tasks.xml
.idea/shelf/
.idea/httpRequests/
.idea/dataSources/
.idea/dataSources.local.xml
.idea/sonarlint/
.idea/caches/

# Eclipse / STS: normalmente local, no del proyecto.
.classpath
.project
.settings/

# NetBeans
nbproject/private/

# SVN legacy
.svn/

# --- Build local / salidas generadas ---
out/
target/
build/
output/
**/output/
**/classes/

**/tmp/
**/work/
**/logs/

# --- Reportes y volcados de runtime ---
*.log
hs_err_pid*
replay_pid*

# --- Cobertura / análisis ---
coverage/
.coverage

# --- Tooling local opcional ---
.gradle/
node_modules/

# --- Java / build artifacts generados ---
*.class
*.ser

# No ignorar *.jar globalmente:
# en este proyecto legacy puede haber JARs necesarios en lib/, ext-lib/, etc.

# No ignorar *.war globalmente:
# ROOT.war queda trackeable si decidís versionarlo.

# Artefactos puntuales generados por Liferay EXT
/ext-impl/ext-impl.jar
/ext-service/ext-service.jar
/ext-web/docroot/WEB-INF/classes/
ext-web/docroot/WEB-INF/classes/

# --- Backups locales generados por scripts ---
_backup_*/
*.bak
*.bak-*
*.backup
*.backup-*

# --- Archivos de entorno sensibles genéricos ---
# OJO: no se ignora app.server.* porque en este repo querés trackear deploy local explícito.
.env
.env.*
*.local

# --- Reportes locales de auditoría ---
tracked-build-properties-audit.txt

# ------------------------------------------------------------
# Exclusiones completas pedidas
# ------------------------------------------------------------

# Runtime / bundles locales
/bundles/

# Scripts SQL completos
/sql-scripts/

# ------------------------------------------------------------
# Exclusiones completas adicionales
# ------------------------------------------------------------

# SQL legacy/base completo
/sql/

# Tests locales / pruebas legacy
/test/

# Archivos puntuales/versiones generadas o locales
/lib/versions.xml

# PDFs de prueba dentro de src
/ext-impl/src/ar/com/ospim/test/*.pdf

.editorconfig
