				<text><![CDATA[No válido como credencial]]></text>
			</staticText>
			<image>
				<reportElement x="9" y="5" width="106" height="22"/>
				<imageExpression class="java.lang.String"><![CDATA[$P{SUBREPORT_DIR} + "logo_ospim.jpg"]]></imageExpression>
			</image>
			<image>
				<reportElement x="160" y="8" width="87" height="22"/>
				<imageExpression class="java.lang.String"><![CDATA[$P{SUBREPORT_DIR} + $F{logo}]]></imageExpression>
			</image>
		</band>
	</detail>
</jasperReport>
