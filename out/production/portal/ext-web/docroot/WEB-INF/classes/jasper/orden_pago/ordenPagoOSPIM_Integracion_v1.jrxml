<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ordenPagoOSPIM_Integracion_v1" pageWidth="595" pageHeight="842" columnWidth="595" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="P_INI" class="java.lang.String"/>
	<parameter name="P_FIN" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["./"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select o.*,(select id_cert from trae_comprobante_retencion_ganancias(o.id_orden_pago,2) ),
(select true from comprobante_orden_pago_ospim where compro_tipo='NDB' and id_orden_pago_ospim=o.id_orden_pago limit 1)
as tieneNotaDebito
from orden_pago_ospim o
where id_orden_pago>=cast($P{P_INI}as Integer) and id_orden_pago <= cast($P{P_FIN} as Integer)
order by o.id_orden_pago desc;]]>
	</queryString>
	<field name="id_orden_pago" class="java.lang.Integer"/>
	<field name="importe" class="java.math.BigDecimal"/>
	<field name="a_favor_de" class="java.lang.String"/>
	<field name="fecha" class="java.sql.Timestamp"/>
	<field name="alta_fecha" class="java.sql.Timestamp"/>
	<field name="alta_usr" class="java.lang.String"/>
	<field name="alta_ip" class="java.lang.String"/>
	<field name="modi_fecha" class="java.sql.Timestamp"/>
	<field name="modi_usr" class="java.lang.String"/>
	<field name="modi_ip" class="java.lang.String"/>
	<field name="baja_fecha" class="java.sql.Timestamp"/>
	<field name="baja_usr" class="java.lang.String"/>
	<field name="baja_ip" class="java.lang.String"/>
	<field name="concepto" class="java.lang.String"/>
	<field name="cuitcuil" class="java.lang.String"/>
	<field name="afiliado_razon_social" class="java.lang.String"/>
	<field name="id_seccional" class="java.lang.Integer"/>
	<field name="prestador" class="java.lang.Boolean"/>
	<field name="observaciones" class="java.lang.String"/>
	<field name="cuit_acreedor" class="java.lang.String"/>
	<field name="sucu_acreedor" class="java.lang.String"/>
	<field name="farmacia" class="java.lang.Boolean"/>
	<field name="descuento" class="java.math.BigDecimal"/>
	<field name="descuento_por_drogueria" class="java.math.BigDecimal"/>
	<field name="fecha_desde" class="java.sql.Timestamp"/>
	<field name="fecha_hasta" class="java.sql.Timestamp"/>
	<field name="id_lote" class="java.lang.Integer"/>
	<field name="destino" class="java.lang.String"/>
	<field name="obs_interna" class="java.lang.String"/>
	<field name="id_cert" class="java.lang.String"/>
	<field name="tienenotadebito" class="java.lang.Boolean"/>
	<background>
		<band height="791">
			<printWhenExpression><![CDATA[1==0]]></printWhenExpression>
			<frame>
				<reportElement x="20" y="90" width="556" height="692">
					<printWhenExpression><![CDATA[$F{id_cert}==null || "".equalsIgnoreCase($F{id_cert})]]></printWhenExpression>
				</reportElement>
				<box>
					<pen lineWidth="1.0"/>
					<topPen lineWidth="0.0"/>
					<leftPen lineWidth="1.0"/>
					<bottomPen lineWidth="1.0"/>
					<rightPen lineWidth="1.0"/>
				</box>
			</frame>
		</band>
	</background>
	<detail>
		<band height="45">
			<subreport runToBottom="true">
				<reportElement stretchType="RelativeToBandHeight" x="0" y="0" width="595" height="45" isRemoveLineWhenBlank="true"/>
				<subreportParameter name="SUBREPORT_DIR">
					<subreportParameterExpression><![CDATA[$P{SUBREPORT_DIR}]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="ID_ORDEN_PAGO">
					<subreportParameterExpression><![CDATA[$F{id_orden_pago}.toString()]]></subreportParameterExpression>
				</subreportParameter>
				<connectionExpression><![CDATA[$P{REPORT_CONNECTION}]]></connectionExpression>
				<subreportExpression class="java.lang.String"><![CDATA[$P{SUBREPORT_DIR} + "ordenPagoOSPIM.jasper"]]></subreportExpression>
			</subreport>
		</band>
		<band height="37" splitType="Stretch">
			<printWhenExpression><![CDATA[$F{id_cert}!=null && !"".equalsIgnoreCase($F{id_cert})]]></printWhenExpression>
			<subreport runToBottom="true">
				<reportElement x="0" y="0" width="595" height="37" isRemoveLineWhenBlank="true"/>
				<subreportParameter name="SUBREPORT_DIR">
					<subreportParameterExpression><![CDATA[$P{SUBREPORT_DIR}]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="entidad_p">
					<subreportParameterExpression><![CDATA["2"]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="id_op_p">
					<subreportParameterExpression><![CDATA[$F{id_orden_pago}.toString()]]></subreportParameterExpression>
				</subreportParameter>
				<connectionExpression><![CDATA[$P{REPORT_CONNECTION}]]></connectionExpression>
				<subreportExpression class="java.lang.String"><![CDATA[$P{SUBREPORT_DIR} + "certificadoRetencion_v01.jasper"]]></subreportExpression>
			</subreport>
		</band>
		<band height="50">
			<printWhenExpression><![CDATA[$F{tienenotadebito}==true]]></printWhenExpression>
			<subreport runToBottom="true">
				<reportElement x="0" y="0" width="595" height="50" isRemoveLineWhenBlank="true">
					<printWhenExpression><![CDATA[$F{tienenotadebito}==true]]></printWhenExpression>
				</reportElement>
				<subreportParameter name="SUBREPORT_DIR">
					<subreportParameterExpression><![CDATA[$P{SUBREPORT_DIR}]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="id_op_p">
					<subreportParameterExpression><![CDATA[$F{id_orden_pago}.toString()]]></subreportParameterExpression>
				</subreportParameter>
				<connectionExpression><![CDATA[$P{REPORT_CONNECTION}]]></connectionExpression>
				<subreportExpression class="java.lang.String"><![CDATA[$P{SUBREPORT_DIR} + "integracion_nota_debito.jasper"]]></subreportExpression>
			</subreport>
		</band>
	</detail>
</jasperReport>
