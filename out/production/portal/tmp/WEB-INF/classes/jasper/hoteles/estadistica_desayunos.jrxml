<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="estadisticas_desayunos" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="48"/>
	<parameter name="desde_p" class="java.lang.String"/>
	<parameter name="hasta_p" class="java.lang.String"/>
	<parameter name="hotel_p" class="java.lang.String"/>
	<parameter name="pathimage" class="java.lang.String"/>
	<queryString>
		<![CDATA[select fecha_egreso as fecha_desayuno,total_desayunos+total_desayunos_menores_sin_cargo as total_desayunos from hoteles.reporte_desayuno_cena_entre_fechas($P{desde_p}::character varying,$P{hasta_p}::character varying)
group by fecha_egreso,total_desayunos+total_desayunos_menores_sin_cargo
order by fecha_egreso;]]>
	</queryString>
	<field name="fecha_desayuno" class="java.lang.String"/>
	<field name="total_desayunos" class="java.math.BigDecimal"/>
	<variable name="pageAux" class="java.lang.Integer" incrementType="Page" calculation="Count"/>
	<pageHeader>
		<band height="160" splitType="Stretch">
			<rectangle radius="10">
				<reportElement x="142" y="123" width="247" height="33" backcolor="#D5CECE"/>
			</rectangle>
			<textField isBlankWhenNull="true">
				<reportElement x="107" y="43" width="247" height="20"/>
				<textElement textAlignment="Center">
					<font size="14" isBold="true" isItalic="true"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["Estadística Desayunos"]]></textFieldExpression>
			</textField>
			<image>
				<reportElement x="4" y="41" width="89" height="79"/>
				<imageExpression class="java.lang.String"><![CDATA[$P{pathimage}+"/logo_hotel.jpg"]]></imageExpression>
			</image>
			<staticText>
				<reportElement positionType="Float" x="166" y="129" width="86" height="20"/>
				<textElement verticalAlignment="Middle">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Fecha]]></text>
			</staticText>
			<staticText>
				<reportElement x="397" y="15" width="45" height="20"/>
				<textElement>
					<font size="8"/>
				</textElement>
				<text><![CDATA[Impreso:]]></text>
			</staticText>
			<textField pattern="dd/MM/yyyy HH.mm.ss">
				<reportElement x="445" y="14" width="100" height="20"/>
				<textElement>
					<font size="8"/>
				</textElement>
				<textFieldExpression class="java.util.Date"><![CDATA[new java.util.Date()]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="108" y="8" width="281" height="20"/>
				<textElement textAlignment="Center">
					<font size="14"/>
				</textElement>
				<text><![CDATA[Hotel 30 de Junio]]></text>
			</staticText>
			<staticText>
				<reportElement positionType="Float" x="266" y="129" width="111" height="20"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Cantidad Desayunos]]></text>
			</staticText>
		</band>
	</pageHeader>
	<detail>
		<band height="25" splitType="Stretch">
			<rectangle>
				<reportElement x="142" y="0" width="247" height="23" backcolor="#ECECEC">
					<printWhenExpression><![CDATA[($V{REPORT_COUNT} % 2) == 0]]></printWhenExpression>
				</reportElement>
			</rectangle>
			<textField pattern="dd/MM/yyyy">
				<reportElement x="166" y="3" width="100" height="20"/>
				<textElement verticalAlignment="Middle"/>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{fecha_desayuno}]]></textFieldExpression>
			</textField>
			<textField pattern="###0;-###0">
				<reportElement x="270" y="3" width="100" height="20"/>
				<textElement textAlignment="Right" verticalAlignment="Middle"/>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{total_desayunos}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<pageFooter>
		<band height="36">
			<textField>
				<reportElement x="426" y="8" width="80" height="20"/>
				<textElement textAlignment="Right"/>
				<textFieldExpression class="java.lang.String"><![CDATA["Página "+$V{PAGE_NUMBER}+" de "]]></textFieldExpression>
			</textField>
			<textField evaluationTime="Report">
				<reportElement x="506" y="8" width="40" height="20"/>
				<textElement/>
				<textFieldExpression class="java.lang.String"><![CDATA[" " + $V{PAGE_NUMBER}]]></textFieldExpression>
			</textField>
		</band>
	</pageFooter>
	<lastPageFooter>
		<band height="32" splitType="Immediate">
			<textField>
				<reportElement x="426" y="8" width="80" height="20"/>
				<textElement textAlignment="Right"/>
				<textFieldExpression class="java.lang.String"><![CDATA["Página "+$V{PAGE_NUMBER}+" de"]]></textFieldExpression>
			</textField>
			<textField evaluationTime="Report">
				<reportElement x="506" y="8" width="40" height="20"/>
				<textElement/>
				<textFieldExpression class="java.lang.String"><![CDATA[" " + $V{PAGE_NUMBER}]]></textFieldExpression>
			</textField>
		</band>
	</lastPageFooter>
</jasperReport>
