	<field name="descripcion" class="java.lang.String"/>
	<field name="alta_fecha" class="java.sql.Timestamp"/>
	<variable name="vTotal" class="java.lang.Double">
		<initialValueExpression><![CDATA[$F{total_a_pagar}+$F{total_cochera}]]></initialValueExpression>
	</variable>
	<variable name="total_1" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{total}]]></variableExpression>
	</variable>
	<variable name="pageAux" class="java.lang.Integer" incrementType="Page" calculation="Count"/>
	<background>
