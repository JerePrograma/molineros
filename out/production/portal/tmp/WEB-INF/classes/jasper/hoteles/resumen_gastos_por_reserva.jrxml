	<field name="direccion" class="java.lang.String"/>
	<field name="telefono" class="java.lang.String"/>
	<field name="condicion_iva" class="java.lang.String"/>
	<field name="ingresos_brutos" class="java.lang.String"/>
	<field name="inicio_actividades" class="java.lang.String"/>
	<field name="jurisdiccion_codigo" class="java.lang.Integer"/>
	<field name="jurisdiccion_descripcion" class="java.lang.String"/>
	<field name="orden_id" class="java.lang.Integer"/>
	<field name="producto_id" class="java.lang.String"/>
	<field name="cantidad" class="java.lang.Integer"/>
	<field name="precio" class="java.lang.Double"/>
