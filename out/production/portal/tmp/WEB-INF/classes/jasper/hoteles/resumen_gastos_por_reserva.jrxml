				<textFieldExpression class="java.lang.String"><![CDATA[(new SimpleDateFormat("dd/MM/yyyy")).format($F{fecha_desde}) + " - " +
(new SimpleDateFormat("dd/MM/yyyy")).format($F{fecha_hasta})]]></textFieldExpression>
			</textField>
