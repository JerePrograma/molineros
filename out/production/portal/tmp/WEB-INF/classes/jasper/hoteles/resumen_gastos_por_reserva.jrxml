				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["Reserva " + $F{reserva_id}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement stretchType="RelativeToTallestObject" mode="Opaque" x="3" y="257" width="550" height="20" isRemoveLineWhenBlank="true" backcolor="#D3D6D8">
					<printWhenExpression><![CDATA[$F{total_dias_cochera}>0 && $V{pageAux}==null]]></printWhenExpression>
