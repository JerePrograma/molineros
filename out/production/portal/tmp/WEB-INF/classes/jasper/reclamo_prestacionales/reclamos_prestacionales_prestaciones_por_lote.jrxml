					<font size="8"/>
				</textElement>
				<textFieldExpression class="java.lang.Double"><![CDATA[$F{cargo_ospim}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement positionType="FixRelativeToBottom" x="50" y="10" width="495" height="16">
					<printWhenExpression><![CDATA[$F{observaciones}!=null && $F{observaciones}!=""]]></printWhenExpression>
				</reportElement>
				<textElement>
					<font size="8"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{observaciones}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="FixRelativeToBottom" x="0" y="10" width="45" height="16">
					<printWhenExpression><![CDATA[$F{observaciones}!=null && $F{observaciones}!="" && $F{observaciones}.length()>1]]></printWhenExpression>
				</reportElement>
				<textElement>
					<font size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[Obs:]]></text>
			</staticText>
		</band>
	</detail>
</jasperReport>
