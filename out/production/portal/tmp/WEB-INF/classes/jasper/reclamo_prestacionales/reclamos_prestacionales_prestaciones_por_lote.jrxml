				<text><![CDATA[Importe]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="10" width="221" height="16"/>
				<textElement>
					<font size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[Reclamo   Prestacion / Modulo Solicitado]]></text>
			</staticText>
			<staticText>
				<reportElement x="288" y="10" width="45" height="16"/>
				<textElement>
					<font size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[Codigo]]></text>
			</staticText>
		</band>
	</title>
	<detail>
		<band height="29" splitType="Stretch">
			<textField>
				<reportElement x="0" y="0" width="50" height="10"/>
				<textElement>
					<font size="8"/>
				</textElement>
				<textFieldExpression class="java.lang.Integer"><![CDATA[$F{id_reclamo_prestacional}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="50" y="0" width="171" height="10"/>
				<textElement>
					<font size="8"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{descripcion_prestacion}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="221" y="0" width="67" height="10"/>
