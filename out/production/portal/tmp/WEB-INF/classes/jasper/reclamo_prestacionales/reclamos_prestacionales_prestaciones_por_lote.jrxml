<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="reclamos_prestacionales_prestaciones_por_lote" pageWidth="555" pageHeight="802" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="SUBREPORTDIR" class="java.lang.String"/>
	<parameter name="p_nro_lote_prestaciones" class="java.lang.String"/>
	<queryString>
		<![CDATA[select a.*,b.*,coalesce(n.descripcion,m.nombre  || ' '  || m.presentacion ) as descripcion_prestacion,
coalesce(n.codigo,cast(m.troquel as character varying)) as codigo_prestacion
 from autorizaciones.reclamos_prestacionales a
 inner join autorizaciones.reclamos_prestacionales_prestaciones b on a.id=b.id_reclamo_prestacional
 left join autorizaciones.nomenclador n  on  b.id_prestacion =  n.id_prestacion
 left join medicamentos m on m.troquel  = b.id_medicamento
where a.nro_lote=cast($P{p_nro_lote_prestaciones} as integer)
and a.baja_fecha is null and b.baja_fecha is null
order by a.id]]>
	</queryString>
	<field name="id" class="java.lang.Integer"/>
	<field name="fecha_recibido" class="java.sql.Date"/>
	<field name="fecha_seccional" class="java.sql.Date"/>
	<field name="sector" class="java.lang.String"/>
	<field name="cuil_titular" class="java.lang.String"/>
	<field name="inte" class="java.lang.Integer"/>
	<field name="alta_fecha" class="java.sql.Timestamp"/>
	<field name="alta_usr" class="java.lang.String"/>
	<field name="amparo" class="java.lang.Boolean"/>
	<field name="entramite" class="java.lang.Boolean"/>
	<field name="recuperable" class="java.lang.Boolean"/>
	<field name="superintendencia" class="java.lang.Boolean"/>
	<field name="caso_vinculado" class="java.lang.Integer"/>
	<field name="baja_usr" class="java.lang.String"/>
	<field name="baja_fecha" class="java.sql.Timestamp"/>
	<field name="modi_usr" class="java.lang.String"/>
	<field name="modi_fecha" class="java.sql.Timestamp"/>
	<field name="dictamen_comision" class="java.lang.String"/>
	<field name="justificacion_medica" class="java.lang.String"/>
	<field name="justificacion_fecha" class="java.sql.Date"/>
	<field name="justificacion_usr" class="java.lang.String"/>
	<field name="codigocie10" class="java.lang.String"/>
	<field name="diagnostico" class="java.lang.String"/>
	<field name="tipopedido" class="java.lang.String"/>
	<field name="nro_lote" class="java.lang.Integer"/>
	<field name="id_reclamo_prestacional" class="java.lang.Integer"/>
	<field name="id_medicamento" class="java.lang.Integer"/>
	<field name="id_prestacion" class="java.lang.Integer"/>
	<field name="importe" class="java.lang.Double"/>
	<field name="frecuencia" class="java.lang.String"/>
	<field name="cargo_ospim" class="java.lang.Double"/>
	<field name="cargo_ps" class="java.lang.Double"/>
	<field name="observaciones" class="java.lang.String"/>
	<field name="estado_aprobacion" class="java.lang.Integer"/>
	<field name="recuperablesur" class="java.lang.Boolean"/>
	<field name="cantidad" class="java.lang.Integer"/>
	<field name="descripcion_prestacion" class="java.lang.String"/>
	<field name="codigo_prestacion" class="java.lang.String"/>
	<title>
		<band height="28" splitType="Stretch">
			<staticText>
				<reportElement x="419" y="10" width="54" height="16"/>
				<textElement textAlignment="Right">
					<font size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[Cargo PS]]></text>
