	function addElementToSelect(id_combo, texto, valor) {
		var combo = document.getElementById(id_combo);
		var idxElemento = combo.options.length; //Numero de elementos de la combo si esta vacio es 0. Este indice será el del nuevo elemento
		combo.options[idxElemento] = new Option();
		combo.options[idxElemento].text = texto; //Este es el texto que verás en la combo
		combo.options[idxElemento].value = valor; //Este es el valor que se enviará cuando hagas un submit del formulario que lo contiene
	}

	function <portlet:namespace />buscarPlanesDelPrestador(){
		if (<portlet:namespace />cargandoPlanes) {
			return;
		}

		var idPrestador = jQuery('#<portlet:namespace />id_prestador').val();
		if (!idPrestador) {
			return;
		}

		<portlet:namespace />cargandoPlanes = true;

		var combo = document.getElementById("<portlet:namespace/>plan");
		var selectedActual = combo ? combo.value : "0";

		var url = '<portlet:renderURL windowState="<%= LiferayWindowState.EXCLUSIVE.toString() %>"/>&struts_action=/prestadores/lista_planes_del_prestador&idPrestador=' + idPrestador;

		jQuery.ajax({
			url: url,
			success: function(data){
				document.getElementById("<portlet:namespace/>plan").length = 0;

				var obj = jQuery.parseJSON(data);

				addElementToSelect("<portlet:namespace/>plan", "TODOS los planes del Prestador", 0);

				for (var i = 0; i < obj.listaFiltrada.length; i++) {
					var value = obj.listaFiltrada[i].split('|')[0];
					var text = obj.listaFiltrada[i].split('|')[1];
					addElementToSelect("<portlet:namespace/>plan", text, value);
				}

				if (jQuery('#<portlet:namespace/>plan option[value="' + selectedActual + '"]').length > 0) {
					jQuery('#<portlet:namespace/>plan').val(selectedActual);
				} else {
					jQuery('#<portlet:namespace/>plan').val("0");
				}
			},
			error: function() {
				alert("No se pudieron cargar los planes del prestador");
			},
			complete: function() {
				<portlet:namespace />cargandoPlanes = false;
			}
		});
	}

	function <portlet:namespace />cambioVista(){
		jQuery('#<portlet:namespace />buscandoDetalles').show();

		var tipoVistaSel = jQuery("input[name='<portlet:namespace/>tipoVista']:checked").val();

		var url = '<portlet:renderURL windowState="<%=LiferayWindowState.EXCLUSIVE.toString()%>"/>&struts_action=/prestadores/cambio_vista_detalles_prestaciones_convenio_prest';

		var params = {"tipoVistaSelec" : tipoVistaSel};

		jQuery('#<portlet:namespace />detalleConvenioContainer').load(url,params, function() {
			jQuery('#<portlet:namespace />buscandoDetalles').hide();
		});
	}

	function <portlet:namespace />onArchivoXlsSeleccionado() {
		if (!<%= esEdicion %>) {
			return false;
		}

		var archivo = jQuery("#<portlet:namespace />archivo_xls").val();

		if (!archivo) {
			return false;
		}

		return <portlet:namespace />previewXlsConvenioPrest();
	}

	function <portlet:namespace />previewXlsConvenioPrest() {
		if (!<%= esEdicion %>) {
			return false;
		}

		var archivo = jQuery("#<portlet:namespace />archivo_xls").val();

		if (!archivo) {
			alert("Seleccione un archivo XLS");
			return false;
		}

		var url = "<portlet:actionURL windowState='<%= LiferayWindowState.MAXIMIZED.toString() %>'>" +
				"<portlet:param name='struts_action' value='/prestadores/editar_convenio_prest_entry' />" +
				"<portlet:param name='cmd' value='uploadXlsPreview' />" +
				"</portlet:actionURL>";

		document.<portlet:namespace />convenios_prest_fm.method = "post";
		document.<portlet:namespace />convenios_prest_fm.enctype = "multipart/form-data";

		submitForm(document.<portlet:namespace />convenios_prest_fm, url);
		return false;
	}

	function <portlet:namespace />exportarXlsConvenioPrest() {
		var url = "<portlet:actionURL windowState='<%= LiferayWindowState.EXCLUSIVE.toString() %>'>" +
				"<portlet:param name='struts_action' value='/liquidaciones/editar_convenio_prest_entry' />" +
				"<portlet:param name='cmd' value='exportXls' />" +
				"</portlet:actionURL>";

		return <portlet:namespace />submitDownload(url);
	}

	function <portlet:namespace />descargarXlsModelo() {
		var url = "<portlet:actionURL windowState='<%= LiferayWindowState.EXCLUSIVE.toString() %>'>" +
				"<portlet:param name='struts_action' value='/liquidaciones/editar_convenio_prest_entry' />" +
				"<portlet:param name='cmd' value='downloadXlsModelo' />" +
				"</portlet:actionURL>";

		return <portlet:namespace />submitDownload(url);
	}

	function <portlet:namespace />submitDownload(url) {
		var form = document.<portlet:namespace />convenios_prest_fm;

		var oldAction = form.action;
		var oldMethod = form.method;
		var oldEnctype = form.enctype;
		var oldTarget = form.target;

		form.action = url;
		form.method = "post";
		form.enctype = "application/x-www-form-urlencoded";
		form.target = "<portlet:namespace />downloadFrame";

		form.submit();

		window.setTimeout(function() {
			form.action = oldAction || "";
			form.method = oldMethod || "post";
			form.enctype = oldEnctype || "multipart/form-data";
			form.target = oldTarget || "";
		}, 100);

		return false;
	}

	function <portlet:namespace />formatDecimalForSubmit(value) {
		var parsed = <portlet:namespace />parseDecimal(value);

		if (isNaN(parsed)) {
			return "0.00";
		}

		return parsed.toFixed(2);
	}

	function <portlet:namespace />bloquearBuscadorPrestacionSiEsVista() {
		if (<%= esEdicion %>) {
			return;
		}

		var $contenedor = jQuery('#<portlet:namespace />buscadorPrestacionContainer');

		if ($contenedor.length === 0) {
			return;
		}

		$contenedor.find('input:not([type=hidden]), select, textarea, button').each(function() {
			jQuery(this).prop('disabled', true).prop('readonly', true);
		});

		$contenedor.find('a').each(function() {
			jQuery(this)
					.css('pointer-events', 'none')
					.css('cursor', 'default')
					.css('opacity', '0.6')
					.removeAttr('onclick')
					.removeAttr('href');
		});

		$contenedor.find('img').each(function() {
			jQuery(this).css('pointer-events', 'none').css('opacity', '0.6');
		});

		jQuery('#<portlet:namespace />codigo').prop('disabled', true).prop('readonly', true);
		jQuery('#<portlet:namespace />prestacion').prop('disabled', true).prop('readonly', true);

		if (jQuery('#<portlet:namespace />btnBuscarPrestacion').length) {
			jQuery('#<portlet:namespace />btnBuscarPrestacion').prop('disabled', true).hide();
		}
	}

	function <portlet:namespace />volverAConvenios() {
		var backURL = jQuery.trim(jQuery("#<portlet:namespace />backURL").val() || "");

		if (backURL !== "") {
			window.location.href = backURL;
			return false;
		}

		if (window.history.length > 1) {
			window.history.back();
			return false;
		}

		window.location.href = "<%= volverConveniosDefault %>";
		return false;
	}

	function <portlet:namespace />fechaParcialInformada(prefijo) {
		var dia = jQuery.trim(jQuery("#<portlet:namespace />" + prefijo + "Dia").val() || "");
		var mes = jQuery.trim(jQuery("#<portlet:namespace />" + prefijo + "Mes").val() || "");
		var anio = jQuery.trim(jQuery("#<portlet:namespace />" + prefijo + "Anio").val() || "");

		var alguno = (dia !== "" || mes !== "" || anio !== "");
		var completa = (dia !== "" && mes !== "" && anio !== "");

		return alguno && !completa;
	}

	function <portlet:namespace />parsePickerDate(prefijo) {
		if (!<portlet:namespace />tieneFechaCompleta(prefijo)) {
			return null;
		}

		var dia = parseInt(jQuery("#<portlet:namespace />" + prefijo + "Dia").val(), 10);
		var mes = parseInt(jQuery("#<portlet:namespace />" + prefijo + "Mes").val(), 10);
		var anio = parseInt(jQuery("#<portlet:namespace />" + prefijo + "Anio").val(), 10);

		if (isNaN(dia) || isNaN(mes) || isNaN(anio)) {
			return null;
		}

		var fecha = new Date(anio, mes, dia);
		fecha.setHours(0, 0, 0, 0);

		if (fecha.getFullYear() !== anio || fecha.getMonth() !== mes || fecha.getDate() !== dia) {
			return null;
		}

		return fecha;
	}

	function <portlet:namespace />formatearFechaDDMMYYYY(fecha) {
		if (!fecha) {
			return "";
		}

		var dia = fecha.getDate();
		var mes = fecha.getMonth() + 1;
		var anio = fecha.getFullYear();

		return dia + "/" + mes + "/" + anio;
	}

	function <portlet:namespace />parseIsoDate(iso) {
		if (!iso) {
			return null;
		}

		var partes = String(iso).split("-");
		if (partes.length !== 3) {
			return null;
		}

		var anio = parseInt(partes[0], 10);
		var mes = parseInt(partes[1], 10) - 1;
		var dia = parseInt(partes[2], 10);

		if (isNaN(anio) || isNaN(mes) || isNaN(dia)) {
			return null;
		}

		var fecha = new Date(anio, mes, dia);
		fecha.setHours(0, 0, 0, 0);

		if (fecha.getFullYear() !== anio || fecha.getMonth() !== mes || fecha.getDate() !== dia) {
			return null;
		}

		return fecha;
	}

	function <portlet:namespace />hoySinHora() {
		var hoy = new Date();
		hoy.setHours(0, 0, 0, 0);
		return hoy;
	}

	function <portlet:namespace />obtenerIdPrestacionSeleccionado() {
		if (jQuery("#<portlet:namespace />id_prestacion").length > 0) {
			return jQuery("#<portlet:namespace />id_prestacion").val();
		}
		if (jQuery("#<portlet:namespace />idPrestacion").length > 0) {
			return jQuery("#<portlet:namespace />idPrestacion").val();
		}
		return "";
	}

	/*
     * Requiere que cada fila del resultado tenga:
     * class="conv-prest-det-row"
     * data-id-prestacion="..."
     * data-id-plan="..."
     * data-fecha-desde="yyyy-MM-dd"
     * data-id-detalle="..."
     */
	function <portlet:namespace />validarReglaTemporalContraGrilla(idPrestacion, planId, fechaDesdeNueva) {
		if (!fechaDesdeNueva) {
			return { ok: true };
		}

		var hoy = <portlet:namespace />hoySinHora();
		var hayMismaClave = false;
		var hayVersionFutura = false;
		var idDetalleEdicion = jQuery.trim(jQuery("#<portlet:namespace />id_convprest_det").val() || "");

		jQuery('#<portlet:namespace />convenio_prest_detalle .conv-prest-det-row').each(function() {
			var $row = jQuery(this);
			var rowPrest = jQuery.trim(String($row.data('id-prestacion') || ""));
			var rowPlan = jQuery.trim(String($row.data('id-plan') || ""));
			var rowFechaDesde = <portlet:namespace />parseIsoDate($row.data('fecha-desde'));
			var rowIdDetalle = jQuery.trim(String($row.data('id-detalle') || ""));

			if (idDetalleEdicion !== "" && rowIdDetalle === idDetalleEdicion) {
				return true;
			}

			if (rowPrest === String(idPrestacion) && rowPlan === String(planId)) {
				hayMismaClave = true;

				if (rowFechaDesde && rowFechaDesde > hoy) {
					hayVersionFutura = true;
				}
			}
		});

		if (!hayMismaClave) {
			return { ok: true };
		}

		if (fechaDesdeNueva <= hoy) {
			return {
				ok: false,
				msg: "Ya existe un detalle cargado con la misma prestación y plan. Sólo se permite agregar una nueva versión con fecha desde futura."
			};
		}

		if (hayVersionFutura) {
			return {
				ok: false,
				msg: "Ya existe una versión futura cargada para esa prestación y plan. No se permite más de una versión futura."
			};
		}

		return { ok: true };
	}
</script>