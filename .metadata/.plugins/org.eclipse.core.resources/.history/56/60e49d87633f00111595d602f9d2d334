	function <portlet:namespace />agregarDetalle() {

		if (!<%= esEdicion %>) {
			return false;
		}

		if (<portlet:namespace />agregandoDetalle) {
			return false;
		}

		if (!<portlet:namespace />validarCamposDetalle()) {
			return false;
		}

		<portlet:namespace />agregandoDetalle = true;
		jQuery('#<portlet:namespace />buscandoDetalles').show();

		var codigo = jQuery.trim(jQuery("#<portlet:namespace />codigo").val() || "");
		var idPrestador = jQuery("#<portlet:namespace />id_prestador").val();
		var idPrest = <portlet:namespace />obtenerIdPrestacionSeleccionado();

		if (!idPrestador) {
			<portlet:namespace />agregandoDetalle = false;
			jQuery('#<portlet:namespace />buscandoDetalles').hide();
			alert("Debe seleccionar un prestador válido");
			return false;
		}

		if (!idPrest) {
			<portlet:namespace />agregandoDetalle = false;
			jQuery('#<portlet:namespace />buscandoDetalles').hide();
			alert("Debe seleccionar una prestación válida");
			return false;
		}

		var fechaDesde = <portlet:namespace />parsePickerDate("prestacionFechaDesde");
		var fechaHasta = <portlet:namespace />parsePickerDate("prestacionFechaHasta");

		var fechaDesdeFinal = <portlet:namespace />formatearFechaDDMMYYYY(fechaDesde);
		var fechaHastaFinal = fechaHasta ? <portlet:namespace />formatearFechaDDMMYYYY(fechaHasta) : "";

		var servicio = "";
		var planId = jQuery("#<portlet:namespace />plan").val();
		var plan_text = jQuery("#<portlet:namespace />plan :selected").text();
		var tipoValoriz = jQuery("#<portlet:namespace />tipo_valorizacion").val();

		var cosegu = <portlet:namespace />formatDecimalForSubmit(
				jQuery("#<portlet:namespace />coseguro").val()
		);

		var importe = "0.00";
		var porcentaje = "0.00";

		if (tipoValoriz === "porcentaje") {
			porcentaje = <portlet:namespace />formatDecimalForSubmit(
					jQuery("#<portlet:namespace />porcentaje").val()
			);
		} else {
			importe = <portlet:namespace />formatDecimalForSubmit(
					jQuery("#<portlet:namespace />importe").val()
			);
		}

		var url = '<portlet:renderURL windowState="<%=LiferayWindowState.EXCLUSIVE.toString()%>"/>&struts_action=/prestadores/lista_prestaciones_convenio_prest';

		var params = {
			"idPrestacion" : idPrest,
			"idPrestador" : idPrestador,
			"codigo" : codigo,
			"fechaDesde" : fechaDesdeFinal,
			"fechaHasta" : fechaHastaFinal,
			"servicio" : servicio,
			"planId" : planId,
			"planDesc" : plan_text,
			"tipoValorizacion" : tipoValoriz,
			"coseguro" : cosegu,
			"importe" : importe,
			"porcentaje" : porcentaje,
			"<%=Constants.CMD%>" : "<%=Constants.ADD%>"
		};

		jQuery('#<portlet:namespace />detalleConvenioContainer').load(url, params, function(response, status) {
			<portlet:namespace />agregandoDetalle = false;
			jQuery('#<portlet:namespace />buscandoDetalles').hide();

			if (status !== "success") {
				alert("No se pudo agregar el detalle");
				return;
			}

			var huboError = jQuery(this).find('.portlet-msg-error, .alert-error, .taglib-alert, .portlet-msg-alert').length > 0;

			if (!huboError) {
				<portlet:namespace />resetDetalleForm();
			}
		});

		return false;
	}

