	function <portlet:namespace />tieneFechaCompleta(prefijo){
		var dia = jQuery("#<portlet:namespace />" + prefijo + "Dia").val();
		var mes = jQuery("#<portlet:namespace />" + prefijo + "Mes").val();
		var anio = jQuery("#<portlet:namespace />" + prefijo + "Anio").val();

		return jQuery.trim(dia || "") !== ""
				&& jQuery.trim(mes || "") !== ""
				&& jQuery.trim(anio || "") !== "";
	}

	function <portlet:namespace />validarCampos(){
		var idPrestador = parseInt(jQuery("#<portlet:namespace />id_prestador").val() || "0", 10);

		if (idPrestador <= 0) {
			alert("Prestador obligatorio");
			jQuery("#<portlet:namespace />cuit_prestador").focus();
			return false;
		}

		if (!<portlet:namespace />tieneFechaCompleta("vigencia")) {
			alert("La vigencia del convenio es obligatoria");
			jQuery("#<portlet:namespace />vigenciaDia").focus();
			return false;
		}

		var vigencia = <portlet:namespace />parsePickerDate("vigencia");
		if (!vigencia) {
			alert("La vigencia del convenio es inválida");
			jQuery("#<portlet:namespace />vigenciaDia").focus();
			return false;
		}

		if (<portlet:namespace />fechaParcialInformada("vencimiento")) {
			alert("La fecha de vencimiento está incompleta");
			jQuery("#<portlet:namespace />vencimientoDia").focus();
			return false;
		}

		if (<portlet:namespace />tieneFechaCompleta("vencimiento")) {
			var vencimiento = <portlet:namespace />parsePickerDate("vencimiento");

			if (!vencimiento) {
				alert("La fecha de vencimiento es inválida");
				jQuery("#<portlet:namespace />vencimientoDia").focus();
				return false;
			}

			if (vencimiento < vigencia) {
				alert("La fecha de vencimiento no puede ser menor a la vigencia");
				jQuery("#<portlet:namespace />vencimientoDia").focus();
				return false;
			}
		}

		return true;
	}

	function <portlet:namespace />parseDecimal(value) {
		if (value == null) {
			return NaN;
		}

		var normalized = jQuery.trim(String(value));
		if (normalized === "") {
			return NaN;
		}

		normalized = normalized.replace(/\s/g, "");

		if (normalized.indexOf(",") >= 0 && normalized.indexOf(".") >= 0) {
			if (normalized.lastIndexOf(",") > normalized.lastIndexOf(".")) {
				normalized = normalized.replace(/\./g, "").replace(",", ".");
			} else {
				normalized = normalized.replace(/,/g, "");
			}
		} else if (normalized.indexOf(",") >= 0) {
			normalized = normalized.replace(",", ".");
		}

		return parseFloat(normalized);
	}

	function <portlet:namespace />validarCamposDetalle(){

		var codigo = jQuery.trim(jQuery("#<portlet:namespace />codigo").val() || "");
		var idPrestacion = <portlet:namespace />obtenerIdPrestacionSeleccionado();
		var plan = jQuery("#<portlet:namespace />plan").val();
		var tipoValoriz = jQuery("#<portlet:namespace />tipo_valorizacion").val();
		var importe = <portlet:namespace />parseDecimal(jQuery("#<portlet:namespace />importe").val());
		var porcentaje = <portlet:namespace />parseDecimal(jQuery("#<portlet:namespace />porcentaje").val());
		var fechaDesde = null;
		var fechaHasta = null;

		if (codigo === "") {
			alert("Código obligatorio");
			jQuery("#<portlet:namespace />codigo").focus();
			return false;
		}

		if (codigo.length > 10) {
			alert("El código no puede superar los 10 caracteres");
			jQuery("#<portlet:namespace />codigo").focus();
			return false;
		}

		if (jQuery("#<portlet:namespace />pres_seleccionada").length > 0
				&& jQuery("#<portlet:namespace />pres_seleccionada").val() != "1") {
			alert("Código inválido");
			jQuery("#<portlet:namespace />codigo").focus();
			return false;
		}

		if (!idPrestacion || idPrestacion === "0") {
			alert("Debe seleccionar una prestación válida");
			return false;
		}

		if (plan == "-1") {
			alert("El Prestador no tiene planes cargados, no se puede cargar prestaciones");
			return false;
		}

		if (!<portlet:namespace />tieneFechaCompleta("prestacionFechaDesde")) {
			alert("La fecha desde del detalle es obligatoria");
			jQuery("#<portlet:namespace />prestacionFechaDesdeDia").focus();
			return false;
		}

		fechaDesde = <portlet:namespace />parsePickerDate("prestacionFechaDesde");
		if (!fechaDesde) {
			alert("La fecha desde del detalle es inválida");
			jQuery("#<portlet:namespace />prestacionFechaDesdeDia").focus();
			return false;
		}

		if (<portlet:namespace />fechaParcialInformada("prestacionFechaHasta")) {
			alert("La fecha hasta del detalle está incompleta");
			jQuery("#<portlet:namespace />prestacionFechaHastaDia").focus();
			return false;
		}

		if (<portlet:namespace />tieneFechaCompleta("prestacionFechaHasta")) {
			fechaHasta = <portlet:namespace />parsePickerDate("prestacionFechaHasta");

			if (!fechaHasta) {
				alert("La fecha hasta del detalle es inválida");
				jQuery("#<portlet:namespace />prestacionFechaHastaDia").focus();
				return false;
			}

			if (fechaHasta < fechaDesde) {
				alert("La fecha hasta no puede ser menor a la fecha desde");
				jQuery("#<portlet:namespace />prestacionFechaHastaDia").focus();
				return false;
			}
		}

		if (tipoValoriz === "porcentaje") {
			if (isNaN(porcentaje) || porcentaje <= 0) {
				alert("Ingrese un porcentaje válido mayor a 0");
				jQuery("#<portlet:namespace />porcentaje").focus();
				return false;
			}
		} else {
			if (isNaN(importe) || importe <= 0) {
				alert("Ingrese un importe válido mayor a 0");
				jQuery("#<portlet:namespace />importe").focus();
				return false;
			}
		}

		var validacionTemporal = <portlet:namespace />validarReglaTemporalContraGrilla(idPrestacion, plan, fechaDesde);
		if (!validacionTemporal.ok) {
			alert(validacionTemporal.msg);
			return false;
		}

		return true;
	}

