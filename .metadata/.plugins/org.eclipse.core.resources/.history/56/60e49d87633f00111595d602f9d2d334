	function <portlet:namespace/>cambiaTipoValoriz(){
		var esEdicion = <%= esEdicion %>;
		var tipValor = jQuery('#<portlet:namespace/>tipo_valorizacion').val();
		var importeEl = document.getElementById("<portlet:namespace/>importe");
		var porcentajeEl = document.getElementById("<portlet:namespace/>porcentaje");
		var coseguroEl = document.getElementById("<portlet:namespace/>coseguro");
		var tipoValEl = document.getElementById("<portlet:namespace/>tipo_valorizacion");

		if (!esEdicion) {
			if (tipoValEl) tipoValEl.disabled = true;
			if (importeEl) importeEl.disabled = true;
			if (porcentajeEl) porcentajeEl.disabled = true;
			if (coseguroEl) coseguroEl.disabled = true;
			return;
		}

		if (tipValor === 'porcentaje') {
			importeEl.disabled = true;
			porcentajeEl.disabled = false;
			jQuery('#<portlet:namespace/>importe').val('');
		} else {
			importeEl.disabled = false;
			porcentajeEl.disabled = true;
			jQuery('#<portlet:namespace/>porcentaje').val('');
		}

		if (coseguroEl) {
			coseguroEl.disabled = false;
		}
	}

