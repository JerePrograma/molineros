    private static final class PeriodCtx {
        boolean valid;
        int anio;
        int mes0;
        String tercerizadoras;
        Date fechaDesde;
        Date fechaHasta;
    }

    private PeriodCtx extractPeriodoFromRenderParams(RenderRequest renderRequest, String ns, String rid) {
        _log.info(prefix(rid) + "Iniciando extractPeriodoFromRenderParams");
        PeriodCtx p = new PeriodCtx();
        p.valid = false;

        int mes0Based = pI(renderRequest, ns, "fechaDesdeMes", -1);
        int anio = pI(renderRequest, ns, "fechaDesdeAnio", -1);

        String tercerizadoras = pS(renderRequest, ns, "tipo_debitos_tercerizadoras",
                pS(renderRequest, ns, "tipo_debito", ""));
        tercerizadoras = (tercerizadoras != null) ? tercerizadoras.trim() : "";

        if (anio <= 0 || mes0Based < 0 || Validator.isNull(tercerizadoras)) {
            return p;
        }

        Date fechaDesde = null;
        Date fechaHasta = null;

        try {
            Calendar calDesde = DateUtils.getCalendarGMTMenos3();
            calDesde.set(Calendar.YEAR, anio);
            calDesde.set(Calendar.MONTH, mes0Based);
            calDesde.set(Calendar.DAY_OF_MONTH, 1);
            calDesde.set(Calendar.HOUR_OF_DAY, 0);
            calDesde.set(Calendar.MINUTE, 0);
            calDesde.set(Calendar.SECOND, 0);
            calDesde.set(Calendar.MILLISECOND, 0);
            fechaDesde = calDesde.getTime();
            fechaHasta = DateUtils.getLastDateOfMonth(fechaDesde, false);
        } catch (Exception e) {
            _log.error(prefix(rid) + "[PERIODO] Error calculando fechas del período", e);
            return p;
        }

        p.valid = (fechaDesde != null && fechaHasta != null);
        p.anio = anio;
        p.mes0 = mes0Based;
        p.tercerizadoras = tercerizadoras;
        p.fechaDesde = fechaDesde;
        p.fechaHasta = fechaHasta;
        _log.info(prefix(rid) + "Finalizando extractPeriodoFromRenderParams");
        return p;
    }

