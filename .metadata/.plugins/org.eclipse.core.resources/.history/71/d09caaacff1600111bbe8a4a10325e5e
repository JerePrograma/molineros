    private static final String SESSION_WORK_RE = "BUSQUEDA_DEBITOS_TERCERIZADORAS_WORK_RE";
    private static final String SESSION_WORK_PR = "BUSQUEDA_DEBITOS_TERCERIZADORAS_WORK_PR";

    // staging (append)
    private static final String SESSION_STG_LI = "BUSQUEDA_DEBITOS_TERCERIZADORAS_STG_LI";
