    @Override
    public void processAction(
            ActionMapping mapping, ActionForm form,
            PortletConfig portletConfig, ActionRequest actionRequest,
            ActionResponse actionResponse) throws Exception {

        final String rid = newRid();
        _log.info(prefix(rid) + "Iniciando processAction");
        final long t0 = System.currentTimeMillis();

        HttpServletRequest httpReq = PortalUtil.getHttpServletRequest(actionRequest);
        HttpSession session = httpReq.getSession();

        boolean dbg = ParamUtil.getBoolean(actionRequest, PARAM_DBG, false);
        boolean dumpAllParams = ParamUtil.getBoolean(actionRequest, PARAM_DUMP, false);

        String ns = null;
        try {
            String portletId = PortalUtil.getPortletId(actionRequest);
            ns = PortalUtil.getPortletNamespace(portletId);
        } catch (Exception ignore) {
            // ns queda null
        }

        String cmd = ParamUtil.getString(actionRequest, Constants.CMD, null);
        if (Validator.isNull(cmd) && ns != null) {
            cmd = ParamUtil.getString(actionRequest, ns + Constants.CMD, null);
        }

        if (_log.isInfoEnabled()) {
            _log.info(prefix(rid) + "[ACTION-START] cmd=" + cmd
                    + " ns=" + safe(ns)
                    + " sessionId=" + (session != null ? String.valueOf(session.getId()) : "null"));
        }

        if (dbg && dumpAllParams) {
            dumpAllActionParams(actionRequest, rid);
        }

        // ============================================================
        // GUARD: bloquear mutaciones si el período WORK está cerrado
        // ============================================================
        if (isMutatingCmd(cmd) && !CMD_REABRIR_PERIODO.equals(cmd)) {

            String tipoSel = resolveTipoSel(actionRequest, ns, session);
            boolean workCerrado = isWorkPeriodoCerrado(session, tipoSel, rid);

            if (_log.isInfoEnabled()) {
                _log.info(prefix(rid) + "[GUARD-CHECK] cmd=" + cmd
                        + " tipoSel=" + safe(tipoSel)
                        + " workCerrado=" + (workCerrado ? "1" : "0")
                        + " workPeriodo=" + safe(workPeriodoLabel(session)));
            }

            if (workCerrado) {
                _log.warn(prefix(rid) + "[GUARD] cmd=" + cmd + " bloqueado: período ya cerrado.");

                // Volver a render en un estado “seguro”
                actionResponse.setRenderParameter(Constants.CMD, "deleteDetalle");
                actionResponse.setRenderParameter("cacheKey", WORK_KEY);
                if (Validator.isNotNull(tipoSel)) {
                    actionResponse.setRenderParameter("tipo_proceso", tipoSel);
                }

                // Flags para UI
                actionResponse.setRenderParameter("cierrePeriodoOk", "0");
                actionResponse.setRenderParameter("cierrePeriodoError", "periodo_ya_cerrado");
                actionResponse.setRenderParameter("workCerrado", "1");

                _log.info(prefix(rid) + "[ACTION-END] (GUARD-BLOCK) cmd=" + cmd
                        + " elapsedMs=" + (System.currentTimeMillis() - t0));
                return;
            }
        }

        if ("deleteDetalle".equals(cmd)) {
            doDeleteDetalle(actionRequest, actionResponse, rid);

        } else if (CMD_ANEXAR_DETALLE.equals(cmd)) {
            doAnexarDetalle(actionRequest, actionResponse, rid);

        } else if (CMD_GUARDAR_BORRADOR.equals(cmd)) {
            doGuardarBorrador(actionRequest, actionResponse, rid);

        } else if (CMD_CERRAR_PERIODO.equals(cmd)) {
            doCerrarPeriodo(actionRequest, actionResponse, rid);

        } else if (CMD_REABRIR_PERIODO.equals(cmd)) {
            doReabrirPeriodo(actionRequest, actionResponse, rid);

        } else {
            if (_log.isInfoEnabled()) {
                _log.info(prefix(rid) + "[ACTION] cmd=" + cmd + " -> (sin acción) búsquedas corren por render/AJAX");
            }
        }

        if (_log.isInfoEnabled()) {
            _log.info(prefix(rid) + "[ACTION-END] cmd=" + cmd
                    + " elapsedMs=" + (System.currentTimeMillis() - t0));
        }

        _log.info(prefix(rid) + "Finalizando processAction");
    }

    @Override
    public ActionForward render(
            ActionMapping mapping, ActionForm form,
            PortletConfig portletConfig, RenderRequest renderRequest,
            RenderResponse renderResponse) throws Exception {

        final String rid = newRid();
        _log.info(prefix(rid) + "Iniciando render");
        final long t0 = System.currentTimeMillis();

        HttpServletRequest httpReq = PortalUtil.getHttpServletRequest(renderRequest);
        HttpSession session = httpReq.getSession();

        boolean dbg = ParamUtil.getBoolean(renderRequest, PARAM_DBG, false);
        boolean dumpAllParams = ParamUtil.getBoolean(renderRequest, PARAM_DUMP, false);

        User usuario = null;
        try {
            usuario = PortalUtil.getUser(renderRequest);
        } catch (Exception ignore) {
            // usuario queda null
        }

        final String ns = getNs(renderRequest);

        // cmd (plano + namespaced resuelto por tu helper pS)
        String cmd = pS(renderRequest, ns, Constants.CMD, null);

        Map tiposMap = parseTiposConfig(getConfigDebitosTercerizadorasTipoRaw());
        renderRequest.setAttribute(REQ_TIPO_MAP_KEY, tiposMap);

        String tipoSel = pS(renderRequest, ns, "tipo_proceso", null);
        if (StringUtils.checkEmpty(tipoSel)) tipoSel = pS(renderRequest, ns, "tipoProceso", null);
        if (StringUtils.checkEmpty(tipoSel)) tipoSel = pS(renderRequest, ns, "tipoDebito", "LI");
        tipoSel = normalizeTipoSel(tipoSel);

        if (!tiposMap.containsKey(tipoSel)) {
            _log.warn(prefix(rid) + "tipoSel inválido='" + tipoSel + "'. Se fuerza a LI.");
            tipoSel = "LI";
        }

        renderRequest.setAttribute(REQ_TIPO_SELECTED_KEY, tipoSel);
        renderRequest.setAttribute(REQ_TOTALES_SESSION_KEY, SESSION_TOTALES_KEY);

        if (dbg) {
            logMappingForwards(mapping, rid);
            logSessionSnapshot(session, rid, 50);
            if (dumpAllParams) dumpAllRequestParams(renderRequest, rid);
        }

        // ============================================================
        // EARLY RETURN: cmd=archivosDebitos -> SOLO forward a JSP de archivos
        // ============================================================
        if (CMD_ARCHIVOS.equalsIgnoreCase(cmd)) {

            final String FWD_ARCHIVOS = "archivos_debitos_tercerizadoras";

            // 1) RAW (sin helper) para detectar si el mapping ya viene mal
            ActionForward raw = mapping.findForward(FWD_ARCHIVOS);
            String rawPath = (raw != null) ? raw.getPath() : null;
            _log.info(prefix(rid) + "[ARCHIVOS][RAW] name=" + FWD_ARCHIVOS
                    + " path=" + (rawPath != null ? rawPath : "null"));

            // 2) Detectar el bug típico: forward path arrancando con /html/
            if (rawPath != null && rawPath.startsWith("/html/")) {
                _log.error(prefix(rid) + "[ARCHIVOS] FORWARD MAL CONFIGURADO/MUTADO: "
                        + FWD_ARCHIVOS + " path=" + rawPath + " (debe ser /portlet/... no /html/...)");
                logMappingForwards(mapping, rid);
            }

            if (_log.isInfoEnabled()) {
                _log.info(prefix(rid) + "[RENDER][ARCHIVOS] cmd=" + cmd + " tipoSel=" + safe(tipoSel));
            }

            // 3) Resolver forward con helper (que además te loguea detalle)
            ActionForward fwdArch = debugFindForward(mapping, FWD_ARCHIVOS, rid, dbg);

            // 4) Si sigue null => cortar con un forward seguro para no “romper” el request sin explicación
            if (fwdArch == null) {
                _log.error(prefix(rid) + "[ARCHIVOS] No se pudo resolver forward '"
                        + FWD_ARCHIVOS + "'. Devuelvo null.jsp para evitar crash.");
                return mapping.findForward("/common/null.jsp");
            }

            if (_log.isInfoEnabled()) {
                _log.info(prefix(rid) + "[RENDER-END][ARCHIVOS] fwd=" + fwdArch.getPath()
                        + " elapsedMs=" + (System.currentTimeMillis() - t0));
            }

            return fwdArch;
        }

        // ============================================================
        // NUEVO: Evaluación de cerrado del WORK SIEMPRE (post-actions)
        // ============================================================
        boolean workCerrado = isWorkPeriodoCerrado(session, tipoSel, rid);

        // Default: PERIODO_CERRADO refleja el WORK (puede ser sobreescrito por SEARCH/APPEND)
        renderRequest.setAttribute("PERIODO_CERRADO", Boolean.valueOf(workCerrado));

        boolean afterCerrar = pB(renderRequest, ns, "afterCerrar", false);
        boolean paramWorkCerrado = pB(renderRequest, ns, "workCerrado", false); // opcional

        if (_log.isInfoEnabled()) {
            _log.info(prefix(rid) + "[RENDER-START] cmd=" + cmd
                    + " tipoSel=" + safe(tipoSel)
                    + " workCerrado=" + (workCerrado ? "1" : "0")
                    + " afterCerrar=" + (afterCerrar ? "1" : "0")
                    + " paramWorkCerrado=" + (paramWorkCerrado ? "1" : "0")
                    + " workPeriodo=" + safe(workPeriodoLabel(session)));
        }

        boolean isSearchCmd = (!StringUtils.checkEmpty(cmd) && Constants.SEARCH.equals(cmd));

        // ============================================================
        // CASO A: cmd=search -> respeta el período SOLICITADO (params)
        // ============================================================
        if (isSearchCmd) {

            PeriodCtx p = extractPeriodoFromRenderParams(renderRequest, ns, rid);
            boolean cerradoSolicitado = false;

            if (p != null && p.valid) {
                cerradoSolicitado = isPeriodoCerrado(
                        p.fechaDesde, p.fechaHasta, p.tercerizadoras, tipoSel, rid
                );
            }

            // IMPORTANTE: PERIODO_CERRADO debe reflejar lo que se va a renderizar en esta búsqueda.
            renderRequest.setAttribute("PERIODO_CERRADO", Boolean.valueOf(cerradoSolicitado));

            if (_log.isInfoEnabled()) {
                _log.info(prefix(rid) + "[RENDER][SEARCH] p.valid=" + (p != null && p.valid ? "1" : "0")
                        + " cerradoSolicitado=" + (cerradoSolicitado ? "1" : "0")
                        + " periodoSolicitado=" + (p != null && p.valid ? (p.anio + "-" + pad2(p.mes0 + 1)) : "invalid")
                        + " terc=" + (p != null ? safe(p.tercerizadoras) : "null"));
            }

            if (cerradoSolicitado) {
                doSearchFromPersistido(renderRequest, session, tipoSel, rid, dbg);
                renderRequest.setAttribute("PERIODO_CERRADO", Boolean.TRUE);
            } else {
                doSearch(renderRequest, session, tipoSel, rid, dbg);
                renderRequest.setAttribute("PERIODO_CERRADO", Boolean.FALSE);
            }

            // ============================================================
            // CASO B: cmd=appendSearch
            // ============================================================
        } else if (CMD_APPEND_SEARCH.equals(cmd)) {

            doAppendSearch(renderRequest, session, tipoSel, rid, dbg);

            // ============================================================
            // CASO C: cmd=deleteDetalle
            // ============================================================
        } else if ("deleteDetalle".equals(cmd)) {

            boolean ok = hydrateFromSession(renderRequest, session, tipoSel, rid, dbg);
            if (!ok) {
                _log.warn(prefix(rid) + "[WORK-MISS] cmd=deleteDetalle sin estado. Fallback a doSearch.");
                doSearch(renderRequest, session, tipoSel, rid, dbg);
                renderRequest.setAttribute("PERIODO_CERRADO", Boolean.FALSE);
            }

            if (afterCerrar || paramWorkCerrado || workCerrado) {
                boolean forced = doRenderClosedFromWorkSession(renderRequest, session, tipoSel, rid, dbg);
                if (_log.isInfoEnabled()) {
                    _log.info(prefix(rid) + "[RENDER][FORCE-CERRADO] trigger="
                            + (afterCerrar ? "afterCerrar" : (paramWorkCerrado ? "paramWorkCerrado" : "workCerrado"))
                            + " forced=" + (forced ? "1" : "0"));
                }
                renderRequest.setAttribute("PERIODO_CERRADO", Boolean.TRUE);
            }

            // ============================================================
            // CASO D: render normal
            // ============================================================
        } else {

            hydrateFromSession(renderRequest, session, tipoSel, rid, dbg);

            if (afterCerrar || paramWorkCerrado || workCerrado) {
                boolean forced = doRenderClosedFromWorkSession(renderRequest, session, tipoSel, rid, dbg);
                if (_log.isInfoEnabled()) {
                    _log.info(prefix(rid) + "[RENDER][FORCE-CERRADO] trigger="
                            + (afterCerrar ? "afterCerrar" : (paramWorkCerrado ? "paramWorkCerrado" : "workCerrado"))
                            + " forced=" + (forced ? "1" : "0"));
                }
                renderRequest.setAttribute("PERIODO_CERRADO", Boolean.TRUE);
            }
        }

        ActionForward fwd = debugFindForward(mapping, FWD_SEARCH_RESULT, rid, dbg);

        if (_log.isInfoEnabled()) {
            _log.info(prefix(rid) + "[RENDER-END] fwd=" + (fwd != null ? fwd.getPath() : "null")
                    + " elapsedMs=" + (System.currentTimeMillis() - t0));
        }

        boolean finalWorkCerrado = isWorkPeriodoCerrado(session, tipoSel, rid);

        // Si estoy en APPEND, PERIODO_CERRADO debe reflejar el período anexado (ya lo setea doAppendSearch).
        Boolean appendMode = (Boolean) renderRequest.getAttribute(REQ_APPEND_MODE);
        if (Boolean.TRUE.equals(appendMode)) {
            Object v = renderRequest.getAttribute("APPEND_EN_CERRADO");
            if (v instanceof Boolean) {
                renderRequest.setAttribute("PERIODO_CERRADO", (Boolean) v);
            }
            // si no existe APPEND_EN_CERRADO, NO lo pises
        } else {
            // NO pises lo decidido por SEARCH (porque ahí PERIODO_CERRADO representa el período solicitado)
            if (!isSearchCmd) {
                renderRequest.setAttribute("PERIODO_CERRADO", Boolean.valueOf(finalWorkCerrado));
            }
        }

        _log.info(prefix(rid) + "Finalizando render");
        return fwd;
    }

    // =========================
    // SEARCH (sin cache) -> DB y guardar "work" en sesión
    // =========================
    @SuppressWarnings({"rawtypes", "unchecked"})
    private void doSearch(RenderRequest renderRequest, HttpSession session, String tipoSel, String rid, boolean dbg) {
        final long t0 = System.currentTimeMillis();
        final SimpleDateFormat sdf = new SimpleDateFormat("dd/MM/yyyy");
        _log.info(prefix(rid) + "[SEARCH] START");

        final String ns = getNs(renderRequest);

        // -------------------------
        // 1) Params
        // -------------------------
        int mes0Based = pI(renderRequest, ns, "fechaDesdeMes", -1);
        int anio = pI(renderRequest, ns, "fechaDesdeAnio", -1);

        String tercerizadoras = pS(renderRequest, ns, "tipo_debitos_tercerizadoras",
                pS(renderRequest, ns, "tipo_debito", ""));
        tercerizadoras = normalizeTercerizadoraKey(tercerizadoras);

        tipoSel = normalizeTipoSel(tipoSel);

        boolean borradorClearedParam = false;
        try { borradorClearedParam = pB(renderRequest, ns, PARAM_BORRADOR_CLEARED, false); } catch (Exception ignore) {}

        if (!borradorClearedParam) {
            // fallback directo por si pB / namespace no lo ve
            try { borradorClearedParam = ParamUtil.getBoolean(renderRequest, PARAM_BORRADOR_CLEARED, false); } catch (Exception ignore) {}
            if (!borradorClearedParam && Validator.isNotNull(ns)) {
                try { borradorClearedParam = ParamUtil.getBoolean(renderRequest, ns + PARAM_BORRADOR_CLEARED, false); } catch (Exception ignore) {}
            }
        }

        boolean afterReabrirParam = false;
        try { afterReabrirParam = pB(renderRequest, ns, "afterReabrir", false); } catch (Exception ignore) {}

        String prevMode = null;
        try { prevMode = (String) session.getAttribute(SESSION_WORK_MODE); } catch (Exception ignore) {}

        boolean forceBorradorRequested = !borradorClearedParam && (afterReabrirParam
                || "REABIERTO".equalsIgnoreCase(prevMode)
                || "BORRADOR".equalsIgnoreCase(prevMode));

        // -------------------------
        // 2) Fechas
        // -------------------------
        Date fechaDesde = null;
        Date fechaHasta = null;

        try {
            if (mes0Based >= 0 && anio > 0) {
                Calendar calDesde = DateUtils.getCalendarGMTMenos3();
                calDesde.set(Calendar.YEAR, anio);
                calDesde.set(Calendar.MONTH, mes0Based);
                calDesde.set(Calendar.DAY_OF_MONTH, 1);
                calDesde.set(Calendar.HOUR_OF_DAY, 0);
                calDesde.set(Calendar.MINUTE, 0);
                calDesde.set(Calendar.SECOND, 0);
                calDesde.set(Calendar.MILLISECOND, 0);
                fechaDesde = calDesde.getTime();
                fechaHasta = DateUtils.getLastDateOfMonth(fechaDesde, false);
            }
        } catch (Exception e) {
            _log.error(prefix(rid) + "[SEARCH] Error calculando fechaDesde/fechaHasta", e);
        }

        final String workKey = buildCacheKey(anio, mes0Based, tercerizadoras);

        String clearedSessKey = null;
        try { clearedSessKey = (String) session.getAttribute(SESSION_BORRADOR_CLEARED_KEY); } catch (Exception ignore) {}

        boolean borradorClearedBySession = Validator.isNotNull(workKey)
                && Validator.isNotNull(clearedSessKey)
                && workKey.equals(clearedSessKey);

        if (borradorClearedBySession) {
            borradorClearedParam = true; // fuerza skip borrador aunque el param no venga
        }

        _log.info(prefix(rid) + "[SEARCH] borradorCleared: param=" + (borradorClearedParam ? "1" : "0")
                + " sessKey=" + safe(clearedSessKey)
                + " bySession=" + (borradorClearedBySession ? "1" : "0"));

        _log.info(prefix(rid) + "[SEARCH] Contexto:"
                + " tipoSel=" + safe(tipoSel)
                + " terc=" + safe(tercerizadoras)
                + " periodo=" + anio + "-" + String.format("%02d", (mes0Based + 1))
                + " desde=" + fmt(sdf, fechaDesde)
                + " hasta=" + fmt(sdf, fechaHasta)
                + " workKey=" + safe(workKey)
                + " forceBorradorRequested=" + forceBorradorRequested
                + " borradorClearedParam=" + borradorClearedParam);

        // -------------------------
        // 3) Totales (solo para UI, NO para decidir GRABADOS)
        // -------------------------
        List totales = new ArrayList();
        DebitosaTotal debitosaTotal = null;

        try {
            if (fechaHasta != null) {
                debitosaTotal = BusquedaDebitosTercerizadorasServiceUtil.getBuscarTotalesDebitos(fechaHasta, tercerizadoras);
                if (debitosaTotal != null) totales.add(debitosaTotal);
            } else {
                _log.warn(prefix(rid) + "[SEARCH] fechaHasta=null -> no totales");
            }
        } catch (Exception e) {
            _log.error(prefix(rid) + "[SEARCH] Error consultando totales", e);
        }
        if (debitosaTotal == null) debitosaTotal = new DebitosaTotal();

        // -------------------------
        // 4) Flags reales: cerrado + hayGrabados (DB)
        // -------------------------
        boolean periodoSolicitadoCerrado = false;
        try {
            if (fechaDesde != null && fechaHasta != null
                    && Validator.isNotNull(tercerizadoras) && Validator.isNotNull(tipoSel)) {
                periodoSolicitadoCerrado = isPeriodoCerrado(fechaDesde, fechaHasta, tercerizadoras, tipoSel, rid);
            }
        } catch (Exception e) {
            _log.error(prefix(rid) + "[SEARCH] Error evaluando isPeriodoCerrado", e);
        }

        boolean hayGrabadosDb = false;
        try {
            hayGrabadosDb = (fechaHasta != null) && hasGrabadosDb(fechaHasta, tercerizadoras, tipoSel, rid);
        } catch (Exception e) {
            _log.error(prefix(rid) + "[SEARCH] Error evaluando hayGrabadosDb", e);
        }

        _log.info(prefix(rid) + "[SEARCH] Flags:"
                + " cerrado=" + (periodoSolicitadoCerrado ? "SI" : "NO")
                + " hayGrabadosDb=" + (hayGrabadosDb ? "SI" : "NO")
                + " (nota: totalesSize=" + size(totales) + " NO decide flujo)");

        // -------------------------
        // 5) Flujo: GRABADOS -> BORRADOR -> ORIGINALES
        // -------------------------
        List detalleLI = new ArrayList();
        List detalleHO = new ArrayList();
        List detalleRE = new ArrayList();
        List detallePR = new ArrayList();

        String busquedaMode = "NEW";
        boolean borradorDbHasRows = false;

        if (fechaHasta == null) {
            _log.warn(prefix(rid) + "[SEARCH] STOP: fechaHasta=null");
        } else {
            // ---- Paso A: GRABADOS (solo si cerrado o DB dice que hay)
            boolean intentoGrabados = (periodoSolicitadoCerrado || hayGrabadosDb);
            if (intentoGrabados) {
                _log.info(prefix(rid) + "[FLOW] Paso 1/3 GRABADOS: intento=SI (cerrado o hayGrabadosDb)");

                busquedaMode = "LEGACY";
                try {
                    if ("LI".equals(tipoSel)) {
                        detalleLI = (List) BusquedaDebitosTercerizadorasServiceUtil.getBusquedaDebitosaGrabados(
                                WebKeysLiquidaciones.DEBITOS_LIQ_PENDIENTES, fechaHasta, tercerizadoras);
                    } else if ("HO".equals(tipoSel)) {
                        detalleHO = (List) BusquedaDebitosTercerizadorasServiceUtil.getBusquedaDebitosaGrabados(
                                WebKeysLiquidaciones.DEBITOS_HOSPITALES, fechaHasta, tercerizadoras);
                    } else if ("RE".equals(tipoSel)) {
                        detalleRE = (List) BusquedaDebitosTercerizadorasServiceUtil.getBusquedaDebitosaGrabados(
                                WebKeysLiquidaciones.DEBITOS_REINTEGROS, fechaHasta, tercerizadoras);
                    } else if ("PR".equals(tipoSel)) {
                        detallePR = (List) BusquedaDebitosTercerizadorasServiceUtil.getBusquedaDebitosaGrabados(
                                WebKeysLiquidaciones.DEBITOS_PRESTADORES, fechaHasta, tercerizadoras);
                    }
                } catch (Exception e) {
                    _log.error(prefix(rid) + "[FLOW] GRABADOS: error consultando", e);
                }

                boolean grabadosEmpty = isEmptySelByTipo(tipoSel, detalleLI, detalleHO, detalleRE, detallePR);
                _log.info(prefix(rid) + "[FLOW] Paso 1/3 GRABADOS: size="
                        + ("LI".equals(tipoSel) ? size(detalleLI)
                        : "HO".equals(tipoSel) ? size(detalleHO)
                        : "RE".equals(tipoSel) ? size(detalleRE)
                        : "PR".equals(tipoSel) ? size(detallePR) : 0)
                        + " => " + (grabadosEmpty ? "VACIO (continuo)" : "OK (corto)"));

                if (!grabadosEmpty) {
                    // Listo: se corta el flujo acá por prioridad.
                } else {
                    // Si GRABADOS dio vacío, seguimos a BORRADOR/ORIGINALES.
                    busquedaMode = "NEW";
                    detalleLI = new ArrayList();
                    detalleHO = new ArrayList();
                    detalleRE = new ArrayList();
                    detallePR = new ArrayList();
                }
            } else {
                _log.info(prefix(rid) + "[FLOW] Paso 1/3 GRABADOS: intento=NO");
            }

            // ---- Paso B: BORRADOR (solo si no venimos de vaciar y todavía no tenemos datos)
            boolean yaTengoDatos = !isEmptySelByTipo(tipoSel, detalleLI, detalleHO, detalleRE, detallePR);
            if (!yaTengoDatos && !borradorClearedParam && Validator.isNotNull(workKey)) {
                _log.info(prefix(rid) + "[FLOW] Paso 2/3 BORRADOR: intento=SI");

                try {
                    if ("LI".equals(tipoSel)) {
                        List tmp = (List) BusquedaDebitosTercerizadorasServiceUtil.getBusquedaDebitosLiquidacionesStatusBorrador(
                                fechaDesde, fechaHasta, debitosaTotal, tercerizadoras, workKey);
                        borradorDbHasRows = (tmp != null && !tmp.isEmpty());
                        if (borradorDbHasRows) detalleLI = tmp;

                    } else if ("HO".equals(tipoSel)) {
                        List tmp = (List) BusquedaDebitosTercerizadorasServiceUtil.getBusquedaDebitosHospitalesStatusBorrador(
                                fechaDesde, fechaHasta, debitosaTotal, tercerizadoras, workKey);
                        borradorDbHasRows = (tmp != null && !tmp.isEmpty());
                        if (borradorDbHasRows) detalleHO = tmp;

                    } else if ("RE".equals(tipoSel)) {
                        List tmp = (List) BusquedaDebitosTercerizadorasServiceUtil.getBusquedaDebitosReintegrosStatusBorrador(
                                fechaDesde, fechaHasta, debitosaTotal, tercerizadoras, workKey);
                        borradorDbHasRows = (tmp != null && !tmp.isEmpty());
                        if (borradorDbHasRows) detalleRE = tmp;

                    } else if ("PR".equals(tipoSel)) {
                        List tmp = (List) BusquedaDebitosTercerizadorasServiceUtil.getBusquedaDebitosPrestadoresStatusBorrador(
                                fechaDesde, fechaHasta, debitosaTotal, tercerizadoras, workKey);
                        borradorDbHasRows = (tmp != null && !tmp.isEmpty());
                        if (borradorDbHasRows) detallePR = tmp;
                    }
                } catch (Exception e) {
                    _log.error(prefix(rid) + "[FLOW] BORRADOR: error consultando", e);
                    borradorDbHasRows = false;
                }

                _log.info(prefix(rid) + "[FLOW] Paso 2/3 BORRADOR: "
                        + (borradorDbHasRows ? "HAY (corto)" : "NO HAY (continuo)")
                        + " size="
                        + ("LI".equals(tipoSel) ? size(detalleLI)
                        : "HO".equals(tipoSel) ? size(detalleHO)
                        : "RE".equals(tipoSel) ? size(detalleRE)
                        : "PR".equals(tipoSel) ? size(detallePR) : 0));

                if (borradorDbHasRows) {
                    busquedaMode = "BORRADOR";
                }
            } else if (!yaTengoDatos) {
                _log.info(prefix(rid) + "[FLOW] Paso 2/3 BORRADOR: intento=NO (borradorClearedParam=1)");
            }

            // ---- Paso C: ORIGINALES (si sigue vacío)
            yaTengoDatos = !isEmptySelByTipo(tipoSel, detalleLI, detalleHO, detalleRE, detallePR);
            if (!yaTengoDatos) {
                _log.info(prefix(rid) + "[FLOW] Paso 3/3 ORIGINALES: intento=SI (sin _con_status)");

                try {
                    if ("LI".equals(tipoSel)) {
                        // Debe terminar en reporte_debito_liq_pendientes(...)
                        detalleLI = (List) BusquedaDebitosTercerizadorasServiceUtil.getBusquedaDebitosaLiquidacionesPendientes(
                                fechaDesde, fechaHasta, debitosaTotal, tercerizadoras);

                    } else if ("HO".equals(tipoSel)) {
                        detalleHO = (List) BusquedaDebitosTercerizadorasServiceUtil.getBusquedaDebitosaHospitales(
                                fechaDesde, fechaHasta, debitosaTotal, tercerizadoras);

                    } else if ("RE".equals(tipoSel)) {
                        detalleRE = (List) BusquedaDebitosTercerizadorasServiceUtil.getBusquedaDebitosReintegros(
                                fechaDesde, fechaHasta, debitosaTotal, tercerizadoras);

                    } else if ("PR".equals(tipoSel)) {
                        detallePR = (List) BusquedaDebitosTercerizadorasServiceUtil.getBusquedaDebitosPrestadores(
                                fechaDesde, fechaHasta, debitosaTotal, tercerizadoras);
                    }
                } catch (Exception e) {
                    _log.error(prefix(rid) + "[FLOW] ORIGINALES: error consultando", e);
                }

                _log.info(prefix(rid) + "[FLOW] Paso 3/3 ORIGINALES: size="
                        + ("LI".equals(tipoSel) ? size(detalleLI)
                        : "HO".equals(tipoSel) ? size(detalleHO)
                        : "RE".equals(tipoSel) ? size(detalleRE)
                        : "PR".equals(tipoSel) ? size(detallePR) : 0));

                busquedaMode = "NEW";
            }
        }

        // -------------------------
        // 6) Guardar en sesión + request
        // -------------------------
        session.setAttribute(SESSION_TOTALES_KEY, (totales != null) ? totales : new ArrayList());

        session.setAttribute(SESSION_WORK_ANIO, Integer.valueOf(anio));
        session.setAttribute(SESSION_WORK_MES0, Integer.valueOf(mes0Based));
        session.setAttribute(SESSION_WORK_TERC, tercerizadoras);
        session.setAttribute(SESSION_WORK_FECHA_DESDE, fechaDesde);
        session.setAttribute(SESSION_WORK_FECHA_HASTA, fechaHasta);
        session.setAttribute(SESSION_WORK_SOURCE_KEY, workKey);
        session.setAttribute(SESSION_WORK_BUSQUEDA_MODE, busquedaMode);
        session.setAttribute(SESSION_WORK_TIPO_SEL, tipoSel);

        session.setAttribute(SESSION_WORK_MODE, busquedaMode);
        session.setAttribute(SESSION_WORK_CERRADO_TIPO, null);
        renderRequest.setAttribute("DEBITOS_CERRADO_TIPO", null);

        session.setAttribute(SESSION_WORK_LI, (detalleLI != null) ? detalleLI : new ArrayList());
        session.setAttribute(SESSION_WORK_HO, (detalleHO != null) ? detalleHO : new ArrayList());
        session.setAttribute(SESSION_WORK_RE, (detalleRE != null) ? detalleRE : new ArrayList());
        session.setAttribute(SESSION_WORK_PR, (detallePR != null) ? detallePR : new ArrayList());

        session.setAttribute(SESSION_STG_LI, new ArrayList());
        session.setAttribute(SESSION_STG_HO, new ArrayList());
        session.setAttribute(SESSION_STG_RE, new ArrayList());
        session.setAttribute(SESSION_STG_PR, new ArrayList());
        session.setAttribute(SESSION_STG_SOURCE_KEY, null);

        applyWorkFromSessionToRequest(session, renderRequest, tipoSel);

        renderRequest.setAttribute(REQ_CACHE_KEY, workKey);
        renderRequest.setAttribute(REQ_WORK_CACHE_KEY, workKey);
        renderRequest.setAttribute("DEBITOS_BUSQUEDA_MODE", busquedaMode);
        renderRequest.removeAttribute(REQ_APPEND_MODE);
        if ("BORRADOR".equalsIgnoreCase(busquedaMode)) {
            // si efectivamente hay borrador, no tiene sentido mantener “cleared”
            session.setAttribute(SESSION_BORRADOR_CLEARED_KEY, null);
        }
        _log.info(prefix(rid) + "[SEARCH] END mode=" + busquedaMode
                + " cerrado=" + (periodoSolicitadoCerrado ? "SI" : "NO")
                + " hayGrabadosDb=" + (hayGrabadosDb ? "SI" : "NO")
                + " borradorDb=" + (borradorDbHasRows ? "SI" : "NO")
                + " sizes(LI/HO/RE/PR)=" + size((List) session.getAttribute(SESSION_WORK_LI)) + "/"
                + size((List) session.getAttribute(SESSION_WORK_HO)) + "/"
                + size((List) session.getAttribute(SESSION_WORK_RE)) + "/"
                + size((List) session.getAttribute(SESSION_WORK_PR))
                + " totalesSize=" + size((List) session.getAttribute(SESSION_TOTALES_KEY))
                + " elapsedMs=" + (System.currentTimeMillis() - t0));
    }

    /**
     * Helper simple (sin inner class / sin lambdas) para no repetir el mismo if 3 veces.
     */
    @SuppressWarnings("rawtypes")
    private boolean isEmptySelByTipo(String tipoSel, List detalleLI, List detalleHO, List detalleRE, List detallePR) {
        if ("HO".equals(tipoSel)) return (detalleHO == null || detalleHO.isEmpty());
        if ("LI".equals(tipoSel)) return (detalleLI == null || detalleLI.isEmpty());
        if ("RE".equals(tipoSel)) return (detalleRE == null || detalleRE.isEmpty());
        if ("PR".equals(tipoSel)) return (detallePR == null || detallePR.isEmpty());
        return true;
    }

    /**
     * Fuente única de verdad para “hay grabados”.
     * Implementala llamando al SP existe_reporte_grabado_debito_tercerizadoras(fechaHasta, terc, tipoDb)
     * o reutilizando el mismo método util/dao que usa HayReporteTercerizadoraGrabadoAction.
     */
    private boolean hasGrabadosDb(Date fechaHasta, String terc, String tipoSel, String rid) throws SystemException {
        final String tipoDb = mapTipoSelToDbTipo(tipoSel);
        return BusquedaDebitosTercerizadorasServiceUtil.existeReporteGrabadoDebitoTercerizadoras(fechaHasta, terc, tipoDb);
    }

    private String mapTipoSelToDbTipo(String tipoSel) {
        if ("LI".equalsIgnoreCase(tipoSel)) return WebKeysLiquidaciones.DEBITOS_LIQ_PENDIENTES;
        if ("HO".equalsIgnoreCase(tipoSel)) return WebKeysLiquidaciones.DEBITOS_HOSPITALES;
        if ("RE".equalsIgnoreCase(tipoSel)) return WebKeysLiquidaciones.DEBITOS_REINTEGROS;
        if ("PR".equalsIgnoreCase(tipoSel)) return WebKeysLiquidaciones.DEBITOS_PRESTADORES;
        return String.valueOf(tipoSel);
    }

    private String normalizeTercerizadoraKey(String tercerizadoras) {
        if (tercerizadoras == null) return "";
        return tercerizadoras.trim().toUpperCase();
    }

    // =========================
    // DELETE (sin cache) -> muta listas WORK en sesión
    // =========================
    @SuppressWarnings({"rawtypes", "unchecked"})
    private void doDeleteDetalle(ActionRequest actionRequest, ActionResponse actionResponse, String rid) {
        HttpServletRequest httpReq = PortalUtil.getHttpServletRequest(actionRequest);
        HttpSession session = httpReq.getSession();

        _log.info(prefix(rid) + "Iniciando doDeleteDetalle");

        String ns = null;
        try {
            String portletId = PortalUtil.getPortletId(actionRequest);
            ns = PortalUtil.getPortletNamespace(portletId);
        } catch (Exception ignore) {}

        String ids = ParamUtil.getString(actionRequest, "ids", "");
        if (Validator.isNull(ids) && ns != null) ids = ParamUtil.getString(actionRequest, ns + "ids", "");
        ids = (ids != null) ? ids.trim() : "";

        String tipoSel = ParamUtil.getString(actionRequest, "tipo_proceso",
                ParamUtil.getString(actionRequest, "tipoDebito", null));
        if (Validator.isNull(tipoSel) && ns != null) {
            tipoSel = ParamUtil.getString(actionRequest, ns + "tipo_proceso",
                    ParamUtil.getString(actionRequest, ns + "tipoDebito", null));
        }
        tipoSel = normalizeTipoSel(tipoSel);

        // Estado inicial (para diagnóstico)
        List li = (List) session.getAttribute(SESSION_WORK_LI);
        List ho = (List) session.getAttribute(SESSION_WORK_HO);
        List re = (List) session.getAttribute(SESSION_WORK_RE);
        List pr = (List) session.getAttribute(SESSION_WORK_PR);

        if (li == null) li = new ArrayList();
        if (ho == null) ho = new ArrayList();
        if (re == null) re = new ArrayList();
        if (pr == null) pr = new ArrayList();

        _log.info(prefix(rid) + "[DELETE][IN] tipoSel=" + safe(tipoSel)
                + " ids.len=" + ids.length()
                + " sizesBefore LI=" + size(li) + " HO=" + size(ho) + " RE=" + size(re) + " PR=" + size(pr)
                + " ids.sample=" + safe(ids.length() > 300 ? ids.substring(0, 300) + "..." : ids));

        if (Validator.isNull(ids)) {
            _log.warn(prefix(rid) + "[DELETE] ids vacío. Nada para borrar.");
            actionResponse.setRenderParameter(Constants.CMD, "deleteDetalle");
            actionResponse.setRenderParameter("cacheKey", WORK_KEY);
            if (Validator.isNotNull(tipoSel)) actionResponse.setRenderParameter("tipo_proceso", tipoSel);
            return;
        }

        String[] parts = ids.split(";");
        Map toDeleteByTipo = new LinkedHashMap(); // tipo -> List<Integer>

        int tokens = 0;
        int parsed = 0;
        int bad = 0;

        for (int i = 0; i < parts.length; i++) {
            String p = (parts[i] != null) ? parts[i].trim() : "";
            if (p.length() == 0) continue;

            tokens++;

            int idx = p.indexOf(':');
            if (idx <= 0) { bad++; continue; }

            String tipo = p.substring(0, idx).trim().toUpperCase();
            String sIndex = p.substring(idx + 1).trim();

            try {
                Integer n = Integer.valueOf(Integer.parseInt(sIndex));

                List list = (List) toDeleteByTipo.get(tipo);
                if (list == null) {
                    list = new ArrayList();
                    toDeleteByTipo.put(tipo, list);
                }

                // dedup suave
                if (!list.contains(n)) list.add(n);

                parsed++;
            } catch (Exception e) {
                bad++;
                _log.warn(prefix(rid) + "[DELETE] No pude parsear index en '" + p + "'");
            }
        }

        // Log de intención
        _log.info(prefix(rid) + "[DELETE][PARSE] tokens=" + tokens
                + " parsed=" + parsed
                + " bad=" + bad
                + " req{LI=" + size((List) toDeleteByTipo.get("LI"))
                + ",HO=" + size((List) toDeleteByTipo.get("HO"))
                + ",RE=" + size((List) toDeleteByTipo.get("RE"))
                + ",PR=" + size((List) toDeleteByTipo.get("PR")) + "}");

        // ALERTA: borrado total (no bloquea; solo evidencia)
        if (size((List) toDeleteByTipo.get("PR")) > 0 && size((List) toDeleteByTipo.get("PR")) == size(pr)) {
            _log.warn(prefix(rid) + "[DELETE][PR] SE PIDE BORRAR TODO PR: indices=" + size((List) toDeleteByTipo.get("PR"))
                    + " targetSize=" + size(pr) + " (esto NO es normal si no hay 'seleccionar todo')");
        }
        if (size((List) toDeleteByTipo.get("RE")) > 0 && size((List) toDeleteByTipo.get("RE")) == size(re)) {
            _log.warn(prefix(rid) + "[DELETE][RE] SE PIDE BORRAR TODO RE: indices=" + size((List) toDeleteByTipo.get("RE"))
                    + " targetSize=" + size(re));
        }

        int removed = 0;
        removed += removeFrom(li, (List) toDeleteByTipo.get("LI"), "LI");
        removed += removeFrom(ho, (List) toDeleteByTipo.get("HO"), "HO");
        removed += removeFrom(re, (List) toDeleteByTipo.get("RE"), "RE");
        removed += removeFrom(pr, (List) toDeleteByTipo.get("PR"), "PR");

        session.setAttribute(SESSION_WORK_LI, li);
        session.setAttribute(SESSION_WORK_HO, ho);
        session.setAttribute(SESSION_WORK_RE, re);
        session.setAttribute(SESSION_WORK_PR, pr);

        _log.info(prefix(rid) + "[DELETE][OUT] removed=" + removed
                + " sizesAfter LI=" + size(li) + " HO=" + size(ho) + " RE=" + size(re) + " PR=" + size(pr));

        actionResponse.setRenderParameter(Constants.CMD, "deleteDetalle");
        actionResponse.setRenderParameter("cacheKey", WORK_KEY); // compat
        if (Validator.isNotNull(tipoSel)) actionResponse.setRenderParameter("tipo_proceso", tipoSel);

        _log.info(prefix(rid) + "Finalizando doDeleteDetalle");
    }

    // ============================================================
// APPEND SEARCH (FIX: excluir ocupados por BORRADOR en otros períodos)
// - Mantiene TODO lo existente.
// - Agrega un filtro adicional: ocupados globales (solo BORRADOR) usando get_busqueda_debitos_ocupados.
// - Comparación por "clave mínima": tipo + id + (factura/doc) para evitar acoplarse a itemKey().
// ============================================================
    @SuppressWarnings({"rawtypes", "unchecked"})
    private void doAppendSearch(RenderRequest renderRequest, HttpSession session, String tipoSel, String rid, boolean dbg) {
        final long t0 = System.currentTimeMillis();
        final String ns = getNs(renderRequest);

        _log.info(prefix(rid) + "Iniciando doAppendSearch");

        tipoSel = normalizeTipoSel(tipoSel);

        boolean reuseStaging = pB(renderRequest, ns, PARAM_APPEND_REUSE, false);

        String stgSourceKey = (String) session.getAttribute(SESSION_STG_SOURCE_KEY);
        int stgSelSize =
                "LI".equals(tipoSel) ? size((List) session.getAttribute(SESSION_STG_LI)) :
                        "HO".equals(tipoSel) ? size((List) session.getAttribute(SESSION_STG_HO)) :
                                "RE".equals(tipoSel) ? size((List) session.getAttribute(SESSION_STG_RE)) :
                                        "PR".equals(tipoSel) ? size((List) session.getAttribute(SESSION_STG_PR)) : 0;

        // Reuso SOLO si hay staging real y corresponde al mismo sourceKey
        if (reuseStaging && stgSelSize > 0 && Validator.isNotNull(stgSourceKey)) {
            renderRequest.setAttribute(REQ_APPEND_MODE, Boolean.TRUE);
            renderRequest.setAttribute(REQ_CACHE_KEY, WORK_KEY);
            renderRequest.setAttribute(REQ_WORK_CACHE_KEY, WORK_KEY);
            renderRequest.setAttribute(REQ_ANEXAR_SOURCE_KEY, stgSourceKey);

            applyWorkFromSessionToRequest(session, renderRequest, tipoSel);
            applyStagingFromSessionToRequest(session, renderRequest, tipoSel);

            _log.info(prefix(rid) + "[APPEND-REUSE] stgSelSize=" + stgSelSize
                    + " stgSourceKey=" + safe(stgSourceKey)
                    + " elapsedMs=" + (System.currentTimeMillis() - t0));
            return;
        }

        if (reuseStaging) {
            _log.info(prefix(rid) + "[APPEND-REUSE-SKIP] reuseRequested=1 but stgSelSize=" + stgSelSize
                    + " stgSourceKey=" + safe(stgSourceKey) + " => recalculo");
        }

        // -------------------------
        // 1) Params + NORMALIZACIÓN CANÓNICA
        // -------------------------
        int mes0Based = pI(renderRequest, ns, "fechaDesdeMes", -1);
        int anio = pI(renderRequest, ns, "fechaDesdeAnio", -1);

        String tercerizadoras = pS(renderRequest, ns, "tipo_debitos_tercerizadoras",
                pS(renderRequest, ns, "tipo_debito", ""));
        tercerizadoras = normalizeTercerizadoraKey(tercerizadoras);

        String sourceKey = buildCacheKey(anio, mes0Based, tercerizadoras);

        String workSourceKey = (String) session.getAttribute(SESSION_WORK_SOURCE_KEY);
        boolean sameAsWorkPeriod = Validator.isNotNull(workSourceKey) && workSourceKey.equals(sourceKey);

        Date fechaDesde = null;
        Date fechaHasta = null;

        try {
            if (mes0Based >= 0 && anio > 0) {
                Calendar calDesde = DateUtils.getCalendarGMTMenos3();
                calDesde.set(Calendar.YEAR, anio);
                calDesde.set(Calendar.MONTH, mes0Based);
                calDesde.set(Calendar.DAY_OF_MONTH, 1);
                calDesde.set(Calendar.HOUR_OF_DAY, 0);
                calDesde.set(Calendar.MINUTE, 0);
                calDesde.set(Calendar.SECOND, 0);
                calDesde.set(Calendar.MILLISECOND, 0);
                fechaDesde = calDesde.getTime();
                fechaHasta = DateUtils.getLastDateOfMonth(fechaDesde, false);
            }
        } catch (Exception e) {
            _log.error(prefix(rid) + "[APPEND] Error calculando fechaDesde/fechaHasta", e);
        }

        // -------------------------
        // 2) Flags reales + Totales (solo insumo para SPs)
        // -------------------------
        boolean periodoSolicitadoCerrado = isPeriodoCerrado(fechaDesde, fechaHasta, tercerizadoras, tipoSel, rid);

        List totales = new ArrayList();
        DebitosaTotal debitosaTotal = null;
        try {
            if (fechaHasta != null) {
                debitosaTotal = BusquedaDebitosTercerizadorasServiceUtil.getBuscarTotalesDebitos(fechaHasta, tercerizadoras);
                if (debitosaTotal != null) totales.add(debitosaTotal);
            }
        } catch (Exception e) {
            _log.error(prefix(rid) + "[APPEND][TOTALES] Error", e);
        }
        if (debitosaTotal == null) debitosaTotal = new DebitosaTotal();

        // -------------------------
        // 3) EXCLUDED KEYS = WORK + BORRADOR(DB-período) + GRABADOS(DB-período)
        // -------------------------
        Set excludedKeys = new HashSet();

        // 3.a) WORK (sesión)
        excludedKeys.addAll(buildKeysFromWorkSession(session, tipoSel));

        // 3.b) BORRADOR (DB) para ESTE período+terc+workKey (sourceKey)
        excludedKeys.addAll(buildKeysFromBorradorPeriodo(
                tipoSel, fechaDesde, fechaHasta, debitosaTotal, tercerizadoras, sourceKey, rid
        ));

        // 3.c) GRABADOS/CERRADO (DB) para ESTE período+terc
        excludedKeys.addAll(buildKeysFromClosedPeriodo(tipoSel, fechaHasta, tercerizadoras, rid));

        // 3.d) NUEVO: ocupados globales (solo BORRADOR) en otros períodos => clave mínima
        //      - No depende de workKey
        //      - Se usa sólo para filtrar candidatos del append
        Set borradorGlobalLooseKeys = new HashSet();
        try {
            borradorGlobalLooseKeys = buildOcupadosBorradorLooseKeys(tipoSel, tercerizadoras, fechaDesde, fechaHasta, rid);
        } catch (Exception e) {
            // fail-open: si no puedo leer, no rompo el append
            _log.error(prefix(rid) + "[APPEND][OCUPADOS-BORRADOR] Error leyendo ocupados globales (fail-open)", e);
            borradorGlobalLooseKeys = new HashSet();
        }

        // -------------------------
        // 4) BASE de candidatos (SIEMPRE “ORIGINAL”, nunca GRABADOS)
        // -------------------------
        String rawMode;
        if (sameAsWorkPeriod) {
            rawMode = (String) session.getAttribute(SESSION_WORK_BUSQUEDA_MODE);
            if (Validator.isNull(rawMode)) rawMode = pS(renderRequest, ns, "busquedaMode", "NEW");
        } else {
            rawMode = pS(renderRequest, ns, "busquedaMode", "NEW");
        }

        String mode = normalizeBusquedaMode(rawMode, "NEW");

        List baseSel = new ArrayList();
        if (fechaHasta != null) {
            baseSel = seedBaseForOpenAppend(
                    tipoSel, mode, fechaDesde, fechaHasta, debitosaTotal, tercerizadoras, rid
            );
        }

        // -------------------------
        // 4.b) NUEVO: filtrar base por ocupados globales de BORRADOR (otros períodos)
        //      Esto resuelve el bug sin tocar el resto.
        // -------------------------
        int baseBeforeGlobal = (baseSel != null ? baseSel.size() : -1);
        if (baseSel != null && !baseSel.isEmpty() && borradorGlobalLooseKeys != null && !borradorGlobalLooseKeys.isEmpty()) {
            baseSel = filterOutByLooseKeys(tipoSel, baseSel, borradorGlobalLooseKeys, rid, "BORRADOR-GLOBAL");
        }
        int baseAfterGlobal = (baseSel != null ? baseSel.size() : -1);

        // -------------------------
        // 5) Filtrado final existente (WORK + borrador-período + grabados-período)
        // -------------------------
        List filteredSel = filterOutByKeys(tipoSel, baseSel, excludedKeys, rid);

        // staging por tipo seleccionado
        List stgLI = new ArrayList();
        List stgHO = new ArrayList();
        List stgRE = new ArrayList();
        List stgPR = new ArrayList();

        if ("LI".equals(tipoSel)) stgLI = filteredSel;
        else if ("HO".equals(tipoSel)) stgHO = filteredSel;
        else if ("RE".equals(tipoSel)) stgRE = filteredSel;
        else if ("PR".equals(tipoSel)) stgPR = filteredSel;

        session.setAttribute(SESSION_STG_LI, stgLI);
        session.setAttribute(SESSION_STG_HO, stgHO);
        session.setAttribute(SESSION_STG_RE, stgRE);
        session.setAttribute(SESSION_STG_PR, stgPR);
        session.setAttribute(SESSION_STG_SOURCE_KEY, sourceKey);

        renderRequest.setAttribute(REQ_APPEND_MODE, Boolean.TRUE);
        renderRequest.setAttribute(REQ_CACHE_KEY, WORK_KEY);
        renderRequest.setAttribute(REQ_WORK_CACHE_KEY, WORK_KEY);
        renderRequest.setAttribute(REQ_ANEXAR_SOURCE_KEY, sourceKey);

        renderRequest.setAttribute("PERIODO_CERRADO", Boolean.valueOf(periodoSolicitadoCerrado));
        renderRequest.setAttribute("APPEND_EN_CERRADO", Boolean.valueOf(periodoSolicitadoCerrado));

        applyWorkFromSessionToRequest(session, renderRequest, tipoSel);
        applyStagingFromSessionToRequest(session, renderRequest, tipoSel);

        _log.info(prefix(rid) + "[APPEND] tipoSel=" + safe(tipoSel)
                + " terc=" + safe(tercerizadoras)
                + " periodo=" + anio + "-" + pad2(mes0Based + 1)
                + " sameAsWorkPeriod=" + (sameAsWorkPeriod ? "1" : "0")
                + " sourceKey=" + safe(sourceKey)
                + " cerrado=" + (periodoSolicitadoCerrado ? "1" : "0")
                + " mode=" + safe(mode)
                + " baseSize=" + (baseSel != null ? baseSel.size() : -1)
                + " baseBeforeGlobal=" + baseBeforeGlobal
                + " baseAfterGlobal=" + baseAfterGlobal
                + " borradorGlobalKeys=" + (borradorGlobalLooseKeys != null ? borradorGlobalLooseKeys.size() : -1)
                + " excludedKeys=" + excludedKeys.size()
                + " stagingSizeSel=" + (filteredSel != null ? filteredSel.size() : -1)
                + " elapsedMs=" + (System.currentTimeMillis() - t0));

        _log.info(prefix(rid) + "Finalizando doAppendSearch");
    }

    // ------------------------------------------------------------
// Ocupados globales (solo BORRADOR) -> devuelve "claves mínimas"
// clave mínima = tipoSel + '|' + id + '|' + factura/doc
// ------------------------------------------------------------
    @SuppressWarnings({"rawtypes", "unchecked"})
    private Set buildOcupadosBorradorLooseKeys(String tipoSel, String terc, Date fechaDesde, Date fechaHasta, String rid) {
        Set out = new HashSet();

        if (Validator.isNull(tipoSel) || Validator.isNull(terc)) return out;

        // Rango acotado (performance): +/- 36 meses alrededor del período consultado.
        // Si falta período, fallback conservador: +/- 36 meses desde hoy.
        java.sql.Date sqlDesde;
        java.sql.Date sqlHasta;

        RangeDates r = calcOcupadosRange(fechaDesde, fechaHasta);
        sqlDesde = r.sqlDesde;
        sqlHasta = r.sqlHasta;

        // Solo borrador global (no estables, no cerrados) => resuelve el bug específico.
        boolean incluirEstables = false;
        boolean incluirBorrador = true;
        boolean incluirCerrado  = false;

        List<String> raw = queryGetBusquedaDebitosOcupados(tipoSel, terc, sqlDesde, sqlHasta,
                incluirEstables, incluirBorrador, incluirCerrado, rid);

        int bad = 0;
        for (int i = 0; raw != null && i < raw.size(); i++) {
            String k = raw.get(i);
            String lk = looseKeyFromSqlOcupado(tipoSel, terc, k);
            if (Validator.isNull(lk)) {
                bad++;
                continue;
            }
            out.add(lk);
        }

        _log.info(prefix(rid) + "[APPEND][OCUPADOS-BORRADOR] rawKeys=" + (raw != null ? raw.size() : -1)
                + " looseKeys=" + out.size()
                + " bad=" + bad
                + " tipoSel=" + safe(tipoSel)
                + " terc=" + safe(terc)
                + " rango=" + sqlDesde + " .. " + sqlHasta);

        return out;
    }

    private static final class RangeDates {
        java.sql.Date sqlDesde;
        java.sql.Date sqlHasta;
    }

    private RangeDates calcOcupadosRange(Date fechaDesde, Date fechaHasta) {
        RangeDates r = new RangeDates();

        Calendar c = DateUtils.getCalendarGMTMenos3();

        Date base = (fechaDesde != null ? fechaDesde : new Date());
        c.setTime(base);
        c.add(Calendar.MONTH, -36);
        c.set(Calendar.DAY_OF_MONTH, 1);
        c.set(Calendar.HOUR_OF_DAY, 0);
        c.set(Calendar.MINUTE, 0);
        c.set(Calendar.SECOND, 0);
        c.set(Calendar.MILLISECOND, 0);
        r.sqlDesde = new java.sql.Date(c.getTimeInMillis());

        Date endBase = (fechaHasta != null ? fechaHasta : new Date());
        c.setTime(endBase);
        c.add(Calendar.MONTH, +36);
        c.set(Calendar.DAY_OF_MONTH, 1);
        c.set(Calendar.HOUR_OF_DAY, 0);
        c.set(Calendar.MINUTE, 0);
        c.set(Calendar.SECOND, 0);
        c.set(Calendar.MILLISECOND, 0);
        // sql function hace < hasta_excl internamente; le pasamos un "hasta" dentro del mes final
        r.sqlHasta = new java.sql.Date(c.getTimeInMillis());

        return r;
    }

    // ------------------------------------------------------------
// JDBC directo a la función public.get_busqueda_debitos_ocupados
// (aislado y fail-open)
// ------------------------------------------------------------
    private List<String> queryGetBusquedaDebitosOcupados(
            String tipoSel,
            String terc,
            java.sql.Date desde,
            java.sql.Date hasta,
            boolean incluirEstables,
            boolean incluirBorrador,
            boolean incluirCerrado,
            String rid
    ) {
        java.sql.Connection con = null;
        java.sql.PreparedStatement ps = null;
        java.sql.ResultSet rs = null;

        ArrayList<String> out = new ArrayList<String>();

        final String sql =
                "SELECT clave " +
                        "FROM public.get_busqueda_debitos_ocupados(?::varchar, ?::varchar, ?::date, ?::date, ?::boolean, ?::boolean, ?::boolean)";

        try {
            con = ar.com.ospim.util.ConnectionHelper.getConnection();
            ps = con.prepareStatement(sql);

            ps.setString(1, tipoSel);
            ps.setString(2, terc);

            if (desde != null) ps.setDate(3, desde); else ps.setNull(3, java.sql.Types.DATE);
            if (hasta != null) ps.setDate(4, hasta); else ps.setNull(4, java.sql.Types.DATE);

            ps.setBoolean(5, incluirEstables);
            ps.setBoolean(6, incluirBorrador);
            ps.setBoolean(7, incluirCerrado);

            rs = ps.executeQuery();
            while (rs != null && rs.next()) {
                String k = rs.getString("clave");
                if (k != null) out.add(k);
            }

            return out;

        } catch (Exception e) {
            _log.error(prefix(rid) + "[APPEND][OCUPADOS-DB] Error ejecutando get_busqueda_debitos_ocupados (fail-open).", e);
            return out;
        } finally {
            try { if (rs != null) rs.close(); } catch (Exception ignore) {}
            ar.com.ospim.util.ConnectionHelper.cerrar(ps, con);
        }
    }

    // ------------------------------------------------------------
// Convierte la clave SQL (tipo_norm|terc|id|factura/doc) a clave mínima:
// tipoSel|id|factura/doc
// - Verifica terc para evitar mezclar.
// ------------------------------------------------------------
    private String looseKeyFromSqlOcupado(String tipoSel, String terc, String sqlKey) {
        if (Validator.isNull(sqlKey) || Validator.isNull(tipoSel) || Validator.isNull(terc)) return null;

        // Esperado: DEBITOS_*|TERC|ID|X
        String[] p = sqlKey.split("\\|", -1);
        if (p == null || p.length < 4) return null;

        String tercKey = (p[1] != null) ? p[1].trim().toUpperCase() : "";
        if (!tercKey.equals((terc != null ? terc.trim().toUpperCase() : ""))) {
            return null; // no mezclar
        }

        String id = (p[2] != null) ? p[2].trim() : "";
        String x  = (p[3] != null) ? p[3].trim().toUpperCase() : "";

        if (id.length() == 0 || x.length() == 0) return null;

        return tipoSel.toUpperCase() + "|" + id + "|" + x;
    }

    // ------------------------------------------------------------
// Filtra lista por clave mínima derivada del ítem
// clave mínima ítem = tipoSel|id|factura/doc (por tipo)
// ------------------------------------------------------------
    @SuppressWarnings({"rawtypes", "unchecked"})
    private List filterOutByLooseKeys(String tipoSel, List base, Set excludedLooseKeys, String rid, String tag) {
        if (base == null || base.isEmpty()) return (base != null ? base : new ArrayList());
        if (excludedLooseKeys == null || excludedLooseKeys.isEmpty()) return base;

        List out = new ArrayList(base.size());

        int noKey = 0;
        int dropped = 0;

        for (int i = 0; i < base.size(); i++) {
            Object o = base.get(i);
            String lk = looseKeyFromItem(tipoSel, o);

            if (Validator.isNull(lk)) {
                noKey++;
                out.add(o); // fail-open
                continue;
            }

            if (excludedLooseKeys.contains(lk)) {
                dropped++;
                continue;
            }

            out.add(o);
        }

        if (dropped > 0 || noKey > 0) {
            _log.info(prefix(rid) + "[APPEND][" + tag + "] dropped=" + dropped
                    + " noKey=" + noKey
                    + " in=" + base.size()
                    + " out=" + out.size()
                    + " excludedLoose=" + excludedLooseKeys.size()
                    + " tipoSel=" + safe(tipoSel));
        }

        return out;
    }

    private String looseKeyFromItem(String tipoSel, Object o) {
        if (o == null || Validator.isNull(tipoSel)) return null;

        String t = tipoSel.trim().toUpperCase();

        // ID y X por tipo
        String id = null;
        String x  = null;

        if ("LI".equals(t) || "HO".equals(t) || "PR".equals(t)) {
            // Factura como "X"
            x = firstNonEmptyUpper(o, new String[]{"getFactura", "getNumeroFactura", "getNumComprobante"});
        } else if ("RE".equals(t)) {
            // Documento como "X"
            x = firstNonEmptyUpper(o, new String[]{"getDocumento", "getNumeroDocumento", "getDocuNumero"});
        }

        // ID por tipo (mejor esfuerzo)
        if ("LI".equals(t)) {
            // Preferir getNumero() (BigDecimal) si existe; fallback a idLiquidacion int
            id = firstNonEmptyNumeric(o, new String[]{"getNumero", "getIdLiquidacion", "getIdLiquidacionInt", "getVIdLiquidacion"});
        } else if ("HO".equals(t)) {
            // En HO el SQL usa orden_pago_id. Si el bean no lo tiene, a veces viene en ordenPago como string numérico.
            id = firstNonEmptyNumeric(o, new String[]{"getNumero"}); // si existe, ideal
            if (Validator.isNull(id)) {
                String op = firstNonEmptyUpper(o, new String[]{"getOrdenPago"});
                id = parseNumericString(op);
            }
            if (Validator.isNull(id)) {
                // último fallback (peor): idLiquidacion
                id = firstNonEmptyNumeric(o, new String[]{"getIdLiquidacion"});
            }
        } else if ("PR".equals(t)) {
            id = firstNonEmptyNumeric(o, new String[]{"getNumero", "getRegistroId", "getRegistroIdInt", "getIdLiquidacion"});
        } else if ("RE".equals(t)) {
            id = firstNonEmptyNumeric(o, new String[]{"getNumReintegro", "getIdReintegro", "getNumero"});
        }

        if (Validator.isNull(id) || Validator.isNull(x)) return null;

        return t + "|" + id + "|" + x;
    }

// -------- reflection helpers (aislados) --------

    private String firstNonEmptyUpper(Object o, String[] getters) {
        String v = getByReflection(o, getters);
        if (v == null) return null;
        String t = v.trim();
        return (t.length() == 0) ? null : t.toUpperCase();
    }

    private String firstNonEmptyNumeric(Object o, String[] getters) {
        for (int i = 0; getters != null && i < getters.length; i++) {
            Object v = invoke0(o, getters[i]);
            if (v == null) continue;

            if (v instanceof java.math.BigDecimal) {
                java.math.BigDecimal b = ((java.math.BigDecimal) v).stripTrailingZeros();
                return b.toPlainString();
            }
            if (v instanceof Number) {
                long n = ((Number) v).longValue();
                if (n > 0) return String.valueOf(n);
            }
            // a veces viene como String
            if (v instanceof String) {
                String s = parseNumericString((String) v);
                if (s != null) return s;
            }
        }
        return null;
    }

    private String parseNumericString(String s) {
        if (s == null) return null;
        String t = s.trim();
        if (t.length() == 0) return null;
        // aceptar solo dígitos (sin romper)
        for (int i = 0; i < t.length(); i++) {
            char c = t.charAt(i);
            if (c < '0' || c > '9') return null;
        }
        // no devolver "0"
        if ("0".equals(t)) return null;
        return t;
    }

