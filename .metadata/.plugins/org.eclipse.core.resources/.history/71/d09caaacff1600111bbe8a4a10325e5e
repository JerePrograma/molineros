    // ============================================================
// ANEXAR (CORREGIDO)
// - Ordena índices DESC por tipo para evitar corrimiento al remover por index
// - Dedupe de índices
// - Si staging queda vacío total, limpia SESSION_STG_SOURCE_KEY
// ============================================================
    @SuppressWarnings({"rawtypes", "unchecked"})
    private void doAnexarDetalle(ActionRequest actionRequest, ActionResponse actionResponse, String rid) {
        HttpServletRequest httpReq = PortalUtil.getHttpServletRequest(actionRequest);
        HttpSession session = httpReq.getSession();

        _log.info(prefix(rid) + "Iniciando doAnexarDetalle");
        String ns = null;
        try {
            String portletId = PortalUtil.getPortletId(actionRequest);
            ns = PortalUtil.getPortletNamespace(portletId);
        } catch (Exception ignore) {
        }

        String ids = ParamUtil.getString(actionRequest, "ids", "");
        if (Validator.isNull(ids) && ns != null) ids = ParamUtil.getString(actionRequest, ns + "ids", "");
        ids = (ids != null) ? ids.trim() : "";

        String tipoSel = ParamUtil.getString(actionRequest, "tipo_proceso",
                ParamUtil.getString(actionRequest, "tipoProceso",
                        ParamUtil.getString(actionRequest, "tipoDebito", null)));
        if (Validator.isNull(tipoSel) && ns != null) {
            tipoSel = ParamUtil.getString(actionRequest, ns + "tipo_proceso",
                    ParamUtil.getString(actionRequest, ns + "tipoProceso",
                            ParamUtil.getString(actionRequest, ns + "tipoDebito", null)));
        }
        tipoSel = normalizeTipoSel(tipoSel);

        if (Validator.isNull(ids)) {
            _log.warn(prefix(rid) + "[ANEXAR] ids vacío. Nada para mover.");
            actionResponse.setRenderParameter(Constants.CMD, "deleteDetalle");
            actionResponse.setRenderParameter("cacheKey", WORK_KEY);
            if (Validator.isNotNull(tipoSel)) actionResponse.setRenderParameter("tipo_proceso", tipoSel);
            return;
        }

        List stgLI = (List) session.getAttribute(SESSION_STG_LI);
        List stgHO = (List) session.getAttribute(SESSION_STG_HO);
        List stgRE = (List) session.getAttribute(SESSION_STG_RE);
        List stgPR = (List) session.getAttribute(SESSION_STG_PR);

        List li = (List) session.getAttribute(SESSION_WORK_LI);
        List ho = (List) session.getAttribute(SESSION_WORK_HO);
        List re = (List) session.getAttribute(SESSION_WORK_RE);
        List pr = (List) session.getAttribute(SESSION_WORK_PR);

        if (stgLI == null) stgLI = new ArrayList();
        if (stgHO == null) stgHO = new ArrayList();
        if (stgRE == null) stgRE = new ArrayList();
        if (stgPR == null) stgPR = new ArrayList();

        if (li == null) li = new ArrayList();
        if (ho == null) ho = new ArrayList();
        if (re == null) re = new ArrayList();
        if (pr == null) pr = new ArrayList();

        String[] parts = ids.split(";");
        Map toMoveByTipo = new LinkedHashMap(); // tipo -> List<Integer>

        for (int i = 0; i < parts.length; i++) {
            String p = (parts[i] != null) ? parts[i].trim() : "";
            if (p.length() == 0) continue;

            int idx = p.indexOf(':');
            if (idx <= 0) continue;

            String tipo = p.substring(0, idx).trim().toUpperCase();
            String sIndex = p.substring(idx + 1).trim();

            try {
                int parsed = Integer.parseInt(sIndex);
                if (parsed < 0) continue;

                Integer n = Integer.valueOf(parsed);
                List list = (List) toMoveByTipo.get(tipo);
                if (list == null) {
                    list = new ArrayList();
                    toMoveByTipo.put(tipo, list);
                }
                list.add(n);
            } catch (Exception e) {
                _log.warn(prefix(rid) + "[ANEXAR] No pude parsear index en '" + p + "'");
            }
        }

        // Normalizar índices por tipo: unique + sort DESC (para no correrse al remover por índice)
        normalizeMoveIndexes((List) toMoveByTipo.get("LI"));
        normalizeMoveIndexes((List) toMoveByTipo.get("HO"));
        normalizeMoveIndexes((List) toMoveByTipo.get("RE"));
        normalizeMoveIndexes((List) toMoveByTipo.get("PR"));

        int moved = 0;
        moved += moveFromTo(stgLI, li, (List) toMoveByTipo.get("LI"));
        moved += moveFromTo(stgHO, ho, (List) toMoveByTipo.get("HO"));
        moved += moveFromTo(stgRE, re, (List) toMoveByTipo.get("RE"));
        moved += moveFromTo(stgPR, pr, (List) toMoveByTipo.get("PR"));

        session.setAttribute(SESSION_STG_LI, stgLI);
        session.setAttribute(SESSION_STG_HO, stgHO);
        session.setAttribute(SESSION_STG_RE, stgRE);
        session.setAttribute(SESSION_STG_PR, stgPR);

        session.setAttribute(SESSION_WORK_LI, li);
        session.setAttribute(SESSION_WORK_HO, ho);
        session.setAttribute(SESSION_WORK_RE, re);
        session.setAttribute(SESSION_WORK_PR, pr);

        // Si no queda nada en staging, limpiá source key para evitar REUSE fantasma
        if (size(stgLI) == 0 && size(stgHO) == 0 && size(stgRE) == 0 && size(stgPR) == 0) {
            session.setAttribute(SESSION_STG_SOURCE_KEY, null);
        }

        _log.info(prefix(rid) + "[ANEXAR] moved=" + moved
                + " mainSizesAfter LI=" + size(li) + " HO=" + size(ho) + " RE=" + size(re) + " PR=" + size(pr)
                + " stagingSizesAfter LI=" + size(stgLI) + " HO=" + size(stgHO) + " RE=" + size(stgRE) + " PR=" + size(stgPR));

        actionResponse.setRenderParameter(Constants.CMD, "deleteDetalle");
        actionResponse.setRenderParameter("cacheKey", WORK_KEY);
        if (Validator.isNotNull(tipoSel)) actionResponse.setRenderParameter("tipo_proceso", tipoSel);
        _log.info(prefix(rid) + "Finalizando doAnexarDetalle");
    }

    @SuppressWarnings({"rawtypes", "unchecked"})
    private void normalizeMoveIndexes(List idxs) {
        if (idxs == null || idxs.isEmpty()) return;

        // dedupe manteniendo ints válidos
        Set<Integer> uniq = new HashSet<Integer>();
        for (int i = 0; i < idxs.size(); i++) {
            Object o = idxs.get(i);
            if (o instanceof Integer) {
                Integer v = (Integer) o;
                if (v != null && v.intValue() >= 0) uniq.add(v);
            }
        }

        idxs.clear();
        idxs.addAll(uniq);

        // sort DESC
        try {
            Collections.sort(idxs, Collections.reverseOrder());
        } catch (Exception ignore) {
            // si algo raro quedó, lo dejamos como esté
        }
    }

    // ============================================================
    // SEED BASE (ABIERTO) (CORREGIDO)
    // - mode normalizado (BORRADOR/REABIERTO => NEW)
    // - fallback bidireccional:
    //     * si NEW vacío -> prueba LEGACY
    //     * si LEGACY vacío -> prueba NEW (porque tu fuente real hoy puede ser STATUS/S)
    // ============================================================
    @SuppressWarnings({"rawtypes", "unchecked"})
    private List seedBaseForOpenAppend(String tipoSel, String mode, Date fechaDesde, Date fechaHasta,
                                       DebitosaTotal debitosaTotal, String tercerizadoras, String rid) {

        List base = new ArrayList();
        boolean existePersistido = safeBool(debitosaTotal);

        String m = normalizeBusquedaMode(mode, "NEW");
        boolean wantNew = !"LEGACY".equals(m);

        try {
            if (wantNew) {
                base = loadBaseStatus(tipoSel, fechaDesde, fechaHasta, debitosaTotal, tercerizadoras);

                if (base == null || base.isEmpty()) {
                    base = loadBaseLegacy(tipoSel, fechaDesde, fechaHasta, debitosaTotal, tercerizadoras);
                    _log.warn(prefix(rid) + "[APPEND][ABIERTO][BASE] NEW vacío -> fallback LEGACY. tipoSel=" + safe(tipoSel));
                }
            } else {
                base = loadBaseLegacy(tipoSel, fechaDesde, fechaHasta, debitosaTotal, tercerizadoras);

                if (base == null || base.isEmpty()) {
                    base = loadBaseStatus(tipoSel, fechaDesde, fechaHasta, debitosaTotal, tercerizadoras);
                    _log.warn(prefix(rid) + "[APPEND][ABIERTO][BASE] LEGACY vacío -> fallback NEW. tipoSel=" + safe(tipoSel));
                }
            }
        } catch (Exception e) {
            _log.error(prefix(rid) + "[APPEND][ABIERTO][BASE] Error", e);
        }

        return (base != null) ? base : new ArrayList();
    }

    // ============================================================
// NORMALIZAR MODE (NUEVO)
// ============================================================
    private String normalizeBusquedaMode(String raw, String defaultMode) {
        String d = (defaultMode == null) ? "NEW" : defaultMode.trim().toUpperCase();
        String m = (raw == null) ? d : raw.trim().toUpperCase();

        // Mapeos “sucios” a lo que realmente significa para BASE OPEN
        if ("BORRADOR".equals(m) || "REABIERTO".equals(m)) return "NEW";

        if ("NEW".equals(m) || "LEGACY".equals(m)) return m;

        return d; // fail-safe
    }

    // ============================================================================
    // GUARDAR BORRADOR (sin cache) -> usa WORK en sesión
    // - Tercerizadora y período: WORK (sesión) first, fallback a request si falta.
    // - IMPORTANTE: borrar SIEMPRE por tipo corto (LI/HO/RE/PR) para no caer en NO-OP silencioso.
    // - Validaciones: si la workList tiene items pero ninguno del tipo esperado => NO borra, falla explícito.
    // - Logs: suficientes para diagnosticar scope, tipo de lista y resultados reales.
    // ============================================================================
    @SuppressWarnings({"rawtypes", "unchecked"})
    private void doGuardarBorrador(ActionRequest actionRequest, ActionResponse actionResponse, String rid) {
        final long t0 = System.currentTimeMillis();

        HttpServletRequest httpReq = PortalUtil.getHttpServletRequest(actionRequest);
        HttpSession session = httpReq.getSession();

        _log.info(prefix(rid) + "Iniciando doGuardarBorrador");

        // -------------------------
        // Namespace (por si vienen params namespaced)
        // -------------------------
        String ns = null;
        try {
            String portletId = PortalUtil.getPortletId(actionRequest);
            ns = PortalUtil.getPortletNamespace(portletId);
        } catch (Exception ignore) {
        }

        // -------------------------
        // Tipo seleccionado
        // -------------------------
        String tipoSel = ParamUtil.getString(actionRequest, "tipo_proceso",
                ParamUtil.getString(actionRequest, "tipoProceso",
                        ParamUtil.getString(actionRequest, "tipoDebito", null)));
        if (Validator.isNull(tipoSel) && ns != null) {
            tipoSel = ParamUtil.getString(actionRequest, ns + "tipo_proceso",
                    ParamUtil.getString(actionRequest, ns + "tipoProceso",
                            ParamUtil.getString(actionRequest, ns + "tipoDebito", null)));
        }
        tipoSel = normalizeTipoSel(tipoSel);
        if (tipoSel == null) tipoSel = "";
        tipoSel = tipoSel.trim();

        if (!("LI".equals(tipoSel) || "HO".equals(tipoSel) || "RE".equals(tipoSel) || "PR".equals(tipoSel))) {
            _log.warn(prefix(rid) + "[GUARDAR-BORRADOR] tipoSel inválido: " + safe(tipoSel));

            actionResponse.setRenderParameter(Constants.CMD, "deleteDetalle");
            actionResponse.setRenderParameter("cacheKey", WORK_KEY);
            actionResponse.setRenderParameter("tipo_proceso", tipoSel);
            actionResponse.setRenderParameter("borradorGuardado", "0");
            actionResponse.setRenderParameter("borradorError", "tipo_invalid");
            actionResponse.setRenderParameter("afterBorrador", "1");
            return;
        }

        // -------------------------
        // Tercerizadora: WORK (sesión) first
        // -------------------------
        String tercerizadoras = null;
        try {
            tercerizadoras = (String) session.getAttribute(SESSION_WORK_TERC);
        } catch (Exception ignore) {
        }

        if (Validator.isNull(tercerizadoras)) {
            tercerizadoras = ParamUtil.getString(actionRequest, "tipo_debitos_tercerizadoras",
                    ParamUtil.getString(actionRequest, "tipo_debito", ""));
            if (Validator.isNull(tercerizadoras) && ns != null) {
                tercerizadoras = ParamUtil.getString(actionRequest, ns + "tipo_debitos_tercerizadoras",
                        ParamUtil.getString(actionRequest, ns + "tipo_debito", ""));
            }
        }
        tercerizadoras = (tercerizadoras != null) ? tercerizadoras.trim() : "";

        if (Validator.isNull(tercerizadoras)) {
            _log.warn(prefix(rid) + "[GUARDAR-BORRADOR] tercerizadoras vacío/null. No guardo.");

            actionResponse.setRenderParameter(Constants.CMD, "deleteDetalle");
            actionResponse.setRenderParameter("cacheKey", WORK_KEY);
            actionResponse.setRenderParameter("tipo_proceso", tipoSel);
            actionResponse.setRenderParameter("borradorGuardado", "0");
            actionResponse.setRenderParameter("borradorError", "terc_null");
            actionResponse.setRenderParameter("afterBorrador", "1");
            return;
        }

        // -------------------------
        // Período: WORK (sesión) first
        // -------------------------
        Date fechaDesdeSess = null;
        Date fechaHastaSess = null;
        try { fechaDesdeSess = (Date) session.getAttribute(SESSION_WORK_FECHA_DESDE); } catch (Exception ignore) {}
        try { fechaHastaSess = (Date) session.getAttribute(SESSION_WORK_FECHA_HASTA); } catch (Exception ignore) {}

        Integer anioSess = null;
        Integer mes0Sess = null;
        try { anioSess = (Integer) session.getAttribute(SESSION_WORK_ANIO); } catch (Exception ignore) {}
        try { mes0Sess = (Integer) session.getAttribute(SESSION_WORK_MES0); } catch (Exception ignore) {}

        long reqFechaHastaMs = ParamUtil.getLong(actionRequest, "fechaHastaMs",
                ParamUtil.getLong(actionRequest, "fechaHasta", 0L));
        if (reqFechaHastaMs == 0L && ns != null) {
            reqFechaHastaMs = ParamUtil.getLong(actionRequest, ns + "fechaHastaMs",
                    ParamUtil.getLong(actionRequest, ns + "fechaHasta", 0L));
        }

        String reqPeriodo = ParamUtil.getString(actionRequest, "periodo",
                ParamUtil.getString(actionRequest, "periodoSel",
                        ParamUtil.getString(actionRequest, "periodoSeleccionado", "")));
        if (Validator.isNull(reqPeriodo) && ns != null) {
            reqPeriodo = ParamUtil.getString(actionRequest, ns + "periodo",
                    ParamUtil.getString(actionRequest, ns + "periodoSel",
                            ParamUtil.getString(actionRequest, ns + "periodoSeleccionado", "")));
        }
        reqPeriodo = (reqPeriodo != null) ? reqPeriodo.trim() : "";

        Date fechaDesde = null;
        Date fechaHasta = null;
        String periodoSource = "UNKNOWN";

        if (fechaDesdeSess != null && fechaHastaSess != null) {
            fechaDesde = fechaDesdeSess;
            fechaHasta = fechaHastaSess;
            periodoSource = "SESSION_DATES";
        }

        if (fechaDesde == null || fechaHasta == null) {
            if (anioSess != null && mes0Sess != null && anioSess.intValue() > 0 && mes0Sess.intValue() >= 0) {
                Calendar cal = DateUtils.getCalendarGMTMenos3();
                cal.set(Calendar.YEAR, anioSess.intValue());
                cal.set(Calendar.MONTH, mes0Sess.intValue());
                cal.set(Calendar.DAY_OF_MONTH, 1);
                cal.set(Calendar.HOUR_OF_DAY, 0);
                cal.set(Calendar.MINUTE, 0);
                cal.set(Calendar.SECOND, 0);
                cal.set(Calendar.MILLISECOND, 0);
                fechaDesde = cal.getTime();
                fechaHasta = DateUtils.getLastDateOfMonth(fechaDesde, false);
                periodoSource = "SESSION_ANIO_MES";
            }
        }

        if ((fechaDesde == null || fechaHasta == null) && reqFechaHastaMs > 0L) {
            try {
                Calendar cal = DateUtils.getCalendarGMTMenos3();
                cal.setTime(new Date(reqFechaHastaMs));
                int y = cal.get(Calendar.YEAR);
                int m0 = cal.get(Calendar.MONTH);

                cal.set(Calendar.YEAR, y);
                cal.set(Calendar.MONTH, m0);
                cal.set(Calendar.DAY_OF_MONTH, 1);
                cal.set(Calendar.HOUR_OF_DAY, 0);
                cal.set(Calendar.MINUTE, 0);
                cal.set(Calendar.SECOND, 0);
                cal.set(Calendar.MILLISECOND, 0);

                fechaDesde = cal.getTime();
                fechaHasta = DateUtils.getLastDateOfMonth(fechaDesde, false);
                periodoSource = "REQUEST_MS";
            } catch (Exception e) {
                _log.error(prefix(rid) + "[GUARDAR-BORRADOR][PERIODO] Error armando período desde REQUEST_MS=" + reqFechaHastaMs, e);
            }
        }

        if ((fechaDesde == null || fechaHasta == null) && Validator.isNotNull(reqPeriodo)) {
            try {
                String p = reqPeriodo;
                int eq = p.indexOf('=');
                if (eq >= 0) p = p.substring(eq + 1);
                p = p.trim();

                String[] parts = p.split("-");
                if (parts != null && parts.length >= 2) {
                    int y = Integer.parseInt(parts[0]);
                    int m1 = Integer.parseInt(parts[1]);
                    int m0 = m1 - 1;

                    Calendar cal = DateUtils.getCalendarGMTMenos3();
                    cal.set(Calendar.YEAR, y);
                    cal.set(Calendar.MONTH, m0);
                    cal.set(Calendar.DAY_OF_MONTH, 1);
                    cal.set(Calendar.HOUR_OF_DAY, 0);
                    cal.set(Calendar.MINUTE, 0);
                    cal.set(Calendar.SECOND, 0);
                    cal.set(Calendar.MILLISECOND, 0);

                    fechaDesde = cal.getTime();
                    fechaHasta = DateUtils.getLastDateOfMonth(fechaDesde, false);
                    periodoSource = "REQUEST_PERIODO";
                }
            } catch (Exception e) {
                _log.error(prefix(rid) + "[GUARDAR-BORRADOR][PERIODO] Error parseando REQUEST_PERIODO=" + safe(reqPeriodo), e);
            }
        }

        _log.info(prefix(rid) + "[GUARDAR-BORRADOR][PERIODO-SRC] "
                + "source=" + periodoSource
                + " req.fechaHastaMs=" + String.valueOf(reqFechaHastaMs)
                + " req.periodo=" + safe(reqPeriodo)
                + " sess.fechaDesde=" + (fechaDesdeSess != null ? String.valueOf(fechaDesdeSess.getTime()) : "null")
                + " sess.fechaHasta=" + (fechaHastaSess != null ? String.valueOf(fechaHastaSess.getTime()) : "null")
                + " sess.anio=" + String.valueOf(anioSess)
                + " sess.mes0=" + String.valueOf(mes0Sess)
                + " chosen.fechaDesde=" + (fechaDesde != null ? String.valueOf(fechaDesde.getTime()) : "null")
                + " chosen.fechaHasta=" + (fechaHasta != null ? String.valueOf(fechaHasta.getTime()) : "null")
                + " workPeriodo=" + safe(workPeriodoLabel(session)));

        if (fechaDesde == null || fechaHasta == null) {
            _log.warn(prefix(rid) + "[GUARDAR-BORRADOR] fechaDesde/fechaHasta null. No guardo.");

            actionResponse.setRenderParameter(Constants.CMD, "deleteDetalle");
            actionResponse.setRenderParameter("cacheKey", WORK_KEY);
            actionResponse.setRenderParameter("tipo_proceso", tipoSel);
            actionResponse.setRenderParameter("borradorGuardado", "0");
            actionResponse.setRenderParameter("borradorError", "periodo_null");
            actionResponse.setRenderParameter("afterBorrador", "1");
            return;
        }

        // Usuario
        String screenName = "system";
        try {
            User u = PortalUtil.getUser(actionRequest);
            if (u != null && Validator.isNotNull(u.getScreenName())) screenName = u.getScreenName();
        } catch (Exception ignore) {
        }

        // -------------------------
        // Work key (SIEMPRE consistente con doSearch)
        // -------------------------
        int anioRp;
        int mes0Rp;
        try {
            Calendar c = DateUtils.getCalendarGMTMenos3();
            c.setTime(fechaDesde);
            anioRp = c.get(Calendar.YEAR);
            mes0Rp = c.get(Calendar.MONTH);
        } catch (Exception e) {
            anioRp = (anioSess != null ? anioSess.intValue() : -1);
            mes0Rp = (mes0Sess != null ? mes0Sess.intValue() : -1);
        }

        String workScopeKey = null;
        try {
            // Prioridad #1: construir igual que doSearch
            if (anioRp > 0 && mes0Rp >= 0 && Validator.isNotNull(tercerizadoras)) {
                workScopeKey = buildCacheKey(anioRp, mes0Rp, tercerizadoras);
            }
        } catch (Exception ignore) {}

        // Prioridad #2: sesión si existía (por compat)
        if (Validator.isNull(workScopeKey)) {
            try {
                Object wk = session.getAttribute(SESSION_WORK_SOURCE_KEY);
                if (wk instanceof String) workScopeKey = (String) wk;
            } catch (Exception ignore) {}
        }

        workScopeKey = (workScopeKey != null) ? workScopeKey.trim() : "";

        if (Validator.isNull(workScopeKey)) {
            _log.error(prefix(rid) + "[GUARDAR-BORRADOR] workKey vacío/null -> no borro/no inserto (fail-safe).");

            actionResponse.setRenderParameter(Constants.CMD, "deleteDetalle");
            actionResponse.setRenderParameter("cacheKey", WORK_KEY);
            actionResponse.setRenderParameter("tipo_proceso", tipoSel);
            actionResponse.setRenderParameter("borradorGuardado", "0");
            actionResponse.setRenderParameter("borradorError", "workkey_null");
            actionResponse.setRenderParameter("afterBorrador", "1");
            return;
        }

        // -------------------------
        // Work list por tipo
        // -------------------------
        List workList = null;
        String workListKey = null;

        if ("LI".equals(tipoSel)) workListKey = SESSION_WORK_LI;
        else if ("HO".equals(tipoSel)) workListKey = SESSION_WORK_HO;
        else if ("RE".equals(tipoSel)) workListKey = SESSION_WORK_RE;
        else if ("PR".equals(tipoSel)) workListKey = SESSION_WORK_PR;

        try { workList = (List) session.getAttribute(workListKey); } catch (Exception ignore) {}
        if (workList == null) workList = new ArrayList();

        final boolean clearingIntent = workList.isEmpty(); // <- CLAVE: “vaciar borrador”
        String firstClass = "null";
        try { if (!workList.isEmpty() && workList.get(0) != null) firstClass = workList.get(0).getClass().getName(); } catch (Exception ignore) {}

        _log.info(prefix(rid) + "[GUARDAR-BORRADOR][START] "
                + "tipoSel=" + safe(tipoSel)
                + " terc=" + safe(tercerizadoras)
                + " periodoFechaDesde(ms)=" + String.valueOf(fechaDesde.getTime())
                + " periodoHasta(ms)=" + String.valueOf(fechaHasta.getTime())
                + " periodoSource=" + periodoSource
                + " workListKey=" + safe(workListKey)
                + " workListSize=" + workList.size()
                + " clearingIntent=" + (clearingIntent ? "1" : "0")
                + " firstClass=" + safe(firstClass)
                + " screenName=" + safe(screenName)
                + " workScopeKey=" + safe(workScopeKey));

        boolean ok = false;
        String errCode = null;

        int deleted = 0;
        int processed = 0;
        int matchedExpectedType = 0;
        int insertedRowsSum = 0;
        int insertedAttempts = 0;
        int errItems = 0;

        String tipoDbKey = mapTipoSelToGrabadosKey(tipoSel);
        if (Validator.isNull(tipoDbKey)) tipoDbKey = tipoSel;

        try {
            // Si hay items pero ninguno matchea tipo esperado => abort (no borro/no inserto)
            if (!workList.isEmpty()) {
                for (Object o : workList) {
                    if ("LI".equals(tipoSel) && (o instanceof ar.com.ospim.liquidaciones.reportes.bean.DebitosLiquidacionesPendientes)) { matchedExpectedType++; break; }
                    if ("HO".equals(tipoSel) && (o instanceof ar.com.ospim.liquidaciones.reportes.bean.DebitosHospitales)) { matchedExpectedType++; break; }
                    if ("RE".equals(tipoSel) && (o instanceof ar.com.ospim.liquidaciones.reportes.bean.DebitosaReintegros)) { matchedExpectedType++; break; }
                    if ("PR".equals(tipoSel) && (o instanceof ar.com.ospim.liquidaciones.reportes.bean.DebitosaPrestadores)) { matchedExpectedType++; break; }
                }
            }

            if (!workList.isEmpty() && matchedExpectedType == 0) {
                ok = false;
                errCode = "worklist_type_mismatch";
                _log.error(prefix(rid) + "[GUARDAR-BORRADOR] ABORT: workList tiene " + workList.size()
                        + " items pero ninguno es del tipo esperado para tipoSel=" + safe(tipoSel)
                        + ". firstClass=" + safe(firstClass)
                        + " -> NO borro/NO inserto.");
            } else {
                // 1) BORRAR (siempre, incluso si clearingIntent)
                deleted = BusquedaDebitosTercerizadorasServiceUtil
                        .borrarBorradorDebitosTercerizadorasPorTipoYPeriodo(tipoSel, fechaDesde, tercerizadoras, workScopeKey);

                _log.info(prefix(rid) + "[GUARDAR-BORRADOR][DELETE] deleted=" + deleted
                        + " tipoSel(short)=" + safe(tipoSel)
                        + " tipoDbKey(logOnly)=" + safe(tipoDbKey)
                        + " terc=" + safe(tercerizadoras)
                        + " periodoFechaDesde(ms)=" + String.valueOf(fechaDesde.getTime())
                        + " workScopeKey=" + safe(workScopeKey));

                // 2) INSERT si hay items
                if ("LI".equals(tipoSel)) {
                    for (Object o : workList) {
                        if (o instanceof ar.com.ospim.liquidaciones.reportes.bean.DebitosLiquidacionesPendientes) {
                            processed++; insertedAttempts++;
                            try {
                                int r = BusquedaDebitosTercerizadorasServiceUtil.grabarBorradorLiquidacionesPendientesDebitos(
                                        (ar.com.ospim.liquidaciones.reportes.bean.DebitosLiquidacionesPendientes) o,
                                        screenName, fechaDesde, tercerizadoras, workScopeKey
                                );
                                insertedRowsSum += r;
                            } catch (Exception e) {
                                errItems++;
                                _log.error(prefix(rid) + "[GUARDAR-BORRADOR][LI] Error grabando item#" + processed, e);
                            }
                        }
                    }
                } else if ("HO".equals(tipoSel)) {
                    for (Object o : workList) {
                        if (o instanceof ar.com.ospim.liquidaciones.reportes.bean.DebitosHospitales) {
                            processed++; insertedAttempts++;
                            try {
                                int r = BusquedaDebitosTercerizadorasServiceUtil.grabarBorradorHospitalesDebitos(
                                        (ar.com.ospim.liquidaciones.reportes.bean.DebitosHospitales) o,
                                        screenName, fechaDesde, tercerizadoras, workScopeKey
                                );
                                insertedRowsSum += r;
                            } catch (Exception e) {
                                errItems++;
                                _log.error(prefix(rid) + "[GUARDAR-BORRADOR][HO] Error grabando item#" + processed, e);
                            }
                        }
                    }
                } else if ("RE".equals(tipoSel)) {
                    for (Object o : workList) {
                        if (o instanceof ar.com.ospim.liquidaciones.reportes.bean.DebitosaReintegros) {
                            processed++; insertedAttempts++;
                            try {
                                int r = BusquedaDebitosTercerizadorasServiceUtil.grabarBorradorReintegrosDebitos(
                                        (ar.com.ospim.liquidaciones.reportes.bean.DebitosaReintegros) o,
                                        screenName, fechaDesde, tercerizadoras, workScopeKey
                                );
                                insertedRowsSum += r;
                            } catch (Exception e) {
                                errItems++;
                                _log.error(prefix(rid) + "[GUARDAR-BORRADOR][RE] Error grabando item#" + processed, e);
                            }
                        }
                    }
                } else if ("PR".equals(tipoSel)) {
                    for (Object o : workList) {
                        if (o instanceof ar.com.ospim.liquidaciones.reportes.bean.DebitosaPrestadores) {
                            processed++; insertedAttempts++;
                            try {
                                int r = BusquedaDebitosTercerizadorasServiceUtil.grabarBorradorPrestadoresDebitos(
                                        (ar.com.ospim.liquidaciones.reportes.bean.DebitosaPrestadores) o,
                                        screenName, fechaDesde, tercerizadoras, workScopeKey
                                );
                                insertedRowsSum += r;
                            } catch (Exception e) {
                                errItems++;
                                _log.error(prefix(rid) + "[GUARDAR-BORRADOR][PR] Error grabando item#" + processed, e);
                            }
                        }
                    }
                }

                ok = (errItems == 0);
                if (!ok) errCode = "items_error";

                if (ok && !workList.isEmpty() && matchedExpectedType > 0 && processed == 0) {
                    ok = false;
                    errCode = "processed_zero";
                    _log.error(prefix(rid) + "[GUARDAR-BORRADOR] processed=0 con workList.size=" + workList.size()
                            + " y matchedExpectedType=1. firstClass=" + safe(firstClass));
                }

                // -------------------------
                // MODO: si clearingIntent => salir de BORRADOR (volver a NEW)
                // -------------------------
                if (ok) {
                    if (clearingIntent) {
                        session.setAttribute(SESSION_WORK_MODE, "NEW");
                        session.setAttribute(SESSION_WORK_BUSQUEDA_MODE, "NEW");
                        session.setAttribute(SESSION_WORK_CERRADO_TIPO, null);

                        // Importante: vaciar lista de sesión del tipo para no re-renderizar “estado borrador” con data vieja
                        try { session.setAttribute(workListKey, new ArrayList()); } catch (Exception ignore) {}
                    } else {
                        session.setAttribute(SESSION_WORK_MODE, "BORRADOR");
                        session.setAttribute(SESSION_WORK_BUSQUEDA_MODE, "BORRADOR");
                        session.setAttribute(SESSION_WORK_CERRADO_TIPO, null);
                    }
                }

                _log.info(prefix(rid) + "[GUARDAR-BORRADOR][POST] ok=" + (ok ? "1" : "0")
                        + " deleted=" + deleted
                        + " processed=" + processed
                        + " insertedAttempts=" + insertedAttempts
                        + " insertedRowsSum=" + insertedRowsSum
                        + " errItems=" + errItems
                        + " clearingIntent=" + (clearingIntent ? "1" : "0")
                        + " tipoSel=" + safe(tipoSel)
                        + " tipoDbKey(logOnly)=" + safe(tipoDbKey)
                        + " terc=" + safe(tercerizadoras)
                        + " periodoFechaDesde(ms)=" + String.valueOf(fechaDesde.getTime()));
            }

        } catch (Exception e) {
            ok = false;
            errCode = "exception";
            _log.error(prefix(rid) + "[GUARDAR-BORRADOR] Error guardando borrador (scope periodo+tipo+terc)", e);
        }

        // -------------------------
        // Render: si clearingIntent OK => ir a SEARCH con borradorCleared=1 para que doSearch arranque NEW
        // -------------------------
        final String nextCmd = (ok && clearingIntent) ? "search" : "deleteDetalle";

        actionResponse.setRenderParameter(Constants.CMD, nextCmd);
        actionResponse.setRenderParameter("cacheKey", workScopeKey);
        actionResponse.setRenderParameter("tipo_proceso", tipoSel);
        actionResponse.setRenderParameter("borradorGuardado", ok ? "1" : "0");
        if (!ok) actionResponse.setRenderParameter("borradorError", Validator.isNotNull(errCode) ? errCode : "1");

        actionResponse.setRenderParameter("afterBorrador", "1");

        // Para doSearch (solo cuando necesitamos “volver a estado inicial” inmediatamente)
        if (ok && clearingIntent) {
            actionResponse.setRenderParameter(PARAM_BORRADOR_CLEARED, "1");
            actionResponse.setRenderParameter("fechaDesdeAnio", String.valueOf(anioRp));
            actionResponse.setRenderParameter("fechaDesdeMes", String.valueOf(mes0Rp)); // 0-based
            actionResponse.setRenderParameter("tipo_debitos_tercerizadoras", tercerizadoras);
        }

        _log.info(prefix(rid) + "[GUARDAR-BORRADOR][END] ok=" + (ok ? "1" : "0")
                + " clearingIntent=" + (clearingIntent ? "1" : "0")
                + " nextCmd=" + safe(nextCmd)
                + " tipoSel=" + safe(tipoSel)
                + " terc=" + safe(tercerizadoras)
                + " elapsedMs=" + (System.currentTimeMillis() - t0));

        _log.info(prefix(rid) + "Finalizando doGuardarBorrador");
    }

    // =========================
    // CERRAR PERIODO (sin cache) -> usa WORK en sesión
    // =========================
    private void doCerrarPeriodo(ActionRequest actionRequest, ActionResponse actionResponse, String rid) {
        final long t0 = System.currentTimeMillis();

        _log.info(prefix(rid) + "Iniciando doCerrarPeriodo");
        HttpServletRequest httpReq = PortalUtil.getHttpServletRequest(actionRequest);
        HttpSession session = httpReq.getSession();

        String ns = null;
        try {
            String portletId = PortalUtil.getPortletId(actionRequest);
            ns = PortalUtil.getPortletNamespace(portletId);
        } catch (Exception ignore) {
        }

        // -------------------------
        // Tipo seleccionado (request primero; fallback namespaced)
        // -------------------------
        String tipoSel = ParamUtil.getString(actionRequest, "tipo_proceso",
                ParamUtil.getString(actionRequest, "tipoProceso",
                        ParamUtil.getString(actionRequest, "tipoDebito", null)));
        if (Validator.isNull(tipoSel) && ns != null) {
            tipoSel = ParamUtil.getString(actionRequest, ns + "tipo_proceso",
                    ParamUtil.getString(actionRequest, ns + "tipoProceso",
                            ParamUtil.getString(actionRequest, ns + "tipoDebito", null)));
        }
        tipoSel = normalizeTipoSel(tipoSel);

        // -------------------------
        // Tercerizadora (sesión primero; fallback request)
        // -------------------------
        String tercerizadoras = null;
        try {
            tercerizadoras = (String) session.getAttribute(SESSION_WORK_TERC);
        } catch (Exception ignore) {
        }

        if (Validator.isNull(tercerizadoras)) {
            tercerizadoras = ParamUtil.getString(actionRequest, "tipo_debitos_tercerizadoras",
                    ParamUtil.getString(actionRequest, "tipo_debito", ""));
            if (Validator.isNull(tercerizadoras) && ns != null) {
                tercerizadoras = ParamUtil.getString(actionRequest, ns + "tipo_debitos_tercerizadoras",
                        ParamUtil.getString(actionRequest, ns + "tipo_debito", ""));
            }
        }
        tercerizadoras = (tercerizadoras != null) ? tercerizadoras.trim() : "";

        // -------------------------
        // Período: PRIORIDAD ABSOLUTA request -> fallback sesión
        // La idea: si el request trae cualquier pista de período (ms o YYYY-MM),
        // se cierra el mes de ese período (1er día a último día).
        // -------------------------
        Date fechaDesdeSess = (Date) session.getAttribute(SESSION_WORK_FECHA_DESDE);
        Date fechaHastaSess = (Date) session.getAttribute(SESSION_WORK_FECHA_HASTA);

        Integer anioSess = null;
        Integer mes0Sess = null;
        try {
            anioSess = (Integer) session.getAttribute(SESSION_WORK_ANIO);
        } catch (Exception ignore) {
        }
        try {
            mes0Sess = (Integer) session.getAttribute(SESSION_WORK_MES0);
        } catch (Exception ignore) {
        }

        long reqFechaHastaMs = ParamUtil.getLong(actionRequest, "fechaHastaMs",
                ParamUtil.getLong(actionRequest, "fechaHasta", 0L));
        if (reqFechaHastaMs == 0L && ns != null) {
            reqFechaHastaMs = ParamUtil.getLong(actionRequest, ns + "fechaHastaMs",
                    ParamUtil.getLong(actionRequest, ns + "fechaHasta", 0L));
        }

        // Intento por "periodo" estilo "2021-08" (por si el JSP lo manda así)
        String reqPeriodo = ParamUtil.getString(actionRequest, "periodo",
                ParamUtil.getString(actionRequest, "periodoSel",
                        ParamUtil.getString(actionRequest, "periodoSeleccionado", "")));
        if (Validator.isNull(reqPeriodo) && ns != null) {
            reqPeriodo = ParamUtil.getString(actionRequest, ns + "periodo",
                    ParamUtil.getString(actionRequest, ns + "periodoSel",
                            ParamUtil.getString(actionRequest, ns + "periodoSeleccionado", "")));
        }
        reqPeriodo = (reqPeriodo != null) ? reqPeriodo.trim() : "";

        Date fechaDesde = null;
        Date fechaHasta = null;
        String periodoSource = "UNKNOWN";

        // --- (A) request por ms (cerramos el mes de esa fecha) ---
        if (reqFechaHastaMs > 0L) {
            try {
                Calendar cal = DateUtils.getCalendarGMTMenos3();
                cal.setTime(new Date(reqFechaHastaMs));

                int y = cal.get(Calendar.YEAR);
                int m0 = cal.get(Calendar.MONTH);

                cal.set(Calendar.YEAR, y);
                cal.set(Calendar.MONTH, m0);
                cal.set(Calendar.DAY_OF_MONTH, 1);
                cal.set(Calendar.HOUR_OF_DAY, 0);
                cal.set(Calendar.MINUTE, 0);
                cal.set(Calendar.SECOND, 0);
                cal.set(Calendar.MILLISECOND, 0);

                fechaDesde = cal.getTime();
                fechaHasta = DateUtils.getLastDateOfMonth(fechaDesde, false);

                periodoSource = "REQUEST_MS";
            } catch (Exception e) {
                _log.error(prefix(rid) + "[CIERRE][PERIODO] Error armando período desde REQUEST_MS=" + reqFechaHastaMs, e);
            }
        }

        // --- (B) request por periodo "YYYY-MM" ---
        if ((fechaDesde == null || fechaHasta == null) && Validator.isNotNull(reqPeriodo)) {
            try {
                // Espera "YYYY-MM" (y tolera "period=YYYY-MM")
                String p = reqPeriodo;
                int eq = p.indexOf('=');
                if (eq >= 0) p = p.substring(eq + 1);
                p = p.trim();

                String[] parts = p.split("-");
                if (parts != null && parts.length >= 2) {
                    int y = Integer.parseInt(parts[0]);
                    int m1 = Integer.parseInt(parts[1]); // 1..12
                    int m0 = m1 - 1;

                    Calendar cal = DateUtils.getCalendarGMTMenos3();
                    cal.set(Calendar.YEAR, y);
                    cal.set(Calendar.MONTH, m0);
                    cal.set(Calendar.DAY_OF_MONTH, 1);
                    cal.set(Calendar.HOUR_OF_DAY, 0);
                    cal.set(Calendar.MINUTE, 0);
                    cal.set(Calendar.SECOND, 0);
                    cal.set(Calendar.MILLISECOND, 0);

                    fechaDesde = cal.getTime();
                    fechaHasta = DateUtils.getLastDateOfMonth(fechaDesde, false);

                    periodoSource = "REQUEST_PERIODO";
                }
            } catch (Exception e) {
                _log.error(prefix(rid) + "[CIERRE][PERIODO] Error parseando REQUEST_PERIODO=" + safe(reqPeriodo), e);
            }
        }

        // --- (C) fallback sesión por fechas directas ---
        if (fechaDesde == null || fechaHasta == null) {
            fechaDesde = fechaDesdeSess;
            fechaHasta = fechaHastaSess;
            if (fechaDesde != null && fechaHasta != null) periodoSource = "SESSION_DATES";
        }

        // --- (D) fallback sesión por anio/mes0 ---
        if (fechaDesde == null || fechaHasta == null) {
            if (anioSess != null && mes0Sess != null && anioSess.intValue() > 0 && mes0Sess.intValue() >= 0) {
                Calendar cal = DateUtils.getCalendarGMTMenos3();
                cal.set(Calendar.YEAR, anioSess.intValue());
                cal.set(Calendar.MONTH, mes0Sess.intValue());
                cal.set(Calendar.DAY_OF_MONTH, 1);
                cal.set(Calendar.HOUR_OF_DAY, 0);
                cal.set(Calendar.MINUTE, 0);
                cal.set(Calendar.SECOND, 0);
                cal.set(Calendar.MILLISECOND, 0);
                fechaDesde = cal.getTime();
                fechaHasta = DateUtils.getLastDateOfMonth(fechaDesde, false);
                periodoSource = "SESSION_ANIO_MES";
            }
        }

        // Warn si request y sesión se contradicen fuerte (solo informativo)
        try {
            if (reqFechaHastaMs > 0L && fechaHastaSess != null) {
                // comparo el mes/año, no el día: el request lo normalizamos a último del mes
                Calendar a = DateUtils.getCalendarGMTMenos3();
                Calendar b = DateUtils.getCalendarGMTMenos3();
                a.setTime(new Date(reqFechaHastaMs));
                b.setTime(fechaHastaSess);

                int ay = a.get(Calendar.YEAR), am = a.get(Calendar.MONTH);
                int by = b.get(Calendar.YEAR), bm = b.get(Calendar.MONTH);

                if (ay != by || am != bm) {
                    _log.warn(prefix(rid) + "[CIERRE][PERIODO-MISMATCH] "
                            + "req(y,m0)=" + ay + "," + am
                            + " vs sess(y,m0)=" + by + "," + bm
                            + " -> usando " + periodoSource);
                }
            }
        } catch (Exception ignore) {
        }

        if (_log.isInfoEnabled()) {
            _log.info(prefix(rid) + "[CIERRE][START] tipoSel=" + safe(tipoSel)
                    + " tercerizadoras=" + safe(tercerizadoras)
                    + " fechaDesde(ms)=" + (fechaDesde != null ? String.valueOf(fechaDesde.getTime()) : "null")
                    + " fechaHasta(ms)=" + (fechaHasta != null ? String.valueOf(fechaHasta.getTime()) : "null")
                    + " periodoSource=" + periodoSource
                    + " workPeriodo=" + safe(workPeriodoLabel(session)));
        }

        if (fechaDesde == null || fechaHasta == null) {
            _log.warn(prefix(rid) + "[CIERRE] fechaDesde/fechaHasta null. No cierro.");

            actionResponse.setRenderParameter(Constants.CMD, "deleteDetalle");
            actionResponse.setRenderParameter("cacheKey", WORK_KEY);
            actionResponse.setRenderParameter("tipo_proceso", tipoSel);
            actionResponse.setRenderParameter("cierrePeriodoOk", "0");
            actionResponse.setRenderParameter("cierrePeriodoError", "periodo_null");
            return;
        }

        User user = null;
        try {
            user = PortalUtil.getUser(actionRequest);
        } catch (Exception ignore) {
        }

        if (user == null) {
            _log.error(prefix(rid) + "[CIERRE] Usuario nulo; no se puede cerrar el período.");

            actionResponse.setRenderParameter(Constants.CMD, "deleteDetalle");
            actionResponse.setRenderParameter("cacheKey", WORK_KEY);
            actionResponse.setRenderParameter("tipo_proceso", tipoSel);
            actionResponse.setRenderParameter("cierrePeriodoOk", "0");
            actionResponse.setRenderParameter("cierrePeriodoError", "user_null");
            return;
        }

        String screenName = "system";
        try {
            if (Validator.isNotNull(user.getScreenName())) screenName = user.getScreenName();
        } catch (Exception ignore) {
        }

        List li = (List) session.getAttribute(SESSION_WORK_LI);
        List ho = (List) session.getAttribute(SESSION_WORK_HO);
        List re = (List) session.getAttribute(SESSION_WORK_RE);
        List pr = (List) session.getAttribute(SESSION_WORK_PR);

        if (li == null && ho == null && re == null && pr == null) {
            _log.warn(prefix(rid) + "[CIERRE] Listas en sesión NULL. No cierro."
                    + " tercerizadoras=" + safe(tercerizadoras)
                    + " fechaHasta(ms)=" + (fechaHasta != null ? String.valueOf(fechaHasta.getTime()) : "null")
                    + " tipoSel=" + safe(tipoSel)
                    + " periodoSource=" + periodoSource);

            actionResponse.setRenderParameter(Constants.CMD, "deleteDetalle");
            actionResponse.setRenderParameter("cacheKey", WORK_KEY);
            actionResponse.setRenderParameter("tipo_proceso", tipoSel);
            actionResponse.setRenderParameter("cierrePeriodoOk", "0");
            actionResponse.setRenderParameter("cierrePeriodoError", "session_lists_null");
            return;
        }

        if (li == null) li = new ArrayList();
        if (ho == null) ho = new ArrayList();
        if (re == null) re = new ArrayList();
        if (pr == null) pr = new ArrayList();

        if (_log.isInfoEnabled()) {
            _log.info(prefix(rid) + "[CIERRE][LISTS] "
                    + "sizes{LI=" + size(li) + ",HO=" + size(ho) + ",RE=" + size(re) + ",PR=" + size(pr) + "}"
                    + " ids{LI=" + System.identityHashCode(li)
                    + ",HO=" + System.identityHashCode(ho)
                    + ",RE=" + System.identityHashCode(re)
                    + ",PR=" + System.identityHashCode(pr) + "}");
        }

        // -------------------------
        // Check cierre previo (fail-safe: si falla, NO cerramos)
        // -------------------------
        long tCheck0 = System.currentTimeMillis();
        try {
            boolean yaCerrado = existeCierrePeriodo(fechaDesde, fechaHasta, tercerizadoras, tipoSel);
            long tCheckMs = System.currentTimeMillis() - tCheck0;

            _log.info(prefix(rid) + "[CIERRE][CHECK-PREVIO] yaCerrado=" + (yaCerrado ? "1" : "0")
                    + " tipoSel=" + safe(tipoSel)
                    + " terc=" + safe(tercerizadoras)
                    + " periodoHasta(ms)=" + String.valueOf(fechaHasta.getTime())
                    + " elapsedMs=" + tCheckMs);

            if (yaCerrado) {
                _log.warn(prefix(rid) + "[CIERRE] Periodo YA cerrado (por tipo). No se ejecuta cierre."
                        + " terc=" + safe(tercerizadoras)
                        + " tipo=" + safe(tipoSel)
                        + " fechaHasta(ms)=" + String.valueOf(fechaHasta.getTime()));

                actionResponse.setRenderParameter(Constants.CMD, "deleteDetalle");
                actionResponse.setRenderParameter("cacheKey", WORK_KEY);
                actionResponse.setRenderParameter("tipo_proceso", tipoSel);
                actionResponse.setRenderParameter("cierrePeriodoOk", "0");
                actionResponse.setRenderParameter("cierrePeriodoError", "periodo_ya_cerrado");
                // Para que el render fuerce persistido si aplica
                actionResponse.setRenderParameter("workCerrado", "1");
                actionResponse.setRenderParameter("afterCerrar", "1");
                return;
            }
        } catch (Exception e) {
            _log.error(prefix(rid) + "[CIERRE] No se pudo verificar cierre previo. No cierro (fail-safe).", e);

            actionResponse.setRenderParameter(Constants.CMD, "deleteDetalle");
            actionResponse.setRenderParameter("cacheKey", WORK_KEY);
            actionResponse.setRenderParameter("tipo_proceso", tipoSel);
            actionResponse.setRenderParameter("cierrePeriodoOk", "0");
            actionResponse.setRenderParameter("cierrePeriodoError", "check_cierre_failed");
            return;
        }

        // -------------------------
        // Totales (sin cambiar comportamiento)
        // -------------------------
        DebitosaTotal debitosaTotal = null;
        try {
            Object totObj = session.getAttribute(SESSION_TOTALES_KEY);
            if (totObj instanceof List) {
                List tl = (List) totObj;
                if (tl != null && !tl.isEmpty() && tl.get(0) instanceof DebitosaTotal) {
                    debitosaTotal = (DebitosaTotal) tl.get(0);
                }
            }
        } catch (Exception ignore) {
        }

        if (debitosaTotal == null) {
            try {
                debitosaTotal = BusquedaDebitosTercerizadorasServiceUtil.getBuscarTotalesDebitos(fechaHasta, tercerizadoras);
            } catch (Exception e) {
                _log.error(prefix(rid) + "[CIERRE][TOTALES] Error recalculando totales (se usará vacío)", e);
            }
        }
        if (debitosaTotal == null) debitosaTotal = new DebitosaTotal();

        java.math.BigDecimal totalDebitoPrestadoras = generarTotalDebitoPrestadoras(debitosaTotal);

        _log.info(prefix(rid) + "[CIERRE] INICIO (POR TIPO)"
                + " userId=" + user.getUserId()
                + " screenName=" + screenName
                + " tercerizadoras=" + safe(tercerizadoras)
                + " tipoSel=" + safe(tipoSel)
                + " fechaDesde(ms)=" + String.valueOf(fechaDesde.getTime())
                + " fechaHasta(ms)=" + String.valueOf(fechaHasta.getTime())
                + " periodoSource=" + periodoSource
                + " sizes{LI=" + size(li) + ",HO=" + size(ho) + ",RE=" + size(re) + ",PR=" + size(pr) + "}"
                + " totalDebitoPrestadoras=" + (totalDebitoPrestadoras != null ? totalDebitoPrestadoras.toPlainString() : "null"));

        boolean ok = false;
        int processed = 0;
        int okItems = 0;
        int errItems = 0;
        int skippedType = 0;

        try {
            if ("LI".equals(tipoSel)) {
                for (Object o : li) {
                    if (o instanceof ar.com.ospim.liquidaciones.reportes.bean.DebitosLiquidacionesPendientes) {
                        processed++;
                        if (_log.isDebugEnabled()) {
                            _log.debug(prefix(rid) + "[CIERRE][LI][ITEM#" + processed + "][IN] " + String.valueOf(o));
                        }
                        try {
                            BusquedaDebitosTercerizadorasServiceUtil.grabarLiquidacionesPendientesDebitos(
                                    (ar.com.ospim.liquidaciones.reportes.bean.DebitosLiquidacionesPendientes) o,
                                    screenName, fechaHasta, tercerizadoras
                            );
                            okItems++;
                            if (_log.isDebugEnabled()) {
                                _log.debug(prefix(rid) + "[CIERRE][LI][ITEM#" + processed + "][OK]");
                            }
                        } catch (Exception e) {
                            errItems++;
                            _log.error(prefix(rid) + "[CIERRE][LI] Error grabando item#" + processed, e);
                        }
                    } else {
                        skippedType++;
                        if (_log.isDebugEnabled()) {
                            _log.debug(prefix(rid) + "[CIERRE][LI][SKIP] class=" + (o != null ? o.getClass().getName() : "null"));
                        }
                    }
                }

            } else if ("HO".equals(tipoSel)) {
                for (Object o : ho) {
                    if (o instanceof ar.com.ospim.liquidaciones.reportes.bean.DebitosHospitales) {
                        processed++;
                        if (_log.isDebugEnabled()) {
                            _log.debug(prefix(rid) + "[CIERRE][HO][ITEM#" + processed + "][IN] " + String.valueOf(o));
                        }
                        try {
                            BusquedaDebitosTercerizadorasServiceUtil.grabarHospitalesDebitos(
                                    (ar.com.ospim.liquidaciones.reportes.bean.DebitosHospitales) o,
                                    screenName, fechaHasta, tercerizadoras
                            );
                            okItems++;
                            if (_log.isDebugEnabled()) {
                                _log.debug(prefix(rid) + "[CIERRE][HO][ITEM#" + processed + "][OK]");
                            }
                        } catch (Exception e) {
                            errItems++;
                            _log.error(prefix(rid) + "[CIERRE][HO] Error grabando item#" + processed, e);
                        }
                    } else {
                        skippedType++;
                        if (_log.isDebugEnabled()) {
                            _log.debug(prefix(rid) + "[CIERRE][HO][SKIP] class=" + (o != null ? o.getClass().getName() : "null"));
                        }
                    }
                }

            } else if ("RE".equals(tipoSel)) {
                for (Object o : re) {
                    if (o instanceof ar.com.ospim.liquidaciones.reportes.bean.DebitosaReintegros) {
                        processed++;
                        if (_log.isDebugEnabled()) {
                            _log.debug(prefix(rid) + "[CIERRE][RE][ITEM#" + processed + "][IN] " + String.valueOf(o));
                        }
                        try {
                            BusquedaDebitosTercerizadorasServiceUtil.grabarReintegrosDebitos(
                                    (ar.com.ospim.liquidaciones.reportes.bean.DebitosaReintegros) o,
                                    screenName, fechaHasta, tercerizadoras
                            );
                            okItems++;
                            if (_log.isDebugEnabled()) {
                                _log.debug(prefix(rid) + "[CIERRE][RE][ITEM#" + processed + "][OK]");
                            }
                        } catch (Exception e) {
                            errItems++;
                            _log.error(prefix(rid) + "[CIERRE][RE] Error grabando item#" + processed, e);
                        }
                    } else {
                        skippedType++;
                        if (_log.isDebugEnabled()) {
                            _log.debug(prefix(rid) + "[CIERRE][RE][SKIP] class=" + (o != null ? o.getClass().getName() : "null"));
                        }
                    }
                }

            } else if ("PR".equals(tipoSel)) {
                for (Object o : pr) {
                    if (o instanceof ar.com.ospim.liquidaciones.reportes.bean.DebitosaPrestadores) {
                        processed++;
                        if (_log.isDebugEnabled()) {
                            _log.debug(prefix(rid) + "[CIERRE][PR][ITEM#" + processed + "][IN] " + String.valueOf(o));
                        }
                        try {
                            BusquedaDebitosTercerizadorasServiceUtil.grabarPrestadoresDebitos(
                                    (ar.com.ospim.liquidaciones.reportes.bean.DebitosaPrestadores) o,
                                    screenName, fechaHasta, tercerizadoras
                            );
                            okItems++;
                            if (_log.isDebugEnabled()) {
                                _log.debug(prefix(rid) + "[CIERRE][PR][ITEM#" + processed + "][OK]");
                            }
                        } catch (Exception e) {
                            errItems++;
                            _log.error(prefix(rid) + "[CIERRE][PR] Error grabando item#" + processed, e);
                        }
                    } else {
                        skippedType++;
                        if (_log.isDebugEnabled()) {
                            _log.debug(prefix(rid) + "[CIERRE][PR][SKIP] class=" + (o != null ? o.getClass().getName() : "null"));
                        }
                    }
                }
            } else {
                _log.warn(prefix(rid) + "[CIERRE] tipoSel inválido/no soportado: " + safe(tipoSel));
            }

            // IMPORTANTE: mantenemos el comportamiento original: ok=true si no explotó el try global
            ok = true;

        } catch (Exception e) {
            _log.error(prefix(rid) + "[CIERRE] Error general (POR TIPO)", e);
        }

        _log.info(prefix(rid) + "[CIERRE] FIN (POR TIPO) ok=" + (ok ? "1" : "0")
                + " tipoSel=" + safe(tipoSel)
                + " terc=" + safe(tercerizadoras)
                + " periodoSource=" + periodoSource
                + " processed=" + processed
                + " okItems=" + okItems
                + " errItems=" + errItems
                + " skippedType=" + skippedType
                + " elapsedMs=" + (System.currentTimeMillis() - t0));

        actionResponse.setRenderParameter(Constants.CMD, "deleteDetalle");
        actionResponse.setRenderParameter("cacheKey", WORK_KEY);
        actionResponse.setRenderParameter("tipo_proceso", tipoSel);
        actionResponse.setRenderParameter("cierrePeriodoOk", ok ? "1" : "0");
        if (!ok) actionResponse.setRenderParameter("cierrePeriodoError", "1");

        // flags de auditoría + gatillo para forzar persistido en render
        actionResponse.setRenderParameter("afterCerrar", "1");
        actionResponse.setRenderParameter("workCerrado", ok ? "1" : "0");
        _log.info(prefix(rid) + "Finalizando doCerrarPeriodo");
    }

    private boolean existeCierrePeriodo(Date fechaDesde, Date fechaHasta, String tercerizadoras, String tipoSel) throws Exception {
        if (fechaHasta == null) return false;
        if (Validator.isNull(tercerizadoras)) return false;

        String tipoKey = mapTipoSelToGrabadosKey(tipoSel);
        if (Validator.isNull(tipoKey)) {
            throw new Exception("Tipo de proceso inválido para verificar cierre: " + tipoSel);
        }

        String terc = tercerizadoras.trim();

        // mismo criterio que tu JSONAction (consistencia total)
        return BusquedaDebitosTercerizadorasServiceUtil
                .existeReporteGrabadoDebitoTercerizadoras(fechaHasta, terc, tipoKey);
    }

    @SuppressWarnings({"rawtypes", "unchecked"})
    private int removeFrom(List target, List indices, String tipo) {
        if (target == null || indices == null || indices.isEmpty()) return 0;

        _log.info(prefix("NO-RID") + "Iniciando removeFrom tipo=" + tipo
                + " targetSize=" + target.size()
                + " indicesSize=" + indices.size());

        // dedup / sanitización (por si llegan repetidos)
        List cleaned = new ArrayList();
        for (int i = 0; i < indices.size(); i++) {
            Object o = indices.get(i);
            if (!(o instanceof Integer)) continue;
            Integer n = (Integer) o;
            if (!cleaned.contains(n)) cleaned.add(n);
        }

        Collections.sort(cleaned, new Comparator() {
            public int compare(Object a, Object b) {
                Integer ia = (Integer) a;
                Integer ib = (Integer) b;
                // descendente
                return (ib.intValue() > ia.intValue()) ? 1 : (ib.intValue() < ia.intValue()) ? -1 : 0;
            }
        });

        int removed = 0;
        int outOfRange = 0;

        for (int i = 0; i < cleaned.size(); i++) {
            Integer idx = (Integer) cleaned.get(i);
            int n = idx.intValue();
            if (n >= 0 && n < target.size()) {
                target.remove(n);
                removed++;
            } else {
                outOfRange++;
            }
        }

        _log.info(prefix("NO-RID") + "Finalizando removeFrom tipo=" + tipo
                + " removed=" + removed
                + " outOfRange=" + outOfRange
                + " targetSizeAfter=" + target.size());

        return removed;
    }

    private List pickByTipo(String tipoSel, List li, List ho, List re, List pr) {
        _log.info(prefix("NO-RID") + "Iniciando pickByTipo");
        if ("HO".equalsIgnoreCase(tipoSel)) return ho;
        if ("RE".equalsIgnoreCase(tipoSel)) return re;
        if ("PR".equalsIgnoreCase(tipoSel)) return pr;
        _log.info(prefix("NO-RID") + "Finalizando pickByTipo");
        return li; // default LI
    }

    private String buildCacheKey(int anio, int mes0Based, String tercerizadoras) {
        _log.info(prefix("NO-RID") + "Iniciando buildCacheKey");
        if (anio <= 0 || mes0Based < 0) return null;
        String t = (tercerizadoras != null) ? tercerizadoras.trim().toUpperCase() : "";
        _log.info(prefix("NO-RID") + "Finalizando buildCacheKey");
        return anio + "-" + pad2(mes0Based + 1) + "|" + t;
    }

    private String pad2(int n) {
        return (n < 10) ? ("0" + n) : String.valueOf(n);
    }

    private int size(List l) {
        return (l != null) ? l.size() : -1;
    }

    private String normalizeTipoSel(String tipoSel) {
        String t = (tipoSel != null) ? tipoSel.trim().toUpperCase() : "";
        if ("LI".equals(t) || "HO".equals(t) || "RE".equals(t) || "PR".equals(t)) return t;
        return ""; // <- no inventes LI
