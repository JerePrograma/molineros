    private String mapTipoSelToGrabadosKey(String tipoSel) {
        if (Validator.isNull(tipoSel)) return null;

        String t = tipoSel.trim();
        if (Validator.isNull(t)) return null;

        // Si ya viene con la key de DB, la acepto
        if (WebKeysLiquidaciones.DEBITOS_LIQ_PENDIENTES.equals(t) ||
                WebKeysLiquidaciones.DEBITOS_HOSPITALES.equals(t) ||
                WebKeysLiquidaciones.DEBITOS_REINTEGROS.equals(t) ||
                WebKeysLiquidaciones.DEBITOS_PRESTADORES.equals(t)) {
            return t;
        }

        // Si viene abreviado, lo mapeo
        t = t.toUpperCase();
        if ("LI".equals(t)) return WebKeysLiquidaciones.DEBITOS_LIQ_PENDIENTES;
        if ("HO".equals(t)) return WebKeysLiquidaciones.DEBITOS_HOSPITALES;
        if ("RE".equals(t)) return WebKeysLiquidaciones.DEBITOS_REINTEGROS;
        if ("PR".equals(t)) return WebKeysLiquidaciones.DEBITOS_PRESTADORES;

        return null;
    }

