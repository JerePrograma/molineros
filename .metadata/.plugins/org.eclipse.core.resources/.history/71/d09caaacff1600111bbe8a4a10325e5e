    // =========================
    // REABRIR PERIODO (sin cache) -> revierte lo grabado por cerrarPeriodo y lo pasa a BORRADOR
    // =========================
    private void doReabrirPeriodo(ActionRequest actionRequest, ActionResponse actionResponse, String rid) {
        final long t0 = System.currentTimeMillis();

        _log.info(prefix(rid) + "Iniciando doReabrirPeriodo");
        HttpServletRequest httpReq = PortalUtil.getHttpServletRequest(actionRequest);
        HttpSession session = httpReq.getSession();

        String ns = null;
        try {
            String portletId = PortalUtil.getPortletId(actionRequest);
            ns = PortalUtil.getPortletNamespace(portletId);
        } catch (Exception ignore) {
        }

        // -------------------------
        // Tipo seleccionado
        // -------------------------
        String tipoSel = ParamUtil.getString(actionRequest, "tipo_proceso",
                ParamUtil.getString(actionRequest, "tipoProceso",
                        ParamUtil.getString(actionRequest, "tipoDebito", null)));
        if (Validator.isNull(tipoSel) && ns != null) {
            tipoSel = ParamUtil.getString(actionRequest, ns + "tipo_proceso",
                    ParamUtil.getString(actionRequest, ns + "tipoProceso",
                            ParamUtil.getString(actionRequest, ns + "tipoDebito", null)));
        }
        tipoSel = normalizeTipoSel(tipoSel);

        // -------------------------
        // Tercerizadora (sesión primero; fallback request)
        // -------------------------
        String tercerizadoras = null;
        try {
            tercerizadoras = (String) session.getAttribute(SESSION_WORK_TERC);
        } catch (Exception ignore) {
        }

        if (Validator.isNull(tercerizadoras)) {
            tercerizadoras = ParamUtil.getString(actionRequest, "tipo_debitos_tercerizadoras",
                    ParamUtil.getString(actionRequest, "tipo_debito", ""));
            if (Validator.isNull(tercerizadoras) && ns != null) {
                tercerizadoras = ParamUtil.getString(actionRequest, ns + "tipo_debitos_tercerizadoras",
                        ParamUtil.getString(actionRequest, ns + "tipo_debito", ""));
            }
        }
        tercerizadoras = (tercerizadoras != null) ? tercerizadoras.trim() : "";

        // -------------------------
        // Período: MISMA lógica que doCerrarPeriodo (request -> sesión)
        // -------------------------
        Date fechaDesdeSess = (Date) session.getAttribute(SESSION_WORK_FECHA_DESDE);
        Date fechaHastaSess = (Date) session.getAttribute(SESSION_WORK_FECHA_HASTA);

        Integer anioSess = null;
        Integer mes0Sess = null;
        try {
            anioSess = (Integer) session.getAttribute(SESSION_WORK_ANIO);
        } catch (Exception ignore) {
        }
        try {
            mes0Sess = (Integer) session.getAttribute(SESSION_WORK_MES0);
        } catch (Exception ignore) {
        }

        long reqFechaHastaMs = ParamUtil.getLong(actionRequest, "fechaHastaMs",
                ParamUtil.getLong(actionRequest, "fechaHasta", 0L));
        if (reqFechaHastaMs == 0L && ns != null) {
            reqFechaHastaMs = ParamUtil.getLong(actionRequest, ns + "fechaHastaMs",
                    ParamUtil.getLong(actionRequest, ns + "fechaHasta", 0L));
        }

        String reqPeriodo = ParamUtil.getString(actionRequest, "periodo",
                ParamUtil.getString(actionRequest, "periodoSel",
                        ParamUtil.getString(actionRequest, "periodoSeleccionado", "")));
        if (Validator.isNull(reqPeriodo) && ns != null) {
            reqPeriodo = ParamUtil.getString(actionRequest, ns + "periodo",
                    ParamUtil.getString(actionRequest, ns + "periodoSel",
                            ParamUtil.getString(actionRequest, ns + "periodoSeleccionado", "")));
        }
        reqPeriodo = (reqPeriodo != null) ? reqPeriodo.trim() : "";

        Date fechaDesde = null;
        Date fechaHasta = null;
        String periodoSource = "UNKNOWN";

        if (reqFechaHastaMs > 0L) {
            try {
                Calendar cal = DateUtils.getCalendarGMTMenos3();
                cal.setTime(new Date(reqFechaHastaMs));

                int y = cal.get(Calendar.YEAR);
                int m0 = cal.get(Calendar.MONTH);

                cal.set(Calendar.YEAR, y);
                cal.set(Calendar.MONTH, m0);
                cal.set(Calendar.DAY_OF_MONTH, 1);
                cal.set(Calendar.HOUR_OF_DAY, 0);
                cal.set(Calendar.MINUTE, 0);
                cal.set(Calendar.SECOND, 0);
                cal.set(Calendar.MILLISECOND, 0);

                fechaDesde = cal.getTime();
                fechaHasta = DateUtils.getLastDateOfMonth(fechaDesde, false);

                periodoSource = "REQUEST_MS";
            } catch (Exception e) {
                _log.error(prefix(rid) + "[REABRIR][PERIODO] Error armando período desde REQUEST_MS=" + reqFechaHastaMs, e);
            }
        }

        if ((fechaDesde == null || fechaHasta == null) && Validator.isNotNull(reqPeriodo)) {
            try {
                String p = reqPeriodo;
                int eq = p.indexOf('=');
                if (eq >= 0) p = p.substring(eq + 1);
                p = p.trim();

                String[] parts = p.split("-");
                if (parts != null && parts.length >= 2) {
                    int y = Integer.parseInt(parts[0]);
                    int m1 = Integer.parseInt(parts[1]);
                    int m0 = m1 - 1;

                    Calendar cal = DateUtils.getCalendarGMTMenos3();
                    cal.set(Calendar.YEAR, y);
                    cal.set(Calendar.MONTH, m0);
                    cal.set(Calendar.DAY_OF_MONTH, 1);
                    cal.set(Calendar.HOUR_OF_DAY, 0);
                    cal.set(Calendar.MINUTE, 0);
                    cal.set(Calendar.SECOND, 0);
                    cal.set(Calendar.MILLISECOND, 0);

                    fechaDesde = cal.getTime();
                    fechaHasta = DateUtils.getLastDateOfMonth(fechaDesde, false);

                    periodoSource = "REQUEST_PERIODO";
                }
            } catch (Exception e) {
                _log.error(prefix(rid) + "[REABRIR][PERIODO] Error parseando REQUEST_PERIODO=" + safe(reqPeriodo), e);
            }
        }

        if (fechaDesde == null || fechaHasta == null) {
            fechaDesde = fechaDesdeSess;
            fechaHasta = fechaHastaSess;
            if (fechaDesde != null && fechaHasta != null) periodoSource = "SESSION_DATES";
        }

        if (fechaDesde == null || fechaHasta == null) {
            if (anioSess != null && mes0Sess != null && anioSess.intValue() > 0 && mes0Sess.intValue() >= 0) {
                Calendar cal = DateUtils.getCalendarGMTMenos3();
                cal.set(Calendar.YEAR, anioSess.intValue());
                cal.set(Calendar.MONTH, mes0Sess.intValue());
                cal.set(Calendar.DAY_OF_MONTH, 1);
                cal.set(Calendar.HOUR_OF_DAY, 0);
                cal.set(Calendar.MINUTE, 0);
                cal.set(Calendar.SECOND, 0);
                cal.set(Calendar.MILLISECOND, 0);
                fechaDesde = cal.getTime();
                fechaHasta = DateUtils.getLastDateOfMonth(fechaDesde, false);
                periodoSource = "SESSION_ANIO_MES";
            }
        }

        if (_log.isInfoEnabled()) {
            _log.info(prefix(rid) + "[REABRIR][START] tipoSel=" + safe(tipoSel)
                    + " tercerizadoras=" + safe(tercerizadoras)
                    + " fechaDesde(ms)=" + (fechaDesde != null ? String.valueOf(fechaDesde.getTime()) : "null")
                    + " fechaHasta(ms)=" + (fechaHasta != null ? String.valueOf(fechaHasta.getTime()) : "null")
                    + " periodoSource=" + periodoSource
                    + " workPeriodo=" + safe(workPeriodoLabel(session)));
        }

        if (fechaDesde == null || fechaHasta == null || Validator.isNull(tercerizadoras)) {
            _log.warn(prefix(rid) + "[REABRIR] período/tercerizadora inválidos. No reabro.");

            actionResponse.setRenderParameter(Constants.CMD, "deleteDetalle");
            actionResponse.setRenderParameter("cacheKey", WORK_KEY);
            actionResponse.setRenderParameter("tipo_proceso", tipoSel);
            actionResponse.setRenderParameter("reabrirPeriodoOk", "0");
            actionResponse.setRenderParameter("reabrirPeriodoError", "periodo_o_terc_null");
            actionResponse.setRenderParameter("afterReabrir", "1");
            actionResponse.setRenderParameter("workCerrado", "0");
            actionResponse.setRenderParameter("afterCerrar", "0");
            return;
        }

        User user = null;
        try {
            user = PortalUtil.getUser(actionRequest);
        } catch (Exception ignore) {
        }

        if (user == null) {
            _log.error(prefix(rid) + "[REABRIR] Usuario nulo; no se puede reabrir.");

            actionResponse.setRenderParameter(Constants.CMD, "deleteDetalle");
            actionResponse.setRenderParameter("cacheKey", WORK_KEY);
            actionResponse.setRenderParameter("tipo_proceso", tipoSel);
            actionResponse.setRenderParameter("reabrirPeriodoOk", "0");
            actionResponse.setRenderParameter("reabrirPeriodoError", "user_null");
            actionResponse.setRenderParameter("afterReabrir", "1");
            actionResponse.setRenderParameter("workCerrado", "0");
            actionResponse.setRenderParameter("afterCerrar", "0");
            return;
        }

        String screenName = "system";
        try {
            if (Validator.isNotNull(user.getScreenName())) screenName = user.getScreenName();
        } catch (Exception ignore) {
        }

        // -------------------------
        // Validar que esté CERRADO (si no, no hay nada que reabrir)
        // -------------------------
        boolean yaCerrado = false;
        try {
            yaCerrado = existeCierrePeriodo(fechaDesde, fechaHasta, tercerizadoras, tipoSel);
        } catch (Exception e) {
            _log.error(prefix(rid) + "[REABRIR] No se pudo verificar cierre previo. No reabro (fail-safe).", e);

            actionResponse.setRenderParameter(Constants.CMD, "deleteDetalle");
            actionResponse.setRenderParameter("cacheKey", WORK_KEY);
            actionResponse.setRenderParameter("tipo_proceso", tipoSel);
            actionResponse.setRenderParameter("reabrirPeriodoOk", "0");
            actionResponse.setRenderParameter("reabrirPeriodoError", "check_cierre_failed");
            actionResponse.setRenderParameter("afterReabrir", "1");
            actionResponse.setRenderParameter("workCerrado", "1"); // si no pude checkear, prefiero marcarlo conservador
            actionResponse.setRenderParameter("afterCerrar", "0");
            return;
        }

        if (!yaCerrado) {
            _log.warn(prefix(rid) + "[REABRIR] El período NO está cerrado para tipoSel. Nada que reabrir.");

            actionResponse.setRenderParameter(Constants.CMD, "deleteDetalle");
            actionResponse.setRenderParameter("cacheKey", WORK_KEY);
            actionResponse.setRenderParameter("tipo_proceso", tipoSel);
            actionResponse.setRenderParameter("reabrirPeriodoOk", "0");
            actionResponse.setRenderParameter("reabrirPeriodoError", "periodo_no_cerrado");
            actionResponse.setRenderParameter("afterReabrir", "1");
            actionResponse.setRenderParameter("workCerrado", "0");
            actionResponse.setRenderParameter("afterCerrar", "0");
            return;
        }

        // -------------------------
        // 1) Leer grabados (la “misma lista” pero desde DB)
        // -------------------------
        String tipoKey = mapTipoSelToGrabadosKey(tipoSel);
        List grabados = null;
        try {
            grabados = BusquedaDebitosTercerizadorasServiceUtil.getBusquedaDebitosaGrabados(tipoKey, fechaHasta, tercerizadoras);
        } catch (Exception e) {
            _log.error(prefix(rid) + "[REABRIR] Error leyendo grabados tipoKey=" + safe(tipoKey), e);
        }
        if (grabados == null) grabados = new ArrayList();

        // -------------------------
        // 2) Reabrir atómico en DB (reconstruye borrador + borra grabado)
        // -------------------------
        boolean ok = false;
        int insertedBorrador = 0;
        int deletedGrabado = 0;

        try {
            int[] r = BusquedaDebitosTercerizadorasServiceUtil.reabrirDebitosTercerizadorasPeriodo(
                    tipoSel, fechaDesde, fechaHasta, tercerizadoras, screenName
            );
            if (r != null && r.length >= 2) {
                insertedBorrador = r[0];
                deletedGrabado = r[1];
            }

            // si estaba “cerrado”, deletedGrabado debería ser > 0
            ok = (deletedGrabado > 0 && insertedBorrador > 0);

        } catch (Exception e) {
            _log.error(prefix(rid) + "[REABRIR] Error ejecutando reabrirDebitosTercerizadorasPeriodo (db-fn).", e);

            actionResponse.setRenderParameter(Constants.CMD, "deleteDetalle");
            actionResponse.setRenderParameter("cacheKey", WORK_KEY);
            actionResponse.setRenderParameter("tipo_proceso", tipoSel);
            actionResponse.setRenderParameter("reabrirPeriodoOk", "0");
            actionResponse.setRenderParameter("reabrirPeriodoError", "db_fn_failed");
            actionResponse.setRenderParameter("afterReabrir", "1");
            actionResponse.setRenderParameter("workCerrado", "1");
            actionResponse.setRenderParameter("afterCerrar", "0");
            return;
        }

        // -------------------------
        // 4) Rehidratar WORK session: el tipo reabierto vuelve editable
        // -------------------------
        if ("LI".equals(tipoSel)) session.setAttribute(SESSION_WORK_LI, grabados);
        else if ("HO".equals(tipoSel)) session.setAttribute(SESSION_WORK_HO, grabados);
        else if ("RE".equals(tipoSel)) session.setAttribute(SESSION_WORK_RE, grabados);
        else if ("PR".equals(tipoSel)) session.setAttribute(SESSION_WORK_PR, grabados);

        session.setAttribute(SESSION_WORK_MODE, "REABIERTO");
        session.setAttribute(SESSION_WORK_CERRADO_TIPO, null);

        // staging vacío (mismo criterio que cierres/persistidos)
        session.setAttribute(SESSION_STG_LI, new ArrayList());
        session.setAttribute(SESSION_STG_HO, new ArrayList());
        session.setAttribute(SESSION_STG_RE, new ArrayList());
        session.setAttribute(SESSION_STG_PR, new ArrayList());
        session.setAttribute(SESSION_STG_SOURCE_KEY, null);

        _log.info(prefix(rid) + "[REABRIR][END] ok=" + (ok ? "1" : "0")
                + " tipoSel=" + safe(tipoSel)
                + " terc=" + safe(tercerizadoras)
                + " periodoSource=" + periodoSource
                + " grabadosRead=" + size(grabados)
                + " insertedBorrador=" + insertedBorrador
                + " deletedGrabado=" + deletedGrabado
                + " elapsedMs=" + (System.currentTimeMillis() - t0));

        actionResponse.setRenderParameter(Constants.CMD, "deleteDetalle");
        actionResponse.setRenderParameter("cacheKey", WORK_KEY);
        actionResponse.setRenderParameter("tipo_proceso", tipoSel);

        actionResponse.setRenderParameter("reabrirPeriodoOk", ok ? "1" : "0");
        if (!ok) actionResponse.setRenderParameter("reabrirPeriodoError", "insert_failed");

        // flags para que render no intente forzar cerrado
        actionResponse.setRenderParameter("afterReabrir", "1");
        actionResponse.setRenderParameter("afterCerrar", "0");
        actionResponse.setRenderParameter("workCerrado", "0");

        _log.info(prefix(rid) + "Finalizando doReabrirPeriodo");
    }

    private static final class AppendFilterResult {
        List stgLI, stgHO, stgRE, stgPR;
        boolean closedLI, closedHO, closedRE, closedPR;
        boolean anyClosed;
        int filteredTotal;
    }

    private AppendFilterResult filterStagingAgainstGrabados(Date fechaHasta, String terc,
                                                            List stgLI, List stgHO, List stgRE, List stgPR, String rid) {

        AppendFilterResult r = new AppendFilterResult();
        r.stgLI = (stgLI != null) ? stgLI : new ArrayList();
        r.stgHO = (stgHO != null) ? stgHO : new ArrayList();
        r.stgRE = (stgRE != null) ? stgRE : new ArrayList();
        r.stgPR = (stgPR != null) ? stgPR : new ArrayList();

        if (fechaHasta == null || Validator.isNull(terc)) return r;

        // Cargo grabados por tipo (una sola vez) y uso eso para: (a) decidir si está cerrado (b) filtrar
        List gLI = loadGrabadosSafe("LI", fechaHasta, terc, rid);
        List gHO = loadGrabadosSafe("HO", fechaHasta, terc, rid);
        List gRE = loadGrabadosSafe("RE", fechaHasta, terc, rid);
        List gPR = loadGrabadosSafe("PR", fechaHasta, terc, rid);

        r.closedLI = (gLI != null && !gLI.isEmpty());
        r.closedHO = (gHO != null && !gHO.isEmpty());
        r.closedRE = (gRE != null && !gRE.isEmpty());
        r.closedPR = (gPR != null && !gPR.isEmpty());
        r.anyClosed = (r.closedLI || r.closedHO || r.closedRE || r.closedPR);

        int before = size(r.stgLI) + size(r.stgHO) + size(r.stgRE) + size(r.stgPR);

        if (r.closedLI) r.stgLI = filterOutByBusinessKey("LI", r.stgLI, gLI, rid);
        if (r.closedHO) r.stgHO = filterOutByBusinessKey("HO", r.stgHO, gHO, rid);
        if (r.closedRE) r.stgRE = filterOutByBusinessKey("RE", r.stgRE, gRE, rid);
        if (r.closedPR) r.stgPR = filterOutByBusinessKey("PR", r.stgPR, gPR, rid);

        int after = size(r.stgLI) + size(r.stgHO) + size(r.stgRE) + size(r.stgPR);
        r.filteredTotal = (before >= 0 && after >= 0) ? (before - after) : 0;

        if (r.anyClosed) {
            _log.info(prefix(rid) + "[APPEND][CERRADO-DIFF] terc=" + safe(terc)
                    + " fechaHasta(ms)=" + String.valueOf(fechaHasta.getTime())
                    + " filteredTotal=" + r.filteredTotal
                    + " sizesAfter{LI=" + size(r.stgLI) + ",HO=" + size(r.stgHO)
                    + ",RE=" + size(r.stgRE) + ",PR=" + size(r.stgPR) + "}");
        }
        return r;
    }

    private List loadGrabadosSafe(String tipoSel, Date fechaHasta, String terc, String rid) {
        try {
            String tipoKey = mapTipoSelToGrabadosKey(tipoSel);
            if (Validator.isNull(tipoKey)) return new ArrayList();
            List g = BusquedaDebitosTercerizadorasServiceUtil.getBusquedaDebitosaGrabados(tipoKey, fechaHasta, terc);
            return (g != null) ? g : new ArrayList();
        } catch (Exception e) {
            _log.error(prefix(rid) + "[APPEND][GRABADOS] Error cargando grabados tipo=" + safe(tipoSel)
                    + " terc=" + safe(terc)
                    + " fechaHasta(ms)=" + (fechaHasta != null ? String.valueOf(fechaHasta.getTime()) : "null"), e);
            return new ArrayList(); // fail-open: si no puedo cargar grabados, no filtro
        }
    }

    private List filterOutByBusinessKey(String tipo, List source, List grabados, String rid) {
        if (source == null || source.isEmpty()) return (source != null) ? source : new ArrayList();
        if (grabados == null || grabados.isEmpty()) return source;

        java.util.HashSet closedKeys = new java.util.HashSet(grabados.size() * 2);
        for (int i = 0; i < grabados.size(); i++) {
            Object o = grabados.get(i);
            String k = buildStableKey(tipo, o);
            if (k != null) closedKeys.add(k);
        }

        // also de-dup inside source to avoid repeated rows (optional but practical)
        java.util.HashSet seen = new java.util.HashSet(source.size() * 2);
        List out = new ArrayList(source.size());

        int dropped = 0;
        for (int i = 0; i < source.size(); i++) {
            Object o = source.get(i);
            String k = buildStableKey(tipo, o);

            // Si no puedo construir key, NO elimino (fail-open).
            if (k == null) {
                out.add(o);
                continue;
            }

            if (closedKeys.contains(k)) {
                dropped++;
                continue;
            }
            if (seen.contains(k)) {
                dropped++;
                continue;
            }

            seen.add(k);
            out.add(o);
        }

        if (dropped > 0) {
            _log.info(prefix(rid) + "[APPEND][CERRADO-DIFF][" + tipo + "] dropped=" + dropped
                    + " sourceIn=" + source.size() + " sourceOut=" + out.size()
                    + " grabados=" + grabados.size());
        }
        return out;
    }

    /**
     * IMPORTANTÍSIMO:
     * Esta key es un “mejor esfuerzo” sin tus beans.
     * Para que sea 100% correcta, reemplazala por una clave natural REAL por tipo.
     */
    private String buildStableKey(String tipo, Object o) {
        if (o == null) return null;

        // 1) Preferir claves que suelen existir en ambos mundos
        Object idReclamo = invoke0(o, "getIdReclamoPrestacional");
        if (idReclamo != null) return tipo + "|IRP|" + String.valueOf(idReclamo);

        Object numeroOp = invoke0(o, "getNumeroOp");
        if (numeroOp != null) return tipo + "|OP|" + String.valueOf(numeroOp);

        // 2) Fallback por combinatoria típica
        Object numero = invoke0(o, "getNumero");
        Object factura = invoke0(o, "getFactura");
        if (factura == null) factura = invoke0(o, "getNumeroFactura");

        Object doc = invoke0(o, "getNumeroDocumento");
        Object monto = invoke0(o, "getMonto");
        if (monto == null) monto = invoke0(o, "getMontoDebitar");

        Object fechaOp = invoke0(o, "getFechaOp");

        String k = tipo
                + "|N|" + norm(numero)
                + "|F|" + norm(factura)
                + "|D|" + norm(doc)
                + "|M|" + norm(monto)
                + "|T|" + dateMs(fechaOp);

        // Si está todo vacío, no sirve.
        if (k.indexOf("|N|(null)") > 0
                && k.indexOf("|F|(null)") > 0
                && k.indexOf("|D|(null)") > 0
                && k.indexOf("|M|(null)") > 0
                && k.indexOf("|T|null") > 0) {
            return null;
        }
        return k;
    }

    private Object invoke0(Object target, String methodName) {
        try {
            java.lang.reflect.Method m = target.getClass().getMethod(methodName, new Class[0]);
            return m.invoke(target, new Object[0]);
        } catch (Exception e) {
            return null;
        }
    }

    private String norm(Object v) {
        if (v == null) return "(null)";
        String s = String.valueOf(v).trim();
        return (s.length() == 0) ? "(empty)" : s.toUpperCase();
    }

    private String dateMs(Object v) {
        if (v == null) return "null";
        if (v instanceof java.util.Date) return String.valueOf(((java.util.Date) v).getTime());
        return String.valueOf(v);
    }

    private Set buildKeysFromWorkSession(HttpSession session, String tipoSel) {
        Set out = new HashSet();
        if (session == null) return out;

        List li = (List) session.getAttribute(SESSION_WORK_LI);
        List ho = (List) session.getAttribute(SESSION_WORK_HO);
        List re = (List) session.getAttribute(SESSION_WORK_RE);
        List pr = (List) session.getAttribute(SESSION_WORK_PR);

        List sel = pickByTipo(tipoSel,
                li != null ? li : new ArrayList(),
                ho != null ? ho : new ArrayList(),
                re != null ? re : new ArrayList(),
                pr != null ? pr : new ArrayList()
        );

        out.addAll(buildKeysFromList(tipoSel, sel));
        return out;
    }

    @SuppressWarnings({"rawtypes", "unchecked"})
    private List filterOutByKeys(String tipoSel, List base, Set excludedKeys, String rid) {
        if (base == null) return new ArrayList();
        if (excludedKeys == null) excludedKeys = new HashSet();

        List out = new ArrayList();
        Set seen = new HashSet();

        int noKey = 0;

        for (int i = 0; i < base.size(); i++) {
            Object o = base.get(i);
            String k = itemKey(tipoSel, o);

            // FAIL-OPEN: si no puedo construir key, lo dejo pasar (y lo logueo)
            if (Validator.isNull(k)) {
                noKey++;
                out.add(o);
                continue;
            }

            if (excludedKeys.contains(k)) continue;
            if (seen.add(k)) out.add(o);
        }

        if (noKey > 0) {
            _log.warn(prefix(rid) + "[APPEND][KEY] " + noKey + " items sin key (itemKey no pudo extraer campos). "
                    + "Esto debilita el filtrado; definí una business key real por tipo.");
        }

        return out;
    }

    /**
     * Clave estable por ítem.
     * La idea: usar campos que existen en tus beans (numero, factura, numeroOp, idReclamoPrestacional, documento, monto).
     * Si un getter no existe, se ignora.
     */
    private String itemKey(String tipoSel, Object o) {
        if (o == null) return "";

        // Nota: tipoSel lo metemos para evitar colisiones entre tipos.
        String numero = getByReflection(o, new String[]{"getNumero"});
        String factura = getByReflection(o, new String[]{"getFactura", "getNumeroFactura"});
        String op = getByReflection(o, new String[]{"getNumeroOp", "getNumeroOP", "getOp"});
        String idReclamo = getByReflection(o, new String[]{"getIdReclamoPrestacional", "getIdReclamo"});
        String doc = getByReflection(o, new String[]{"getNumeroDocumento", "getDocumento"});
        String monto = getByReflection(o, new String[]{"getMontoDebitar", "getMonto"});

        // Normalización mínima
        numero = normKeyPart(numero);
        factura = normKeyPart(factura);
        op = normKeyPart(op);
        idReclamo = normKeyPart(idReclamo);
        doc = normKeyPart(doc);
        monto = normKeyPart(monto);

        return tipoSel + "|" + numero + "|" + factura + "|" + op + "|" + idReclamo + "|" + doc + "|" + monto;
    }

    private String normKeyPart(String s) {
        if (s == null) return "";
        String t = s.trim();
        return t.length() == 0 ? "" : t.toUpperCase();
    }

    private String getByReflection(Object o, String[] getters) {
        if (o == null || getters == null) return null;
        for (int i = 0; i < getters.length; i++) {
            String m = getters[i];
            try {
                java.lang.reflect.Method mm = o.getClass().getMethod(m, new Class[0]);
                Object v = mm.invoke(o, new Object[0]);
                if (v != null) return String.valueOf(v);
            } catch (Exception ignore) {
            }
        }
        return null;
    }

    private Set buildKeysFromClosedPeriodo(String tipoSel, Date fechaHasta, String tercerizadoras, String rid) {
        Set out = new HashSet();

        if (fechaHasta == null || Validator.isNull(tercerizadoras)) return out;

        String tipoDbKey = mapTipoSelToGrabadosKey(tipoSel);
        if (Validator.isNull(tipoDbKey)) return out;

        try {
            // Traigo SOLO lo grabado en ESTE período (no all-periodos)
            List closedList = (List) BusquedaDebitosTercerizadorasServiceUtil.getBusquedaDebitosaGrabados(
                    tipoDbKey, fechaHasta, tercerizadoras
            );

            if (closedList != null && !closedList.isEmpty()) {
                // IMPORTANTE: estas claves deben ser IDENTICAS a las que usa filterOutByKeys(...)
                out.addAll(buildKeysFromList(tipoSel, closedList));
            }

            if (_log.isDebugEnabled()) {
                _log.debug(prefix(rid) + "[CERRADO-KEYS] tipoSel=" + safe(tipoSel)
                        + " tipoDbKey=" + safe(tipoDbKey)
                        + " closedList.size=" + (closedList != null ? closedList.size() : -1)
                        + " keys.size=" + out.size());
            }

        } catch (Exception e) {
            _log.error(prefix(rid) + "[CERRADO-KEYS] Error leyendo grabados del período", e);
        }

        return out;
    }

    private Set<String> buildKeysFromList(String tipoSel, List<?> items) {
        if (items == null || items.isEmpty()) {
            return java.util.Collections.<String>emptySet();
        }

        // Orden determinista (útil para logs/diffs)
        Set<String> out = new java.util.LinkedHashSet<String>(
                Math.max((int) (items.size() / 0.75f) + 1, 16)
        );

        for (Object o : items) {
            if (o == null) continue;

            String k = itemKey(tipoSel, o);
            if (k == null) continue;

            k = k.trim();
            if (!k.isEmpty()) {
                out.add(k);
            }
        }
        return out;
    }

