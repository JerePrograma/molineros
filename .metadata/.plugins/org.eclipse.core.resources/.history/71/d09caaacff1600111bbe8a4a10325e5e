        }
        terc = (terc != null) ? terc.trim() : "";

        // Si falta fechaHasta, intento reconstruir por anio/mes
        if (fechaHasta == null) {
            Integer anio = (Integer) session.getAttribute(SESSION_WORK_ANIO);
            Integer mes0 = (Integer) session.getAttribute(SESSION_WORK_MES0);
            if (anio != null && mes0 != null && anio.intValue() > 0 && mes0.intValue() >= 0) {
                Calendar cal = DateUtils.getCalendarGMTMenos3();
                cal.set(Calendar.YEAR, anio.intValue());
                cal.set(Calendar.MONTH, mes0.intValue());
                cal.set(Calendar.DAY_OF_MONTH, 1);
                cal.set(Calendar.HOUR_OF_DAY, 0);
                cal.set(Calendar.MINUTE, 0);
                cal.set(Calendar.SECOND, 0);
                cal.set(Calendar.MILLISECOND, 0);
                fechaDesde = cal.getTime();
                fechaHasta = DateUtils.getLastDateOfMonth(fechaDesde, false);
            }
        }

        if (fechaHasta == null || Validator.isNull(terc)) {
            _log.warn(prefix(rid) + "[FORCE-CERRADO] No puedo forzar persistido: fechaHasta/terc inválidos."
                    + " fechaHasta=" + (fechaHasta != null ? String.valueOf(fechaHasta.getTime()) : "null")
                    + " terc=" + safe(terc));
            return false;
        }

        // Check real por tipoSel (fail-safe)
        boolean cerrado = isPeriodoCerrado(fechaDesde, fechaHasta, terc, tipoSel, rid);
        if (!cerrado) {
            if (_log.isInfoEnabled()) {
                _log.info(prefix(rid) + "[FORCE-CERRADO] WORK no está cerrado según check actual. No fuerzo."
                        + " tipoSel=" + safe(tipoSel)
                        + " fechaHasta(ms)=" + String.valueOf(fechaHasta.getTime())
                        + " terc=" + safe(terc));
            }
            // Aún así, dejamos PERIODO_CERRADO en false
            renderRequest.setAttribute("PERIODO_CERRADO", Boolean.FALSE);
            return false;
        }

        // Traer persistidos (igual que doSearchFromPersistido, pero sin depender de params)
        List totales = new ArrayList();
        DebitosaTotal debitosaTotal = null;
        try {
            debitosaTotal = BusquedaDebitosTercerizadorasServiceUtil.getBuscarTotalesDebitos(fechaHasta, terc);
            if (debitosaTotal != null) totales.add(debitosaTotal);
        } catch (Exception e) {
            _log.error(prefix(rid) + "[FORCE-CERRADO][TOTALES] Error consultando totales", e);
        }
        if (debitosaTotal == null) debitosaTotal = new DebitosaTotal();

        List detalleLI = new ArrayList();
        List detalleHO = new ArrayList();
        List detalleRE = new ArrayList();
        List detallePR = new ArrayList();

        try {
            detalleLI = (List) BusquedaDebitosTercerizadorasServiceUtil.getBusquedaDebitosaGrabados(
                    WebKeysLiquidaciones.DEBITOS_LIQ_PENDIENTES, fechaHasta, terc);
        } catch (Exception e) {
            _log.error(prefix(rid) + "[FORCE-CERRADO][LI] Error grabados", e);
        }
        try {
            detalleHO = (List) BusquedaDebitosTercerizadorasServiceUtil.getBusquedaDebitosaGrabados(
                    WebKeysLiquidaciones.DEBITOS_HOSPITALES, fechaHasta, terc);
        } catch (Exception e) {
            _log.error(prefix(rid) + "[FORCE-CERRADO][HO] Error grabados", e);
        }
        try {
            detalleRE = (List) BusquedaDebitosTercerizadorasServiceUtil.getBusquedaDebitosaGrabados(
                    WebKeysLiquidaciones.DEBITOS_REINTEGROS, fechaHasta, terc);
        } catch (Exception e) {
            _log.error(prefix(rid) + "[FORCE-CERRADO][RE] Error grabados", e);
        }
        try {
            detallePR = (List) BusquedaDebitosTercerizadorasServiceUtil.getBusquedaDebitosaGrabados(
                    WebKeysLiquidaciones.DEBITOS_PRESTADORES, fechaHasta, terc);
        } catch (Exception e) {
            _log.error(prefix(rid) + "[FORCE-CERRADO][PR] Error grabados", e);
        }

        session.setAttribute(SESSION_TOTALES_KEY, (totales != null) ? totales : new ArrayList());
        session.setAttribute(SESSION_WORK_FECHA_DESDE, fechaDesde);
        session.setAttribute(SESSION_WORK_FECHA_HASTA, fechaHasta);
        session.setAttribute(SESSION_WORK_TERC, terc);
        session.setAttribute(SESSION_WORK_EXISTE_PERSIST, Boolean.TRUE);
        session.setAttribute(SESSION_WORK_MODE, "CERRADO");

        session.setAttribute(SESSION_WORK_LI, (detalleLI != null) ? detalleLI : new ArrayList());
        session.setAttribute(SESSION_WORK_HO, (detalleHO != null) ? detalleHO : new ArrayList());
        session.setAttribute(SESSION_WORK_RE, (detalleRE != null) ? detalleRE : new ArrayList());
        session.setAttribute(SESSION_WORK_PR, (detallePR != null) ? detallePR : new ArrayList());

        // staging vacío
        session.setAttribute(SESSION_STG_LI, new ArrayList());
        session.setAttribute(SESSION_STG_HO, new ArrayList());
        session.setAttribute(SESSION_STG_RE, new ArrayList());
        session.setAttribute(SESSION_STG_PR, new ArrayList());
        session.setAttribute(SESSION_STG_SOURCE_KEY, null);

        applyWorkFromSessionToRequest(session, renderRequest, tipoSel);
        renderRequest.setAttribute(REQ_CACHE_KEY, WORK_KEY);
        renderRequest.setAttribute(REQ_WORK_CACHE_KEY, WORK_KEY);
        renderRequest.setAttribute("DEBITOS_BUSQUEDA_MODE", "CERRADO");
        renderRequest.setAttribute("PERIODO_CERRADO", Boolean.TRUE);
        renderRequest.removeAttribute(REQ_APPEND_MODE);
        session.setAttribute(SESSION_WORK_CERRADO_TIPO, tipoSel);
        renderRequest.setAttribute("DEBITOS_CERRADO_TIPO", tipoSel);

        if (_log.isInfoEnabled()) {
            _log.info(prefix(rid) + "[FORCE-CERRADO] OK"
                    + " terc=" + safe(terc)
                    + " fechaHasta(ms)=" + String.valueOf(fechaHasta.getTime())
                    + " sizes{LI=" + size(detalleLI) + ",HO=" + size(detalleHO)
                    + ",RE=" + size(detalleRE) + ",PR=" + size(detallePR) + "}"
                    + " elapsedMs=" + (System.currentTimeMillis() - t0));
        }
        _log.info(prefix(rid) + "Finalizando doRenderClosedFromWorkSession");
        return true;
    }

    // ============================================================================
    // dump params action
    // ============================================================================
    private void dumpAllActionParams(ActionRequest actionRequest, String rid) {
        _log.info(prefix(rid) + "Iniciando dumpAllActionParams");
        try {
            StringBuilder sb = new StringBuilder();
            sb.append(prefix(rid)).append("[ACTION-PARAM-DUMP] ");

            java.util.Enumeration names = actionRequest.getParameterNames();
            while (names != null && names.hasMoreElements()) {
                String k = String.valueOf(names.nextElement());
                String[] vs = actionRequest.getParameterValues(k);
                sb.append(k).append("=");

                if (vs == null) {
                    sb.append("null");
                } else if (vs.length == 1) {
                    sb.append("'").append(vs[0]).append("'");
                } else {
                    sb.append("[");
                    for (int i = 0; i < vs.length; i++) {
                        if (i > 0) sb.append(",");
                        sb.append("'").append(vs[i]).append("'");
                    }
                    sb.append("]");
                }
                sb.append(" ");
            }

            _log.info(sb.toString());
        } catch (Exception e) {
            _log.warn(prefix(rid) + "No pude dumpear parámetros de ACTION", e);
        } finally {
            _log.info(prefix(rid) + "Finalizando dumpAllActionParams");
        }
    }

