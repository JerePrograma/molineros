    private void incCount(Map<Integer, Integer> map, int key) {
        Integer k = new Integer(key);
        Integer curr = map.get(k);
        if (curr == null) map.put(k, new Integer(1));
        else map.put(k, new Integer(curr.intValue() + 1));
    }

