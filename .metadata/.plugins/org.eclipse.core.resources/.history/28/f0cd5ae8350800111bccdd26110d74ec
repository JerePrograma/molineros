    private static BigDecimal parseBigDecimalOrNull(String s) {
        if (s == null) return null;
        String t = s.trim();
        if (t.length() == 0) return null;
        try {
            return new BigDecimal(t);
        } catch (Exception ignore) {
            return null;
        }
    }

