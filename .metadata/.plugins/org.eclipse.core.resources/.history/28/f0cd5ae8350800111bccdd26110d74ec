    }

    // Top N para Map<String,Integer> (sin lambdas)
    private void logTopNoCoincidePorKey(String rid, Map<String, Integer> map, int topN) {
        if (map == null || map.isEmpty()) {
            _log.debug(prefix(rid) + "[NO-COINCIDE] none");
            return;
        }
        List<Map.Entry<String, Integer>> entries = new ArrayList<Map.Entry<String, Integer>>(map.entrySet());
        java.util.Collections.sort(entries, new java.util.Comparator<Map.Entry<String, Integer>>() {
            public int compare(Map.Entry<String, Integer> a, Map.Entry<String, Integer> b) {
                int va = (a.getValue() == null) ? 0 : a.getValue().intValue();
                int vb = (b.getValue() == null) ? 0 : b.getValue().intValue();
                return (vb - va); // desc
            }
        });

        StringBuilder sb = new StringBuilder();
        sb.append(prefix(rid)).append("[NO-COINCIDE] top ").append(topN).append(" key => count: ");
        int n = Math.min(topN, entries.size());
        for (int i = 0; i < n; i++) {
            Map.Entry<String, Integer> e = entries.get(i);
            if (i > 0) sb.append(", ");
            sb.append(e.getKey()).append("=>").append(e.getValue());
        }
        _log.debug(sb.toString());
    }

    // Invocación por reflexión para no romper compilación si el método no existe
    private void tryInvokeSetter(Object target, String methodName, BigDecimal value) {
        if (target == null || methodName == null) return;
        try {
            java.lang.reflect.Method m = target.getClass().getMethod(methodName, new Class[]{BigDecimal.class});
            m.invoke(target, new Object[]{value});
        } catch (Exception ignore) {
        }
    }

