<%@ include file="/html/portlet/prestadores/init.jsp"%>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>

<%@ page import="java.util.ArrayList" %>
<%@ page import="java.util.List" %>

<%@ page import="com.liferay.portal.kernel.util.HtmlUtil" %>
<%@ page import="com.liferay.portal.kernel.dao.search.ResultRow" %>
<%@ page import="com.liferay.portal.kernel.dao.search.SearchContainer" %>

<%@ page import="ar.com.ospim.liquidaciones.beans.CartillaConvenioRow" %>

<%@ taglib uri="http://java.sun.com/portlet_2_0" prefix="portlet" %>
<portlet:defineObjects/>

<style type="text/css">
    .cartilla-leyenda-resultados {
        margin: 0 0 10px 0;
        padding: 8px 12px;
        background: #f4f8fb;
        border: 1px solid #c9d7e1;
        color: #2d4a5d;
        font-weight: bold;
    }

    .cartilla-leyenda-resultados-icono {
        display: inline-block;
        width: 12px;
        height: 12px;
        margin-right: 8px;
        background: #7fa7c2;
        border: 1px solid #5e89a6;
        vertical-align: middle;
    }

    .cartilla-resultados {
        margin-top: 4px;
    }

    .cartilla-row-normal:hover td {
        background: #f7f7f7 !important;
    }

    .cartilla-sin-resultados {
        margin: 8px 0;
        padding: 8px 12px;
        background: #fafafa;
        border: 1px solid #ddd;
        color: #666;
    }
</style>

<%
    List<CartillaConvenioRow> resultados =
            (List<CartillaConvenioRow>) request.getAttribute(WebKeysLiquidaciones.BUSQUEDA_CARTILLA_CONVENIO_RESULTS);

    if (resultados == null) {
        resultados = new ArrayList<CartillaConvenioRow>();
    }

    int totalResultados = resultados.size();

    PortletURL portletURL = renderResponse.createRenderURL();

    List<String> headerNames = new ArrayList<String>();
    headerNames.add("Plan");
    headerNames.add("Prestador");
    headerNames.add("CUIT");
    headerNames.add("Zona");
    headerNames.add("Especialidad");
    headerNames.add("Domicilio");
    headerNames.add("Teléfono");
    headerNames.add("Localidad");
    headerNames.add("Provincia");

    SearchContainer searchContainer = new SearchContainer(
            renderRequest,
            null,
            null,
            SearchContainer.DEFAULT_CUR_PARAM,
            Integer.MAX_VALUE,
            portletURL,
            headerNames,
            "No se encontraron resultados."
    );

    searchContainer.setTotal(totalResultados);

    List resultRows = searchContainer.getResultRows();

    for (int i = 0; i < resultados.size(); i++) {
        CartillaConvenioRow item = resultados.get(i);

        ResultRow row = new ResultRow(item, String.valueOf(i), i);
        row.setClassName("cartilla-row-normal");

        row.addText(item.getPlanDescripcion() != null ? HtmlUtil.escape(item.getPlanDescripcion()) : "");
        row.addText(item.getPrestadorDescripcion() != null ? HtmlUtil.escape(item.getPrestadorDescripcion()) : "");
        row.addText(item.getCuitPrestador() != null ? HtmlUtil.escape(item.getCuitPrestador()) : "");
        row.addText(item.getZona() != null ? HtmlUtil.escape(item.getZona()) : "");
        row.addText(item.getEspecialidad() != null ? HtmlUtil.escape(item.getEspecialidad()) : "");
        row.addText(item.getDomicilio() != null ? HtmlUtil.escape(item.getDomicilio()) : "");
        row.addText(item.getTelefono() != null ? HtmlUtil.escape(item.getTelefono()) : "");
        row.addText(item.getLocalidad() != null ? HtmlUtil.escape(item.getLocalidad()) : "");
        row.addText(item.getProvincia() != null ? HtmlUtil.escape(item.getProvincia()) : "");

        resultRows.add(row);
    }
%>

<input type="hidden"
       id="<portlet:namespace/>cartillaResultsCount"
       value="<%= totalResultados %>" />

<% if (totalResultados > 0) { %>
    <div class="cartilla-leyenda-resultados">
        <span class="cartilla-leyenda-resultados-icono"></span>
        Total encontrados: <%= totalResultados %>
    </div>
<% } else { %>
    <div class="cartilla-sin-resultados">
        No se encontraron resultados.
    </div>
<% } %>

<div class="cartilla-resultados">
    <liferay-ui:search-iterator searchContainer="<%= searchContainer %>" />
</div>