								<td>&nbsp;</td>
								<td><input type="checkbox"
									id="<portlet:namespace />chk_entramite"
									name="<portlet:namespace />chk_entramite"
									<%=Validator.isNotNull(reclamoprestacional) && reclamoprestacional.isEntramite()   ? "checked" : "Unchecked" %>
