							       <span style="font-size: 9pt; color: green; "><label><b>Preautorizacion: <%= idPreautorizacion %></b></label></span>
							      </div>
							    <%}%>
							    
							    </td>
							    
							    <td></td>
							-->
							</tr>					
							<tr>			       	
						</tr>
					</table>
				</td>
				
				
				<!-- DS -->
				<td>
<!-- 					<div class="divheaderNroReclamo"> -->
<%-- 						<label><b><liferay-ui:message key="<%= nroreclamo %>" /></b></label> --%>
