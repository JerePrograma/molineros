	<fieldset class="cabeceraCaso">
		<legend>
			<liferay-ui:message key="Cabecera Caso" />
		</legend>

		<table class="lfr-table"
			style="border-collapse: separate; border-spacing: 3px; width: 100%;">
			<tr>
				<td style="white-space: nowrap;">
					<label><liferay-ui:message key="Fecha Ospim" />:&nbsp;</label>
				</td>
				<td style="white-space: nowrap;">
					<% if (reclamoprestacional == null) { %>
						<liferay-ui:input-date
							dayParam="fechaospimDia"
							dayValue="<%= fechadia.get(Calendar.DATE) %>"
							dayNullable="<%= true %>"
							monthParam="fechaospimMes"
							monthValue="<%= fechadia.get(Calendar.MONTH) %>"
							monthNullable="<%= true %>"
							yearParam="fechaospimAnio"
							yearValue="<%= fechadia.get(Calendar.YEAR) %>"
							yearRangeStart="<%= fechaospim.get(Calendar.YEAR) - 5 %>"
							yearRangeEnd="<%= fechaospim.get(Calendar.YEAR) %>"
							yearNullable="<%= true %>"
							firstDayOfWeek="<%= fechaospim.getFirstDayOfWeek() - 1 %>"
							disabled="<%= !esEdicion %>" />
					<% } else { %>
						<liferay-ui:input-date
							dayParam="fechaospimDia"
							dayValue="<%= fechaospim.get(Calendar.DATE) %>"
							dayNullable="<%= true %>"
							monthParam="fechaospimMes"
							monthValue="<%= fechaospim.get(Calendar.MONTH) %>"
							monthNullable="<%= true %>"
							yearParam="fechaospimAnio"
							yearValue="<%= fechaospim.get(Calendar.YEAR) %>"
							yearRangeStart="<%= fechaospim.get(Calendar.YEAR) - 5 %>"
							yearRangeEnd="<%= fechaospim.get(Calendar.YEAR) + 1 %>"
							yearNullable="<%= true %>"
							firstDayOfWeek="<%= fechaospim.getFirstDayOfWeek() - 1 %>"
							disabled="<%= !esEdicion %>" />
					<% } %>
				</td>

				<td style="white-space: nowrap;">
					<label><liferay-ui:message key="Fecha Seccional" />:&nbsp;</label>
				</td>
				<td style="white-space: nowrap;">
					<% if (reclamoprestacional == null || nofechaseccional) { %>
						<liferay-ui:input-date
							dayParam="fechaseccionalDia"
							dayValue=""
							dayNullable="<%= true %>"
							monthParam="fechaseccionalMes"
							monthValue="-1"
							monthNullable="<%= true %>"
							yearParam="fechaseccionalAnio"
							yearValue=""
							yearRangeStart="<%= fechaseccional.get(Calendar.YEAR) - 5 %>"
							yearRangeEnd="<%= fechaseccional.get(Calendar.YEAR) %>"
							yearNullable="<%= true %>"
							firstDayOfWeek="<%= fechaseccional.getFirstDayOfWeek() - 1 %>"
							disabled="<%= !esEdicion %>" />
					<% } else { %>
						<liferay-ui:input-date
							dayParam="fechaseccionalDia"
							dayValue="<%= fechaseccional.get(Calendar.DATE) %>"
							dayNullable="<%= true %>"
							monthParam="fechaseccionalMes"
							monthValue="<%= fechaseccional.get(Calendar.MONTH) %>"
							monthNullable="<%= true %>"
							yearParam="fechaseccionalAnio"
							yearValue="<%= fechaseccional.get(Calendar.YEAR) %>"
							yearRangeStart="<%= fechaseccional.get(Calendar.YEAR) - 5 %>"
							yearRangeEnd="<%= fechaseccional.get(Calendar.YEAR) + 1 %>"
							yearNullable="<%= true %>"
							firstDayOfWeek="<%= fechaseccional.getFirstDayOfWeek() - 1 %>"
							disabled="<%= !esEdicion %>" />
					<% } %>
				</td>

				<td style="white-space: nowrap;">
					<label for="<portlet:namespace />chk_amparo">
						<liferay-ui:message key="Amparo" />:
					</label>
				</td>
				<td>
					<input
						type="checkbox"
						id="<portlet:namespace />chk_amparo"
						name="<portlet:namespace />chk_amparo"
						<%= Validator.isNotNull(reclamoprestacional)
								&& reclamoprestacional.isAmparo()
								? "checked=\"checked\""
								: "" %>
						<% if (!esEdicion) { %>
							disabled="disabled"
						<% } %> />
				</td>

				<td style="white-space: nowrap;">
					<label for="<portlet:namespace />nroLote">
						<liferay-ui:message key="Lote" />:
					</label>
				</td>
				<td>
					<input
						type="text"
						id="<portlet:namespace />nroLote"
						name="<portlet:namespace />nroLote"
						size="8"
						maxlength="9"
						value="<%= reclamoprestacional == null
								|| reclamoprestacional.getNroLote() == null
								|| reclamoprestacional.getNroLote() == 0
								? ""
								: reclamoprestacional.getNroLote() %>"
						readonly="readonly" />
				</td>

				<td style="width: 250px;">
					<div class="divheaderNroReclamo">
						<label><b><%= nroreclamo %></b></label>
					</div>
					<div class="divheaderNroOP">
						<label><b><%= opAsignadaalReclamo %></b></label>
					</div>
				</td>
			</tr>
		</table>

		<br />

		<table class="lfr-table"
			style="border-collapse: separate; border-spacing: 3px; width: 100%;">
			<tr>
				<td style="white-space: nowrap;">
					<label for="<portlet:namespace />tipopedido">
						<liferay-ui:message key="Tipo Pedido" />:
					</label>
				</td>
				<td>
					<select
						name="<portlet:namespace />tipopedido"
						id="<portlet:namespace />tipopedido"
						onchange="if (typeof <portlet:namespace />actualizarBuscadorPrestacion == 'function') { <portlet:namespace />actualizarBuscadorPrestacion(); } cambioTipoPedido();manejarTipoPedidoCierre();"
						onblur="manejarTipoPedido();"
						<% if (!esEdicion) { %>
							disabled="disabled"
						<% } %>>
						<option value="SELECCIONAR">SELECCIONAR</option>
						<option
							value="EXCEPCION"
							<%= Validator.isNotNull(reclamoprestacional)
									&& "EXCEPCION".equals(
											reclamoprestacional.getTipoPedido()
									)
									? "selected=\"selected\""
									: "" %>>EXCEPCIóN</option>
						<option
							value="REINTEGRO"
							<%= Validator.isNotNull(reclamoprestacional)
									&& "REINTEGRO".equals(
											reclamoprestacional.getTipoPedido()
									)
									? "selected=\"selected\""
									: "" %>>REINTEGRO</option>
						<option
							value="EXTRACAPITA"
							<%= Validator.isNotNull(reclamoprestacional)
									&& "EXTRACAPITA".equals(
											reclamoprestacional.getTipoPedido()
									)
									? "selected=\"selected\""
									: "" %>>EXTRAC&Aacute;PITA</option>
					</select>
				</td>

				<td style="white-space: nowrap;">
					<label for="<portlet:namespace />sector">
						<liferay-ui:message key="Sector" />:
					</label>
				</td>
				<td>
					<select
						name="<portlet:namespace />sector"
						id="<portlet:namespace />sector"
						onchange="if (typeof <portlet:namespace />actualizarBuscadorPrestacion == 'function') { <portlet:namespace />actualizarBuscadorPrestacion(); } manejarTipoSector();"
						<% if (!esEdicion) { %>
							disabled="disabled"
						<% } %>>
						<option
							value=""
							<%= reclamoprestacional == null
									|| Validator.isNull(
											reclamoprestacional.getSector()
									)
									? "selected=\"selected\""
									: "" %>>-- SELECCIONAR --</option>
						<option value="DISCAPACIDAD"
							<%= "DISCAPACIDAD".equals(
									reclamoprestacional != null
											? reclamoprestacional.getSector()
											: ""
							) ? "selected=\"selected\"" : "" %>>DISCAPACIDAD</option>
						<option value="PRESTACIONES MEDICAS"
							<%= "PRESTACIONES MEDICAS".equals(
									reclamoprestacional != null
											? reclamoprestacional.getSector()
											: ""
							) ? "selected=\"selected\"" : "" %>>PRESTACIONES M&Eacute;DICAS</option>
						<option value="FARMACIA"
							<%= "FARMACIA".equals(
									reclamoprestacional != null
											? reclamoprestacional.getSector()
											: ""
							) ? "selected=\"selected\"" : "" %>>FARMACIA</option>
						<option value="LEGALES"
							<%= "LEGALES".equals(
									reclamoprestacional != null
											? reclamoprestacional.getSector()
											: ""
							) ? "selected=\"selected\"" : "" %>>LEGALES</option>
						<option value="ODONTOLOGIA"
							<%= "ODONTOLOGIA".equals(
									reclamoprestacional != null
											? reclamoprestacional.getSector()
											: ""
							) ? "selected=\"selected\"" : "" %>>ODONTOLOGIA</option>
					</select>
				</td>

				<td style="white-space: nowrap;">
					<label
						id="integracion_label"
						for="<portlet:namespace />integracion"
						style="display:<%= esBorradorCompras ? "inline" : "none" %>;">
						<liferay-ui:message key="integracion" />:
					</label>
				</td>
				<td>
					<select
						name="<portlet:namespace />integracion"
						id="<portlet:namespace />integracion"
						style="display:<%= esBorradorCompras ? "inline" : "none" %>;"
						<% if (!esEdicion) { %>
							disabled="disabled"
						<% } %>>
						<option value="0">Seleccione Integración</option>
						<% for (ReclamosPrestacionalesIntegracion integracion : listaIntegracion) { %>
							<option
								value="<%= integracion.getId() %>"
								<%= reclamoprestacional != null
										&& reclamoprestacional.getCodigoIntegracion()
												== integracion.getId()
										? "selected=\"selected\""
										: "" %>><%= integracion.getDescripcion() %></option>
						<% } %>
					</select>
				</td>
				<td>
					<div
						id="integracion_div"
						style="display:<%= esBorradorCompras ? "block" : "none" %>;">
						<img
							id="integracion_desc"
							height="16"
							width="16"
							src="/html/themes/classic/images/common/help.png"
							title=""
							alt="Ayuda" />
					</div>
				</td>

				<td style="white-space: nowrap;">
					<label for="<portlet:namespace />estado">
						<liferay-ui:message key="Estado" />:
					</label>
				</td>
				<td>
					<select
						name="<portlet:namespace />estado"
						id="<portlet:namespace />estado"
						onchange="controlarEstadoCerrado();"
						<% if (!esEdicion) { %>
							disabled="disabled"
						<% } %>>
						<option value="-1">SELECCIONE</option>
						<% for (EstadosReclamosPrestacionales estados : listaestados) { %>
							<% if (!(esAlta && !esBorradorCompras && estados.getId() == 0)) { %>
								<option
									value="<%= estados.getId() %>"
									<%= reclamoprestacional != null
											&& reclamoprestacional.getEstado()
													== estados.getId()
											? "selected=\"selected\""
											: "" %>><%= estados.getDescripcion() %></option>
							<% } %>
						<% } %>
					</select>
				</td>
			</tr>
		</table>

		<%
		if (reclamoprestacional != null
				&& reclamoprestacional.getEstadoObservacion() != null
				&& reclamoprestacional.getEstadoObservacion().length() > 0) {
		%>
			<fieldset class="block-labels">
				<legend><liferay-ui:message key="observacion" /></legend>
				<span
					id="<portlet:namespace />estadoObservacion"
					style="color: red;"><%= reclamoprestacional.getEstadoObservacion() %></span>
			</fieldset>
		<% } %>

		<% if (reclamo_vinculado
				|| (idPreautorizacion != null && idPreautorizacion != 0)) { %>
			<table class="lfr-table">
				<tr>
					<td>
						<% if (reclamo_vinculado) { %>
							<div class="divNroRecord_Vinculado">
								<liferay-ui:message key="Asociado al Reclamo Nro :" /><%= caso_vinculado %>
							</div>
						<% } %>

						<% if (idPreautorizacion != null && idPreautorizacion != 0) { %>
							<div>
								<span style="font-size: 9pt; color: green;">
									<label><b>Preautorización: <%= idPreautorizacion %></b></label>
								</span>
							</div>
						<% } %>
					</td>
				</tr>
			</table>
		<% } %>
	</fieldset>
