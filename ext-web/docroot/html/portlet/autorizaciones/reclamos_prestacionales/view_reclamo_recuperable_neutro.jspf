<%@ page import="java.util.List" %>
<%@ page import="ar.com.ospim.autorizaciones.beans.PrestacionesReclamo" %>
<%
/*
 * La precarga Compras -> Reclamo Prestacional se conserva completa.
 *
 * Solamente Recuperable SUR se normaliza de forma dinamica:
 * surge=true usa SUR (1) y surge=false deja Seleccione (0).
 * Reconocido SSS permanece neutralizado segun la regla vigente.
 */
boolean contextoComprasActivo =
        esBorradorCompras
        && contextoCompras != null
        && Validator.isNotNull(nonceCompras)
        && contextoCompras.coincideNonce(nonceCompras);

int recuperableSurInicialCompras =
        contextoComprasActivo
        && contextoCompras.isSurge()
                ? 1
                : 0;

int recuperableInicial =
        contextoComprasActivo
                ? recuperableSurInicialCompras
                : 0;

Object listadoPrestacionesNeutro =
        session.getAttribute(
                WebKeysAutorizaciones
                        .LISTADO_PRESTACIONES_RECLAMOS_EN_SESION
        );

if (listadoPrestacionesNeutro instanceof List) {
    List prestacionesNeutras =
            (List) listadoPrestacionesNeutro;

    for (Object prestacionObj : prestacionesNeutras) {
        if (prestacionObj instanceof PrestacionesReclamo) {
            PrestacionesReclamo prestacionNeutra =
                    (PrestacionesReclamo) prestacionObj;

            prestacionNeutra.setRecuperable(
                    Integer.valueOf(recuperableInicial)
            );
            prestacionNeutra.setRecuperableSur(
                    Boolean.valueOf(recuperableInicial == 1)
            );
            prestacionNeutra.setReconocidoSSS(
                    Double.valueOf(0D)
            );
        }
    }
}

Object prestacionEnEdicionNeutra =
        session.getAttribute(
                WebKeysAutorizaciones
                        .PRESTACION_EN_PROCESO_DE_EDICION
        );

if (prestacionEnEdicionNeutra instanceof PrestacionesReclamo) {
    PrestacionesReclamo prestacionNeutra =
            (PrestacionesReclamo) prestacionEnEdicionNeutra;

    prestacionNeutra.setRecuperable(
            Integer.valueOf(recuperableInicial)
    );
    prestacionNeutra.setRecuperableSur(
            Boolean.valueOf(recuperableInicial == 1)
    );
    prestacionNeutra.setReconocidoSSS(
            Double.valueOf(0D)
    );
}
%>
<% if (contextoComprasActivo) { %>
    <input type="hidden"
           id="<portlet:namespace />recuperable_sur_compra_inicial"
           name="<portlet:namespace />recuperable_sur_compra_inicial"
           value="<%= recuperableSurInicialCompras %>" />
<% } %>
