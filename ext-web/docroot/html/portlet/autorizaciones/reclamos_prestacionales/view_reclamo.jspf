<%@ include file="/html/portlet/autorizaciones/reclamos_prestacionales/view_reclamo_contexto.jspf" %>
<%@ include file="/html/portlet/autorizaciones/reclamos_prestacionales/view_reclamo_inicio_formulario.jspf" %>
<%@ include file="/html/portlet/autorizaciones/reclamos_prestacionales/view_reclamo_cabecera.jspf" %>
<%@ include file="/html/portlet/autorizaciones/reclamos_prestacionales/view_reclamo_afiliado_diagnostico.jspf" %>
<%
Object tipoEdicionOriginalAntesDePrestaciones = request.getAttribute("tipoEdicion");
boolean aplicarTipoEdicionComun =
		tipoEdicionOriginalAntesDePrestaciones == null
		&& request.getSession().getAttribute(
				WebKeysAutorizaciones.PRESTACION_EN_PROCESO_DE_EDICION
		) != null;

if (aplicarTipoEdicionComun) {
	request.setAttribute("tipoEdicion", Integer.valueOf(0));
}
%>
<%@ include file="/html/portlet/autorizaciones/reclamos_prestacionales/view_reclamo_prestaciones.jspf" %>
<%
if (aplicarTipoEdicionComun) {
	request.removeAttribute("tipoEdicion");
}
%>
<%@ include file="/html/portlet/autorizaciones/reclamos_prestacionales/view_reclamo_seguimiento_cierre.jspf" %>
<%@ include file="/html/portlet/autorizaciones/reclamos_prestacionales/view_reclamo_acciones.jspf" %>
<%@ include file="/html/portlet/autorizaciones/reclamos_prestacionales/view_reclamo_configuracion.jspf" %>
