.alnright {
	text-align: right;
}

span-fixed-size {
	display: inline-block;
	width: 20px;
}

.rp-validacion-resumen {
	display: none;
	margin: 0 0 12px 0;
	padding: 10px 14px;
}

.rp-validacion-resumen ul {
	margin: 6px 0 0 20px;
	padding: 0;
}

.rp-campo-error {
	background-color: #fff2f2 !important;
	border: 2px solid #b30000 !important;
}

.rp-campo-error-contenedor {
	background-color: #fff2f2 !important;
	outline: 2px solid #b30000;
}
