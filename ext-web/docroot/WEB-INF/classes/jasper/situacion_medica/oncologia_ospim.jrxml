<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="oncologia_ospim" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.5000000000000038"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="223"/>
	<parameter name="ID_SITUACION" class="java.lang.String"/>
	<parameter name="LOGO_OSPIM" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
    sm.id AS id_situacion,
    form.formulario_nro,
    current_date AS fecha_impresion,

    sm.cuil_titular,
    sm.inte,
    sm.tipo_situ_medica,
    sm.vigen_desde,
    sm.vigen_hasta,
    sm.detalle_tipo_situ,

    a.apellido,
    a.nombre,
    a.documento_tipo,
    a.docu_numero,
    a.sexo,
    a.naci_fecha,

    COALESCE(a.nro_afiliado::varchar, a.id_ospim::varchar, '') || '/' || sm.inte::varchar AS afiliado_nro,

    p.descripcion AS plan_descripcion,

    TRIM(
        COALESCE(d.calle, '') || ' ' ||
        COALESCE(d.numero, '') ||
        CASE WHEN d.piso IS NOT NULL AND d.piso <> '' THEN ' Piso ' || d.piso ELSE '' END ||
        CASE WHEN d.depto IS NOT NULL AND d.depto <> '' THEN ' Depto ' || d.depto ELSE '' END
    ) AS domicilio,

    COALESCE(d.localidad::varchar, '') AS localidad,

    TRIM(
        COALESCE(t.codigo_area, '') ||
        CASE WHEN t.codigo_area IS NOT NULL AND t.codigo_area <> '' THEN '-' ELSE '' END ||
        COALESCE(t.numero, '')
    ) AS telefono

FROM public.afi_situ_medica sm

LEFT JOIN public.afi_situ_medica_formulario form
       ON form.id_situ_medica = sm.id

LEFT JOIN public.afiliado a
       ON a.cuil_titular = sm.cuil_titular
      AND a.inte = sm.inte

LEFT JOIN public.afi_plan ap
       ON ap.cuil_titular = sm.cuil_titular
      AND ap.inte = sm.inte
      AND ap.vigen_hasta IS NULL

LEFT JOIN public.plan p
       ON p.id_plan = ap.id_plan

LEFT JOIN (
    SELECT DISTINCT ON (cuil_titular, inte)
        cuil_titular,
        inte,
        id_domicilio,
        calle,
        numero,
        piso,
        depto,
        localidad
    FROM public.afi_domicilio
    WHERE baja_fecha IS NULL
    ORDER BY cuil_titular, inte, vigen_desde DESC, alta_fecha DESC, id_domicilio DESC
) d
       ON d.cuil_titular = sm.cuil_titular
      AND d.inte = sm.inte

LEFT JOIN (
    SELECT DISTINCT ON (cuil_titular, inte)
        cuil_titular,
        inte,
        id_telefono,
        codigo_area,
        numero
    FROM public.afi_telefono
    WHERE baja_fecha IS NULL
    ORDER BY cuil_titular, inte, vigen_desde DESC, id_telefono DESC
) t
       ON t.cuil_titular = sm.cuil_titular
      AND t.inte = sm.inte

WHERE sm.id = CAST($P{ID_SITUACION} AS integer)]]>
	</queryString>
