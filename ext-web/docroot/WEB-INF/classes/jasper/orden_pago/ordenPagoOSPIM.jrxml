	<subDataset name="pagos">
		<parameter name="ID_ORDEN_PAGO" class="java.lang.String"/>
		<queryString language="SQL">
			<![CDATA[select * from reporte_pagos_op_ospim($P{ID_ORDEN_PAGO})]]>
		</queryString>
		<field name="nro_cheque" class="java.lang.String"/>
		<field name="descripcion" class="java.lang.String"/>
		<field name="importe" class="java.lang.String"/>
		<field name="a_favor_de" class="java.lang.String"/>
		<field name="baja_fecha" class="java.lang.String"/>
	</subDataset>
	<subDataset name="conceptos">
		<parameter name="ID_ORDEN_PAGO" class="java.lang.String"/>
		<queryString>
			<![CDATA[select cc__descripcion,        sum(case when cc_importe_op>=0 then ccc__importe else ccc__importe*-1 end ) as ccc__importe from buscar_concepto_comprobante_por_orden_pago_ospim($P{ID_ORDEN_PAGO}) group by cc__descripcion having sum(case when cc_importe_op>=0 then ccc__importe else ccc__importe*-1 end ) >0]]>
		</queryString>
		<field name="cc__descripcion" class="java.lang.String"/>
		<field name="ccc__importe" class="java.math.BigDecimal"/>
	</subDataset>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA["jasper/"]]></defaultValueExpression>
