	<subDataset name="conceptos" uuid="b8d60ce3-2be2-4cac-b9ec-deaf631297e0">
		<parameter name="ID_ORDEN_PAGO" class="java.lang.String"/>
		<queryString>
			<![CDATA[select cc__descripcion,        sum(case when cc_importe_op>=0 then ccc__importe else ccc__importe*-1 end ) as ccc__importe from buscar_concepto_comprobante_por_orden_pago_ospim($P{ID_ORDEN_PAGO}) group by cc__descripcion having sum(case when cc_importe_op>=0 then ccc__importe else ccc__importe*-1 end ) >0]]>
		</queryString>
		<field name="cc__descripcion" class="java.lang.String"/>
		<field name="ccc__importe" class="java.math.BigDecimal"/>
	</subDataset>
