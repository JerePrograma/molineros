    <field name="tipo" class="java.lang.String"/>
    <field name="etiqueta" class="java.lang.String"/>
    <field name="unidad" class="java.lang.String"/>
    <field name="proveedores" class="java.util.Map"/>
    <group name="Cierre" keepTogether="true">
        <groupExpression><![CDATA[Boolean.valueOf(!"detalle".equals($F{tipo}))]]></groupExpression>
    </group>
    <pageHeader>
        <band height="24">
            <textField>
                <reportElement x="0" y="0" width="802" height="22"/>
                <box padding="0"><pen lineWidth="0.0"/></box>
                <textElement><font size="12" isBold="true"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["Comparativa de presupuestos - Requerimiento " + $P{REQUERIMIENTO}]]></textFieldExpression>
            </textField>
        </band>
    </pageHeader>
    <columnHeader>
        <band height="82" splitType="Prevent">
            <staticText>
                <reportElement x="0" y="0" width="252" height="60" stretchType="RelativeToBandHeight"/>
                <text><![CDATA[]]></text>
            </staticText>
            <staticText>
                <reportElement x="252" y="0" width="550" height="18" backcolor="#EAD1DC"/>
