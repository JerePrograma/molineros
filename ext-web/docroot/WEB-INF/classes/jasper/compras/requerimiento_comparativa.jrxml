                <textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Proveedores]]></text>
            </staticText>
            <staticText>
                <reportElement positionType="FixRelativeToBottom" x="0" y="60" width="210" height="22"/>
                <textElement verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Ítem]]></text>
            </staticText>
            <staticText>
                <reportElement positionType="FixRelativeToBottom" x="210" y="60" width="42" height="22"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[Unidad]]></text>
            </staticText>
            <frame>
                <reportElement key="proveedor" x="252" y="18" width="550" height="64" stretchType="RelativeToBandHeight"/>
                <box padding="0"><pen lineWidth="0.0"/></box>
                <textField isStretchWithOverflow="true">
                    <reportElement x="0" y="0" width="550" height="42" backcolor="#FFFF00" stretchType="RelativeToBandHeight"/>
                    <textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true"/></textElement>
                    <textFieldExpression class="java.lang.String"><![CDATA[(String)((java.util.Map)$P{PROVEEDORES}.get($P{PROVEEDOR})).get("prestador")]]></textFieldExpression>
                </textField>
                <staticText>
                    <reportElement positionType="FixRelativeToBottom" x="0" y="42" width="275" height="22"/>
                    <textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true"/></textElement>
                    <text><![CDATA[$/ unit]]></text>
                </staticText>
                <staticText>
                    <reportElement positionType="FixRelativeToBottom" x="275" y="42" width="275" height="22"/>
                    <textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true"/></textElement>
                    <text><![CDATA[Subtotal]]></text>
                </staticText>
            </frame>
        </band>
    </columnHeader>
    <detail>
        <band height="34" splitType="Prevent">
            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="0" width="210" height="34" stretchType="RelativeToBandHeight">
                    <printWhenExpression><![CDATA["detalle".equals($F{tipo})]]></printWhenExpression>
                </reportElement>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression class="java.lang.String"><![CDATA[$F{etiqueta}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="210" y="0" width="42" height="34" stretchType="RelativeToBandHeight">
                    <printWhenExpression><![CDATA["detalle".equals($F{tipo})]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression class="java.lang.String"><![CDATA[$F{unidad}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement style="CeldaProveedor" x="0" y="0" width="252" height="34" stretchType="RelativeToBandHeight">
                    <printWhenExpression><![CDATA[!"detalle".equals($F{tipo})]]></printWhenExpression>
                </reportElement>
                <textElement verticalAlignment="Middle"><font isBold="true"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$F{etiqueta}]]></textFieldExpression>
            </textField>
            <frame>
                <reportElement key="proveedor" x="252" y="0" width="550" height="34" stretchType="RelativeToBandHeight"/>
                <box padding="0"><pen lineWidth="0.0"/></box>
                <textField isStretchWithOverflow="true">
                    <reportElement style="CeldaProveedor" x="0" y="0" width="275" height="34" stretchType="RelativeToBandHeight">
                        <printWhenExpression><![CDATA["detalle".equals($F{tipo})]]></printWhenExpression>
                    </reportElement>
                    <textElement textAlignment="Right" verticalAlignment="Middle"/>
                    <textFieldExpression class="java.lang.String"><![CDATA[$F{proveedores}.get($P{PROVEEDOR}) == null ? "" : (((String)((java.util.Map)$F{proveedores}.get($P{PROVEEDOR})).get("importe")) == null || "".equals((String)((java.util.Map)$F{proveedores}.get($P{PROVEEDOR})).get("importe")) ? "" : "$ " + new java.text.DecimalFormat("#,##0.00", new java.text.DecimalFormatSymbols(new java.util.Locale("es", "AR"))).format(new java.math.BigDecimal((String)((java.util.Map)$F{proveedores}.get($P{PROVEEDOR})).get("importe"))))]]></textFieldExpression>
                </textField>
                <textField isStretchWithOverflow="true">
                    <reportElement style="CeldaProveedor" x="275" y="0" width="275" height="34" stretchType="RelativeToBandHeight">
                        <printWhenExpression><![CDATA["detalle".equals($F{tipo})]]></printWhenExpression>
                    </reportElement>
                    <textElement textAlignment="Right" verticalAlignment="Middle"/>
                    <textFieldExpression class="java.lang.String"><![CDATA[$F{proveedores}.get($P{PROVEEDOR}) == null ? "" : (((String)((java.util.Map)$F{proveedores}.get($P{PROVEEDOR})).get("subtotal")) == null || "".equals((String)((java.util.Map)$F{proveedores}.get($P{PROVEEDOR})).get("subtotal")) ? "" : "$ " + new java.text.DecimalFormat("#,##0.00", new java.text.DecimalFormatSymbols(new java.util.Locale("es", "AR"))).format(new java.math.BigDecimal((String)((java.util.Map)$F{proveedores}.get($P{PROVEEDOR})).get("subtotal"))))]]></textFieldExpression>
                </textField>
                <textField isStretchWithOverflow="true">
                    <reportElement style="CeldaProveedor" x="0" y="0" width="550" height="34" stretchType="RelativeToBandHeight">
                        <printWhenExpression><![CDATA["resumen".equals($F{tipo}) || "total".equals($F{tipo})]]></printWhenExpression>
                    </reportElement>
                    <textElement textAlignment="Right" verticalAlignment="Middle"/>
                    <textFieldExpression class="java.lang.String"><![CDATA[!("resumen".equals($F{tipo}) || "total".equals($F{tipo})) || $F{proveedores}.get($P{PROVEEDOR}) == null ? "" : ("total".equals($F{tipo}) && "true".equals((String)((java.util.Map)$F{proveedores}.get($P{PROVEEDOR})).get("incompleto")) ? "Parcial: " : "") + (((String)((java.util.Map)$F{proveedores}.get($P{PROVEEDOR})).get("valor")) == null || "".equals((String)((java.util.Map)$F{proveedores}.get($P{PROVEEDOR})).get("valor")) ? "" : "$ " + new java.text.DecimalFormat("#,##0.00", new java.text.DecimalFormatSymbols(new java.util.Locale("es", "AR"))).format(new java.math.BigDecimal((String)((java.util.Map)$F{proveedores}.get($P{PROVEEDOR})).get("valor"))))]]></textFieldExpression>
                </textField>
                <textField isStretchWithOverflow="true">
                    <reportElement style="CeldaProveedor" x="0" y="0" width="550" height="34" stretchType="RelativeToBandHeight">
                        <printWhenExpression><![CDATA["condicion".equals($F{tipo}) || "dictamen".equals($F{tipo})]]></printWhenExpression>
                    </reportElement>
                    <textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true"/></textElement>
                    <textFieldExpression class="java.lang.String"><![CDATA[$F{proveedores}.get($P{PROVEEDOR}) == null ? "" : (String)((java.util.Map)$F{proveedores}.get($P{PROVEEDOR})).get("valor")]]></textFieldExpression>
                </textField>
            </frame>
        </band>
    </detail>
