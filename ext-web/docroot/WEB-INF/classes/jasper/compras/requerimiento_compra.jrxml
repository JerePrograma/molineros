        xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
        name="requerimiento_compra"
        pageWidth="842"
        pageHeight="595"
        orientation="Landscape"
        columnWidth="802"
        leftMargin="20"
        rightMargin="20"
        topMargin="20"
        bottomMargin="20"
        uuid="7d2f4c4c-0a98-4a9a-9a38-111111111111">

    <property name="net.sf.jasperreports.default.pdf.encoding" value="Cp1252"/>
    <property name="net.sf.jasperreports.default.pdf.embedded" value="false"/>

    <parameter name="ID_REQUERIMIENTO" class="java.lang.String"/>
    <parameter name="SUBREPORT_DIR" class="java.lang.String"/>
    <parameter name="pathimage" class="java.lang.String"/>

    <queryString>
        <![CDATA[
            SELECT *
            FROM compras.get_requerimiento_compra_pdf(CAST($P{ID_REQUERIMIENTO} AS INTEGER))
        ]]>
    </queryString>

    <field name="id_requerimiento" class="java.lang.Integer"/>
    <field name="alta_fecha" class="java.sql.Timestamp"/>
    <field name="alta_usr" class="java.lang.String"/>
    <field name="modi_fecha" class="java.sql.Timestamp"/>
    <field name="modi_usr" class="java.lang.String"/>

    <field name="id_estado" class="java.lang.Integer"/>
    <field name="estado_descripcion" class="java.lang.String"/>

    <field name="id_sector" class="java.lang.Integer"/>
    <field name="sector_descripcion" class="java.lang.String"/>
    <field name="requiere_afiliado" class="java.lang.Boolean"/>

    <field name="afiliado_cuil_titular" class="java.lang.String"/>
    <field name="afiliado_int" class="java.lang.Integer"/>
    <field name="afiliado_nombre" class="java.lang.String"/>
