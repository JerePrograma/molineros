<?xml version="1.0" encoding="ISO-8859-1"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="requerimiento_compra"
              pageWidth="595"
              pageHeight="842"
              columnWidth="555"
              leftMargin="20"
              rightMargin="20"
              topMargin="20"
              bottomMargin="20">
    <property name="ireport.zoom" value="1.0"/>
    <property name="ireport.x" value="0"/>
    <property name="ireport.y" value="0"/>

    <parameter name="ID_REQUERIMIENTO" class="java.lang.String"/>

    <queryString language="SQL">
        <![CDATA[
SELECT *
FROM compras.get_requerimiento_compra_pdf(
    CAST($P{ID_REQUERIMIENTO} AS INTEGER)
)
        ]]>
    </queryString>

    <field name="id_requerimiento" class="java.lang.Integer"/>
    <field name="alta_fecha" class="java.sql.Timestamp"/>
    <field name="alta_usr" class="java.lang.String"/>
    <field name="id_estado" class="java.lang.Integer"/>
    <field name="estado_descripcion" class="java.lang.String"/>
    <field name="id_sector" class="java.lang.Integer"/>
    <field name="sector_descripcion" class="java.lang.String"/>
    <field name="requiere_afiliado" class="java.lang.Boolean"/>
    <field name="afiliado_int" class="java.lang.Integer"/>
    <field name="afiliado_nombre_apellido" class="java.lang.String"/>
    <field name="afiliado_documento" class="java.lang.String"/>
    <field name="afiliado_direccion" class="java.lang.String"/>
    <field name="afiliado_localidad" class="java.lang.String"/>
    <field name="afiliado_provincia" class="java.lang.String"/>
    <field name="afiliado_celular" class="java.lang.String"/>
    <field name="afiliado_telefono" class="java.lang.String"/>
    <field name="afiliado_email" class="java.lang.String"/>
    <field name="cargo_ospim" class="java.lang.Integer"/>
    <field name="cargo_tercerizadora" class="java.lang.Integer"/>
    <field name="id_tercerizadora" class="java.lang.String"/>
    <field name="recupero" class="java.lang.Boolean"/>
    <field name="observaciones" class="java.lang.String"/>
    <field name="detalle_id" class="java.lang.Integer"/>
    <field name="detalle_orden" class="java.lang.Integer"/>
    <field name="id_articulo" class="java.lang.Integer"/>
    <field name="articulo" class="java.lang.String"/>
    <field name="cantidad" class="java.lang.Integer"/>
    <field name="precio_unitario_estimado" class="java.math.BigDecimal"/>
    <field name="precio_total_estimado" class="java.math.BigDecimal"/>
    <field name="prestador_razon_social" class="java.lang.String"/>
    <field name="prestador_cuit" class="java.lang.String"/>
    <field name="detalle_observaciones" class="java.lang.String"/>
    <field name="total_general" class="java.math.BigDecimal"/>

    <background>
        <band splitType="Stretch"/>
    </background>

    <title>
        <band height="164" splitType="Stretch">
            <frame>
                <reportElement x="0" y="0" width="555" height="160"/>
                <box>
                    <pen lineWidth="1.0"/>
                    <topPen lineWidth="1.0"/>
                    <leftPen lineWidth="1.0"/>
                    <bottomPen lineWidth="1.0"/>
                    <rightPen lineWidth="1.0"/>
                </box>

                <staticText>
                    <reportElement x="0" y="8" width="555" height="20"/>
                    <textElement textAlignment="Center" verticalAlignment="Middle">
                        <font fontName="SansSerif" size="13" isBold="true"/>
                    </textElement>
                    <text><![CDATA[PEDIDO DE PRESUPUESTO]]></text>
                </staticText>

                <staticText>
                    <reportElement x="12" y="38" width="70" height="13"/>
                    <textElement>
                        <font fontName="SansSerif" size="8" isBold="true"/>
                    </textElement>
                    <text><![CDATA[Número:]]></text>
                </staticText>

                <textField isBlankWhenNull="true">
                    <reportElement x="82" y="38" width="85" height="13"/>
                    <textElement>
                        <font fontName="SansSerif" size="8"/>
                    </textElement>
                    <textFieldExpression class="java.lang.Integer"><![CDATA[$F{id_requerimiento}]]></textFieldExpression>
                </textField>

                <staticText>
                    <reportElement x="180" y="38" width="45" height="13"/>
                    <textElement>
                        <font fontName="SansSerif" size="8" isBold="true"/>
                    </textElement>
                    <text><![CDATA[Fecha:]]></text>
                </staticText>

                <textField pattern="dd/MM/yyyy HH:mm" isBlankWhenNull="true">
                    <reportElement x="225" y="38" width="112" height="13"/>
                    <textElement>
                        <font fontName="SansSerif" size="8"/>
                    </textElement>
                    <textFieldExpression class="java.sql.Timestamp"><![CDATA[$F{alta_fecha}]]></textFieldExpression>
                </textField>

                <staticText>
                    <reportElement x="350" y="38" width="45" height="13"/>
                    <textElement>
                        <font fontName="SansSerif" size="8" isBold="true"/>
                    </textElement>
                    <text><![CDATA[Estado:]]></text>
                </staticText>

                <textField isBlankWhenNull="true">
                    <reportElement x="395" y="38" width="145" height="13"/>
                    <textElement>
                        <font fontName="SansSerif" size="8"/>
                    </textElement>
                    <textFieldExpression class="java.lang.String"><![CDATA[$F{estado_descripcion}]]></textFieldExpression>
                </textField>

                <staticText>
                    <reportElement x="12" y="58" width="70" height="13"/>
                    <textElement>
                        <font fontName="SansSerif" size="8" isBold="true"/>
                    </textElement>
                    <text><![CDATA[Sector:]]></text>
                </staticText>

                <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                    <reportElement x="82" y="58" width="458" height="13"/>
                    <textElement>
                        <font fontName="SansSerif" size="8"/>
                    </textElement>
                    <textFieldExpression class="java.lang.String"><![CDATA[$F{sector_descripcion}]]></textFieldExpression>
                </textField>

                <staticText>
                    <reportElement x="12" y="80" width="70" height="13"/>
                    <textElement>
                        <font fontName="SansSerif" size="8" isBold="true"/>
                    </textElement>
                    <text><![CDATA[Afiliado:]]></text>
                </staticText>

                <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                    <reportElement x="82" y="80" width="458" height="13"/>
                    <textElement>
                        <font fontName="SansSerif" size="8"/>
                    </textElement>
                    <textFieldExpression class="java.lang.String"><![CDATA[
$F{afiliado_nombre_apellido} == null
|| $F{afiliado_nombre_apellido}.trim().length() == 0
    ? "Sin afiliado asociado"
    : $F{afiliado_nombre_apellido}
                    ]]></textFieldExpression>
                </textField>

                <staticText>
                    <reportElement x="12" y="98" width="70" height="13"/>
                    <textElement>
                        <font fontName="SansSerif" size="8" isBold="true"/>
                    </textElement>
                    <text><![CDATA[Documento:]]></text>
                </staticText>

                <textField isBlankWhenNull="true">
                    <reportElement x="82" y="98" width="210" height="13"/>
                    <textElement>
                        <font fontName="SansSerif" size="8"/>
                    </textElement>
                    <textFieldExpression class="java.lang.String"><![CDATA[$F{afiliado_documento}]]></textFieldExpression>
                </textField>

                <staticText>
                    <reportElement x="320" y="98" width="65" height="13"/>
                    <textElement>
                        <font fontName="SansSerif" size="8" isBold="true"/>
                    </textElement>
                    <text><![CDATA[Integrante:]]></text>
                </staticText>

                <textField isBlankWhenNull="true">
                    <reportElement x="385" y="98" width="80" height="13"/>
                    <textElement>
                        <font fontName="SansSerif" size="8"/>
                    </textElement>
                    <textFieldExpression class="java.lang.Integer"><![CDATA[$F{afiliado_int}]]></textFieldExpression>
                </textField>

                <staticText>
                    <reportElement x="12" y="116" width="70" height="13"/>
                    <textElement>
                        <font fontName="SansSerif" size="8" isBold="true"/>
                    </textElement>
                    <text><![CDATA[Domicilio:]]></text>
                </staticText>

                <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                    <reportElement x="82" y="116" width="458" height="13"/>
                    <textElement>
                        <font fontName="SansSerif" size="8"/>
                    </textElement>
                    <textFieldExpression class="java.lang.String"><![CDATA[
($F{afiliado_direccion} == null ? "" : $F{afiliado_direccion})
+ ($F{afiliado_localidad} == null
   || $F{afiliado_localidad}.trim().length() == 0
        ? ""
        : " - " + $F{afiliado_localidad})
+ ($F{afiliado_provincia} == null
   || $F{afiliado_provincia}.trim().length() == 0
        ? ""
        : " - " + $F{afiliado_provincia})
                    ]]></textFieldExpression>
                </textField>

                <staticText>
                    <reportElement x="12" y="134" width="70" height="13"/>
                    <textElement>
                        <font fontName="SansSerif" size="8" isBold="true"/>
                    </textElement>
                    <text><![CDATA[Contacto:]]></text>
                </staticText>

                <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                    <reportElement x="82" y="134" width="458" height="13"/>
                    <textElement>
                        <font fontName="SansSerif" size="8"/>
                    </textElement>
                    <textFieldExpression class="java.lang.String"><![CDATA[
($F{afiliado_celular} == null
 || $F{afiliado_celular}.trim().length() == 0
        ? ""
        : "Cel: " + $F{afiliado_celular})
+ ($F{afiliado_telefono} == null
   || $F{afiliado_telefono}.trim().length() == 0
        ? ""
        : " Tel: " + $F{afiliado_telefono})
+ ($F{afiliado_email} == null
   || $F{afiliado_email}.trim().length() == 0
        ? ""
        : " Email: " + $F{afiliado_email})
                    ]]></textFieldExpression>
                </textField>
            </frame>
        </band>
    </title>

    <columnHeader>
        <band height="28" splitType="Stretch">
            <frame>
                <reportElement x="0" y="0" width="555" height="24"/>
                <box>
                    <pen lineWidth="1.0"/>
                </box>

                <staticText>
                    <reportElement x="0" y="5" width="28" height="12"/>
                    <textElement textAlignment="Center">
                        <font fontName="SansSerif" size="7" isBold="true"/>
                    </textElement>
                    <text><![CDATA[#]]></text>
                </staticText>

                <staticText>
                    <reportElement x="28" y="5" width="42" height="12"/>
                    <textElement textAlignment="Center">
                        <font fontName="SansSerif" size="7" isBold="true"/>
                    </textElement>
                    <text><![CDATA[Cant.]]></text>
                </staticText>

                <staticText>
                    <reportElement x="70" y="5" width="140" height="12"/>
                    <textElement textAlignment="Center">
                        <font fontName="SansSerif" size="7" isBold="true"/>
                    </textElement>
                    <text><![CDATA[Detalle]]></text>
                </staticText>

                <staticText>
                    <reportElement x="210" y="5" width="68" height="12"/>
                    <textElement textAlignment="Center">
                        <font fontName="SansSerif" size="7" isBold="true"/>
                    </textElement>
                    <text><![CDATA[Unitario]]></text>
                </staticText>

                <staticText>
                    <reportElement x="278" y="5" width="68" height="12"/>
                    <textElement textAlignment="Center">
                        <font fontName="SansSerif" size="7" isBold="true"/>
                    </textElement>
                    <text><![CDATA[Total]]></text>
                </staticText>

                <staticText>
                    <reportElement x="346" y="5" width="120" height="12"/>
                    <textElement textAlignment="Center">
                        <font fontName="SansSerif" size="7" isBold="true"/>
                    </textElement>
                    <text><![CDATA[Prestador]]></text>
                </staticText>

                <staticText>
                    <reportElement x="466" y="5" width="89" height="12"/>
                    <textElement textAlignment="Center">
                        <font fontName="SansSerif" size="7" isBold="true"/>
                    </textElement>
                    <text><![CDATA[Observaciones]]></text>
                </staticText>

                <line><reportElement x="28" y="0" width="1" height="24"/></line>
                <line><reportElement x="70" y="0" width="1" height="24"/></line>
                <line><reportElement x="210" y="0" width="1" height="24"/></line>
                <line><reportElement x="278" y="0" width="1" height="24"/></line>
                <line><reportElement x="346" y="0" width="1" height="24"/></line>
                <line><reportElement x="466" y="0" width="1" height="24"/></line>
            </frame>
        </band>
    </columnHeader>

    <detail>
        <band height="42" splitType="Stretch">
            <printWhenExpression><![CDATA[$F{detalle_id} != null]]></printWhenExpression>

            <frame>
                <reportElement stretchType="RelativeToBandHeight"
                               x="0"
                               y="0"
                               width="555"
                               height="38"/>
                <box>
                    <pen lineWidth="0.5"/>
                </box>

                <textField isBlankWhenNull="true">
                    <reportElement x="0" y="4" width="28" height="12"/>
                    <textElement textAlignment="Center">
                        <font fontName="SansSerif" size="7"/>
                    </textElement>
                    <textFieldExpression class="java.lang.Integer"><![CDATA[$F{detalle_orden}]]></textFieldExpression>
                </textField>

                <textField isBlankWhenNull="true">
                    <reportElement x="28" y="4" width="42" height="12"/>
                    <textElement textAlignment="Center">
                        <font fontName="SansSerif" size="7"/>
                    </textElement>
                    <textFieldExpression class="java.lang.Integer"><![CDATA[$F{cantidad}]]></textFieldExpression>
                </textField>

                <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                    <reportElement x="74" y="4" width="132" height="30"/>
                    <textElement>
                        <font fontName="SansSerif" size="7"/>
                    </textElement>
                    <textFieldExpression class="java.lang.String"><![CDATA[$F{articulo}]]></textFieldExpression>
                </textField>

                <textField isBlankWhenNull="true">
                    <reportElement x="214" y="4" width="60" height="12"/>
                    <textElement textAlignment="Right">
                        <font fontName="SansSerif" size="7"/>
                    </textElement>
                    <textFieldExpression class="java.lang.String"><![CDATA[
$F{precio_unitario_estimado} == null
    ? ""
    : new java.text.DecimalFormat("$ #,##0.00")
        .format($F{precio_unitario_estimado})
                    ]]></textFieldExpression>
                </textField>

                <textField isBlankWhenNull="true">
                    <reportElement x="282" y="4" width="60" height="12"/>
                    <textElement textAlignment="Right">
                        <font fontName="SansSerif" size="7"/>
                    </textElement>
                    <textFieldExpression class="java.lang.String"><![CDATA[
$F{precio_total_estimado} == null
    ? ""
    : new java.text.DecimalFormat("$ #,##0.00")
        .format($F{precio_total_estimado})
                    ]]></textFieldExpression>
                </textField>

                <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                    <reportElement x="350" y="4" width="112" height="30"/>
                    <textElement>
                        <font fontName="SansSerif" size="7"/>
                    </textElement>
                    <textFieldExpression class="java.lang.String"><![CDATA[
($F{prestador_razon_social} == null
        ? ""
        : $F{prestador_razon_social})
+ ($F{prestador_cuit} == null
   || $F{prestador_cuit}.trim().length() == 0
        ? ""
        : " - " + $F{prestador_cuit})
                    ]]></textFieldExpression>
                </textField>

                <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                    <reportElement x="470" y="4" width="81" height="30"/>
                    <textElement>
                        <font fontName="SansSerif" size="7"/>
                    </textElement>
                    <textFieldExpression class="java.lang.String"><![CDATA[$F{detalle_observaciones}]]></textFieldExpression>
                </textField>

                <line><reportElement x="28" y="0" width="1" height="38"/></line>
                <line><reportElement x="70" y="0" width="1" height="38"/></line>
                <line><reportElement x="210" y="0" width="1" height="38"/></line>
                <line><reportElement x="278" y="0" width="1" height="38"/></line>
                <line><reportElement x="346" y="0" width="1" height="38"/></line>
                <line><reportElement x="466" y="0" width="1" height="38"/></line>
            </frame>
        </band>
    </detail>

    <summary>
        <band height="120" splitType="Stretch">
            <line>
                <reportElement x="0" y="4" width="555" height="1"/>
            </line>

            <staticText>
                <reportElement x="345" y="14" width="90" height="14">
                    <printWhenExpression><![CDATA[
$F{id_estado} != null
&& $F{id_estado}.intValue() != 1
                    ]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Total general:]]></text>
            </staticText>

            <textField isBlankWhenNull="true">
                <reportElement x="440" y="14" width="115" height="14">
                    <printWhenExpression><![CDATA[
$F{id_estado} != null
&& $F{id_estado}.intValue() != 1
                    ]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[
$F{total_general} == null
    ? ""
    : new java.text.DecimalFormat("$ #,##0.00")
        .format($F{total_general})
                ]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="38" width="85" height="14"/>
                <textElement>
                    <font fontName="SansSerif" size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Observaciones:]]></text>
            </staticText>

            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="0" y="56" width="555" height="50"/>
                <textElement>
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$F{observaciones}]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>
