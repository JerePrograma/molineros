    <field name="recupero" class="java.lang.Boolean"/>
    <field name="observaciones" class="java.lang.String"/>

    <field name="detalle_id" class="java.lang.Integer"/>
    <field name="detalle_orden" class="java.lang.Integer"/>
    <field name="id_articulo" class="java.lang.Integer"/>
    <field name="articulo" class="java.lang.String"/>
    <field name="cantidad" class="java.lang.Integer"/>
    <field name="precio_unitario_estimado" class="java.math.BigDecimal"/>
    <field name="precio_total_estimado" class="java.math.BigDecimal"/>
    <field name="detalle_observaciones" class="java.lang.String"/>

    <field name="total_estimado" class="java.math.BigDecimal"/>

    <variable name="TOTAL_ESTIMADO" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[
            $F{detalle_id} == null || $F{precio_total_estimado} == null
                ? new java.math.BigDecimal("0")
                : $F{precio_total_estimado}
        ]]></variableExpression>
        <initialValueExpression><![CDATA[new java.math.BigDecimal("0")]]></initialValueExpression>
    </variable>

