<c3p0-config>	
	<named-config name="portal-ospim"> 
		<property name="driverClass">org.postgresql.Driver</property>
		<property name="jdbcUrl">jdbc:postgresql://@IP@:5432/@BASE@</property>
		<property name="user">postgres</property>
		<property name="password">@PASS@</property>
		<property name="acquireIncrement">1</property> 
		<property name="initialPoolSize">5</property> 
		<property name="minPoolSize">5</property> 
		<property name="maxPoolSize">20</property> 
		<!-- fbrachi adopts a different approach to configuring statement caching -->
		<property name="maxStatements">0</property> 
		<property name="maxStatementsPerConnection">30</property>
		<property name="unreturnedConnectionTimeout">200</property> <!-- seconds -->
		<property name="debugUnreturnedConnectionStackTraces">true</property>
		<!-- Prueba de configuracion para evitar colapso en la peticion de conexiones -->
		<property name="numHelperThreads">3</property>
        <property name="acquireRetryDelay">2000</property>
        <property name="acquireRetryAttempts">3</property>
  	    <!--Fin Prueba -->
	</named-config>
	<named-config name="portal-lportal"> 
		<property name="driverClass">org.postgresql.Driver</property>
