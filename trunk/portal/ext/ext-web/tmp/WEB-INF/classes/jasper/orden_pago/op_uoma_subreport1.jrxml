<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="report5_subreport1" pageWidth="300" pageHeight="802" columnWidth="300" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<style name="Title" forecolor="#FFFFFF" fontSize="50" isBold="false"/>
	<style name="SubTitle" forecolor="#CCCCCC" fontSize="18" isBold="false"/>
	<style name="Column header" forecolor="#666666" fontSize="14" isBold="true"/>
	<style name="Detail" mode="Transparent"/>
	<style name="Row" mode="Transparent">
		<conditionalStyle>
			<conditionExpression><![CDATA[$V{REPORT_COUNT}%2 == 0]]></conditionExpression>
			<style mode="Opaque" backcolor="#F0EFEF"/>
		</conditionalStyle>
	</style>
	<parameter name="CUIT" class="java.lang.String">
		<parameterDescription><![CDATA[]]></parameterDescription>
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PUNTO_VTA" class="java.math.BigDecimal">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="COMPRO_NRO" class="java.lang.String">
		<parameterDescription><![CDATA[]]></parameterDescription>
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="COMPRO_TIPO" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="COMPRO_LETRA" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="COMPRO_SUCU" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select ccc__concepto_id,cc__descripcion,sum(ccc__importe) as ccc__importe
from uoma.buscar_concepto_comprobante_uoma(cast($P{PUNTO_VTA} as integer),
cast($P{COMPRO_TIPO} as varchar), cast($P{COMPRO_NRO} as varchar), cast($P{CUIT} as varchar),
cast($P{COMPRO_LETRA} as varchar), cast($P{COMPRO_SUCU} as integer))
group by ccc__concepto_id,cc__descripcion]]>
	</queryString>
	<field name="ccc__concepto_id" class="java.lang.Integer"/>
	<field name="cc__descripcion" class="java.lang.String"/>
	<field name="ccc__importe" class="java.math.BigDecimal"/>
	<detail>
		<band height="13" splitType="Stretch">
			<frame>
				<reportElement style="Row" mode="Opaque" x="0" y="0" width="300" height="13"/>
				<textField>
					<reportElement style="Detail" positionType="Float" x="0" y="0" width="270" height="13"/>
					<textElement>
						<font size="8"/>
					</textElement>
					<textFieldExpression class="java.lang.String"><![CDATA[$F{cc__descripcion}]]></textFieldExpression>
				</textField>
				<textField pattern="#,##0.00">
					<reportElement x="207" y="0" width="92" height="13"/>
					<textElement textAlignment="Right">
						<font size="8"/>
