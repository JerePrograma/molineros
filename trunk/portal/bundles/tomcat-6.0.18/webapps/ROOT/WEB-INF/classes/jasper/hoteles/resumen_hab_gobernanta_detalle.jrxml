<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="report name" pageWidth="802" pageHeight="555" orientation="Landscape" columnWidth="802" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="aniod_p" class="java.lang.String"/>
	<parameter name="fechad_p" class="java.lang.String"/>
	<parameter name="piso_p" class="java.lang.String"/>
	<queryString>
		<![CDATA[select * from hoteles.reporte_gobernanta($P{aniod_p}::integer, $P{fechad_p}::character varying)
inner join hoteles.habitaciones_configuracion hc on habitacion_id = nro_habitacion::character varying
where grupo = $P{piso_p}::character varying ;]]>
	</queryString>
	<field name="habitacion_id" class="java.lang.String"/>
	<field name="reserva_id" class="java.lang.Integer"/>
	<field name="fecha_desde" class="java.sql.Date"/>
	<field name="fecha_hasta" class="java.sql.Date"/>
