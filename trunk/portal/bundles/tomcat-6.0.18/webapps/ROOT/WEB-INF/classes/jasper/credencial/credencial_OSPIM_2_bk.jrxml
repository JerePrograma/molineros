<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="report name" pageWidth="255" pageHeight="170" columnWidth="255" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="82"/>
	<parameter name="id_lote" class="java.lang.String"/>
	<queryString>
		<![CDATA[select * from traer_datos_credencial(cast($P{id_lote} as varchar))]]>
	</queryString>
	<field name="cuil" class="java.lang.String"/>
	<field name="plan_p" class="java.lang.String"/>
	<field name="apellido" class="java.lang.String"/>
	<field name="nombre" class="java.lang.String"/>
	<field name="tdoc" class="java.lang.String"/>
	<field name="nro_doc" class="java.lang.Integer"/>
	<field name="inte" class="java.lang.Integer"/>
	<field name="categoria" class="java.lang.String"/>
	<field name="id_uoma" class="java.lang.Integer"/>
	<field name="id_ospim" class="java.lang.Integer"/>
	<field name="id_amtima" class="java.lang.Integer"/>
	<field name="parentesco" class="java.lang.String"/>
	<field name="ingreso" class="java.lang.String"/>
	<field name="baja_fecha" class="java.lang.String"/>
	<field name="id_seccional" class="java.lang.Integer"/>
	<field name="seccional_p" class="java.lang.String"/>
	<field name="cuit" class="java.lang.String"/>
	<field name="razon_soc" class="java.lang.String"/>
	<field name="disca" class="java.lang.String"/>
	<field name="plan_omint" class="java.lang.String"/>
	<detail>
		<band height="170" splitType="Stretch">
			<textField>
				<reportElement x="18" y="70" width="236" height="19"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font size="12" isBold="true" isItalic="false"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{apellido}+" "+$F{nombre}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="33" y="128" width="110" height="11"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="SansSerif" size="9" isBold="true"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{id_uoma}==null&&$F{id_ospim}!=null?String.valueOf("OSPIM: "+$F{id_ospim})+"/"+String.valueOf($F{inte})
:"UOMA: "+$F{id_uoma}.toString()]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="33" y="138" width="110" height="11"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="SansSerif" size="9" isBold="true"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{id_ospim}==null
&&$F{id_uoma}!=null
&&$F{id_amtima}!=null
?"AMTIMA: "+$F{id_amtima}.toString()
:$F{id_ospim}!=null
&&$F{id_uoma}==null
&&$F{id_amtima}!=null
?"AMTIMA: "+$F{id_amtima}.toString()
:$F{id_uoma}!=null
&&$F{id_ospim}!=null
?"OSPIM: "+$F{id_ospim}+"/"+$F{inte}.toString()
:$F{id_ospim}!=null
&&$F{id_uoma}==null
&&$F{id_amtima}==null?"":""]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="33" y="148" width="110" height="11"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="SansSerif" size="9" isBold="true"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{id_amtima}==null
&&$F{id_uoma}!=null
&&$F{id_ospim}!=null
?""
:$F{id_amtima}!=null
&&$F{id_uoma}==null
&&$F{id_ospim}!=null
?""
:$F{id_uoma}!=null
&&$F{id_ospim}!=null
?"AMTIMA: "+$F{id_amtima}.toString()
:$F{id_amtima}!=null
&&$F{id_uoma}==null
&&$F{id_uoma}==null?"":""]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement stretchType="RelativeToBandHeight" x="33" y="93" width="221" height="27"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font size="9" isBold="false"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{parentesco}.length()<38?$F{parentesco}:$F{parentesco}.substring(0,37)+"-"+$F{parentesco}.substring(38,$F{parentesco}.length())]]></textFieldExpression>
			</textField>
			<textField pattern="dd/MM/yy">
				<reportElement x="140" y="115" width="114" height="13"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font size="9"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{ingreso}==null?"":"F.Ing: "+$F{ingreso}]]></textFieldExpression>
			</textField>
			<textField pattern="dd/MM/yyyy">
				<reportElement x="33" y="115" width="111" height="13"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font size="9" isBold="true"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{baja_fecha}==null?"":"F.Vto: "+$F{baja_fecha}.toString()]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="83" y="126" width="171" height="14"/>
				<box leftPadding="4" bottomPadding="1">
					<pen lineWidth="0.0" lineStyle="Double"/>
					<topPen lineWidth="0.0" lineStyle="Double"/>
					<leftPen lineWidth="0.0" lineStyle="Double"/>
					<bottomPen lineWidth="0.0" lineStyle="Double"/>
					<rightPen lineWidth="0.0" lineStyle="Double"/>
				</box>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font size="9"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["Secc: "+$F{id_seccional}+" - "+$F{seccional_p}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="85" y="137" width="169" height="12"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font size="9"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{razon_soc}]]></textFieldExpression>
			</textField>
			<image vAlign="Top">
				<reportElement x="118" y="86" width="22" height="15">
					<printWhenExpression><![CDATA[$F{disca}.equals("1")]]></printWhenExpression>
				</reportElement>
				<imageExpression class="java.lang.String"><![CDATA["./handicap.png"]]></imageExpression>
			</image>
			<textField pattern="#,##0">
				<reportElement x="154" y="84" width="100" height="15"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font size="10" isBold="true"/>
				</textElement>
				<textFieldExpression class="java.lang.Integer"><![CDATA[$F{nro_doc}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="159" y="148" width="95" height="12"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="SansSerif" size="9"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{cuit}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
</jasperReport>
