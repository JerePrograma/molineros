	<subDataset name="Table Dataset 1"/>
	<parameter name="idreclamo" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["./"]]></defaultValueExpression>
	</parameter>
	<parameter name="pathimage" class="java.lang.String"/>
	<queryString>
		<![CDATA[select distinct
coalesce(B.r__id_orden_pago , C.r__id_orden_pago )  as   r__id_orden_pago ,
coalesce(B.r__nro_cheque, C.r__nro_cheque )  as   r_nro_cheque  ,
coalesce(B.r__fecha_op ,C.r__fecha_op   )  as   r__fecha_op   ,
A.rp_id_reclamo  , A.rp_cuiltitular , A.rp_inte  , A.apellido  , A.nombre  , A.nombreapellido  , A.cuil  , A.docu_numero  ,
TO_CHAR(A.rp_fecha_ospim ,  'DD/MM/YYYY')   as   rp_fecha_ospim      , A.rp_fecha_seccional
 , A.sector , A.rp_fecha_cierre , A.rp_obscierre , A.rp_anegociar , A.rp_factura_ospim , A.rp_seccional , A.plan_molineros  , A.plan_prevencion  , A.nrocredencial
 , A.fechadiscapacidad  , A.justificacion_medica  , A.dictamen_comision  , A.rp_codigocie10  , A.rp_diagnoticocie10  , A.rp_diagnostico  , A.rp_tipopedido
,rp.amparo::boolean,rp.entramite,
coalesce((select true from
 autorizaciones.reclamos_prestacionales_prestaciones PRES where  PRES.id_reclamo_prestacional = cast( $P{idreclamo} as integer)  and
PRES.recuperable in(1,3) limit 1
),false) as recuperable

,superintendencia ,rp.amparo::boolean,rp.entramite,rp.recuperable,superintendencia
from autorizaciones.rpt_reclamo_datosafiliado(cast( $P{idreclamo} as integer)) A
inner join autorizaciones.reclamos_prestacionales rp on A.rp_id_reclamo=rp.id
left join buscar_resumen_op_reintegros_reclamos_prestacionales  (cast( $P{idreclamo} as integer)) B
on A.rp_id_reclamo  = B.r_id_reclamo_prestacional
left join buscar_resumen_op_reintegros_reclamos_prestacionales_farmacia  (cast( $P{idreclamo} as integer)) C
on A.rp_id_reclamo   = C.r_id_reclamo_prestacional]]>
	</queryString>
