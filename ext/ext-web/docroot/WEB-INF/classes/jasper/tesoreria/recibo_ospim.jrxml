	<subDataset name="pagos">
		<parameter name="id_recibo" class="java.lang.String"/>
		<queryString>
			<![CDATA[select
coalesce( ee.descripcion,
case when ri__nro_cheque is not null then 'Cheque ' || ri__nro_cheque::character varying || ' ' || coalesce(b.descripcion)
when ri__id_recibo_ingreso_tipo_deposito=1 then 'Depósito Bancario ' || coalesce('nro ' ||ri__numero_deposito,'')
when ri__id_recibo_ingreso_tipo_deposito=2 then 'Transferencia Bancaria ' || coalesce(ri__numero_deposito,'')  || ' ' || coalesce( ch__cta_bcria,'')
when ri__id_anticipo_recibo_concepto <>0 then 'Anticipo '
else 'Efectivo'
end) as descripcion,
ri__importe as importe,
ri__fecha as fecha
from
buscar_recibo_ingresos($P{id_recibo}::integer) r
left join banco b on r.ri__id_banco=b.id_banco
left join efectivo_estado ee on r.ri__id_estado_efectivo =ee.id
where ri__baja_fecha is null]]>
		</queryString>
		<field name="descripcion" class="java.lang.String"/>
		<field name="importe" class="java.math.BigDecimal"/>
		<field name="fecha" class="java.sql.Date"/>
	</subDataset>
	<parameter name="ID_RECIBO" class="java.lang.String"/>
	<queryString>
		<![CDATA[select r.numero,r.fecha,r.cuit,r.sucursal,e.razon_soc,r.importe,
case when rc.acta_id is not null then 'Acta ' || coalesce(a.numero,'')
when rc.convenio_id is not null then 'Convenio ' || coalesce(cv.numero,'')
when rc.caja_concepto_id is not null then c.descripcion else ''
end as concepto_descripcion,
(coalesce(rc.concepto_importe_por_cheques,0)+coalesce(rc.concepto_importe_adicional,0)) as concepto_importe,
(select distinct string_agg(TO_CHAR(periodo, 'YYYY/MM'),'-') from acta_periodos ap where ap.acta_id=a.id)
as periodos,
transf_importe_a_texto(r.importe) as importe_en_letras
from recibo_conceptos rc
inner join recibo r on r.id =rc.recibo_id
left join informacion_afip.empresa e on r.cuit=e.cuit and r.sucursal=e.sucursal
left join acta a on rc.acta_id=a.id
left join convenio cv on rc.convenio_id=cv.id
left outer join conceptos c
    on rc.caja_concepto_id = c.id_concepto_maestro
    and cast(c.valido_desde as date)  <= cast(r.fecha as date)
    and cast(c.valido_hasta as date)  >= cast(r.fecha as date)
where r.id=$P{ID_RECIBO}::integer;]]>
	</queryString>
	<field name="numero" class="java.lang.String"/>
	<field name="fecha" class="java.sql.Date"/>
	<field name="cuit" class="java.lang.String"/>
	<field name="sucursal" class="java.lang.String"/>
	<field name="razon_soc" class="java.lang.String"/>
	<field name="importe" class="java.math.BigDecimal"/>
	<field name="concepto_descripcion" class="java.lang.String"/>
	<field name="concepto_importe" class="java.math.BigDecimal"/>
	<field name="periodos" class="java.lang.String"/>
	<field name="importe_en_letras" class="java.lang.String"/>
