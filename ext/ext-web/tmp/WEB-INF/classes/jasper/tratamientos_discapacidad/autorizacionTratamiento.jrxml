	<queryString>
		<![CDATA[select td_id_tratamiento, td_importe_total, a_apellido  || ', ' || a_nombre as afiliado_string,  TO_CHAR(localtimestamp, 'DD/MM/YYYY') as fecha_actual, prestador_string, n_descripcion, cast (a_docu_numero as character varying) as a_id_ospim, s_descripcion, cast(TO_CHAR(td_periodo_desde,'YYYY') as character varying) as anio_actual, cast (td_cantidad as numeric) as td_cantidad, TO_CHAR(td_periodo_desde, 'DD/MM/YYYY') as td_periodo_desde, TO_CHAR(td_periodo_hasta, 'DD/MM/YYYY') as td_periodo_hasta, '(' || td_periodicidad || ')' as td_periodicidad
from buscar_tratamiento_discapacidad_by_id(cast ($P{id_ini} as integer))
union all
select td_id_tratamiento, td_importe_total, a_apellido  || ', ' || a_nombre as afiliado_string,  TO_CHAR(localtimestamp, 'DD/MM/YYYY') as fecha_actual, prestador_string, n_descripcion, cast (a_docu_numero as character varying) as a_id_ospim, s_descripcion, cast(TO_CHAR(td_periodo_desde,'YYYY') as character varying) as anio_actual, cast (td_cantidad as numeric) as td_cantidad, TO_CHAR(td_periodo_desde, 'DD/MM/YYYY') as td_periodo_desde, TO_CHAR(td_periodo_hasta, 'DD/MM/YYYY') as td_periodo_hasta, '(' || td_periodicidad || ')' as td_periodicidad
from autorizaciones.buscar_autorizacion_prestacional_by_id(cast ($P{id_ini} as integer))]]>
	</queryString>
