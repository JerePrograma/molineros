	<parameter name="fecha_desde" class="java.lang.String"/>
	<parameter name="fecha_hasta" class="java.lang.String"/>
	<queryString>
		<![CDATA[select

to_char (localtimestamp, 'DD/MM/YYYY') as fecha_actual,
a.apellido || ', ' || a.nombre as afiliado_string,
a.documento_tipo || ': ' || a.docu_numero as a_nro_documento,
ati.apellido || ', ' || ati.nombre as afiliado_titular_string

from afiliado a, afiliado ati

where

a.cuil_titular = $P{cuil_titular}
and a.inte=cast($P{inte} as integer)
and a.cuil_titular = ati.cuil_titular
and ati.inte = 0]]>
	</queryString>
	<field name="fecha_actual" class="java.lang.String"/>
	<field name="afiliado_string" class="java.lang.String"/>
	<field name="a_nro_documento" class="java.lang.String"/>
