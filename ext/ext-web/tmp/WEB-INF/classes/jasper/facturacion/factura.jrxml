<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="factura" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="603"/>
	<subDataset name="dataset1">
		<parameter name="p_factura" class="java.lang.String" isForPrompting="false"/>
		<queryString>
			<![CDATA[select case when fi__nro_cheque is not null then 'Cheque'
        when fi__id_factura_ingreso_tipo_deposito =3 then 'Tarjeta Débito'
        when fi__id_factura_ingreso_tipo_deposito =4 then 'Tarjeta Crédito'
        when fi__id_factura_ingreso_tipo_deposito =7 then 'Financiación Turismo'
        when fi__id_factura_ingreso_tipo_deposito >0 and  fi__id_factura_ingreso_tipo_deposito not in(3,4,7)then 'Transferencia Bancaria'
        when fi__nro_pagare is not null then 'Pagaré'
        else 'Efectivo'
       end as tipo ,b.descripcion as banco,
ra__importe  from uoma.buscar_factura_ingresos($P{p_factura}::integer) a
left join banco b on b.id_banco =a.fi__id_banco
union
select 'ANTICIPO NRO ' || recibo_nro,'' as banco, importe as ra__importe
 from uoma.factura_recibos where id_factura=$P{p_factura}::integer]]>
		</queryString>
		<field name="tipo" class="java.lang.String"/>
		<field name="banco" class="java.lang.String"/>
		<field name="ra__importe" class="java.math.BigDecimal"/>
	</subDataset>
	<scriptlet name="digitoVerificador" class="net.sf.jasperreports.engine.JRDefaultScriptlet"/>
	<parameter name="id_fc_p" class="java.lang.String"/>
	<parameter name="id_ejemplar" class="java.lang.String"/>
	<parameter name="imprimeRazonSocial" class="java.lang.String"/>
	<queryString>
		<![CDATA[select  fc.compro_tipo,fc.compro_nro,fc.compro_letra,fc.compro_sucu,fc.fecha,fc.impre_fecha,fc.cae,fc.id_cliente,fc.exen,fc.grava,fc.iva_total,fc.total,fc.id_cliente,fc.fecha_vto_cae,
 fc.observaciones as observacionesFC,  fd.id_producto,fd.precio,
  cli.apellido,cli.nombre,coalesce(cli.cuil,cli.documento_numero) as cuil,cli.cuit,cli.tipo,cli.condicion_iva,cli.razon_social,
dom.*,
pr.*,
cfg.nombre_fantasia, cfg.direccion as direccion_pto_vta,cfg.telefono as telefono_pto_vta,cfg.condicion_iva as condicion_iva_pto_vta,cfg.ingresos_brutos as ingresos_brutos_pto_vta,cfg.inicio_actividades as inicio_actividades_pto_vta,
(case when fc.cae is not null then
uoma.digito_verificador_factura_electronica('30531143856' || (case when fc.compro_letra='A' then '001' else '006' end) || cfg.id || fc.cae || to_char(fc.fecha_vto_cae,'YYYYMMDD')) else 0 end)
as digito_verificador,
 to_char(fc.fecha_vto_cae,'YYYYMMDD') as cae_vto_as_string,
(select
string_agg(condicion_pago,'-')
from (select distinct
case when (numero_deposito is not null and (
	id_factura_ingreso_tipo_deposito in(2,1) or id_factura_ingreso_tipo_deposito is null ) )
   then 'TRANSFERENCIA BCRIA.'
when (id_factura_ingreso_tipo_deposito in(3))
   then 'TARJETA DEBITO'
when (id_factura_ingreso_tipo_deposito in(4))
   then 'TARJETA CREDITO'
when (id_factura_ingreso_tipo_deposito in(7))
   then 'FINANCIACION TURISMO'
when (nro_cheque is not null) then 'CHEQUE' else 'EFECTIVO' end
as condicion_pago
from uoma.factura_ingresos fi
where fi.factura_id = fd.id_factura ) a
) as condicion_pago,

( 'https://www.afip.gob.ar/fe/qr/?p=' ||
encode(((json_build_object('ver',1,'fecha',to_char(fc.fecha,'yyyy-MM-dd'),
  'cuit',30531143856,'ptoVta',fc.compro_sucu::integer,
  'ticpoCmp', case when fc.compro_tipo='FCP' and fc.compro_letra='A' then 1
                   when fc.compro_tipo='FCP' and fc.compro_letra='B' then 6
                   when fc.compro_tipo='NCR' and fc.compro_letra='A' then 3
                   when fc.compro_tipo='NCR' and fc.compro_letra='B' then 8
              end,
   'nroCmp',fc.compro_nro::bigint,
   'importe',fc.total,
   'moneda','PES',
   'ctz',1,
   'tipoDocRec',case when coalesce(cli.cuil,cli.documento_numero) is not null and length(trim(coalesce(cli.cuil,cli.documento_numero)))=11 then 86
                     when coalesce(cli.cuil,cli.documento_numero) is not null and length(trim(coalesce(cli.cuil,cli.documento_numero)))<11 then 96
                     when cli.cuit is not null and length(trim(coalesce(cli.cuil,cli.documento_numero)))=11 then 80
                end,
    'nroDocRec', coalesce(coalesce(cli.cuil,cli.documento_numero),cli.cuit)::numeric,
    'tipoCodAut','E',
    'codAut',fc.cae::numeric
))::character varying)::bytea,'base64')
 )as codigoQR


from uoma.factura_detalle fd
inner join uoma.factura fc on fd.id_factura=fc.id
inner join uoma.cliente cli on cli.id = fc.id_cliente
left join uoma.cliente_domicilio clidom on cli.id=clidom.id_cliente
left join uoma.domicilio dom on dom.id_domicilio =clidom.id_domicilio
left join uoma.producto pr on pr.id = fd.id_producto
left join uoma.factura_cfg_puntos_venta cfg on fc.compro_sucu=cfg.id
where  fc.id = $P{id_fc_p}::integer and fd.baja_fecha is null;]]>
	</queryString>
